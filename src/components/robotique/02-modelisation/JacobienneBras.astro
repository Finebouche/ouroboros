---
// Cours Robotique : la jacobienne du bras d'exemple (l1 = 0,5 m, l2 = 0,4 m).
// À gauche, le bras dans le plan de la tâche : les deux colonnes de J dessinées comme vitesses de la pince (q̇1 = 1 rad/s seul,
// puis q̇2 = 1 rad/s seul), et l'ellipse des vitesses atteintes pour ‖q̇‖ = 1 (image du cercle unité par J).
// À droite, l'espace des configurations (q1, q2) : un clic y choisit q ; bandes plus foncées = |det J| plus grand ;
// lignes q2 = 0 (tendu) et q2 = ±180° (replié) : singularités. Tout est recalculé dans le navigateur (bras.ts).
import katex from 'katex';
const tx = (s: string) => katex.renderToString(s, { throwOnError: false });
const F = {
  x: tx('p_x = l_1 \\cos q_1 + l_2 \\cos(q_1 + q_2)'),
  y: tx('p_y = l_1 \\sin q_1 + l_2 \\sin(q_1 + q_2)'),
  J: tx('J = \\begin{pmatrix} -l_1 \\sin q_1 - l_2 \\sin(q_1{+}q_2) & -l_2 \\sin(q_1{+}q_2) \\\\ \\phantom{-}l_1 \\cos q_1 + l_2 \\cos(q_1{+}q_2) & \\phantom{-}l_2 \\cos(q_1{+}q_2) \\end{pmatrix}'),
  d: tx('\\det J = l_1\\, l_2 \\sin q_2'),
};
---
<div class="widget jacw" data-widget="jacw">
  <div class="jw-h">
    <div class="jw-t"><b>Quelle vitesse de la pince chaque articulation produit-elle ?</b></div>
    <div class="jw-st"><span>|det J|</span><b data-ref="det"></b></div>
  </div>
  <div class="jw-ctl">
    <div class="sl">
      <label><span>Épaule q₁</span><input type="range" data-ref="q1" min="-180" max="180" step="1" value="45" /><b data-ref="q1-out"></b></label>
      <label><span>Coude q₂</span><input type="range" data-ref="q2" min="-180" max="180" step="1" value="90" /><b data-ref="q2-out"></b></label>
    </div>
    <div class="row"><span>Pose :</span><span class="seg" data-ref="pose">
      <button data-v="90">coudé, q₂ = 90°</button><button data-v="0">tendu, q₂ = 0°</button><button data-v="180">replié, q₂ = 180°</button>
    </span></div>
  </div>
  <div class="jw-body">
    <svg data-ref="arm" viewBox="0 0 410 340" role="img" aria-label="Le bras dans son plan, les deux colonnes de la jacobienne en flèches à la pince et l'ellipse des vitesses"></svg>
    <div class="jw-cs">
      <div class="jw-cst">Espace des configurations <span>(un clic choisit q)</span></div>
      <svg data-ref="cs" viewBox="0 0 326 302" role="img" aria-label="Carré des configurations (q1, q2) avec les lignes singulières q2 = 0 et q2 = ±180°"></svg>
    </div>
  </div>
  <div class="jw-calc">
    <div><div class="fm" set:html={F.x} /><div class="ef" data-ref="lx"></div></div>
    <div><div class="fm" set:html={F.y} /><div class="ef" data-ref="ly"></div></div>
    <div><div class="fm" set:html={F.J} /><div class="ef" data-ref="lJ"></div></div>
    <div><div class="fm" set:html={F.d} /><div class="ef" data-ref="ld"></div></div>
  </div>
  <div class="kpis">
    <div><span>Grand demi-axe σ<sub>max</sub></span><b data-ref="smax"></b><i>plus grande vitesse de la pince pour ‖q̇‖ = 1 rad/s</i></div>
    <div><span>Petit demi-axe σ<sub>min</sub></span><b data-ref="smin"></b><i>0 : une direction de vitesse est perdue</i></div>
    <div><span>κ(J) = σ<sub>max</sub> / σ<sub>min</sub></span><b data-ref="mu"></b><i>1 : toutes les directions aussi faciles</i></div>
  </div>
  <p class="note">Flèche pleine : colonne 1 (épaule) ; pointillée : colonne 2 (coude). Ellipse : image de ‖q̇‖ = 1. Échelle : 1 m/s dessiné comme 0,4 m. Carré : plus foncé là où |det J| est grand.</p>
</div>

<script>
  import { fk, jac, svd2, fr } from './bras';
  import { arrow, link, joint, ground } from './svg';

  document.querySelectorAll<HTMLElement>('[data-widget="jacw"]').forEach((root) => {
    const $ = <E extends Element = HTMLElement>(r: string) => root.querySelector<E>(`[data-ref="${r}"]`)!;
    const i1 = $<HTMLInputElement>('q1'), i2 = $<HTMLInputElement>('q2'), arm = $<SVGSVGElement>('arm'), cs = $<SVGSVGElement>('cs');
    const D = Math.PI / 180, VS = 0.4;
    const deg = (v: number) => `${Math.round(v)}°`.replace('-', '−');
    const vec = (a: number, b: number, d = 3) => `(${fr(a, d)} ; ${fr(b, d)})`;

    // vue du bras : 1 m = 120 px, épaule au centre
    const S = 148, X = (x: number) => 205 + x * S, Y = (y: number) => 170 - y * S;
    // carré des configurations : q de −180° à 180°, 260 px de côté
    const CX0 = 44, CY0 = 8, CW = 260, QX = (q: number) => CX0 + ((q + 180) / 360) * CW, QY = (q: number) => CY0 + ((180 - q) / 360) * CW;

    // fond fixe du carré : bandes |sin q2|, lignes singulières, graduations
    let bg = '';
    for (let k = 0; k < 72; k++) {
      const qa = -180 + k * 5, op = 0.03 + 0.2 * Math.abs(Math.sin((qa + 2.5) * D));
      bg += `<rect x="${CX0}" y="${QY(qa + 5).toFixed(1)}" width="${CW}" height="${(CW / 72 + 0.3).toFixed(2)}" fill="var(--text-2)" fill-opacity="${op.toFixed(3)}"/>`;
    }
    bg += `<rect x="${CX0}" y="${CY0}" width="${CW}" height="${CW}" fill="none" stroke="var(--border)"/>`;
    [0, 180, -180].forEach((q) => (bg += `<line x1="${CX0}" y1="${QY(q)}" x2="${CX0 + CW}" y2="${QY(q)}" stroke="var(--text)" stroke-width="1.3" stroke-dasharray="5 4"/>`));
    bg += `<text x="${CX0 + 6}" y="${QY(0) - 5}" class="jw-sg">singulier : tendu (q₂ = 0)</text>`;
    bg += `<text x="${CX0 + 6}" y="${QY(180) + 14}" class="jw-sg">singulier : replié (q₂ = ±180°)</text>`;
    [-180, -90, 0, 90, 180].forEach((q) => {
      bg += `<text x="${QX(q)}" y="${CY0 + CW + 14}" text-anchor="middle" class="jw-ax">${deg(q)}</text>`;
      bg += `<text x="${CX0 - 5}" y="${QY(q) + 4}" text-anchor="end" class="jw-ax">${deg(q)}</text>`;
    });
    bg += `<text x="${CX0 + CW / 2}" y="${CY0 + CW + 28}" text-anchor="middle" class="jw-ax">q₁</text>`;
    bg += `<text x="${CX0 + CW - 2}" y="${CY0 + 24}" text-anchor="end" class="jw-ax">q₂ ↑</text>`;

    const pose = root.querySelectorAll<HTMLButtonElement>('[data-ref="pose"] button');

    function draw() {
      const a = +i1.value, b = +i2.value, q = [a * D, b * D];
      $('q1-out').textContent = deg(a); $('q2-out').textContent = deg(b);
      pose.forEach((bt) => bt.classList.toggle('active', Math.abs(Math.abs(b) - +bt.dataset.v!) < 0.5 && (+bt.dataset.v! !== 0 || b === 0)));
      const { p1, p2 } = fk(q), J = jac(q), sv = svd2(J), det = J[0][0] * J[1][1] - J[0][1] * J[1][0];
      const sing = Math.abs(Math.sin(b * D)) < 1e-9;

      // ---- vue du bras ----
      let s = '';
      // ellipse des vitesses : image du cercle ‖q̇‖ = 1 par J (segment à la singularité)
      const pts = Array.from({ length: 73 }, (_, k) => { const t = (k / 72) * 2 * Math.PI, vx = J[0][0] * Math.cos(t) + J[0][1] * Math.sin(t), vy = J[1][0] * Math.cos(t) + J[1][1] * Math.sin(t); return `${X(p2[0] + VS * vx).toFixed(1)},${Y(p2[1] + VS * vy).toFixed(1)}`; });
      s += `<polygon points="${pts.join(' ')}" fill="var(--text-2)" fill-opacity="0.08" stroke="var(--text-2)" stroke-opacity="0.55" stroke-width="${sing ? 2.2 : 1.1}"/>`;
      // ligne épaule → pince (la colonne 1 lui est perpendiculaire)
      s += `<line x1="${X(0)}" y1="${Y(0)}" x2="${X(p2[0]).toFixed(1)}" y2="${Y(p2[1]).toFixed(1)}" stroke="var(--text-2)" stroke-width="0.9" stroke-dasharray="3 3" opacity="0.8"/>`;
      s += ground(X(0), Y(0));
      s += link(X(0), Y(0), X(p1[0]), Y(p1[1])) + link(X(p1[0]), Y(p1[1]), X(p2[0]), Y(p2[1]));
      s += joint(X(0), Y(0)) + joint(X(p1[0]), Y(p1[1]));
      s += `<circle cx="${X(p2[0]).toFixed(1)}" cy="${Y(p2[1]).toFixed(1)}" r="3.5" fill="var(--text)"/>`;
      // angles droits : colonne 1 ⟂ (pince − épaule), colonne 2 ⟂ (pince − coude)
      const rightAngle = (from: number[], col: number[]) => {
        const ux = from[0] - p2[0], uy = from[1] - p2[1], L = Math.hypot(ux, uy), cl = Math.hypot(col[0], col[1]);
        if (L < 1e-6 || cl < 1e-6) return '';
        const a1 = [ux / L, uy / L], a2 = [col[0] / cl, col[1] / cl], r = 7 / S;
        const P0 = [p2[0] + a1[0] * r, p2[1] + a1[1] * r], P1 = [P0[0] + a2[0] * r, P0[1] + a2[1] * r], P2 = [p2[0] + a2[0] * r, p2[1] + a2[1] * r];
        return `<polyline points="${X(P0[0]).toFixed(1)},${Y(P0[1]).toFixed(1)} ${X(P1[0]).toFixed(1)},${Y(P1[1]).toFixed(1)} ${X(P2[0]).toFixed(1)},${Y(P2[1]).toFixed(1)}" fill="none" stroke="var(--rb-q)" stroke-width="1" opacity="0.8"/>`;
      };
      const c1 = [J[0][0], J[1][0]], c2 = [J[0][1], J[1][1]];
      s += rightAngle([0, 0], c1) + rightAngle(p1, c2);
      const tip = (c: number[]) => [X(p2[0] + VS * c[0]), Y(p2[1] + VS * c[1])];
      const t1 = tip(c1), t2 = tip(c2);
      s += arrow(X(p2[0]), Y(p2[1]), t1[0], t1[1], { c: 'var(--rb-q)', w: 2.6, head: 9 });
      s += arrow(X(p2[0]), Y(p2[1]), t2[0], t2[1], { c: 'var(--rb-q)', w: 2.2, head: 8, dash: '5 3' });
      // étiquettes au bout des flèches, écartées si elles se chevauchent
      const lab = (t: number[], c: number[], txt: string, dy = 0) => {
        const L = Math.hypot(c[0], c[1]) || 1, ux = c[0] / L, uy = -c[1] / L, x = t[0] + ux * 12, y = t[1] + uy * 12 + 4 + dy;
        const an = ux > 0.35 ? 'start' : ux < -0.35 ? 'end' : 'middle';
        return { x, y, s: `<text x="${x.toFixed(1)}" y="${y.toFixed(1)}" text-anchor="${an}" class="jw-lb">${txt}</text>` };
      };
      const l1 = lab(t1, c1, 'épaule'); let l2 = lab(t2, c2, 'coude');
      if (Math.hypot(l1.x - l2.x, l1.y - l2.y) < 16) l2 = lab(t2, c2, 'coude', l2.y >= l1.y ? 15 : -15);
      s += l1.s + l2.s;
      arm.innerHTML = s;

      // ---- carré des configurations ----
      cs.innerHTML = bg + `<circle cx="${QX(a).toFixed(1)}" cy="${QY(b).toFixed(1)}" r="6" fill="var(--rb-q)" stroke="var(--surface)" stroke-width="2"/>`;

      // ---- calcul ----
      $('lx').textContent = `p_x = 0,5 cos ${deg(a)} + 0,4 cos ${deg(a + b)} = ${fr(p2[0], 3)} m`;
      $('ly').textContent = `p_y = 0,5 sin ${deg(a)} + 0,4 sin ${deg(a + b)} = ${fr(p2[1], 3)} m`;
      $('lJ').textContent = `colonne 1 = ${vec(c1[0], c1[1])}, colonne 2 = ${vec(c2[0], c2[1])} (m/s par rad/s)`;
      $('ld').textContent = `det J = 0,5 × 0,4 × sin ${deg(b)} = ${fr(det, 3)} m²`;
      $('det').textContent = `${fr(Math.abs(det), 3)} m²`;
      $('smax').textContent = `${fr(sv.smax, 3)} m/s`;
      $('smin').textContent = `${fr(sing ? 0 : sv.smin, 3)} m/s`;
      $('mu').textContent = sing ? '∞' : fr(sv.smax / sv.smin, 2);
    }

    i1.addEventListener('input', draw); i2.addEventListener('input', draw);
    pose.forEach((bt) => bt.addEventListener('click', () => { i2.value = bt.dataset.v!; draw(); }));
    // clic ou glissé dans le carré : q1, q2 au degré près
    const pick = (e: PointerEvent) => {
      const r = cs.getBoundingClientRect(), k = 326 / r.width;
      const px = (e.clientX - r.left) * k, py = (e.clientY - r.top) * k;
      const a = Math.round(-180 + ((px - CX0) / CW) * 360), b = Math.round(180 - ((py - CY0) / CW) * 360);
      i1.value = String(Math.max(-180, Math.min(180, a))); i2.value = String(Math.max(-180, Math.min(180, b)));
      draw();
    };
    let drag = false;
    cs.addEventListener('pointerdown', (e) => { drag = true; cs.setPointerCapture(e.pointerId); pick(e); });
    cs.addEventListener('pointermove', (e) => { if (drag) pick(e); });
    cs.addEventListener('pointerup', () => (drag = false));
    cs.addEventListener('pointercancel', () => (drag = false));
    draw();
  });
</script>

<style is:global>
  .jacw .jw-h { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px 14px; flex-wrap: wrap; margin-bottom: 10px; }
  .jacw .jw-t b { font-size: 15px; font-weight: 600; color: var(--text); }
  .jacw .jw-st { display: flex; align-items: baseline; gap: 8px; background: var(--surface-2); border-radius: 8px; padding: 4px 10px; }
  .jacw .jw-st span { font-size: 12px; color: var(--text-2); }
  .jacw .jw-st b { font-size: 14px; font-weight: 600; }
  .jacw .jw-ctl .sl { display: grid; margin-bottom: 8px; }
  .jacw .jw-ctl .row { margin-bottom: 4px; font-size: 13px; }
  .jacw .seg { display: inline-flex; flex-wrap: wrap; gap: 6px; }
  .jacw .seg button { font-size: 13px; padding: 4px 11px; }
  .jacw .jw-body { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: 14px; align-items: center; margin-top: 6px; }
  .jacw .jw-body svg { width: 100%; height: auto; display: block; }
  .jacw svg[data-ref="cs"] { cursor: crosshair; touch-action: none; }
  .jacw .jw-cst { font-size: 13px; font-weight: 500; color: var(--text); margin-bottom: 2px; }
  .jacw .jw-cst span { font-weight: 400; color: var(--text-2); font-size: 12.5px; }
  .jacw .jw-calc { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 18px; background: color-mix(in srgb, var(--text-2) 6%, transparent); border-radius: 8px; padding: 8px 12px; margin-top: 10px; }
  .jacw .jw-calc > div:nth-child(3) { grid-column: 1 / -1; }
  .jacw .fm { font-size: 13px; overflow-x: auto; overflow-y: hidden; }
  .jacw .fm .katex { font-size: 1em; }
  .jacw .ef { font-size: 12.5px; color: var(--text-2); font-variant-numeric: tabular-nums; }
  .jacw svg text.jw-lb { font: 600 11.5px var(--font); fill: var(--rb-q); }
  .jacw svg text.jw-ax { font: 11px var(--font); fill: var(--text-2); }
  .jacw svg text.jw-sg { font: 11px var(--font); fill: var(--text); }
  @media (max-width: 640px) { .jacw .jw-body, .jacw .jw-calc { grid-template-columns: 1fr; } .jacw .jw-cs { max-width: 320px; } }
  @media (max-width: 640px) { .jacw svg text.jw-lb { font-size: 15px; } .jacw svg text.jw-ax, .jacw svg text.jw-sg { font-size: 13px; } }
</style>
