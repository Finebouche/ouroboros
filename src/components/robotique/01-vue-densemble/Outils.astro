---
// Cours Robotique, vue d'ensemble : les outils d'une famille, même mise en forme que Families.astro (cours RL, chapitre 1).
// Prop `f` : la famille. Gris seul. Les faits viennent des anciens chapitres (versions et essais indiqués dans le texte).
const { f } = Astro.props as { f: string };
type Row = { name: string; org: string; what: string; base: string };
const DATA: Record<string, Row[]> = {
  cao: [
    { name: 'Onshape', org: 'PTC', what: 'CAO paramétrique dans le navigateur : pièces (Part Studio), assemblage et liaisons (Assembly, mates)', base: 'navigateur, API d\'Onshape' },
    { name: 'onshape-to-robot', org: 'Rhoban', what: 'lit un Assembly, écrit URDF, SDF ou MJCF : arbre d\'après le nom des mates, inerties fusionnées', base: 'API d\'Onshape' },
    { name: 'Microban', org: 'Rhoban, LaBRI', what: 'humanoïde open source de 30 cm, 19 servomoteurs : exemple complet de la chaîne', base: 'Onshape, onshape-to-robot' },
  ],
  modelisation: [
    { name: 'Pinocchio', org: 'Inria', what: 'cinématique, jacobienne, RNEA, CRBA, ABA et leurs dérivées analytiques ; pas de simulation', base: 'C++ ; URDF' },
    { name: 'MuJoCo', org: 'Google DeepMind', what: 'simulateur : intégration et contacts mous, par optimisation convexe', base: 'MJCF (lit aussi l\'URDF)' },
  ],
  ik: [
    { name: 'pink', org: 'Caron et al.', what: 'cinématique inverse différentielle : un QP par pas (tâches, butées, vitesses)', base: 'Pinocchio, solveur QP à part (DAQP)' },
    { name: 'mink', org: 'Zakka', what: 'cinématique inverse sur MuJoCo, sur le modèle de pink', base: 'MuJoCo' },
    { name: 'placo', org: 'Rhoban', what: 'même QP, plus dynamique et marche ; poids appliqué à la norme au carré', base: 'C++ ; Pinocchio jusqu\'à la 0.10, modèle propre depuis la 0.11' },
  ],
  planification: [
    { name: 'Dijkstra, A*', org: '—', what: 'plus court chemin sur une grille ; A* oriente la recherche par une heuristique h(n)', base: 'configurations discrétisées' },
    { name: 'RRT, RRT-Connect', org: '—', what: 'arbre(s) de configurations tirées au hasard, gardées si le segment est libre', base: 'test de collision et distance' },
  ],
  apprentissage: [
    { name: 'Gymnasium', org: 'Farama Foundation', what: 'le contrat environnement-agent : reset, step, espaces', base: 'NumPy' },
    { name: 'Stable Baselines3', org: 'DLR-RM', what: 'PPO, SAC, DQN… en une ligne : PPO("MlpPolicy", env).learn()', base: 'PyTorch, Gymnasium' },
    { name: 'mjlab', org: 'mujocolab', what: 'tâches de robots, milliers de copies en parallèle, randomisation', base: 'MuJoCo Warp (GPU NVIDIA), RSL-RL' },
  ],
  identification: [
    { name: 'BAM', org: 'Rhoban', what: 'modèles de servo-actionneurs (moteur, firmware, six frottements) ajustés sur les positions par CMA-ES ; actionneur pour MuJoCo', base: 'MuJoCo, Optuna' },
  ],
  corps: [
    { name: 'TSID', org: 'Del Prete, Carpentier et al.', what: 'dynamique inverse : un QP par pas de commande (tâches PD en accélération, contacts), couples en sortie', base: 'Pinocchio, eiquadprog' },
    { name: 'Crocoddyl', org: 'Mastalli, Mansard et al.', what: 'commande optimale sur un horizon : DDP et FDDP, phases d\'appui et de vol', base: 'Pinocchio' },
  ],
};
const rows = DATA[f];
---
<figure class="rb-vo">
  <div class="orr ohd"><div>outil</div><div>ce qu'il fait</div><div>s'appuie sur</div></div>
  {rows.map((r, i) => (
    <div class={`orr org${i % 2 ? ' alt' : ''}`}>
      <div class="onm"><b>{r.name}</b><small>{r.org}</small></div>
      <div class="owh">{r.what}</div>
      <div class="ob">{r.base}</div>
    </div>
  ))}
</figure>

<style is:global>
  .rb-vo { margin: 1.2rem 0; font-family: var(--font); }
  .rb-vo .orr { display: grid; grid-template-columns: 150px minmax(0, 1fr) 170px; column-gap: 16px; align-items: center; }
  .rb-vo .ohd { padding: 0 14px 6px; font-size: 11.5px; font-weight: 600; color: var(--text); }
  .rb-vo .org { border-radius: 8px; background: color-mix(in srgb, var(--text-2) 7%, transparent); padding: 9px 14px; margin-bottom: 6px; }
  .rb-vo .org.alt { background: color-mix(in srgb, var(--text-2) 3.5%, transparent); }
  .rb-vo .onm b { display: block; font-size: 13px; font-weight: 600; color: var(--text); }
  .rb-vo .onm small { display: block; font-size: 11.5px; color: var(--text-2); margin-top: 2px; }
  .rb-vo .owh { font-size: 12.5px; color: var(--text); line-height: 1.45; }
  .rb-vo .ob { font-size: 11.5px; color: var(--text-2); line-height: 1.4; font-style: italic; }
  @media (max-width: 680px) { .rb-vo .orr { grid-template-columns: 1fr; row-gap: 4px; } .rb-vo .ohd { display: none; } }
</style>
