---
// Cours Robotique, vue d'ensemble : les sept familles de la diapositive « A toolbox », sur un rail numéroté.
// Chaque famille répond à une question et produit un objet. Gris seul : pas de couleur par famille.
const rows = [
  { fr: 'Décrire', en: 'Robot & CAD', q: 'quels corps, quelles articulations, quelles masses ?', out: 'fichier URDF / MJCF' },
  { fr: 'Modéliser', en: 'Modelling', q: 'où est chaque repère, quel mouvement pour quels couples ?', out: 'M(q), J(q), b(q, q̇)' },
  { fr: 'Cinématique inverse', en: 'Inverse kinematics', q: 'quelle configuration place un repère sur sa cible ?', out: 'configuration q' },
  { fr: 'Planifier', en: 'Planning', q: 'quel chemin mène au but sans collision ?', out: 'chemin q(t)' },
  { fr: 'Apprendre', en: 'Learning', q: 'quel contrôleur, appris en simulation ?', out: 'politique π' },
  { fr: 'Identifier', en: 'Identification', q: 'quels paramètres font coller le modèle au robot réel ?', out: 'paramètres θ' },
  { fr: 'Corps complet', en: 'Whole-body dynamics', q: 'quels couples pour tout le corps, avec les contacts ?', out: 'couples τ, forces f' },
];
---
<figure class="rb-fam">
  {rows.map((r, i) => (
    <div class="rfm-r">
      <div class="rfm-n"><span>{i + 1}</span></div>
      <div class="rfm-c">
        <div class="rfm-f"><b>{r.fr}</b><small>{r.en}</small></div>
        <div class="rfm-q">{r.q}</div>
        <div class="rfm-o"><small>produit</small><code>{r.out}</code></div>
      </div>
    </div>
  ))}
</figure>

<style is:global>
  .rb-fam { margin: 1.4rem 0; font-family: var(--font); }
  .rb-fam .rfm-r { display: grid; grid-template-columns: 30px minmax(0, 1fr); column-gap: 12px; align-items: center; position: relative; padding-bottom: 8px; }
  .rb-fam .rfm-r:not(:last-child)::before { content: ''; position: absolute; left: 14.25px; top: 50%; bottom: -50%; width: 1.5px; background: var(--border); }
  .rb-fam .rfm-n span { position: relative; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 1.5px solid var(--text-2); background: var(--surface, var(--bg)); font-size: 13px; font-weight: 600; color: var(--text); }
  .rb-fam .rfm-c { display: grid; grid-template-columns: 150px minmax(0, 1fr) 190px; column-gap: 14px; align-items: center; border: 1px solid var(--border); border-radius: 10px; padding: 8px 14px; }
  .rb-fam .rfm-f b { display: block; font-size: 13px; font-weight: 600; color: var(--text); }
  .rb-fam .rfm-f small { display: block; font-size: 11.5px; color: var(--text-2); margin-top: 1px; }
  .rb-fam .rfm-q { text-wrap: balance; font-size: 12.5px; line-height: 1.45; color: var(--text); }
  .rb-fam .rfm-o small { display: block; font-size: 11px; color: var(--text-2); }
  .rb-fam .rfm-o code { font-size: 12px; font-weight: 600; color: var(--text); background: none; padding: 0; }
  @media (max-width: 680px) { .rb-fam .rfm-c { grid-template-columns: minmax(0, 1fr); row-gap: 3px; } .rb-fam .rfm-f small, .rb-fam .rfm-o small { display: none; } .rb-fam .rfm-o code { font-size: 11.5px; } }
</style>
