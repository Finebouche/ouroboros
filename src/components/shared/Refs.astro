---
// Références liées à une partie du cours : [titre, auteurs, année, identifiant].
// L'identifiant est un numéro arXiv (2502.05171), un DOI (10.1109/…) ou une URL complète (https://…).
interface Props { items: [string, string, number, string][] }
const { items } = Astro.props;
const href = (id: string) => (id.startsWith('http') ? id : id.startsWith('10.') ? `https://doi.org/${id}` : `https://arxiv.org/abs/${id}`);
---
<p class="refs">
  <span class="rl">Références</span>
  {items.map(([title, authors, year, id], i) => (
    <>
      {i > 0 && <span class="sep">·</span>}
      <a href={href(id)} target="_blank" rel="noopener">{title}</a> <span class="ra">({authors}, {year})</span>
    </>
  ))}
</p>

<style>
  .refs { font-size: 13px; line-height: 1.6; color: var(--text-2); margin: -0.6rem 0 1.5rem; }
  .rl { font-weight: 500; color: var(--text); margin-right: 6px; }
  .sep { margin: 0 6px; }
  .ra { color: var(--text-2); }
</style>
