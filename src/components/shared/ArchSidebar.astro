---
// Schéma d'un transformer décodeur, avec mise en évidence de la partie en cours d'explication.
// Parties : head, norm-final, norm1, qkv (projections Q, K, V), attn, wo (projection de sortie W_O), kv (K et V gardés en cache), add1, norm2, mlp, add2, embed.
// Une boîte peut porter plusieurs parties (data-part="qkv kv") : elle s'allume si l'une d'elles est active.
// Variante « loop » (module 1) : embed, inject (réinjection de l'embedding), block (bloc partagé), loop (retour de la boucle), norm-final, head.
interface Props { variant?: 'transformer' | 'loop' }
const { variant = 'transformer' } = Astro.props;
---
<aside class="arch" data-arch-sidebar aria-label="Position dans l'architecture">
  {variant === 'loop' ? (
  <svg viewBox="0 0 210 384" width="100%" role="img" aria-label="Transformer bouclé : un bloc partagé répété T fois">
    <defs>
      <marker id="arch-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>

    <rect x="10" y="92" width="190" height="210" rx="10" class="loop" />
    <text x="20" y="108" class="sub">× T passes</text>

    <g class="edges">
      <path d="M115 52V40" /><path d="M115 130V78" /><path d="M115 221V182" /><path d="M115 318V245" />
    </g>

    <g data-part="head"><rect x="40" y="8" width="150" height="32" rx="6" /><text x="115" y="21" text-anchor="middle">Tête de sortie</text><text x="115" y="34" text-anchor="middle" class="sub">probas du token suivant</text></g>
    <g data-part="norm-final"><rect x="40" y="52" width="150" height="24" rx="6" /><text x="115" y="68" text-anchor="middle">RMSNorm</text></g>

    <g data-part="block"><rect x="40" y="130" width="150" height="50" rx="6" /><text x="115" y="151" text-anchor="middle">Bloc partagé</text><text x="115" y="168" text-anchor="middle" class="sub">attention + MLP</text></g>
    <g data-part="loop"><path d="M190 155 H198 V232 H128" /></g>
    <g data-part="inject"><circle cx="115" cy="232" r="11" /><text x="115" y="236" text-anchor="middle">+</text><text x="70" y="270" text-anchor="middle" class="sub">e réinjecté</text></g>

    <g data-part="embed"><rect x="40" y="318" width="150" height="28" rx="6" /><text x="115" y="336" text-anchor="middle">Embedding e</text></g>
    <text x="115" y="372" text-anchor="middle" class="sub">tokens d'entrée</text>
  </svg>
  ) : (
  <svg viewBox="0 0 210 524" width="100%" role="img" aria-label="Architecture d'un transformer décodeur">
    <defs>
      <marker id="arch-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>

    <rect x="10" y="90" width="190" height="356" rx="10" class="loop" />
    <text x="190" y="106" text-anchor="end" class="sub">× N couches</text>

    <g class="edges">
      <path d="M115 460V426" />
      <path d="M63 400V380" /><path d="M115 400V380" /><path d="M167 400V380" />
      <path d="M63 346V330" /><path d="M115 346V330" /><path d="M167 346V330" />
      <path d="M115 288V278" /><path d="M115 254V245" /><path d="M115 227V212" />
      <path d="M115 188V176" /><path d="M115 146V137" /><path d="M115 119V76" /><path d="M115 52V40" />
      <path d="M115 446H22V236H106" /><path d="M115 219H22V128H106" />
    </g>

    <g data-part="head"><rect x="40" y="8" width="150" height="32" rx="6" /><text x="115" y="21" text-anchor="middle">Tête de sortie</text><text x="115" y="34" text-anchor="middle" class="sub">probas du token suivant</text></g>
    <g data-part="norm-final"><rect x="40" y="52" width="150" height="24" rx="6" /><text x="115" y="68" text-anchor="middle">RMSNorm</text></g>

    <g data-part="add2"><circle cx="115" cy="128" r="9" /><text x="115" y="132" text-anchor="middle">+</text></g>
    <g data-part="mlp"><rect x="40" y="146" width="150" height="30" rx="6" /><text x="115" y="165" text-anchor="middle">MLP</text></g>
    <g data-part="norm2"><rect x="40" y="188" width="150" height="24" rx="6" /><text x="115" y="204" text-anchor="middle">RMSNorm</text></g>

    <g data-part="add1"><circle cx="115" cy="236" r="9" /><text x="115" y="240" text-anchor="middle">+</text></g>
    <g data-part="wo"><rect x="40" y="254" width="150" height="24" rx="6" /><text x="115" y="270" text-anchor="middle">Projection W<tspan dy="2" font-size="9">O</tspan></text></g>
    <g data-part="attn"><rect x="40" y="288" width="150" height="40" rx="6" /><text x="115" y="303" text-anchor="middle">Attention causale</text><text x="115" y="319" text-anchor="middle" class="sub">softmax(Q·Kᵀ)·V</text></g>

    <g data-part="qkv"><rect x="40" y="346" width="46" height="32" rx="5" /><text x="63" y="359" text-anchor="middle" class="cq">Q</text><text x="63" y="372" text-anchor="middle" class="sub">x·W<tspan dy="2" font-size="8">Q</tspan></text></g>
    <g data-part="qkv kv"><rect x="92" y="346" width="46" height="32" rx="5" /><text x="115" y="359" text-anchor="middle" class="ck">K</text><text x="115" y="372" text-anchor="middle" class="sub">x·W<tspan dy="2" font-size="8">K</tspan></text></g>
    <g data-part="qkv kv"><rect x="144" y="346" width="46" height="32" rx="5" /><text x="167" y="359" text-anchor="middle" class="cv">V</text><text x="167" y="372" text-anchor="middle" class="sub">x·W<tspan dy="2" font-size="8">V</tspan></text></g>

    <g data-part="norm1"><rect x="40" y="400" width="150" height="24" rx="6" /><text x="115" y="416" text-anchor="middle">RMSNorm</text></g>

    <g data-part="embed"><rect x="40" y="460" width="150" height="28" rx="6" /><text x="115" y="478" text-anchor="middle">Embedding</text></g>
    <text x="115" y="510" text-anchor="middle" class="sub">tokens d'entrée</text>
  </svg>
  )}
  <p class="caption" data-arch-label>Vue d'ensemble</p>
</aside>

<script>
  const root = document.querySelector<HTMLElement>('[data-arch-sidebar]');
  if (root) {
    const markers = Array.from(document.querySelectorAll<HTMLElement>('[data-arch-marker]'));
    const parts = Array.from(root.querySelectorAll<SVGGElement>('[data-part]'));
    const label = root.querySelector<HTMLElement>('[data-arch-label]')!;
    let current: HTMLElement | null | undefined;

    function update() {
      // En bas de page, les derniers repères ne peuvent plus monter jusqu'à 40 % : on prend le dernier visible.
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      const line = window.innerHeight * (atBottom ? 0.95 : 0.4);
      let active: HTMLElement | null = null;
      for (const m of markers) {
        if (m.getBoundingClientRect().top <= line) active = m;
        else break;
      }
      const follow = active?.dataset.follow ? document.querySelector<HTMLElement>(active.dataset.follow) : null;
      if (active === current && !follow) return;
      current = active;
      apply(follow?.dataset.archParts ?? active?.dataset.parts ?? '', follow?.dataset.archLabel ?? active?.dataset.label ?? "Vue d'ensemble");
    }

    function apply(names: string, text: string) {
      const on = new Set(names.split(/\s+/).filter(Boolean));
      parts.forEach((p) => p.classList.toggle('on', p.dataset.part!.split(/\s+/).some((n) => on.has(n))));
      label.textContent = text;
    }

    // Un widget peut aussi pointer une partie (ex. les étapes du bloc d'attention) ; le prochain défilement reprend la main.
    window.addEventListener('arch:focus', (ev) => {
      const d = (ev as CustomEvent<{ parts: string; label: string }>).detail;
      apply(d.parts, d.label);
      current = undefined;
    });

    let queued = false;
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); });
    }, { passive: true });
    update();
  }
</script>

<style is:global>
  .arch svg .loop { fill: none; stroke: var(--border); stroke-dasharray: 4 4; }
  .arch svg .edges path { fill: none; stroke: var(--text-2); stroke-width: 1; marker-end: url(#arch-arrow); }
  .arch svg text { font: 12px var(--font); fill: var(--text); }
  .arch svg text.sub { font-size: 11px; fill: var(--text-2); }
  .arch svg [data-part] > rect, .arch svg [data-part] > circle { fill: var(--surface-2); stroke: var(--border); transition: fill 0.2s, stroke 0.2s; }
  .arch svg [data-part].on > rect, .arch svg [data-part].on > circle { fill: var(--hl-bg); stroke: var(--hl-stroke); stroke-width: 1.5; }
  .arch svg [data-part].on > text { fill: var(--hl-text); }
  .arch svg [data-part] > text.cq { fill: var(--c-q); font-weight: 600; }
  .arch svg [data-part] > text.ck { fill: var(--c-k); font-weight: 600; }
  .arch svg [data-part] > text.cv { fill: var(--c-v); font-weight: 600; }
  .arch svg [data-part] > path { fill: none; stroke: var(--text-2); stroke-width: 1.2; marker-end: url(#arch-arrow); transition: stroke 0.2s; }
  .arch svg [data-part].on > path { stroke: var(--hl-stroke); stroke-width: 2.5; }
  .arch .caption { font-size: 13px; line-height: 1.4; color: var(--text-2); margin: 0.4rem 0 0; min-height: 2.8em; }
</style>
