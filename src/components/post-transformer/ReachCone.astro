---
// Champ réceptif sur fenêtre glissante : le cône s'élargit de W − 1 à chaque étage, comparé au contexte entier.
// unit = « couche » (couches empilées, module 0) ou « passe » (bloc bouclé, module 1).
interface Props { unit?: 'couche' | 'passe'; sym?: string }
const { unit = 'passe', sym = 'T' } = Astro.props;
---
<div class="widget reach" data-widget="reach" data-unit={unit} data-sym={sym}>
  <div class="sl">
    <label><span>Fenêtre W</span><input type="range" data-ref="w" min="1" max="6" step="1" value="3" /><b data-ref="w-out"></b></label>
    <label><span>{unit === 'couche' ? 'Couches' : 'Passes'} {sym}</span><input type="range" data-ref="t" min="1" max="6" step="1" value="3" /><b data-ref="t-out"></b></label>
  </div>
  <label class="full"><input type="checkbox" data-ref="full" /> Attention complète, sans fenêtre (W = taille du contexte)</label>
  <p class="hint">Clique sur une colonne pour choisir le mot dont on suit les dépendances.</p>
  <p class="lg"><i class="sq cur"></i>mot choisi <i class="sq in"></i>peut l'atteindre <i class="sq out"></i>hors de portée</p>
  <svg data-ref="svg" width="100%" role="img" aria-label="Cône de dépendance d'un mot, comparé au contexte"></svg>
  <div class="kpis">
    <div><span>Mots visibles après {sym} {unit}s</span><b data-ref="k1"></b></div>
    <div><span>Avec une seule {unit}</span><b data-ref="k2"></b></div>
  </div>
</div>

<script>
  const PHRASE = ['Le', 'chat', 'noir', 'dort', 'sur', 'le', 'canapé', 'du', 'salon', 'depuis', 'ce', 'matin', 'car', 'il', 'fait', 'froid', 'dehors', 'et', 'il', 'pleut'];

  document.querySelectorAll<HTMLElement>('[data-widget="reach"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const inp = (r: string) => $(r) as HTMLInputElement;
    const svg = $('svg') as unknown as SVGSVGElement;
    const S = PHRASE.length;
    const unit = root.dataset.unit ?? 'passe';
    const sym = root.dataset.sym ?? 'T';
    let target = S - 1;

    function draw() {
      const full = inp('full').checked;
      const W = full ? S : +inp('w').value;
      const T = +inp('t').value;
      inp('w').disabled = full;
      $('w-out').textContent = full ? String(S) : String(W);
      $('t-out').textContent = String(T);
      const cell = 26, ox = 74, oy = 10;
      const rows = T + 1;
      const yRow = (p: number) => oy + (T - p) * cell; // p = 0 (entrée) en bas, p = T en haut
      const xCol = (j: number) => ox + j * cell;
      const reachAt = (p: number) => Math.max(0, target - (T - p) * (W - 1));
      const left = reachAt(0);
      const visible = target - left + 1;
      let g = '';
      for (let p = 0; p <= T; p++) {
        g += `<text x="${ox - 8}" y="${yRow(p) + cell / 2 + 4}" text-anchor="end" class="ts">${p === 0 ? 'entrée' : `${unit} ${p}`}</text>`;
        for (let j = 0; j < S; j++) {
          const x0 = xCol(j) + 4, y0 = yRow(p) + 4, sz = cell - 8;
          const inCone = p === T ? j === target : j >= reachAt(p) && j <= target;
          const fill = p === T && j === target ? 'var(--c-reach-target)' : inCone ? 'var(--c-reach)' : 'none';
          const stroke = inCone || (p === T && j === target) ? 'none' : 'var(--border)';
          g += `<rect x="${x0}" y="${y0}" width="${sz}" height="${sz}" rx="3" fill="${fill}" stroke="${stroke}"/>`;
        }
      }
      // les mots du contexte, inclinés sous la grille
      const wy = yRow(0) + cell + 6;
      for (let j = 0; j < S; j++) {
        const cx = xCol(j) + cell / 2 + 3;
        const cls = j === target ? 'tw cur' : j >= left && j <= target ? 'tw in' : 'tw';
        g += `<text x="${cx}" y="${wy}" text-anchor="end" transform="rotate(-45 ${cx} ${wy})" class="${cls}">${PHRASE[j]}</text>`;
      }
      // accolades : portée, puis contexte entier
      const by = wy + 42;
      g += `<path d="M${xCol(left) + 4} ${by - 6} V${by} H${xCol(target) + cell - 4} V${by - 6}" fill="none" stroke="var(--c-reach-target)" stroke-width="1.2"/>`;
      g += `<text x="${(xCol(left) + xCol(target) + cell) / 2}" y="${by + 15}" text-anchor="middle" class="ts rc">portée : ${visible} mots</text>`;
      const cy2 = by + 30;
      g += `<path d="M${xCol(0) + 4} ${cy2 - 6} V${cy2} H${xCol(S - 1) + cell - 4} V${cy2 - 6}" fill="none" stroke="var(--text-2)" stroke-width="1.2"/>`;
      g += `<text x="${(xCol(0) + xCol(S - 1) + cell) / 2}" y="${cy2 + 15}" text-anchor="middle" class="ts">contexte : ${S} mots</text>`;
      // zones cliquables (une par colonne)
      for (let j = 0; j < S; j++) g += `<rect x="${xCol(j)}" y="${oy}" width="${cell}" height="${rows * cell}" fill="transparent" data-col="${j}" style="cursor:pointer"/>`;
      const H = cy2 + 24;
      svg.setAttribute('viewBox', `0 0 ${ox + S * cell + 10} ${H}`);
      svg.innerHTML = g;
      const formula = full ? 'tout le contexte' : `${sym} × (W − 1) + 1 = ${T * (W - 1) + 1}`;
      $('k1').innerHTML = `${visible} <small>sur ${S} (${formula})</small>`;
      $('k2').innerHTML = `${Math.min(W, target + 1)} <small>sur ${S}</small>`;
    }

    svg.addEventListener('click', (ev) => {
      const el = (ev.target as Element).closest('[data-col]');
      if (!el) return;
      target = +(el as HTMLElement).dataset.col!;
      draw();
    });
    ['w', 't'].forEach((r) => inp(r).addEventListener('input', draw));
    inp('full').addEventListener('change', draw);
    draw();
  });
</script>

<style is:global>
  .reach .sl { display: grid; gap: 6px; margin-bottom: 6px; }
  .reach .sl label { display: grid; grid-template-columns: 160px 1fr 40px; align-items: center; gap: 12px; font-size: 14px; color: var(--text-2); }
  .reach .sl b { text-align: right; color: var(--text); font-weight: 500; }
  .reach .full { display: block; font-size: 14px; color: var(--text-2); margin: 4px 0 6px; cursor: pointer; }
  .reach .hint { font-size: 13px; color: var(--text-2); margin: 0 0 4px; }
  .reach .lg { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; font-size: 12px; color: var(--text-2); margin: 0 0 8px; }
  .reach .sq { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: 4px; vertical-align: -1px; }
  .reach .sq.cur { background: var(--c-reach-target); }
  .reach .sq.in { background: var(--c-reach); }
  .reach .sq.out { border: 1px solid var(--border); }
  .reach svg text.ts { font: 11px var(--font); fill: var(--text-2); }
  .reach svg text.rc { fill: var(--text); font-weight: 500; }
  .reach svg text.tw { font: 11px var(--font); fill: var(--text-2); opacity: 0.45; }
  .reach svg text.tw.in { fill: var(--text); opacity: 1; }
  .reach svg text.tw.cur { fill: var(--text); opacity: 1; font-weight: 600; text-decoration: underline; }
  .reach .kpis small { font-size: 13px; color: var(--text-2); font-weight: 400; }
  @media (max-width: 600px) { .reach .sl label { grid-template-columns: 1fr; } }
</style>
