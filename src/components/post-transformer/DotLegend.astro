---
// Légende des disques, affichée une seule fois en tête de chapitre.
---
<div class="dotlegend" aria-label="Légende des disques">
  <span><svg width="22" height="22" viewBox="0 0 26 26" aria-hidden="true"><circle cx="13" cy="13" r="11" fill="var(--text-2)" /></svg>grande valeur +</span>
  <span><svg width="22" height="22" viewBox="0 0 26 26" aria-hidden="true"><circle cx="13" cy="13" r="5" fill="var(--text-2)" /></svg>petite valeur +</span>
  <span><svg width="22" height="22" viewBox="0 0 26 26" aria-hidden="true"><circle cx="13" cy="13" r="9" fill="none" stroke="var(--text-2)" stroke-width="1.5" /></svg>valeur −</span>
  <span><svg width="22" height="22" viewBox="0 0 26 26" aria-hidden="true"><circle cx="13" cy="13" r="1.5" fill="var(--text-2)" /></svg>zéro</span>
  <span><svg width="22" height="22" viewBox="0 0 26 26" aria-hidden="true"><rect x="2" y="2" width="22" height="22" rx="3" fill="var(--surface-2)" stroke="var(--border)" /></svg>case grise = masquée</span>
</div>

<style>
  .dotlegend { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 14px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 0.5rem 0.9rem; margin: 1rem 0 1.5rem; font-size: 13px; color: var(--text-2); }
  .dotlegend span { display: inline-flex; align-items: center; gap: 6px; }
</style>
