---
// Module 1 : sortie anticipée mot par mot, avec les quatre règles du tableau (ACT, Huginn, Ouro, MoR).
// Les valeurs par passe (probabilités d'arrêt, KL, scores du routeur) sont des valeurs d'illustration, pas celles d'un modèle entraîné.
---
<div class="widget exitw" data-widget="earlyexit">
  <div class="row"><span>Règle :</span><span class="seg" data-ref="rules"></span></div>
  <div class="sl">
    <label><span data-ref="pl"></span><input type="range" data-ref="p" /><b data-ref="p-out"></b></label>
  </div>
  <p class="hint" data-ref="hint"></p>
  <p class="lg"><i class="sq run"></i>passe calculée <i class="sq ex"></i>passe de sortie <i class="sq skip"></i>passe sautée<span class="lgv">· nombre dans la case : valeur que la règle lit</span></p>
  <svg data-ref="svg" width="100%" role="img" aria-label="Passes calculées pour chaque mot selon la règle d'arrêt"></svg>
  <div class="kpis">
    <div><span>Passes par mot (moyenne)</span><b data-ref="k1"></b></div>
    <div><span>Entrées K, V (mots actifs)</span><b data-ref="k2"></b></div>
    <div><span>Calcul économisé</span><b data-ref="k3"></b></div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-widget="earlyexit"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const inp = (r: string) => $(r) as HTMLInputElement;
    const svg = $('svg') as unknown as SVGSVGElement;
    const TMAX = 4;
    const WORDS = ['Le', 'chat', 'noir', 'dort', 'sur', 'le', 'canapé'];
    const N = WORDS.length;
    const pc = (v: number) => `${Math.round(v * 100)} %`;
    const f2 = (v: number) => v.toFixed(2).replace('.', ',');

    // valeurs d'illustration, une ligne par mot, une colonne par passe
    const H_ACT = [[.7, .4, .3, .5], [.2, .3, .4, .5], [.1, .2, .2, .3], [.05, .1, .2, .2], [.5, .5, .3, .3], [.9, .2, .2, .2], [.1, .15, .3, .5]];
    const KL = [[0, 3e-3, 2e-4, 1e-5], [0, 2e-2, 4e-3, 5e-4], [0, 5e-2, 1e-2, 3e-3], [0, 8e-2, 2e-2, 6e-3], [0, 4e-3, 3e-4, 2e-5], [0, 1e-3, 1e-4, 1e-5], [0, 6e-2, 1e-2, 2e-3]];
    const LAM = [[.7, .6, .5], [.2, .5, .4], [.15, .2, .4], [.1, .15, .2], [.6, .5, .5], [.8, .5, .5], [.1, .2, .3]];
    const SCORE = [[0, .2, .1, .1], [0, .6, .4, .5], [0, .8, .7, .6], [0, .9, .8, .9], [0, .3, .2, .2], [0, .1, .1, .1], [0, .7, .9, .7]];

    type Res = { exit: number; vals: string[] }[];
    type Rule = {
      name: string; label: string; min: number; max: number; step: number; def: number;
      show: (v: number) => string; hint: string; run: (v: number) => Res;
    };

    const RULES: Rule[] = [
      {
        name: 'ACT', label: 'ε', min: 0.01, max: 0.5, step: 0.01, def: 0.01, show: (v) => f2(v),
        hint: "ACT : on s'arrête quand la somme cumulée des probabilités d'arrêt h atteint 1 − ε. Le nombre dans la case est cette somme. Si elle n'y arrive pas, arrêt forcé à la dernière passe.",
        run: (eps) => H_ACT.map((h) => {
          let s = 0, exit = TMAX - 1;
          const vals: string[] = [];
          for (let p = 0; p < TMAX; p++) {
            s += h[p];
            vals.push(f2(s));
            if (s >= 1 - eps - 1e-9) { exit = p; break; }
          }
          return { exit, vals };
        }),
      },
      {
        name: 'Huginn', label: 'Seuil KL', min: 1, max: 5, step: 0.1, def: 3.3, show: (v) => `10^−${v.toFixed(1).replace('.', ',')}`,
        hint: "Huginn : on s'arrête quand la divergence KL entre les sorties de deux passes successives passe sous le seuil (pas de décision possible à la passe 1). Le nombre dans la case est ce KL.",
        run: (e) => KL.map((row) => {
          const thr = Math.pow(10, -e);
          let exit = TMAX - 1;
          const vals = ['—'];
          for (let p = 1; p < TMAX; p++) {
            vals.push(row[p].toExponential(0));
            if (row[p] < thr) { exit = p; break; }
          }
          return { exit, vals };
        }),
      },
      {
        name: 'Ouro', label: 'Seuil q', min: 0.1, max: 1, step: 0.05, def: 0.6, show: (v) => f2(v),
        hint: "Ouro : on s'arrête à la première passe où la probabilité cumulée de sortie CDF atteint q. Le nombre dans la case est cette probabilité cumulée.",
        run: (q) => LAM.map((lam) => {
          let surv = 1, exit = TMAX - 1;
          const vals: string[] = [];
          for (let p = 0; p < TMAX; p++) {
            const cdf = p < TMAX - 1 ? 1 - (surv *= 1 - lam[p]) : 1;
            vals.push(pc(cdf));
            if (cdf >= q - 1e-9) { exit = p; break; }
          }
          return { exit, vals };
        }),
      },
      {
        name: 'MoR', label: 'Capacité c', min: 0.3, max: 1, step: 0.05, def: 0.6, show: (v) => `${Math.round(v * 100)} %`,
        hint: "MoR (version expert-choice) : à chaque passe, un routeur note les mots encore actifs et ne garde que la fraction c des mieux notés, qui passent à la passe suivante. Le nombre dans la case est le score du routeur.",
        run: (c) => {
          let active = WORDS.map((_, i) => i);
          const exit = new Array(N).fill(0);
          const vals: string[][] = WORDS.map(() => ['—']);
          for (let p = 1; p < TMAX; p++) {
            const k = Math.max(1, Math.round(active.length * c));
            active = [...active].sort((a, b) => SCORE[b][p] - SCORE[a][p]).slice(0, k);
            active.forEach((i) => { exit[i] = p; vals[i][p] = f2(SCORE[i][p]); });
          }
          return WORDS.map((_, i) => ({ exit: exit[i], vals: vals[i] }));
        },
      },
    ];

    let cur = 2; // Ouro par défaut
    const vals = RULES.map((r) => r.def);

    function draw() {
      const rule = RULES[cur];
      const v = vals[cur];
      $('pl').textContent = rule.label;
      $('p-out').textContent = rule.show(v);
      $('hint').textContent = rule.hint;
      root.querySelectorAll('[data-rule]').forEach((b, i) => b.classList.toggle('active', i === cur));
      const res = rule.run(v);
      const cell = 36, ox = 62, oy = 6;
      const yOf = (p: number) => oy + (TMAX - 1 - p) * cell;
      let g = '';
      let total = 0;
      for (let p = 0; p < TMAX; p++) g += `<text x="${ox - 10}" y="${yOf(p) + cell / 2 + 4}" text-anchor="end">passe ${p + 1}</text>`;
      res.forEach(({ exit, vals: vs }, j) => {
        total += exit + 1;
        const x = ox + j * cell;
        for (let p = 0; p < TMAX; p++) {
          const fill = p < exit ? 'hsl(30,45%,68%)' : p === exit ? 'var(--c-model-loop)' : 'none';
          const stroke = p <= exit ? 'none' : 'var(--border)';
          g += `<rect x="${x + 3}" y="${yOf(p) + 3}" width="${cell - 6}" height="${cell - 6}" rx="4" fill="${fill}" stroke="${stroke}"/>`;
          if (p <= exit && vs[p]) g += `<text x="${x + cell / 2}" y="${yOf(p) + cell / 2 + 3.5}" text-anchor="middle" class="${p === exit ? 'cv ex' : 'cv'}">${vs[p]}</text>`;
        }
        g += `<text x="${x + cell / 2}" y="${oy + TMAX * cell + 16}" text-anchor="middle" class="tw">${WORDS[j]}</text>`;
      });
      svg.setAttribute('viewBox', `0 0 ${ox + N * cell + 10} ${oy + TMAX * cell + 26}`);
      svg.innerHTML = g;
      const full = N * TMAX;
      $('k1').innerHTML = `${(total / N).toFixed(1).replace('.', ',')} <small>sur ${TMAX}</small>`;
      $('k2').innerHTML = `${total} <small>sur ${full}</small>`;
      $('k3').textContent = `${Math.round((1 - total / full) * 100)} %`;
    }

    function setRule(i: number) {
      cur = i;
      const r = RULES[i];
      inp('p').min = String(r.min);
      inp('p').max = String(r.max);
      inp('p').step = String(r.step);
      inp('p').value = String(vals[i]);
      draw();
    }

    RULES.forEach((r, i) => {
      const b = document.createElement('button');
      b.textContent = r.name;
      b.dataset.rule = String(i);
      b.addEventListener('click', () => setRule(i));
      $('rules').appendChild(b);
    });
    inp('p').addEventListener('input', () => { vals[cur] = +inp('p').value; draw(); });
    setRule(cur);
  });
</script>

<style is:global>
  .exitw .seg { display: inline-flex; gap: 6px; }
  .exitw .seg button { font-size: 13px; padding: 4px 12px; }
  .exitw .sl { margin-bottom: 4px; }
  .exitw .sl label { display: grid; grid-template-columns: 160px 1fr 70px; align-items: center; gap: 12px; font-size: 14px; color: var(--text-2); }
  .exitw .sl b { text-align: right; color: var(--text); font-weight: 500; }
  .exitw .hint { font-size: 13px; line-height: 1.45; color: var(--text-2); margin: 4px 0 6px; min-height: 3.8em; }
  .exitw .lg { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; font-size: 12px; color: var(--text-2); margin: 0 0 8px; }
  .exitw .sq { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: 4px; vertical-align: -1px; }
  .exitw .sq.run { background: hsl(30, 45%, 68%); }
  .exitw .sq.ex { background: var(--c-model-loop); }
  .exitw .sq.skip { border: 1px solid var(--border); }
  .exitw svg text { font: 11px var(--font); fill: var(--text-2); }
  .exitw svg text.tw { font-size: 12px; fill: var(--text); }
  .exitw svg text.cv { font-size: 9.5px; fill: #3d2610; }
  .exitw svg text.cv.ex { fill: #ffffff; font-weight: 500; }
  .exitw .kpis small { font-size: 13px; color: var(--text-2); font-weight: 400; }
  @media (max-width: 600px) { .exitw .sl label { grid-template-columns: 1fr; } }
</style>
