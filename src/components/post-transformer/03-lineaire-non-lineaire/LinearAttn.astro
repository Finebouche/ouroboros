---
// Chapitre 3 : attention sans softmax = récurrence à état matriciel. Deux calculs du même résultat sur les 4 premiers mots :
// forme parallèle (matrice des scores masquée × V) et forme récurrente (S_t = S_{t-1} + v_t k_tᵀ, o_t = S_t q_t).
import katex from 'katex';
const tx = (s: string) => katex.renderToString(s, { throwOnError: false });
const F = {
  par: tx('o_t = \\sum_{j \\le t} (q_t \\cdot k_j)\\, v_j'),
  rec: tx('S_t = S_{t-1} + v_t\\, k_t^{\\top}, \\qquad o_t = S_t\\, q_t'),
};
---
<div class="widget linatt" data-widget="linatt">
  <div class="row"><span>Mot :</span><span class="seg" data-ref="words"></span><label class="nums"><input type="checkbox" data-ref="nums" /> afficher les nombres</label></div>
  <div class="la-sec">
    <div class="la-h"><b>Forme parallèle</b> <span>tous les mots d'un coup</span></div>
    <div class="fm" set:html={F.par} />
    <div class="la-stage" data-ref="par"></div>
  </div>
  <div class="la-sec">
    <div class="la-h"><b>Forme récurrente</b> <span>un mot après l'autre, avec un état S de taille fixe</span></div>
    <div class="fm" set:html={F.rec} />
    <div class="la-stage" data-ref="rec"></div>
  </div>
  <div class="kpis">
    <div><span>Écart entre les deux formes</span><b data-ref="kd"></b><i>même résultat, calculé autrement</i></div>
    <div><span>Taille de l'état S</span><b data-ref="ks"></b><i>fixe, quel que soit le nombre de mots lus</i></div>
    <div><span>KV cache d'une attention softmax</span><b data-ref="kv"></b><i>un K et un V de plus à chaque mot</i></div>
  </div>
</div>

<script>
  import { WORDS, X, WQ, WK, WV, mul } from './../00-bases/qkvData';

  document.querySelectorAll<HTMLElement>('[data-widget="linatt"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    type M = number[][];
    const N = 4, w = WORDS.slice(0, N), D = WQ[0].length;
    const Xn = X.slice(0, N);
    // pas de 1/√d ni de softmax : le calcul linéaire pur
    const Q = Xn.map((x) => mul(x, WQ)), K = Xn.map((x) => mul(x, WK)), V = Xn.map((x) => mul(x, WV));
    const dot = (a: number[], b: number[]) => a.reduce((s, v, i) => s + v * b[i], 0);
    const Sc: M = Q.map((q, i) => K.map((k, j) => (j <= i ? dot(q, k) : 0)));
    const Opar: M = Sc.map((row) => V[0].map((_, c) => row.reduce((s, sc, j) => s + sc * V[j][c], 0)));
    // états S_t (lignes = dimension de v, colonnes = dimension de k)
    const S: M[] = []; let cur: M = Array.from({ length: D }, () => new Array(D).fill(0)); S.push(cur);
    const dS: M[] = V.map((v, t) => v.map((vr) => K[t].map((kc) => vr * kc)));
    for (let t = 0; t < N; t++) { cur = cur.map((r, i) => r.map((x, j) => x + dS[t][i][j])); S.push(cur); }
    const Orec: M = Q.map((q, t) => S[t + 1].map((row) => dot(row, q)));
    const diff = Math.max(...Opar.flat().map((v, i) => Math.abs(v - Orec.flat()[i])));
    $('kd').textContent = diff < 1e-9 ? '< 10⁻⁹' : diff.toExponential(1);
    $('ks').textContent = `${D} × ${D} = ${D * D} nombres`;
    let sel = 3, showNums = false;
    const C = { gray: 'var(--text-2)', q: 'var(--c-q)', k: 'var(--c-k)', v: 'var(--c-v)', sc: 'var(--c-w)', out: 'var(--c-neutral)' };
    const fx = (v: number) => (Math.abs(v) < 0.05 ? '0.0' : v.toFixed(1)).replace('-', '−');
    function mat(title: string, m: M, o: { cell: number; color: string; rows?: string[]; cols?: string[]; hl?: number; shape: string; vmax?: number; mask?: boolean }) {
      const cell = o.cell, lw = o.rows ? 36 : 0, th = 14, nr = m.length, nc = m[0].length;
      const vmax = o.vmax ?? Math.max(1e-9, ...m.flat().map(Math.abs));
      let g = '';
      if (o.cols) o.cols.forEach((c, j) => (g += `<text x="${lw + j * cell + cell / 2}" y="10" text-anchor="middle">${c}</text>`));
      m.forEach((row, i) => {
        const cy = th + i * cell + cell / 2;
        if (o.rows) g += `<text x="${lw - 5}" y="${cy + 3.5}" text-anchor="end">${o.rows[i]}</text>`;
        row.forEach((v, j) => {
          const x0 = lw + j * cell, y0 = th + i * cell, masked = !!o.mask && j > i;
          g += `<rect x="${x0 + 1}" y="${y0 + 1}" width="${cell - 2}" height="${cell - 2}" rx="3" fill="${masked ? 'var(--surface-2)' : 'none'}" stroke="var(--border)" stroke-width="0.5"/>`;
          if (masked) return;
          if (showNums) { g += `<text x="${x0 + cell / 2}" y="${cy + 3}" text-anchor="middle" class="mn" style="font-size:${Math.min(10.5, cell * 0.4).toFixed(1)}px">${fx(v)}</text>`; return; }
          const r = Math.abs(v) < 1e-9 ? 1 : (cell / 2 - 2) * Math.sqrt(Math.abs(v) / vmax);
          g += `<circle cx="${x0 + cell / 2}" cy="${cy}" r="${r.toFixed(2)}" ${v < 0 ? `fill="none" stroke="${o.color}" stroke-width="1.5"` : `fill="${o.color}"`}><title>${v.toFixed(2)}</title></circle>`;
        });
      });
      if (o.hl !== undefined) g += `<rect x="${lw}" y="${th + o.hl * cell}" width="${nc * cell}" height="${cell}" rx="4" fill="none" stroke="var(--accent)" stroke-width="1.5"/>`;
      const W = lw + nc * cell, Ht = th + nr * cell;
      return `<div class="mblk"><div class="mt">${title}</div><svg width="${W}" height="${Ht}" viewBox="0 0 ${W} ${Ht}" role="img" aria-label="${o.shape}">${g}</svg><div class="ms">${o.shape}</div></div>`;
    }
    const op = (t: string) => `<div class="op">${t}</div>`;
    const sub = (s: string) => s;
    function draw() {
      const t = sel, cell = 24;
      const Vm = V;
      $('par').innerHTML =
        mat('scores q·k (masqués)', Sc, { cell, color: C.sc, rows: w, cols: w, hl: t, mask: true, shape: '4 × 4, sans softmax' }) + op('×') +
        mat('V', Vm, { cell, color: C.v, rows: w, shape: '4 × 4' }) + op('=') +
        mat('sorties o', Opar, { cell, color: C.out, hl: t, shape: '4 × 4' });
      const Sprev = S[t], Snow = S[t + 1];
      const vcol: M = V[t].map((v) => [v]);
      const krow: M = [K[t]];
      const qcol: M = Q[t].map((v) => [v]);
      $('rec').innerHTML =
        mat(`S<sub>${t}</sub> (avant)`, Sprev, { cell, color: C.out, shape: '4 × 4' }) + op('+') +
        mat(`v<sub>${w[t]}</sub>`, vcol, { cell, color: C.v, shape: '4 × 1' }) + op('·') +
        mat(`k<sub>${w[t]}</sub><sup>⊤</sup>`, krow, { cell, color: C.k, shape: '1 × 4' }) + op('=') +
        mat(`S<sub>${t + 1}</sub> (après)`, Snow, { cell, color: C.out, shape: '4 × 4' }) +
        '<div class="br"></div>' +
        mat(`S<sub>${t + 1}</sub>`, Snow, { cell, color: C.out, shape: '4 × 4' }) + op('×') +
        mat(`q<sub>${w[t]}</sub>`, qcol, { cell, color: C.q, shape: '4 × 1' }) + op('=') +
        mat(`o<sub>${w[t]}</sub>`, Orec[t].map((v) => [v]), { cell, color: C.out, shape: '4 × 1' }) + op('= ligne encadrée de o ci-dessus');
    }
    w.forEach((x, i) => {
      const b = document.createElement('button'); b.textContent = x; if (i === sel) b.classList.add('active');
      b.addEventListener('click', () => { sel = i; $('words').querySelectorAll('button').forEach((o, j) => o.classList.toggle('active', j === i)); draw(); });
      $('words').appendChild(b);
    });
    ($('nums') as HTMLInputElement).addEventListener('change', (e) => { showNums = (e.target as HTMLInputElement).checked; draw(); });
    $('kv').textContent = `${sel + 1} paires (K, V)`;
    $('words').addEventListener('click', () => { $('kv').textContent = `${sel + 1} paires (K, V)`; });
    draw();
  });
</script>

<style is:global>
  .linatt .row { gap: 8px 12px; }
  .linatt .row .nums { margin-left: auto; font-size: 13px; cursor: pointer; }
  .linatt .la-sec { margin-top: 10px; padding: 10px 12px; border-radius: 10px; background: color-mix(in srgb, var(--text-2) 4.5%, transparent); }
  .linatt .la-h b { font-size: 13px; }
  .linatt .la-h span { font-size: 12px; color: var(--text-2); }
  .linatt .fm { margin: 4px 0 6px; font-size: 0.95rem; overflow-x: auto; overflow-y: hidden; }
  .linatt .la-stage { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .linatt .mblk { display: flex; flex-direction: column; align-items: center; }
  .linatt .mt { font-size: 12px; font-weight: 500; margin-bottom: 2px; white-space: nowrap; }
  .linatt .ms { font-size: 11px; color: var(--text-2); }
  .linatt .br { flex-basis: 100%; height: 0; }
  .linatt .op { font-size: 15px; color: var(--text-2); white-space: nowrap; }
  .linatt svg text { font: 10px var(--font); fill: var(--text-2); }
  .linatt svg text.mn { fill: var(--text); font-variant-numeric: tabular-nums; }
</style>
