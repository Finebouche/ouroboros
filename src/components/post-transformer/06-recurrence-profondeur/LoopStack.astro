---
// Widget du chapitre 6 : transformer classique (L couches différentes) contre transformer bouclé (k blocs × T passes).
---
<div class="widget lstack" data-widget="lstack">
  <div class="sl">
    <div class="krow"><span>Blocs différents k</span><span class="seg" data-ref="kseg"><button data-k="1">1</button><button data-k="2" class="active">2</button><button data-k="3">3</button></span></div>
    <label><span>Passes T</span><input type="range" data-ref="t" min="1" max="6" step="1" value="3" /><b data-ref="t-out"></b></label>
  </div>
  <label class="inj"><input type="checkbox" data-ref="inj" checked /> Réinjecter l'embedding e à chaque passe (input injection)</label>
  <svg data-ref="svg" width="100%" role="img" aria-label="Couches d'un transformer classique et d'un transformer bouclé"></svg>
  <div class="lbars" data-ref="bars"></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-widget="lstack"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const inp = (r: string) => $(r) as HTMLInputElement;
    const svg = $('svg') as unknown as SVGSVGElement;
    const D = 2048;
    const P = 12 * D * D; // paramètres d'un bloc : 4d² (attention) + 8d² (MLP)
    const nf = (v: number, d = 0) => v.toLocaleString('fr-FR', { maximumFractionDigits: d });

    // même teinte = mêmes poids
    // classique : nuances de gris ; bouclé : nuances de brun (même nuance = mêmes poids)
    const shade = (L: number) => ({ fill: `hsl(35, 8%, ${L}%)`, text: L < 58 ? '#ffffff' : '#2c2c2a' });
    const shadeLoop = (L: number) => ({ fill: `hsl(30, 45%, ${L}%)`, text: L < 58 ? '#ffffff' : '#3d2610' });

    let k = 2;
    root.querySelectorAll<HTMLButtonElement>('[data-k]').forEach((b) =>
      b.addEventListener('click', () => {
        k = +b.dataset.k!;
        root.querySelectorAll('[data-k]').forEach((o) => o.classList.toggle('active', o === b));
        redraw();
      }),
    );

    let ready = false;
    function draw() {
      const T = +inp('t').value, inj = inp('inj').checked;
      const N = k * T;
      $('t-out').textContent = String(T);

      const bh = 18, gap = 3, top = 34;
      const embY = top + N * (bh + gap) + 10;
      const H = embY + 30 + 6;
      const yOf = (n: number) => embY - 10 - (n + 1) * (bh + gap) + gap; // n = 0 tout en bas
      const xL = 20, xR = 360, w = 210;
      let g = `<rect x="${xL}" y="6" width="12" height="12" rx="3" fill="var(--c-model-classic)"/><text class="tt" x="${xL + 18}" y="16">Classique : ${N} couches différentes</text>`;
      g += `<rect x="${xR}" y="6" width="12" height="12" rx="3" fill="var(--c-model-loop)"/><text class="tt" x="${xR + 18}" y="16">Bouclé : ${k} bloc${k > 1 ? 's' : ''} × ${T} passe${T > 1 ? 's' : ''}</text>`;

      for (let n = 0; n < N; n++) {
        const c = shade(82 - (N > 1 ? n / (N - 1) : 0) * 40);
        g += `<rect x="${xL}" y="${yOf(n)}" width="${w}" height="${bh}" rx="4" fill="${c.fill}"/>`;
        g += `<text x="${xL + w / 2}" y="${yOf(n) + 13}" text-anchor="middle" fill="${c.text}" class="lb">couche ${n + 1}</text>`;
      }
      for (let t = 0; t < T; t++) {
        for (let b = 0; b < k; b++) {
          const n = t * k + b;
          const c = shadeLoop(76 - b * 17);
          g += `<rect x="${xR}" y="${yOf(n)}" width="${w}" height="${bh}" rx="4" fill="${c.fill}"/>`;
          g += `<text x="${xR + w / 2}" y="${yOf(n) + 13}" text-anchor="middle" fill="${c.text}" class="lb">bloc ${b + 1}</text>`;
        }
        const y1 = yOf(t * k + k - 1), y2 = yOf(t * k) + bh;
        g += `<path d="M${xR - 8} ${y1} H${xR - 12} V${y2} H${xR - 8}" fill="none" stroke="var(--text-2)"/>`;
        g += `<text x="${xR - 16}" y="${(y1 + y2) / 2 + 4}" text-anchor="end" class="ts">passe ${t + 1}</text>`;
        if (inj) {
          const yi = yOf(t * k) + bh / 2;
          g += `<path d="M${xR + w + 22} ${yi} H${xR + w + 4}" fill="none" stroke="var(--c-model-loop)" stroke-width="1.5" marker-end="url(#ls-arrow)"/>`;
        }
      }
      if (inj) {
        g += `<path d="M${xR + w + 40} ${embY + 15} H${xR + w + 22} V${yOf((T - 1) * k) + bh / 2}" fill="none" stroke="var(--c-model-loop)" stroke-width="1.5" stroke-dasharray="4 3"/>`;
        g += `<text x="${xR + w + 26}" y="${embY - 4}" class="ts" style="fill:var(--c-model-loop)">e</text>`;
      }
      for (const x of [xL, xR]) {
        g += `<rect x="${x}" y="${embY}" width="${w}" height="26" rx="4" fill="var(--surface-2)" stroke="var(--border)"/>`;
        g += `<text x="${x + w / 2}" y="${embY + 17}" text-anchor="middle" class="ts">Embedding e</text>`;
      }
      const defs = `<defs><marker id="ls-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5"/></marker></defs>`;
      svg.setAttribute('viewBox', `0 0 640 ${H}`);
      svg.innerHTML = defs + g;

      // barres : classique (gris) contre bouclé (brun), d_model = 2048
      const rows = [
        { label: 'Paramètres', formula: '12d² × kT → 12d² × k', c: N, l: k, note: T > 1 ? `${nf((k * P) / 1e6)} M au lieu de ${nf((N * P) / 1e6)} M (÷ ${T})` : 'identique' },
        { label: 'Calcul, activations, KV cache', formula: 'tous proportionnels à kT', c: N, l: N, note: `identiques (${nf((2 * P * N) / 1e9, 2)} GFLOP/token)` },
      ];
      $('bars').innerHTML = rows
        .map(
          (r) => `<div class="lb-row"><div class="lb-label"><b>${r.label}</b><span>${r.formula}</span></div>
            <div class="lb-bars"><div class="bar classic" style="width:${(r.c / N) * 100}%"></div><div class="bar looped" style="width:${(r.l / N) * 100}%"></div></div>
            <div class="lb-note${r.c !== r.l ? ' diff' : ''}">${r.note}</div></div>`,
        )
        .join('');
    }

    // le schéma d'architecture à gauche suit k, T et la réinjection
    const publish = () => {
      const T = +inp('t').value, inj = inp('inj').checked;
      const extra = { k, t: T, inj };
      const label = `Boucler ${k} bloc${k > 1 ? 's' : ''} × ${T} passe${T > 1 ? 's' : ''}${inj ? ', avec réinjection de e' : ', sans réinjection'}`;
      root.dataset.archParts = 'embed inject block loop';
      root.dataset.archLabel = label;
      root.dataset.archExtra = JSON.stringify(extra);
      if (ready) window.dispatchEvent(new CustomEvent('arch:focus', { detail: { parts: root.dataset.archParts, label, extra } }));
    };
    const redraw = () => { draw(); publish(); };
    inp('t').addEventListener('input', redraw);
    inp('inj').addEventListener('change', redraw);
    redraw();
    ready = true;
  });
</script>

<style is:global>
  .lstack .sl { display: grid; gap: 6px; margin-bottom: 8px; }
  .lstack .sl label { display: grid; grid-template-columns: 160px 1fr 40px; align-items: center; gap: 12px; font-size: 14px; color: var(--text-2); }
  .lstack .sl b { text-align: right; color: var(--text); font-weight: 500; }
  .lstack .krow { display: grid; grid-template-columns: 160px 1fr 40px; align-items: center; gap: 12px; font-size: 14px; color: var(--text-2); }
  .lstack .seg { display: inline-flex; gap: 6px; }
  .lstack .seg button { min-width: 44px; padding: 4px 0; font-size: 14px; }
  .lstack .inj { display: block; font-size: 14px; color: var(--text-2); margin-bottom: 10px; cursor: pointer; }
  .lstack svg text.tt { font: 500 13px var(--font); fill: var(--text); }
  .lstack svg text.ts { font: 12px var(--font); fill: var(--text-2); }
  .lstack svg text.lb { font: 11px var(--font); }
  .lstack .lbars { margin-top: 10px; }
  .lstack .lb-row { display: grid; grid-template-columns: 230px 1fr 210px; align-items: center; gap: 14px; padding: 6px 0; line-height: 1.3; border-top: 1px solid var(--border); }
  .lstack .lb-label b { display: block; font-size: 14px; font-weight: 500; }
  .lstack .lb-label span { font-size: 12px; color: var(--text-2); font-family: var(--mono); }
  .lstack .lb-bars { display: flex; flex-direction: column; gap: 4px; }
  .lstack .bar { height: 12px; border-radius: 3px; min-width: 4px; }
  .lstack .bar.classic { background: var(--c-model-classic); }
  .lstack .bar.looped { background: var(--c-model-loop); }
  .lstack .lb-note { font-size: 13px; color: var(--text-2); }
  .lstack .lb-note.diff { color: var(--c-model-loop); font-weight: 500; }
  @media (max-width: 600px) { .lstack .lb-row { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .lstack .sl label { grid-template-columns: 1fr; } }
</style>
