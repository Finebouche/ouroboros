---
// Widget du module 0 : d'un embedding x_i aux trois vecteurs q_i, k_i, v_i via W_Q, W_K, W_V.
---
<div class="widget qkv" data-widget="qkv">
  <div class="row">
    <span>Choisis un mot :</span>
    <span data-ref="words"></span>
    <label class="nums"><input type="checkbox" data-ref="nums" /> afficher les nombres</label>
  </div>
  <div data-ref="body"></div>
</div>

<script>
  import { WORDS, X, WQ, WK, WV, D_MODEL, D_K, mul } from './qkvData';

  document.querySelectorAll<HTMLElement>('[data-widget="qkv"]').forEach((root) => {
    const NW = 4;
    const W = { Q: WQ, K: WK, V: WV } as const;
    const COLORS = { Q: 'var(--c-q)', K: 'var(--c-k)', V: 'var(--c-v)' } as const;
    const kinds = ['Q', 'K', 'V'] as const;
    let sel = 3;
    const wordsEl = root.querySelector<HTMLElement>('[data-ref="words"]')!;
    const body = root.querySelector<HTMLElement>('[data-ref="body"]')!;

    const CELL = 24;
    const R = 10;
    const fx = (v: number, d: number) => (Math.abs(v) < 1e-9 ? 0 : v).toFixed(d);
    let showNums = false;
    const nums = root.querySelector<HTMLInputElement>('[data-ref="nums"]')!;

    const tableDots = (
      rows: readonly (readonly number[])[],
      hl: number | null,
      labels: string[] | undefined,
      color: string,
      dec: number,
    ) => {
      const lw = labels ? 44 : 0;
      const cols = rows[0].length;
      const vmax = Math.max(...rows.flat().map(Math.abs));
      let g = '';
      rows.forEach((r, i) => {
        const cy = i * CELL + CELL / 2;
        if (i === hl) g += `<rect x="0" y="${i * CELL + 1}" width="${lw + cols * CELL}" height="${CELL - 2}" rx="6" fill="var(--hl-bg)" />`;
        if (labels) g += `<text x="${lw - 6}" y="${cy + 4}" text-anchor="end" class="ml">${labels[i]}</text>`;
        r.forEach((v, j) => {
          const cx = lw + j * CELL + CELL / 2;
          if (showNums) {
            g += `<text x="${cx}" y="${cy + 3}" text-anchor="middle" class="mn${i === hl ? ' hl' : ''}">${fx(v, 1).replace(/^-(0\.0)$/, '$1').replace('-', '−')}</text>`;
            return;
          }
          const r_ = Math.abs(v) < 1e-9 ? 1.5 : R * Math.sqrt(Math.abs(v) / vmax);
          const style = v < 0 ? `fill="none" stroke="${color}" stroke-width="2"` : `fill="${color}"`;
          g += `<circle cx="${cx}" cy="${cy}" r="${r_.toFixed(2)}" ${style}><title>${fx(v, dec)}</title></circle>`;
        });
      });
      return `<svg class="md" width="${lw + cols * CELL}" height="${rows.length * CELL}" role="img" aria-label="matrice de ${rows.length} lignes et ${cols} colonnes">${g}</svg>`;
    };

    const table = (
      rows: readonly (readonly number[])[],
      hl: number | null,
      labels: string[] | undefined,
      color: string,
      dec: number,
    ) => tableDots(rows, hl, labels, color, dec);

    function draw() {
      const words = WORDS.slice(0, NW);
      const Xs = X.slice(0, NW);
      const x = Xs[sel];
      const w = words[sel];
      // Schéma de Falk : W en haut à droite, X en bas à gauche, le produit en bas à droite (les lignes de X alignées avec celles de Q, K, V)
      const outs = kinds.map((k) => Xs.map((row) => mul(row, W[k])));
      let h = `<div class="qgrid"><div class="eqs">${kinds.map((k) => `<div style="color:${COLORS[k]}"><b>${k}</b> = X · W<sub>${k}</sub></div>`).join('')}</div>`;
      kinds.forEach((k, ki) => {
        h += `<div class="card top" style="border-top-color:${COLORS[k]}">
          <div class="cap capt"><span>W<sub>${k}</sub> : ${D_MODEL} × ${D_K}</span></div>
          ${table(W[k], null, undefined, COLORS[k], 1)}
          <div class="calc">${k.toLowerCase()}<sub>${w}</sub> = x<sub>${w}</sub> · W<sub>${k}</sub><br /><b>[${outs[ki][sel].map((v) => fx(v, 2)).join(' ')}]</b></div>
        </div>`;
      });
      h += `<div class="blk"><div class="cap">Embeddings <b>X</b> : ${NW} × ${D_MODEL}</div>${table(Xs, sel, words, 'var(--text-2)', 2)}</div>`;
      kinds.forEach((k, ki) => {
        h += `<div class="card bot"><div class="cap">${k} : ${NW} × ${D_K}</div>${table(outs[ki], sel, undefined, COLORS[k], 2)}</div>`;
      });
      h += '</div>';
      body.innerHTML = h;
    }

    nums.addEventListener('change', () => {
      showNums = nums.checked;
      draw();
    });

    WORDS.slice(0, NW).forEach((w, i) => {
      const b = document.createElement('button');
      b.textContent = w;
      b.addEventListener('click', () => {
        sel = i;
        wordsEl.querySelectorAll('button').forEach((o, j) => o.classList.toggle('active', j === i));
        draw();
      });
      if (i === sel) b.classList.add('active');
      wordsEl.appendChild(b);
    });
    draw();
  });
</script>

<style is:global>
  .qkv .row button { margin-right: 6px; }
  .qkv .row .nums { margin-left: auto; font-size: 13px; cursor: pointer; }
  .qkv svg.md { display: block; }
  .qkv svg.md text.ml { font: 12px var(--font); fill: var(--text-2); }
  .qkv svg.md text.mn { font: 10.5px var(--font); fill: var(--text); font-variant-numeric: tabular-nums; }
  .qkv svg.md text.mn.hl { fill: var(--hl-text); }
  .qkv .blk { margin-bottom: 14px; }
  .qkv .qgrid { display: grid; grid-template-columns: auto repeat(3, minmax(0, 1fr)); column-gap: 8px; row-gap: 0; align-items: stretch; }
  .qkv .qgrid .blk { margin: 0 6px 0 0; align-self: start; }
  .qkv .eqs { align-self: end; font-size: 13px; line-height: 1.7; padding: 0 6px 8px 0; }
  .qkv .card { background: var(--surface-2); padding: 0.45rem 0.4rem; }
  .qkv .card.top { border-radius: var(--radius) var(--radius) 0 0; border-top: 3px solid; }
  .qkv .card.bot { border-radius: 0 0 var(--radius) var(--radius); padding-top: 0; }
  .qkv .card .calc { font-size: 11px; }
  @media (max-width: 700px) { .qkv .qgrid { display: block; } .qkv .qgrid > div { margin-bottom: 8px; } }
  .qkv .cap { font-size: 12px; color: var(--text-2); margin: 6px 0 3px; }
  .qkv .capt { display: flex; justify-content: flex-start; align-items: baseline; gap: 8px; }
  .qkv .calc { font: 13px/1.6 var(--mono); margin: 8px 0; overflow-wrap: anywhere; }
  .qkv .note { font-size: 12px; color: var(--text-2); margin: 10px 0 0; }
</style>
