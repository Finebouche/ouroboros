---
// Widget du chapitre 0 : le bloc d'attention étape par étape, de l'embedding au résidu, avec les vrais nombres.
// L'étape 3 (Q, K, V) affiche le widget QKVProjection (choix du mot, matrices W_Q, W_K, W_V, produit pour ce mot).
import QKVProjection from './QKVProjection.astro';
import katex from 'katex';
const tx = (t: string) => katex.renderToString(t, { throwOnError: false });
// formules rappelées discrètement sous les calculs (RMSNorm aux étapes 2 et 10, MLP aux étapes 11 à 13)
const EQ = {
  rms: tx('\\mathrm{RMSNorm}(x) = \\frac{x}{\\sqrt{\\tfrac{1}{d}\\sum_{i=1}^{d} x_i^2 + \\varepsilon}} \\odot g'),
  mlp: tx('\\mathrm{MLP}(u) = \\sigma(u\\, W_1)\\, W_2'),
};
---
<div class="widget atsteps" data-widget="att-steps">
  <div class="chips" data-ref="chips"></div>
  <div class="numsrow"><label class="nums"><input type="checkbox" data-ref="nums" /> afficher les nombres</label></div>
  <div class="stage" data-ref="stage" data-rms={EQ.rms} data-mlp={EQ.mlp}></div>
  <div class="qkvslot" data-ref="qkvslot" hidden><QKVProjection /></div>
</div>

<script>
  import { WORDS, E, X, WQ, WK, WV, WO, D_K, D_MODEL, mul, rmsnorm } from './qkvData';

  document.querySelectorAll<HTMLElement>('[data-widget="att-steps"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    type M = number[][];

    // --- le calcul complet, pour les 4 premiers mots ---
    const N = 4;
    const w = WORDS.slice(0, N);
    const En = E.slice(0, N);
    const Xn = X.slice(0, N);
    const Q = Xn.map((x) => mul(x, WQ));
    const K = Xn.map((x) => mul(x, WK));
    const Vm = Xn.map((x) => mul(x, WV));
    const KT = K[0].map((_, c) => K.map((r) => r[c]));
    const S = Q.map((q) => K.map((k) => q.reduce((a, v, d) => a + v * k[d], 0) / Math.sqrt(D_K)));
    const masked = (i: number, j: number) => j > i;
    const P = S.map((row, i) => {
      const ex = row.map((v, j) => (masked(i, j) ? 0 : Math.exp(v)));
      const z = ex.reduce((a, b) => a + b, 0);
      return ex.map((e) => e / z);
    });
    const O = P.map((p) => Vm[0].map((_, c) => p.reduce((a, wt, j) => a + wt * Vm[j][c], 0)));
    const A = O.map((o) => mul(o, WO));
    const H = En.map((e, i) => e.map((v, c) => v + A[i][c]));

    // Tirages reproductibles pour le MLP et la tête de sortie (rien n'est entraîné).
    const rng = (seed: number) => () => {
      seed = (seed + 0x6d2b79f5) | 0;
      let r = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      r = (r + Math.imul(r ^ (r >>> 7), 61 | r)) ^ r;
      return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
    };
    const gauss = (r: () => number) => Math.sqrt(-2 * Math.log(1 - r())) * Math.cos(2 * Math.PI * r());
    const randM = (r: () => number, rows: number, cols: number, sd: number) =>
      Array.from({ length: rows }, () => Array.from({ length: cols }, () => Math.round(gauss(r) * sd * 10) / 10));
    const D_FF = 4 * D_MODEL;
    const W1 = randM(rng(31), D_MODEL, D_FF, 1 / Math.sqrt(D_MODEL));
    const W2 = randM(rng(32), D_FF, D_MODEL, 1 / Math.sqrt(D_FF));
    const gelu = (x: number) => 0.5 * x * (1 + Math.tanh(Math.sqrt(2 / Math.PI) * (x + 0.044715 * x ** 3)));
    const Hn = H.map(rmsnorm);
    const Z = Hn.map((h) => mul(h, W1));
    const Ga = Z.map((z) => z.map(gelu));
    const Mo = Ga.map((a) => mul(a, W2));
    const Y = H.map((h, i) => h.map((v, c) => v + Mo[i][c]));
    // tête de sortie : petit vocabulaire, prédiction du mot qui suit « dort »
    const VOCAB = WORDS.slice(0, 10);
    const WVOC = randM(rng(33), D_MODEL, VOCAB.length, 1);
    const last = rmsnorm(Y[N - 1]);
    const logits = mul(last, WVOC);
    const ez = logits.map((v) => Math.exp(v - Math.max(...logits)));
    const probs = ez.map((e) => e / ez.reduce((a, b) => a + b, 0));

    // --- dessin d'une matrice en disques ---
    // out : sortie de la tête (poids × V), en gris moyen pour ne pas la confondre avec V (même convention que CausalAttention)
    const C = { gray: 'var(--text-2)', q: 'var(--c-q)', k: 'var(--c-k)', v: 'var(--c-v)', p: 'var(--c-w)', out: 'var(--c-neutral)' };
    type Opt = { cell: number; rows?: string[]; cols?: string[]; color?: string; vmax?: number; mask?: boolean; hl?: number; shape: string };
    function mat(title: string, m: M, o: Opt) {
      const lw = o.rows ? 36 : 0;
      const th = 14;
      const nr = m.length, nc = m[0].length;
      const vmax = o.vmax ?? Math.max(...m.flat().map(Math.abs));
      const color = o.color ?? C.gray;
      let g = '';
      if (o.cols) o.cols.forEach((c, j) => (g += `<text x="${lw + j * o.cell + o.cell / 2}" y="10" text-anchor="middle">${c}</text>`));
      m.forEach((row, i) => {
        const cy = th + i * o.cell + o.cell / 2;
        if (o.rows) g += `<text x="${lw - 5}" y="${cy + 3.5}" text-anchor="end">${o.rows[i]}</text>`;
        row.forEach((v, j) => {
          const x0 = lw + j * o.cell, y0 = th + i * o.cell;
          const isMasked = o.mask && masked(i, j);
          g += `<rect x="${x0 + 1}" y="${y0 + 1}" width="${o.cell - 2}" height="${o.cell - 2}" rx="3" fill="${isMasked ? 'var(--surface-2)' : 'none'}" stroke="var(--border)" stroke-width="0.5"/>`;
          if (isMasked) return;
          if (showNums) { g += num(x0 + o.cell / 2, cy, v, o.cell, o.vmax === 1); return; }
          const r = Math.abs(v) < 1e-9 ? 1 : (o.cell / 2 - 2) * Math.sqrt(Math.abs(v) / vmax);
          const style = v < 0 ? `fill="none" stroke="${color}" stroke-width="1.5"` : `fill="${color}"`;
          g += `<circle cx="${x0 + o.cell / 2}" cy="${cy}" r="${r.toFixed(2)}" ${style}><title>${v.toFixed(2)}</title></circle>`;
        });
      });
      if (o.hl !== undefined) g += `<rect x="${lw}" y="${th + o.hl * o.cell}" width="${nc * o.cell}" height="${o.cell}" rx="4" fill="none" stroke="var(--accent)" stroke-width="1.5"/>`;
      const W = lw + nc * o.cell, Ht = th + nr * o.cell;
      return `<div class="mblk"><div class="mt">${title}</div><svg width="${W}" height="${Ht}" viewBox="0 0 ${W} ${Ht}" role="img" aria-label="${o.shape}">${g}</svg><div class="ms">${o.shape}</div></div>`;
    }
    // affichage des nombres à la place des disques (1 décimale ; en % pour les probabilités)
    let showNums = false;
    const num = (cx: number, cy: number, v: number, cell: number, pct = false) => {
      const t = pct ? `${Math.round(v * 100)}%` : (Math.abs(v) < 0.05 ? '0.0' : v.toFixed(1)).replace('-', '−');
      return `<text x="${cx}" y="${cy + 3}" text-anchor="middle" class="mn" style="font-size:${Math.min(10.5, cell * 0.4).toFixed(1)}px">${t}</text>`;
    };
    const op = (t: string) => `<div class="op">${t}</div>`;
    const br = '<div class="br"></div>';

    let zoom = 3;
    const pickWord = () => `<div class="zt pick">Choisis un mot : ${w.map((x, j) => `<button data-zoom="${j}" class="${j === zoom ? 'active' : ''}">${x}</button>`).join('')}</div>`;
    // --- les étapes ---
    type Step = { chip: string; parts: string; view: () => string };
    const STEPS: Step[] = [
      {
        chip: 'Embeddings', parts: 'embed',
        view: () => op('mots →') + mat('Embeddings E', En, { cell: 24, rows: w, shape: '4 mots × 8' }),
      },
      {
        chip: 'RMSNorm', parts: 'norm1',
        view: () => mat('E', En, { cell: 24, rows: w, shape: '4 × 8' }) + op('RMSNorm →') + mat('X', Xn, { cell: 24, shape: '4 × 8' }),
      },
      {
        chip: 'Q, K, V', parts: 'qkv',
        view: () =>
          mat('X', Xn, { cell: 22, rows: w, shape: '4 × 8' }) + op('→') +
          mat('Q = X·W<sub>Q</sub>', Q, { cell: 22, color: C.q, shape: '4 × 4' }) +
          mat('K = X·W<sub>K</sub>', K, { cell: 22, color: C.k, shape: '4 × 4' }) +
          mat('V = X·W<sub>V</sub>', Vm, { cell: 22, color: C.v, shape: '4 × 4' }),
      },
      {
        chip: 'Scores', parts: 'attn',
        view: () =>
          mat('Q', Q, { cell: 26, rows: w, color: C.q, shape: '4 × 4' }) + op('×') +
          mat('Kᵀ', KT, { cell: 26, cols: w, color: C.k, shape: '4 × 4' }) + op('÷ 2 =') +
          mat('Scores S', S, { cell: 26, cols: w, shape: '4 × 4' }),
      },
      {
        chip: 'Masque', parts: 'attn',
        view: () =>
          mat('S', S, { cell: 26, rows: w, cols: w, shape: '4 × 4' }) + op('masque →') +
          mat('S masqué', S, { cell: 26, cols: w, mask: true, shape: '4 × 4' }),
      },
      {
        chip: 'Softmax', parts: 'attn',
        view: () =>
          mat('S masqué', S, { cell: 26, rows: w, cols: w, mask: true, shape: '4 × 4' }) + op('softmax par ligne →') +
          mat('softmax(S masqué)', P, { cell: 26, cols: w, mask: true, color: C.p, vmax: 1, shape: '4 × 4, lignes = 100 %' }),
      },
      {
        chip: 'softmax(S masqué) × V', parts: 'attn',
        view: () =>
          pickWord() +
          mat('softmax(S masqué)', P, { cell: 26, rows: w, cols: w, mask: true, color: C.p, vmax: 1, hl: zoom, shape: '4 × 4' }) + op('×') +
          mat('V', Vm, { cell: 26, rows: w, color: C.v, shape: '4 × 4' }) + op('=') +
          mat('Sortie de la tête', O, { cell: 26, color: C.out, hl: zoom, shape: '4 × 4' }),

      },
      {
        chip: '× W<sub>O</sub>', parts: 'wo',
        view: () =>
          mat('Sortie de la tête', O, { cell: 22, rows: w, color: C.out, shape: '4 × 4' }) + op('×') +
          mat('W<sub>O</sub>', WO, { cell: 22, shape: '4 × 8' }) + op('=') +
          mat('Sortie de l’attention', A, { cell: 22, shape: '4 × 8' }),
      },
      {
        chip: '+ résidu', parts: 'add1',
        view: () =>
          mat('E (entrée)', En, { cell: 22, rows: w, shape: '4 × 8' }) + op('+') +
          mat('Sortie de l’attention', A, { cell: 22, shape: '4 × 8' }) + op('=') +
          mat('Nouveau vecteur', H, { cell: 22, shape: '4 × 8' }),
      },
      {
        chip: 'RMSNorm', parts: 'norm2',
        view: () => mat('H', H, { cell: 22, rows: w, shape: '4 × 8' }) + op('RMSNorm →') + mat('H normalisé', Hn, { cell: 22, shape: '4 × 8' }),
      },
      {
        chip: 'MLP : monter', parts: 'mlp',
        view: () =>
          mat('H normalisé', Hn, { cell: 18, rows: w, shape: '4 × 8' }) + op('× W<sub>1</sub> (8 × 32) =') + br +
          mat('Z', Z, { cell: 18, rows: w, shape: '4 × 32' }),
      },
      {
        chip: 'Activation', parts: 'mlp',
        view: () => mat('Z', Z, { cell: 18, rows: w, shape: '4 × 32' }) + br + op('↓ GELU') + br + mat('GELU(Z)', Ga, { cell: 18, rows: w, shape: '4 × 32' }),
      },
      {
        chip: 'MLP : redescendre', parts: 'mlp',
        view: () =>
          mat('GELU(Z)', Ga, { cell: 18, rows: w, shape: '4 × 32' }) + br + op('× W<sub>2</sub> (32 × 8) =') +
          mat('Sortie du MLP', Mo, { cell: 18, rows: w, shape: '4 × 8' }),
      },
      {
        chip: '+ résidu', parts: 'add2',
        view: () =>
          mat('H', H, { cell: 22, rows: w, shape: '4 × 8' }) + op('+') +
          mat('Sortie du MLP', Mo, { cell: 22, shape: '4 × 8' }) + op('=') +
          mat('Sortie de la couche', Y, { cell: 22, shape: '4 × 8' }),
      },
      {
        chip: 'Sortie du modèle', parts: 'norm-final head',
        view: () =>
          mat(`ligne « ${WORDS[N - 1]} »`, [last], { cell: 18, shape: '1 × 8' }) + op('× W<sub>vocab</sub>, softmax →') +
          mat('probabilités du mot suivant', [probs], { cell: 34, cols: VOCAB, color: 'var(--c-neutral)', vmax: 1, shape: `1 × ${VOCAB.length}, somme = 100 %` }),
      },
    ];

    let cur = 0;
    // groupes de boutons : chaque rangée correspond à une partie du bloc
    const GROUPS: [string, number, number][] = [
      ['Entrée', 0, 0],
      ['Attention', 1, 8],
      ['MLP', 9, 13],
      ['Sortie', 14, 14],
    ];
    const chips: HTMLButtonElement[] = [];
    GROUPS.forEach(([name, from, to]) => {
      const row = document.createElement('div');
      row.className = 'grp';
      row.innerHTML = `<span class="gn">${name}</span>`;
      const bs = document.createElement('div');
      bs.className = 'gb';
      for (let i = from; i <= to; i++) {
        const b = document.createElement('button');
        b.innerHTML = `${i + 1}. ${STEPS[i].chip}`;
        b.addEventListener('click', () => go(i, true));
        bs.appendChild(b);
        chips[i] = b;
      }
      row.appendChild(bs);
      $('chips').appendChild(row);
    });

    function go(i: number, fromUser: boolean) {
      cur = Math.max(0, Math.min(STEPS.length - 1, i));
      const st = STEPS[cur];
      chips.forEach((b, j) => b.classList.toggle('active', j === cur));
      const isQKV = cur === 2;
      $('stage').hidden = isQKV;
      $('qkvslot').hidden = !isQKV;
      // rappel de la formule, discret, au bas de la zone des calculs
      const kind = cur === 1 || cur === 9 ? 'rms' : cur >= 10 && cur <= 12 ? 'mlp' : '';
      const sg = $('stage');
      const eq = kind === 'rms' ? `<div class="eqnote">${sg.dataset.rms}<span> ; ici g = 1 (le gain appris n'est pas représenté)</span></div>` : kind === 'mlp' ? `<div class="eqnote">${sg.dataset.mlp}<span> ; σ = GELU</span></div>` : '';
      sg.innerHTML = isQKV ? '' : st.view() + eq;
      const label = `Étape ${cur + 1} : ${st.chip.replace(/<[^>]+>/g, '')}`;
      root.dataset.archParts = st.parts;
      root.dataset.archLabel = label;
      if (fromUser) window.dispatchEvent(new CustomEvent('arch:focus', { detail: { parts: st.parts, label } }));
    }

    const numsIn = $('nums') as HTMLInputElement;
    numsIn.addEventListener('change', () => {
      showNums = numsIn.checked;
      const inner = root.querySelector<HTMLInputElement>('[data-widget="qkv"] [data-ref="nums"]');
      if (inner && inner.checked !== showNums) { inner.checked = showNums; inner.dispatchEvent(new Event('change')); }
      go(cur, false);
    });
    $('stage').addEventListener('click', (ev) => {
      const b = (ev.target as Element).closest<HTMLElement>('[data-zoom]');
      if (!b) return;
      zoom = +b.dataset.zoom!;
      go(cur, false);
    });
    go(0, false);
  });
</script>

<style is:global>
  .atsteps .chips { display: grid; gap: 8px; margin-bottom: 12px; }
  .atsteps .grp { display: grid; grid-template-columns: 78px 1fr; align-items: start; gap: 10px; padding-top: 8px; border-top: 1px solid var(--border); }
  .atsteps .grp:first-child { border-top: 0; padding-top: 0; }
  .atsteps .gn { font-size: 12px; font-weight: 500; color: var(--text-2); text-transform: uppercase; letter-spacing: .04em; padding-top: 6px; }
  @media (max-width: 600px) { .atsteps .grp { grid-template-columns: 1fr; gap: 4px; } .atsteps .gn { padding-top: 0; } }
  .atsteps .gb { display: flex; flex-wrap: wrap; gap: 6px; }
  .atsteps .chips button { font-size: 13px; padding: 4px 10px; }
  .atsteps .stage { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; min-height: 160px; }
  .atsteps .mblk { display: flex; flex-direction: column; align-items: center; }
  .atsteps .mt { font-size: 13px; font-weight: 500; margin-bottom: 2px; white-space: nowrap; }
  .atsteps .ms { font-size: 11px; color: var(--text-2); }
  .atsteps .br { flex-basis: 100%; height: 0; }
  .atsteps .op { font-size: 15px; color: var(--text-2); white-space: nowrap; }
  .atsteps svg text { font: 10px var(--font); fill: var(--text-2); }
  .atsteps .zt { font-size: 13px; color: var(--text-2); display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: 6px; }
  .atsteps .zt button { font-size: 13px; padding: 2px 8px; }
  .atsteps .zc { flex-basis: 100%; font-size: 13px; color: var(--text-2); margin: 6px 0 0; }
  .atsteps .zt.pick { flex-basis: 100%; margin-bottom: 4px; }
  /* zone des calculs : légèrement teintée, pour la séparer du menu des étapes */
  .atsteps .stage, .atsteps .qkvslot { background: color-mix(in srgb, var(--text-2) 4.5%, transparent); border-radius: 10px; padding: 14px; }
  .atsteps .stage[hidden], .atsteps .qkvslot[hidden] { display: none; }
  .atsteps .qkvslot .widget.qkv { border: 0; padding: 0; margin: 0; background: none; }
  .atsteps .qkvslot .qkv .row .nums { display: none; }
  .atsteps .qkvslot svg.md text.ml { font-size: 10px; }
  .atsteps .eqnote { flex-basis: 100%; margin: 2px 0 0; font-size: 13px; color: var(--text-2); display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 6px; }
  .atsteps .eqnote .katex { font-size: 0.95em; }
  .atsteps .eqnote span { font-size: 12px; }
  .atsteps .numsrow { display: flex; justify-content: flex-end; margin: -4px 0 6px; }
  .atsteps .numsrow .nums { font-size: 13px; color: var(--text-2); cursor: pointer; }
  .atsteps svg text.mn { fill: var(--text); font-variant-numeric: tabular-nums; }
  .atsteps .note { font-size: 12px; color: var(--text-2); margin: 8px 0 0; }
</style>
