---
// Cours Post-Transformer, chapitre 0 : les trois façons de donner la position, côte à côte.
// Même mise en forme que Families.astro (RL, chapitre 1) : bandes arrondies, gris uniquement.
import katex from 'katex';
const k = (t: string) => katex.renderToString(t, { throwOnError: false });
const cols = ['Positions apprises', 'Positions sinusoïdales', 'RoPE'];
const rows: { q: string; c: [string, string, string] }[] = [
  { q: 'Ce qui porte la position', c: ['un vecteur p<sub>i</sub>, <b>appris</b>', 'un vecteur p<sub>i</sub>, <b>calculé</b> (fixe)', 'un <b>angle</b> i · θ<sub>m</sub> par paire de dimensions (fixe)'] },
  { q: 'Où elle entre', c: ['à l\'entrée : ajouté à l\'embedding', 'à l\'entrée : ajouté à l\'embedding', 'dans l\'attention : rotation de q et k, embedding inchangé'] },
  { q: 'Formules', c: [
    k('x_i = e_i + p_i') + k('p_i = P_i') + '<small>(ligne i de la table)</small>',
    k('x_i = e_i + p_i') + k('p_{i,2k} = \\sin\\tfrac{i}{10\\,000^{2k/d}}') + '<small>(cosinus pour les indices impairs)</small>',
    k('q_i \\cdot k_j =') + k('\\sum_m q^{(m)} \\cdot R\\big((j-i)\\theta_m\\big)\\, k^{(m)}'),
  ] },
  { q: 'Ce qui est appris', c: ['la table P (L<sub>max</sub> lignes)', 'rien', 'rien'] },
  { q: 'Le score q<sub>i</sub> · k<sub>j</sub> dépend de', c: ['i et j séparément', 'i et j séparément', '<b>seulement de l\'écart i − j</b>'] },
  { q: 'Au-delà de la longueur d\'entraînement', c: ['impossible : pas de ligne', 'calculable, mais positions jamais vues', 'calculable, mais angles jamais vus (interpolation)'] },
  { q: 'Exemple', c: ['BERT', 'transformer de 2017', 'LLaMA'] },
];
---
<figure class="pt">
  <div class="ptr pth">
    <div></div>
    {cols.map((c) => <div>{c}</div>)}
  </div>
  {rows.map((r, i) => (
    <div class={`ptr ptg${i % 2 ? ' alt' : ''}`}>
      <div class="ptq" set:html={r.q} />
      {r.c.map((t, k) => <div class="ptc" data-col={cols[k]} set:html={t} />)}
    </div>
  ))}
</figure>

<style is:global>
  .pt { margin: 1.4rem 0; font-family: var(--font); }
  .pt .ptr { display: grid; grid-template-columns: 150px repeat(3, minmax(0, 1fr)); column-gap: 16px; align-items: center; }
  .pt .pth { padding: 0 14px 8px; font-size: 13px; font-weight: 600; color: var(--text); }
  .pt .ptg { border-radius: 8px; background: color-mix(in srgb, var(--text-2) 7%, transparent); padding: 10px 14px; margin-bottom: 6px; }
  .pt .ptg.alt { background: color-mix(in srgb, var(--text-2) 3.5%, transparent); }
  .pt .ptq { font-size: 12.5px; font-weight: 600; color: var(--text); line-height: 1.35; }
  .pt .ptc { font-size: 12.5px; color: var(--text-2); line-height: 1.45; }
  .pt .ptc .katex { font-size: 1.08em; color: var(--text); }
  .pt .ptc .katex-display, .pt .ptc > .katex { display: block; margin: 3px 0; }
  .pt .ptc small { display: block; margin-top: 2px; font-size: 11.5px; }
  .pt .ptc b { color: var(--text); font-weight: 600; }
  @media (max-width: 680px) {
    .pt .ptr { grid-template-columns: 1fr; row-gap: 4px; }
    .pt .pth { display: none; }
    .pt .ptc::before { content: attr(data-col) " : "; font-weight: 600; color: var(--text); }
  }
</style>
