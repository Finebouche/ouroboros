---
// Chapitre 0 : RoPE — chaque paire de dimensions de q et de k tourne d'un angle proportionnel à sa position.
---
<div class="widget rope" data-widget="rope">
  <div class="sl">
    <label><span>Mot qui regarde (q)</span><input type="range" data-ref="i" min="0" max="31" step="1" value="10" /><b data-ref="i-out"></b></label>
    <label><span>Mot regardé (k)</span><input type="range" data-ref="j" min="0" max="31" step="1" value="6" /><b data-ref="j-out"></b></label>
    <span class="shift" title="Décaler les deux positions de 5 : le score ne change pas">
      <button data-ref="minus">− 5</button>
      <button data-ref="plus">+ 5</button>
    </span>
    <label class="pi" title="Interpolation des positions : on comprime les positions d'un facteur 2 pour rester dans la zone apprise"><input type="checkbox" data-ref="pi" /> Interpolation (÷ 2)</label>
  </div>
  <svg data-ref="svg" width="100%" viewBox="0 0 660 250" role="img" aria-label="Rotation de q et k selon leur position, pour trois paires de dimensions"></svg>
  <div class="kpis">
    <div><span>Écart de position i − j</span><b data-ref="k1"></b><i>le score ne dépend que de cet écart</i></div>
    <div><span>Score q · k</span><b data-ref="k2"></b></div>
    <div><span>Paire lente</span><b data-ref="k3"></b><i data-ref="k3s"></i></div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-widget="rope"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const inp = (r: string) => $(r) as HTMLInputElement;
    const svg = $('svg') as unknown as SVGSVGElement;
    // trois paires de dimensions : rotation rapide, moyenne, lente (base réduite à 100 pour la lisibilité)
    const TH = [1, 0.215, 0.0464];
    const NAMES = ['paire rapide', 'paire moyenne', 'paire lente'];
    const QN = [1, 0.9, 1.1], KN = [1, 1.15, 0.85];
    const PHQ = 0.3, PHK = 0;
    const LT = 16, MAXP = 31;

    function draw() {
      let i = +inp('i').value, j = +inp('j').value;
      const pi = inp('pi').checked;
      const sc = pi ? (LT - 1) / MAXP : 1; // interpolation : on comprime les positions dans la zone apprise
      const pq = i * sc, pk = j * sc;
      $('i-out').textContent = String(i);
      $('j-out').textContent = String(j);
      ($('minus') as HTMLButtonElement).disabled = Math.min(i, j) < 5;
      ($('plus') as HTMLButtonElement).disabled = Math.max(i, j) + 5 > MAXP;

      const R = 72;
      let g = `<defs><marker id="rope-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5"/></marker></defs>`;
      let score = 0;
      const outZone = !pi && Math.max(i, j) > LT - 1;
      TH.forEach((th, m) => {
        const cx = 110 + m * 220, cy = 112;
        const aq = PHQ + pq * th, ak = PHK + pk * th;
        score += QN[m] * KN[m] * Math.cos(aq - ak);
        const pt = (a: number, r: number) => `${(cx + r * Math.cos(a)).toFixed(1)},${(cy - r * Math.sin(a)).toFixed(1)}`;
        if (m === 2) {
          // zone d'angles vue à l'entraînement pour la paire lente (positions 0 à 15)
          const a0 = 0, a1 = PHQ + (LT - 1) * th;
          g += `<path d="M${cx},${cy} L${pt(a0, R)} A${R},${R} 0 0 0 ${pt(a1, R)} Z" fill="var(--c-reach-soft)" opacity="0.8"/>`;
          g += `<text x="${cx}" y="${cy + R + 22}" text-anchor="middle" class="ts">zone vue à l'entraînement</text>`;
        }
        g += `<circle cx="${cx}" cy="${cy}" r="${R}" fill="none" stroke="var(--border)"/>`;
        const dash = m === 2 && outZone ? ' stroke-dasharray="5 3"' : '';
        g += `<line x1="${cx}" y1="${cy}" x2="${pt(ak, R * KN[m] * 0.8).split(',')[0]}" y2="${pt(ak, R * KN[m] * 0.8).split(',')[1]}" stroke="var(--c-k)" stroke-width="2.5" marker-end="url(#rope-arrow)"${dash}/>`;
        g += `<line x1="${cx}" y1="${cy}" x2="${pt(aq, R * QN[m] * 0.8).split(',')[0]}" y2="${pt(aq, R * QN[m] * 0.8).split(',')[1]}" stroke="var(--c-q)" stroke-width="2.5" marker-end="url(#rope-arrow)"${dash}/>`;
        g += `<text x="${cx}" y="18" text-anchor="middle" class="tt">${NAMES[m]}</text>`;
        g += `<text x="${cx}" y="34" text-anchor="middle" class="ts">θ = ${th} par position</text>`;
        g += `<text x="${cx}" y="${cy + R + (m === 2 ? 40 : 22)}" text-anchor="middle" class="ts">contribution : ${(QN[m] * KN[m] * Math.cos(aq - ak)).toFixed(2)}</text>`;
      });
      g += `<text x="12" y="244" class="ts"><tspan style="fill:var(--c-q)">— q</tspan> tourne de θ × i, <tspan style="fill:var(--c-k)">— k</tspan> tourne de θ × j</text>`;
      svg.innerHTML = g;
      $('k1').textContent = String(i - j);
      $('k2').textContent = score.toFixed(2);
      $('k3').textContent = outZone ? 'hors zone' : 'dans la zone';
      $('k3').className = outZone ? 'r' : '';
      $('k3s').textContent = outZone ? 'angle jamais vu à l\'entraînement (16 positions)' : 'angle déjà vu à l\'entraînement (16 positions)';
    }

    const shift = (d: number) => {
      inp('i').value = String(+inp('i').value + d);
      inp('j').value = String(+inp('j').value + d);
      draw();
    };
    $('plus').addEventListener('click', () => shift(5));
    $('minus').addEventListener('click', () => shift(-5));
    ['i', 'j'].forEach((r) => inp(r).addEventListener('input', draw));
    inp('pi').addEventListener('change', draw);
    draw();
  });
</script>

<style is:global>
  .rope .sl { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto auto; gap: 6px 20px; align-items: center; margin-bottom: 8px; }
  .rope .sl label { display: grid; grid-template-columns: auto 1fr 28px; align-items: center; gap: 10px; font-size: 14px; color: var(--text-2); }
  .rope .sl b { text-align: right; color: var(--text); font-weight: 500; }
  .rope .shift button { min-width: 48px; }
  .rope .shift button:disabled { opacity: 0.4; cursor: default; }
  .rope .shift { display: flex; gap: 6px; }
  .rope .pi { display: flex; align-items: center; gap: 6px; font-size: 14px; color: var(--text-2); cursor: pointer; white-space: nowrap; }
  .rope svg text.tt { font: 500 13px var(--font); fill: var(--text); }
  .rope svg text.ts { font: 12px var(--font); fill: var(--text-2); }
  @media (max-width: 700px) { .rope .sl { grid-template-columns: 1fr 1fr; } }
</style>
