---
// Widget du module 0 : matrice d'attention causale, entraînement parallèle vs génération pas à pas.
---
<div class="widget causal" data-widget="causal-attention">
  <div class="row">
    <button data-mode="train" class="active">Entraînement (teacher forcing)</button>
    <button data-mode="gen">Génération (token par token)</button>
    <button data-mode="bert">BERT (bidirectionnel)</button>
  </div>
  <div class="row">
    <label>Longueur s <input type="range" data-ref="s" min="4" max="14" step="1" value="8" /></label>
    <b data-ref="s-out">8</b>
    <span data-ref="gen-ctl" hidden>
      <button data-ref="prev">&larr; pas</button>
      <button data-ref="next">pas suivant &rarr;</button>
    </span>
  </div>
  <div class="mrow">
    <svg data-ref="mat" viewBox="0 0 410 400" role="img" aria-label="Matrice d'attention causale"></svg>
    <div class="outp" data-ref="out"></div>
  </div>
  <div class="mcap" data-ref="cap"></div>
  <div class="kpis">
    <div><span>Étapes séquentielles</span><b data-ref="k-seq">1</b></div>
    <div><span>Cases calculées</span><b data-ref="k-cells">36</b></div>
    <div><span>K et V en mémoire</span><b data-ref="k-kv">8</b></div>
  </div>
</div>

<script>
  import { WORDS, X, WQ, WK, D_K, V, mul, attentionWeights } from './qkvData';

  document.querySelectorAll<HTMLElement>('[data-widget="causal-attention"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const svg = $('mat') as unknown as SVGSVGElement;
    const slider = $('s') as HTMLInputElement;
    const causalW = attentionWeights();
    const Qa = X.map((x) => mul(x, WQ));
    const Ka = X.map((x) => mul(x, WK));
    // BERT : pas de masque, chaque ligne est un softmax sur les s mots
    const fullW = (n: number) =>
      Qa.slice(0, n).map((q) => {
        const ex = Ka.slice(0, n).map((k) => Math.exp(q.reduce((a, v, d) => a + v * k[d], 0) / Math.sqrt(D_K)));
        const z = ex.reduce((a, b) => a + b, 0);
        return ex.map((e) => e / z);
      });
    let weights = causalW;
    const MASKED = 2;
    const label = (j: number) => (mode === 'bert' && j === MASKED ? '[MASK]' : WORDS[j]);
    let mode: 'train' | 'gen' | 'bert' = 'train';
    let s = 8;
    let t = 1;
    let selRow = 3;
    const VCOL = 'var(--c-v)';
    let curCell = 34;
    let curOy = 78;
    const VBW = 410;
    const fx = (v: number) => (Math.abs(v) < 0.005 ? 0 : v).toFixed(2);

    function renderOut() {
      const el = $('out');
      if (mode === 'gen' && selRow >= t) {
        el.innerHTML = '<p class="hint">Clique sur une ligne déjà calculée pour voir ce que ce mot récupère des autres.</p>';
        return;
      }
      const i = selRow;
      const p = weights[i];
      const dv = V[0].length;
      const o = Array.from({ length: dv }, (_, c) => p.reduce((a, w, j) => a + w * V[j][c], 0));
      const vmax = Math.max(...V.flat().map(Math.abs), ...o.map(Math.abs));
      // une ligne de 4 disques (même échelle pour V et la sortie)
      const dots = (row: number[], framed = false) =>
        `<svg class="vdots" viewBox="0 0 ${dv * 100} 100" aria-hidden="true">${row
          .map((v, c) => {
            const r = Math.abs(v) < 1e-9 ? 3 : 44 * Math.sqrt(Math.abs(v) / vmax);
            const st = v < 0 ? `fill="none" stroke="${VCOL}" stroke-width="7"` : `fill="${VCOL}"`;
            return `<circle cx="${50 + c * 100}" cy="50" r="${r.toFixed(1)}" ${st}><title>${fx(v)}</title></circle>`;
          })
          .join('')}${framed ? `<rect x="3" y="3" width="${dv * 100 - 6}" height="94" rx="14" fill="none" stroke="var(--accent)" stroke-width="7"/>` : ''}</svg>`;
      const body = p.map((_, j) => `<tr><td class="wd">${label(j)}</td><td class="vd">${dots(V[j])}</td></tr>`).join('');
      el.innerHTML = `<div class="otitle">Ligne « ${label(i)} » (encadrée) × V</div>
        <table class="ot"><thead><tr><th>Mot</th><th class="vh">V</th></tr></thead><tbody>${body}
        <tr class="sum"><td class="wd">= sortie</td><td class="vd">${dots(o, true)}</td></tr></tbody></table>`;
    }

    function draw() {
      const cell = Math.min(34, Math.floor(300 / s));
      const ox = 80, oy = 78;
      curCell = cell;
      curOy = oy;
      let h = '';
      h += `<text class="ts" x="${ox}" y="16">Mot regardé →</text>`;
      const midY = oy + (s * cell) / 2;
      h += `<text class="ts" x="12" y="${midY}" transform="rotate(-90 12 ${midY})" text-anchor="middle">Mot qui regarde</text>`;
      weights = mode === 'bert' ? fullW(s) : causalW;
      for (let i = 0; i < s; i++) {
        h += `<text class="ts" x="${ox - 8}" y="${oy + i * cell + cell / 2 + 4}" text-anchor="end" data-row="${i}">${label(i)}</text>`;
        const cx = ox + i * cell + cell / 2;
        h += `<text class="ts" x="${cx}" y="${oy - 8}" transform="rotate(-45 ${cx} ${oy - 8})">${label(i)}</text>`;
        for (let j = 0; j < s; j++) {
          const allowed = mode === 'bert' || j <= i;
          const visible = allowed && (mode !== 'gen' || i + 1 <= t);
          const current = mode === 'gen' && i + 1 === t;
          const fill = !allowed ? 'var(--surface-2)' : current ? 'var(--hl-bg)' : 'var(--surface)';
          const x0 = ox + j * cell, y0 = oy + i * cell;
          h += `<rect x="${x0}" y="${y0}" width="${cell - 2}" height="${cell - 2}" rx="3" fill="${fill}" stroke="var(--border)" stroke-width="0.5" opacity="${allowed ? 1 : 0.6}"${allowed ? ` data-row="${i}"` : ''}/>`;
          if (visible) {
            const w = weights[i][j];
            const r = ((cell - 2) / 2 - 1) * Math.sqrt(w);
            const color = mode === 'bert' ? 'var(--c-w)' : current ? 'var(--hl-stroke)' : mode === 'train' ? 'var(--c-w)' : 'var(--c-w-soft)';
            h += `<circle cx="${x0 + (cell - 2) / 2}" cy="${y0 + (cell - 2) / 2}" r="${r.toFixed(2)}" fill="${color}" data-row="${i}"><title>« ${label(i)} » regarde « ${label(j)} » : ${Math.round(w * 100)} %</title></circle>`;
          }
        }
      }
      if (!(mode === 'gen' && selRow >= t)) {
        h += `<rect x="${ox - 3}" y="${oy + selRow * cell - 2}" width="${s * cell + 2}" height="${cell + 2}" rx="5" fill="none" stroke="var(--accent)" stroke-width="1.5" pointer-events="none"/>`;
      }
      $('cap').innerHTML =
        mode === 'bert'
          ? `<p class="tt2">BERT : chaque mot regarde toute la phrase, avant et après lui</p><p>Pas de masque causal : toute la matrice est remplie, et chaque ligne somme à 100 % sur les ${s} mots. À l'entraînement, BERT remplace quelques mots par [MASK] et doit les retrouver grâce au contexte des deux côtés. Il comprend bien une phrase entière, mais ne génère pas mot à mot.</p>`
          : mode === 'train'
          ? `<p class="tt2">Toutes les lignes d'un coup : Q × Kᵀ, puis softmax</p>`
          : `<p class="tt2">Pas ${t} : « ${WORDS[t - 1]} » regarde ${t === 1 ? 'seulement lui-même' : t <= 5 ? WORDS.slice(0, t).map((w) => `« ${w} »`).join(', ') : `les ${t} mots de « ${WORDS[0]} » à « ${WORDS[t - 1]} »`}</p><p>Ambre = ligne calculée maintenant. Vert clair = lignes déjà faites.</p>`;
      svg.setAttribute('viewBox', `0 0 ${VBW} ${oy + s * cell + 8}`);
      svg.innerHTML = h;
      const cells = (s * (s + 1)) / 2;
      $('k-seq').textContent = String(mode === 'gen' ? s : 1);
      $('k-cells').textContent = mode === 'bert' ? String(s * s) : mode === 'train' ? String(cells) : `${(t * (t + 1)) / 2} / ${cells}`;
      $('k-kv').textContent = mode === 'bert' ? '—' : String(mode === 'train' ? s : t);
      renderOut();
      layoutOut();
    }

    // Aligne les lignes du tableau sur celles de la matrice (échelle réelle du SVG à l'écran).
    function layoutOut() {
      const out = $('out');
      const box = svg.getBoundingClientRect();
      const k = box.width / VBW;
      const wrapped = out.getBoundingClientRect().top >= box.bottom - 1;
      out.classList.toggle('wrapped', wrapped);
      out.style.setProperty('--row-h', `${(curCell * k).toFixed(2)}px`);
      out.style.setProperty('--top', `${(curOy * k).toFixed(2)}px`);
    }
    new ResizeObserver(layoutOut).observe(svg);

    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
      b.addEventListener('click', () => {
        mode = b.dataset.mode as 'train' | 'gen' | 'bert';
        t = 1;
        if (mode === 'gen') selRow = 0;
        if (mode === 'bert') selRow = MASKED;
        root.classList.toggle('bert', mode === 'bert');
        root.querySelectorAll('[data-mode]').forEach((o) => o.classList.toggle('active', o === b));
        $('gen-ctl').hidden = mode !== 'gen';
        draw();
      }),
    );
    slider.addEventListener('input', () => {
      s = +slider.value;
      $('s-out').textContent = String(s);
      if (t > s) t = s;
      if (selRow > s - 1) selRow = s - 1;
      draw();
    });
    $('next').addEventListener('click', () => { if (t < s) t++; selRow = t - 1; draw(); });
    $('prev').addEventListener('click', () => { if (t > 1) t--; selRow = t - 1; draw(); });
    svg.addEventListener('click', (ev) => {
      const el = (ev.target as Element).closest('[data-row]');
      if (!el) return;
      const i = +(el as HTMLElement).dataset.row!;
      if (mode === 'gen' && i >= t) return;
      selRow = i;
      draw();
    });
    draw();
  });
</script>

<style is:global>
  .widget svg text.ts { font: 12px var(--font); fill: var(--text-2); }
  .widget svg text.tt { font: 500 14px var(--font); fill: var(--text); }
  .causal svg [data-row] { cursor: pointer; }
  .widget.causal { transition: background 0.3s, color 0.3s; }
  .widget.causal.bert {
    --surface: #3d3029; --surface-2: #4d3e35; --text: #fbf6f0; --text-2: #e6dacd; --border: #6e5b4d;
    --c-w: #8ea5d8;
    --accent: #f3d9a8; --hl-bg: #5e4a3c; --hl-text: #ffffff; --hl-stroke: #f3d9a8;
    background: var(--surface); color: var(--text); border-color: var(--border);
  }
  .causal .mrow { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-start; }
  .causal .mrow > svg { flex: 0 1 360px; width: 360px; max-width: 100%; height: auto; }
  .causal .outp { flex: 1 1 260px; min-width: 260px; }
  .causal .mcap { margin-top: 6px; }
  .causal .mcap p { font-size: 12px; color: var(--text-2); margin: 2px 0; line-height: 1.5; }
  .causal .mcap p.tt2 { font-size: 14px; font-weight: 500; color: var(--text); }
  .causal .otitle { font-weight: 500; font-size: 13px; line-height: 1.3; margin: 0; height: calc(var(--top, 0px) - 24px); display: flex; align-items: flex-end; padding-bottom: 4px; }
  .causal .outp.wrapped .otitle { height: auto; margin-bottom: 6px; }
  .causal table.ot thead tr { height: 24px; }
  .causal table.ot tbody tr { height: var(--row-h, 24px); }
  .causal .outp.wrapped table.ot tbody tr { height: 24px; }
  .causal table.ot { border-collapse: collapse; font-size: 12.5px; font-variant-numeric: tabular-nums; width: 100%; }
  .causal table.ot th { font-weight: 400; color: var(--text-2); text-align: right; padding: 0 3px; border-bottom: 1px solid var(--border); }
  .causal table.ot th:first-child, .causal table.ot td.wd { text-align: left; }
  .causal table.ot th.vh { text-align: left; }
  .causal table.ot td { text-align: right; padding: 0 3px; line-height: 1.1; }
  .causal table.ot td.vd { text-align: left; }
  .causal svg.vdots { display: block; height: calc(var(--row-h, 24px) - 2px); width: calc((var(--row-h, 24px) - 2px) * 4); }
  .causal .outp.wrapped svg.vdots { height: 22px; width: 88px; }
  .causal tr.sum td { border-top: 1px solid var(--border-strong, var(--border)); font-weight: 500; background: var(--hl-bg); color: var(--hl-text); }
  .causal .hint { font-size: 12px; color: var(--text-2); margin: 6px 0 0; }
</style>
