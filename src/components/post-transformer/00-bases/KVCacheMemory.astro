---
// Widget du chapitre 0 : taille du KV cache, M = 2 · L · h_kv · d_k · b · s · batch.
---
<div class="widget kvmem" data-widget="kv-mem">
  <div class="row">
    <label>Configuration
      <select data-ref="preset">
        <option value="mha">Type 7B, 32 têtes K/V (multi-head)</option>
        <option value="gqa">Type 7B, 8 têtes K/V (GQA)</option>
        <option value="custom">Personnalisée</option>
      </select>
    </label>
    <label>Précision
      <select data-ref="b">
        <option value="1">1 octet (int8 / fp8)</option>
        <option value="2" selected>2 octets (bf16 / fp16)</option>
        <option value="4">4 octets (fp32)</option>
      </select>
    </label>
  </div>
  <div class="sliders">
    <label><span>Couches L</span><input type="range" data-ref="L" min="1" max="96" step="1" value="32" /><b data-ref="L-out"></b></label>
    <label><span>Têtes K/V h<sub>kv</sub></span><input type="range" data-ref="h" min="1" max="64" step="1" value="32" /><b data-ref="h-out"></b></label>
    <label><span>Dimension par tête d<sub>k</sub></span><input type="range" data-ref="dk" min="32" max="256" step="32" value="128" /><b data-ref="dk-out"></b></label>
    <label><span>Longueur s</span><input type="range" data-ref="e" min="7" max="20" step="1" value="12" /><b data-ref="s-out"></b></label>
    <label><span>Séquences en parallèle</span><input type="range" data-ref="bs" min="1" max="64" step="1" value="1" /><b data-ref="bs-out"></b></label>
  </div>
  <div class="kpis">
    <div><span>Par token</span><b data-ref="k-tok"></b><i>K et V, toutes couches, toutes têtes</i></div>
    <div><span>Cache total</span><b data-ref="k-tot"></b><i>par token × longueur du contexte × séquences</i></div>
    <div><span>Part d'un GPU de 80 Go</span><b data-ref="k-pct"></b><i>au-delà de 100 %, le cache ne tient plus</i></div>
  </div>
  <div class="bar"><div data-ref="bar"></div></div>
  <p class="note">Ordre de grandeur : sans les poids du modèle ni les activations.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-widget="kv-mem"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const inp = (r: string) => $(r) as HTMLInputElement;
    const PRESETS: Record<string, { L: number; h: number; dk: number; b: number }> = {
      mha: { L: 32, h: 32, dk: 128, b: 2 },
      gqa: { L: 32, h: 8, dk: 128, b: 2 },
    };
    const nf = (v: number) => v.toLocaleString('fr-FR', { maximumFractionDigits: 2 });
    const bytes = (n: number) =>
      n < 1e3 ? `${nf(n)} o` : n < 1e6 ? `${nf(n / 1e3)} Ko` : n < 1e9 ? `${nf(n / 1e6)} Mo` : `${nf(n / 1e9)} Go`;

    function update() {
      const L = +inp('L').value, h = +inp('h').value, dk = +inp('dk').value;
      const b = +(inp('b') as unknown as HTMLSelectElement).value;
      const s = 2 ** +inp('e').value, bs = +inp('bs').value;
      const perToken = 2 * L * h * dk * b;
      const total = perToken * s * bs;
      const pct = (total / 80e9) * 100;
      $('L-out').textContent = String(L);
      $('h-out').textContent = String(h);
      $('dk-out').textContent = String(dk);
      $('s-out').textContent = s.toLocaleString('fr-FR');
      $('bs-out').textContent = String(bs);
      $('k-tok').textContent = bytes(perToken);
      $('k-tot').textContent = bytes(total);
      $('k-pct').textContent = `${nf(pct)} %`;
      $('k-pct').style.color = pct > 100 ? 'var(--bad)' : '';
      $('bar').style.width = `${Math.min(100, pct)}%`;
      const match = Object.entries(PRESETS).find(([, p]) => p.L === L && p.h === h && p.dk === dk && p.b === b);
      (inp('preset') as unknown as HTMLSelectElement).value = match ? match[0] : 'custom';
    }

    (inp('preset') as unknown as HTMLSelectElement).addEventListener('change', (ev) => {
      const p = PRESETS[(ev.target as HTMLSelectElement).value];
      if (!p) return;
      inp('L').value = String(p.L);
      inp('h').value = String(p.h);
      inp('dk').value = String(p.dk);
      (inp('b') as unknown as HTMLSelectElement).value = String(p.b);
      update();
    });
    ['L', 'h', 'dk', 'e', 'bs'].forEach((r) => inp(r).addEventListener('input', update));
    (inp('b') as unknown as HTMLSelectElement).addEventListener('change', update);
    update();
  });
</script>

<style is:global>
  /* cinq curseurs sur deux lignes (3 + 2) : nom et valeur au-dessus, curseur en dessous */
  .kvmem .sliders { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px 24px; margin-bottom: 12px; }
  .kvmem .sliders label:nth-child(-n+3) { grid-column: span 2; }
  .kvmem .sliders label:nth-child(n+4) { grid-column: span 3; }
  .kvmem .sliders label { display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 2px 8px; font-size: 14px; color: var(--text-2); }
  .kvmem .sliders label > span { grid-column: 1; grid-row: 1; }
  .kvmem .sliders label > b { grid-column: 2; grid-row: 1; }
  .kvmem .sliders label input { grid-column: 1 / -1; grid-row: 2; width: 100%; }
  .kvmem .sliders b { text-align: right; color: var(--text); font-weight: 500; }
  .kvmem .row label { display: flex; align-items: center; gap: 8px; }
  .kvmem select { font: inherit; font-size: 14px; padding: 4px 6px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--surface); color: var(--text); }
  .kvmem .bar { height: 10px; border-radius: 5px; background: var(--surface-2); margin-top: 10px; overflow: hidden; }
  .kvmem .bar > div { height: 100%; background: var(--accent); transition: width 0.15s; }
  .kvmem .note { font-size: 12px; color: var(--text-2); margin: 8px 0 0; }
  @media (max-width: 600px) { .kvmem .sliders { grid-template-columns: 1fr; } .kvmem .sliders label:nth-child(n) { grid-column: auto; } }
</style>
