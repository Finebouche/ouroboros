---
// Chapitre MFCC, section 3 : échelle de Mel, banc de filtres triangulaires, énergies par filtre pour une trame.
---
<div class="widget melb pp" data-widget="melbank">
  <div class="row"><span>Espacement des filtres :</span><span class="seg" data-ref="space"></span></div>
  <div class="row"><span>Nombre de filtres M :</span><span class="seg" data-ref="m"></span></div>
  <div class="sl">
    <input type="range" data-ref="pos" min="0" max="575" step="5" value="100" hidden />
    <label class="posl"><span>Filtre mis en évidence</span><input type="range" data-ref="sel" min="1" max="40" step="1" value="12" /><b data-ref="sel-out"></b></label>
  </div>

  <div class="ft">Signal <span>(clique ou glisse sur le signal pour placer la trame de 25 ms)</span></div>
  <svg data-ref="wave" width="100%" role="img" aria-label="Signal d'origine x entier, avec la trame choisie surlignée"></svg>

  <div class="ft">1. Les filtres sur le spectre de la trame</div>
  <svg data-ref="filters" width="100%" role="img" aria-label="Filtres triangulaires superposés au spectre de puissance"></svg>

  <div class="ft">2. Une énergie par filtre : la trame passe de 257 valeurs à M valeurs</div>
  <svg data-ref="bars" width="100%" role="img" aria-label="Énergie dans chaque filtre"></svg>

  <div class="kpis">
    <div><span>Filtre mis en évidence</span><b data-ref="k1"></b></div>
    <div><span>Largeur du filtre</span><b data-ref="k2"></b></div>
    <div><span>Filtres sans aucune fréquence de la FFT</span><b data-ref="k3"></b></div>
  </div>
</div>

<script>
  import { SR, makeSignal } from './signal';
  import { drawWaveStrip, pickOnWave } from './waveStrip';
  import { windowOf, powerSpectrum } from './dsp';

  document.querySelectorAll<HTMLElement>('[data-widget="melbank"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const inp = (r: string) => $(r) as HTMLInputElement;
    const x = makeSignal();
    const L = 400, NFFT = 512, FMAX = SR / 2;
    const win = windowOf('hamming', L);
    const hz2mel = (f: number) => 2595 * Math.log10(1 + f / 700);
    const mel2hz = (m: number) => 700 * (Math.pow(10, m / 2595) - 1);
    const MS = [20, 40, 80, 128];
    let M = 40, mode: 'mel' | 'lin' = 'mel';

    function seg(key: string, items: [string, string][], onPick: (v: string) => void) {
      items.forEach(([v, label]) => {
        const b = document.createElement('button');
        b.textContent = label;
        b.dataset.v = v;
        b.addEventListener('click', () => { onPick(v); draw(); });
        $(key).appendChild(b);
      });
    }
    seg('space', [['mel', 'En mel (régulier sur l’échelle de Mel)'], ['lin', 'En hertz (régulier)']], (v) => (mode = v as 'mel' | 'lin'));
    seg('m', MS.map((v) => [String(v), String(v)]), (v) => {
      M = +v;
      inp('sel').max = String(M);
      if (+inp('sel').value > M) inp('sel').value = String(Math.round(M / 2));
    });

    function draw() {
      const mark = (key: string, v: string) => $(key).querySelectorAll('button').forEach((b) => b.classList.toggle('active', b.dataset.v === v));
      mark('space', mode); mark('m', String(M));
      const t0 = +inp('pos').value;
      drawWaveStrip($('wave') as unknown as SVGSVGElement, x, t0);
      const sel = Math.min(+inp('sel').value, M) - 1;
      $('sel-out').textContent = `n° ${sel + 1} sur ${M}`;

      // M + 2 points : bords et centres des filtres
      const pts: number[] = [];
      for (let i = 0; i < M + 2; i++) {
        const u = i / (M + 1);
        pts.push(mode === 'mel' ? mel2hz(u * hz2mel(FMAX)) : u * FMAX);
      }
      // poids des filtres sur les cases de la FFT
      const nb = NFFT / 2 + 1, df = SR / NFFT;
      const H: Float64Array[] = [];
      let empty = 0;
      for (let m = 1; m <= M; m++) {
        const lo = pts[m - 1], c = pts[m], hi = pts[m + 1];
        const h = new Float64Array(nb);
        let any = false;
        for (let k = 0; k < nb; k++) {
          const f = k * df;
          const v = Math.max(0, Math.min((f - lo) / (c - lo), (hi - f) / (hi - c)));
          h[k] = v;
          if (v > 0) any = true;
        }
        if (!any) empty++;
        H.push(h);
      }
      // spectre de la trame
      const s0 = Math.round((t0 * SR) / 1000);
      const fr = new Float64Array(L);
      for (let i = 0; i < L; i++) fr[i] = x[s0 + i] * win[i];
      const P = powerSpectrum(fr, NFFT);
      const pmax = Math.max(...P, 1e-12);
      const E = H.map((h) => h.reduce((a, w, k) => a + w * P[k], 0));
      const emax = Math.max(...E, 1e-12);

      const W = 640, ox = 40, wpx = W - ox - 8;
      const FX = (f: number) => ox + (f / FMAX) * wpx;

      // --- 1. filtres sur le spectre ---
      const fh = 140, fy0 = 8, fhh = fh - 28;
      const FY = (v: number) => fy0 + (1 - v) * fhh;
      let a = `${FX(0)},${FY(0)} `;
      for (let k = 0; k < nb; k++) a += `${FX(k * df).toFixed(1)},${FY(P[k] / pmax).toFixed(1)} `;
      a += `${FX(FMAX)},${FY(0)}`;
      let f2 = `<polygon points="${a}" fill="var(--p-wave)" opacity="0.18"/><line x1="${ox}" y1="${FY(0)}" x2="${W - 8}" y2="${FY(0)}" stroke="var(--border)"/>`;
      for (let m = 1; m <= M; m++) {
        const on = m - 1 === sel;
        const tri = `${FX(pts[m - 1])},${FY(0)} ${FX(pts[m])},${FY(1)} ${FX(pts[m + 1])},${FY(0)}`;
        if (!on) f2 += `<polygon points="${tri}" fill="none" stroke="var(--p-mel)" stroke-width="0.9"/>`;
      }
      const m1 = sel + 1;
      f2 += `<polygon points="${FX(pts[m1 - 1])},${FY(0)} ${FX(pts[m1])},${FY(1)} ${FX(pts[m1 + 1])},${FY(0)}" fill="var(--hl-bg)" fill-opacity="0.8" stroke="var(--hl-stroke)" stroke-width="1.6"/>`;
      for (let kHz = 0; kHz <= 8; kHz++) f2 += `<text x="${FX(kHz * 1000)}" y="${fh + 2}" text-anchor="${kHz === 0 ? 'start' : kHz === 8 ? 'end' : 'middle'}" class="ax">${kHz === 8 ? '8 kHz' : kHz}</text>`;
      f2 += `<text x="${ox - 6}" y="${FY(1) + 3.5}" text-anchor="end" class="ax">1</text><text x="${ox - 6}" y="${FY(0) + 3.5}" text-anchor="end" class="ax">0</text>`;
      const c2 = $('filters') as unknown as SVGSVGElement;
      c2.setAttribute('viewBox', `0 0 ${W} ${fh + 8}`);
      c2.innerHTML = f2;

      // --- 2. énergies ---
      const bh = 110, by0 = 6, bhh = bh - 20;
      const bw = wpx / M;
      let b3 = `<line x1="${ox}" y1="${by0 + bhh}" x2="${W - 8}" y2="${by0 + bhh}" stroke="var(--border)"/>`;
      E.forEach((e, i) => {
        const h = (e / emax) * bhh;
        b3 += `<rect x="${(ox + i * bw + 0.5).toFixed(1)}" y="${(by0 + bhh - h).toFixed(1)}" width="${Math.max(1, bw - 1).toFixed(1)}" height="${h.toFixed(1)}" rx="1" fill="${i === sel ? 'var(--hl-stroke)' : 'var(--p-mel)'}"${i === sel ? ' stroke="var(--hl-text)" stroke-width="1.2"' : ' fill-opacity="0.4"'}/>`;
      });
      b3 += `<text x="${ox}" y="${bh + 2}" class="ax">filtre 1</text><text x="${W - 8}" y="${bh + 2}" text-anchor="end" class="ax">filtre ${M}</text>`;
      const c3 = $('bars') as unknown as SVGSVGElement;
      c3.setAttribute('viewBox', `0 0 ${W} ${bh + 8}`);
      c3.innerHTML = b3;

      const lo = pts[sel], hi = pts[sel + 2], c = pts[sel + 1];
      $('k1').innerHTML = `${Math.round(lo)} à ${Math.round(hi)} Hz <small>centre ${Math.round(c)} Hz</small>`;
      $('k2').textContent = `${Math.round(hi - lo)} Hz`;
      $('k3').innerHTML = `${empty} <small>sur ${M}</small>`;
    }

    inp('pos').addEventListener('input', draw);
    pickOnWave($('wave') as unknown as SVGSVGElement, () => 25, inp('pos'), draw);
    inp('sel').addEventListener('input', draw);
    draw();
  });
</script>

<style is:global>
  .melb .row { margin-bottom: 6px; }
  .melb .seg { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .melb .seg button { font-size: 13px; padding: 4px 12px; }
  .melb .sl { display: grid; grid-template-columns: minmax(0, 50%); gap: 6px 24px; }
  @media (max-width: 600px) { .melb .sl { grid-template-columns: minmax(0, 1fr); } }
  .melb .ft { font-size: 13px; font-weight: 500; margin: 12px 0 2px; }
  .melb svg text.ax { font: 11px var(--font); fill: var(--text-2); }
  .melb .kpis small { font-size: 13px; color: var(--text-2); font-weight: 400; }
  @media (max-width: 600px) { .melb .posl { grid-template-columns: 1fr; } }
</style>
