---
// Chapitre MFCC, section 4 : la DCT des log-énergies de Mel ; garder les K premiers coefficients = garder la forme générale.
---
<div class="widget dctt pp" data-widget="dctt">
  <div class="sl">
    <input type="range" data-ref="pos" min="0" max="575" step="5" value="100" hidden />
    <label class="posl"><span>Coefficients gardés K</span><input type="range" data-ref="k" min="1" max="40" step="1" value="13" /><b data-ref="k-out"></b></label>
  </div>

  <div class="ft">Signal <span>(clique ou glisse sur le signal pour placer la trame de 25 ms)</span></div>
  <svg data-ref="wave" width="100%" role="img" aria-label="Signal d'origine x entier, avec la trame choisie surlignée"></svg>

  <div class="ft">Les 40 coefficients de la DCT : le poids de chaque onde <span>(c<sub>0</sub> : barre tronquée, hors échelle)</span></div>
  <svg data-ref="coef" width="100%" role="img" aria-label="Coefficients de la DCT"></svg>

  <div class="ft">Chaque onde multipliée par son coefficient <span>(les 6 premières)</span></div>
  <svg data-ref="waves" width="100%" role="img" aria-label="Les premières ondes cosinus de la DCT, chacune multipliée par son coefficient"></svg>

  <div class="ft">On additionne les K premières ondes : la courbe reconstruite, comparée aux 40 log-énergies</div>
  <svg data-ref="rec" width="100%" role="img" aria-label="Log-énergies de Mel et leur reconstruction à partir des premiers coefficients de la DCT"></svg>
</div>

<script>
  import { makeSignal } from './signal';
  import { drawWaveStrip, pickOnWave } from './waveStrip';
  import { melEnergiesAt, dct2, idctK } from './mel';

  document.querySelectorAll<HTMLElement>('[data-widget="dctt"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const inp = (r: string) => $(r) as HTMLInputElement;
    const x = makeSignal();
    const M = 40;
    const fr = (v: number, d = 2) => v.toLocaleString('fr-FR', { maximumFractionDigits: d });

    function draw() {
      const t0 = +inp('pos').value, K = +inp('k').value;
      drawWaveStrip($('wave') as unknown as SVGSVGElement, x, t0);
      $('k-out').textContent = String(K);
      const v = melEnergiesAt(x, t0, M).map((e) => Math.log(Math.max(e, 1e-12)));
      const c = dct2(v);
      const r = idctK(c, K);

      const W = 640, ox = 52, wpx = W - ox - 8, bw = wpx / M;
      const lo = Math.min(...v, ...r), hi = Math.max(...v, ...r);

      // --- reconstruction ---
      const H1 = 150, y0 = 8, hh = H1 - 28;
      const Y = (a: number) => y0 + (1 - (a - lo) / (hi - lo || 1)) * hh;
      const X = (i: number) => ox + (i + 0.5) * bw;
      let g = `<line x1="${ox}" y1="${y0 + hh}" x2="${W - 8}" y2="${y0 + hh}" stroke="var(--border)"/>`;
      let pl = '';
      v.forEach((a, i) => { g += `<circle cx="${X(i).toFixed(1)}" cy="${Y(a).toFixed(1)}" r="2.6" fill="var(--p-wave)" opacity="0.8"/>`; });
      r.forEach((a, i) => { pl += `${X(i).toFixed(1)},${Y(a).toFixed(1)} `; });
      g += `<polyline points="${pl}" fill="none" stroke="var(--p-mel)" stroke-width="2" stroke-linejoin="round"/>`;
      g += `<text x="${ox}" y="${H1 - 4}" class="ax">filtre 1 (graves)</text><text x="${W - 8}" y="${H1 - 4}" text-anchor="end" class="ax">filtre 40 (aigus)</text>`;
      g += `<text x="${W - 12}" y="${y0 + 12}" text-anchor="end" class="ax" style="fill:var(--p-wave);font-weight:600">● log-énergies (40 valeurs)</text><text x="${W - 12}" y="${y0 + 27}" text-anchor="end" class="ax" style="fill:var(--p-mel);font-weight:600">━ reconstruction avec ${K} coefficients</text>`;
      const s1 = $('rec') as unknown as SVGSVGElement;
      s1.setAttribute('viewBox', `0 0 ${W} ${H1}`);
      s1.innerHTML = g;

      // --- les 6 premières ondes, chacune multipliée par son coefficient (échelle verticale commune) ---
      {
        const NP = 6, pw = 84, gap = 16, x00 = 4, H3 = 100, top = 6, ph = 50, mid = top + ph / 2;
        const sn = (n: number) => (n === 0 ? Math.sqrt(1 / M) : Math.sqrt(2 / M));
        const term = (n: number, m: number) => c[n] * sn(n) * Math.cos((Math.PI * n * (m + 0.5)) / M);
        let tm = 1e-9;
        for (let n = 0; n < NP; n++) for (let m = 0; m < M; m++) tm = Math.max(tm, Math.abs(term(n, m)));
        const sub = (n: number) => '₀₁₂₃₄₅₆₇₈₉'[n];
        const nm = ['constante', '½ onde', '1 onde', '1½ onde', '2 ondes', '2½ ondes'];
        let w = '';
        for (let n = 0; n < NP; n++) {
          const x0 = x00 + n * (pw + gap), kept = n < K, col = kept ? 'var(--p-mel)' : 'var(--p-frame-a)';
          w += `<line x1="${x0}" y1="${mid}" x2="${x0 + pw}" y2="${mid}" stroke="var(--border)" stroke-dasharray="2 3"/>`;
          let pts = '';
          for (let m = 0; m < M; m++) pts += `${(x0 + ((m + 0.5) / M) * pw).toFixed(1)},${(mid - (term(n, m) / tm) * (ph / 2)).toFixed(1)} `;
          w += `<polyline points="${pts}" fill="none" stroke="${col}" stroke-width="2" stroke-linejoin="round"/>`;
          w += `<text x="${x0 + pw / 2}" y="${top + ph + 16}" text-anchor="middle" class="ax" style="fill:${kept ? 'var(--text)' : 'var(--text-2)'};font-weight:600">c${sub(n)} = ${fr(c[n], 1)}</text>`;
          w += `<text x="${x0 + pw / 2}" y="${top + ph + 30}" text-anchor="middle" class="ax">× ${nm[n]}</text>`;
          if (n < NP - 1) w += `<text x="${x0 + pw + gap / 2}" y="${mid + 4}" text-anchor="middle" class="ax">+</text>`;
        }
        w += `<text x="${x00 + NP * (pw + gap) - gap / 2}" y="${mid + 4}" class="ax">+ …</text>`;
        const s3 = $('waves') as unknown as SVGSVGElement;
        s3.setAttribute('viewBox', `0 0 640 ${H3 - 6}`);
        s3.innerHTML = w;
      }

      // --- coefficients c_0 … c_39 (c_0 hors échelle : barre tronquée, valeur écrite à gauche) ---
      const H2 = 120, cy = 6 + (H2 - 28) / 2, ch = (H2 - 28) / 2;
      const cm = Math.max(...c.slice(1).map(Math.abs), 1e-9);
      let b = `<line x1="${ox}" y1="${cy}" x2="${W - 8}" y2="${cy}" stroke="var(--border)"/>`;
      for (let n = 0; n < M; n++) {
        const h = n === 0 ? Math.sign(c[0] || 1) * ch : (c[n] / cm) * ch;
        b += `<rect x="${(ox + n * bw + 0.5).toFixed(1)}" y="${(h >= 0 ? cy - h : cy).toFixed(1)}" width="${Math.max(1, bw - 1).toFixed(1)}" height="${Math.max(0.5, Math.abs(h)).toFixed(1)}" fill="${n < K ? 'var(--p-mel)' : 'var(--p-frame-a)'}"/>`;
      }
      {
        // coupure de la barre de c_0 et sa valeur dans la marge
        const x0 = ox + 0.5, x1 = x0 + Math.max(1, bw - 1), yb = cy - Math.sign(c[0] || 1) * ch * 0.6;
        b += `<line x1="${(x0 - 1).toFixed(1)}" y1="${(yb + 3).toFixed(1)}" x2="${(x1 + 1).toFixed(1)}" y2="${(yb - 3).toFixed(1)}" stroke="var(--surface)" stroke-width="2.2"/>`;
        b += `<text x="${ox - 5}" y="${(cy - Math.sign(c[0] || 1) * ch + (c[0] < 0 ? 0 : 10)).toFixed(1)}" text-anchor="end" class="ax" style="fill:var(--text);font-weight:600">${fr(c[0], 1)}</text>`;
      }
      for (const n of [0, 1, 10, 20, 30, 39]) b += `<text x="${ox + (n + 0.5) * bw}" y="${H2 - 4}" text-anchor="middle" class="ax">c${String(n).split('').map((d) => '₀₁₂₃₄₅₆₇₈₉'[+d]).join('')}</text>`;
      const s2 = $('coef') as unknown as SVGSVGElement;
      s2.setAttribute('viewBox', `0 0 ${W} ${H2}`);
      s2.innerHTML = b;

    }
    ['pos', 'k'].forEach((r) => inp(r).addEventListener('input', draw));
    pickOnWave($('wave') as unknown as SVGSVGElement, () => 25, inp('pos'), draw);
    draw();
  });
</script>

<style is:global>
  .dctt .sl { display: grid; grid-template-columns: minmax(0, 50%); gap: 6px 24px; }
  @media (max-width: 600px) { .dctt .sl { grid-template-columns: minmax(0, 1fr); } }
  .dctt .ft { font-size: 13px; font-weight: 500; margin: 12px 0 2px; }
  .dctt .ft span { font-weight: 400; color: var(--text-2); }
  .dctt .lg { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; font-size: 12px; color: var(--text-2); margin: 0 0 2px; }
  .dctt .sq { display: inline-block; width: 12px; height: 12px; margin-right: 4px; vertical-align: -1px; }
  .dctt .sq.pts { background: var(--p-wave); border-radius: 6px; }
  .dctt .sq.rec { background: var(--p-mel); height: 3px; vertical-align: 3px; }
  .dctt svg text.ax { font: 11px var(--font); fill: var(--text-2); }
  @media (max-width: 600px) { .dctt .posl { grid-template-columns: 1fr; } }
</style>
