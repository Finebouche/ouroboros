---
// Chapitre MFCC, section 5 : les deltas, c'est-à-dire la variation d'un coefficient MFCC d'une trame à l'autre.
---
<div class="widget deltas pp" data-widget="deltas">
  <div class="row"><span>Ordre :</span><span class="seg" data-ref="ord"></span><span class="sp">Demi-fenêtre N :</span><span class="seg" data-ref="nn"></span></div>
  <label class="posl"><span>Coefficient c<sub>k</sub>, k =</span><input type="range" data-ref="k" min="0" max="12" step="1" value="1" /><b data-ref="k-out"></b></label>
  <label class="posl"><span>Trame t</span><input type="range" data-ref="t" min="0" max="57" step="1" value="12" /><b data-ref="t-out"></b></label>
  <div class="ft" data-ref="t1">Le coefficient au fil des trames</div>
  <p class="lg"><i class="sq win"></i>trames utilisées pour calculer le delta en t <i class="sq cur"></i>trame t</p>
  <svg data-ref="top" width="100%" role="img" aria-label="Un coefficient MFCC au fil des trames"></svg>
  <div class="ft" data-ref="t2">Son delta</div>
  <svg data-ref="bot" width="100%" role="img" aria-label="Delta du coefficient"></svg>
  <div class="kpis">
    <div><span data-ref="l1">c<sub>k</sub> en t</span><b data-ref="k1"></b></div>
    <div><span data-ref="l2">Δc<sub>k</sub> en t</span><b data-ref="k2"></b></div>
    <div><span>Trames utilisées</span><b data-ref="k3"></b></div>
  </div>
</div>

<script>
  import { makeSignal } from './signal';
  import { mfccFrames, delta } from './mel';

  document.querySelectorAll<HTMLElement>('[data-widget="deltas"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const inp = (r: string) => $(r) as HTMLInputElement;
    const C = mfccFrames(makeSignal(), 13, 40); // [trame][coefficient]
    const T = C.length;
    inp('t').max = String(T - 1);
    const fr = (v: number, d = 2) => (Math.abs(v) < 0.5 * 10 ** -d ? 0 : v).toLocaleString('fr-FR', { maximumFractionDigits: d });
    let order = 1, N = 2;

    function seg(key: string, items: [string, string][], onPick: (v: string) => void) {
      items.forEach(([v, label]) => {
        const b = document.createElement('button');
        b.textContent = label;
        b.dataset.v = v;
        b.addEventListener('click', () => { onPick(v); draw(); });
        $(key).appendChild(b);
      });
    }
    seg('ord', [['1', 'Δ (vitesse)'], ['2', 'ΔΔ (accélération)']], (v) => (order = +v));
    seg('nn', [['1', '1'], ['2', '2'], ['3', '3']], (v) => (N = +v));

    function plot(svgKey: string, vals: number[], t: number, band: [number, number] | null, zero: boolean) {
      const W = 640, ox = 40, wpx = W - ox - 8, H = 130, y0 = 8, hh = H - 28;
      const lo = Math.min(...vals, zero ? 0 : Infinity), hi = Math.max(...vals, zero ? 0 : -Infinity);
      const pad = (hi - lo || 1) * 0.1;
      const Y = (v: number) => y0 + (1 - (v - (lo - pad)) / (hi - lo + 2 * pad)) * hh;
      const X = (i: number) => ox + (i / (T - 1)) * wpx;
      let g = '';
      if (band) g += `<rect x="${X(band[0]) - 2}" y="${y0}" width="${X(band[1]) - X(band[0]) + 4}" height="${hh}" fill="var(--p-frame-b)"/>`;
      if (zero) g += `<line x1="${ox}" y1="${Y(0)}" x2="${W - 8}" y2="${Y(0)}" stroke="var(--border)"/>`;
      let pl = '';
      vals.forEach((v, i) => (pl += `${X(i).toFixed(1)},${Y(v).toFixed(1)} `));
      g += `<polyline points="${pl}" fill="none" stroke="var(--p-wave)" stroke-width="1.5" stroke-linejoin="round"/>`;
      vals.forEach((v, i) => { g += `<circle cx="${X(i).toFixed(1)}" cy="${Y(v).toFixed(1)}" r="${i === t ? 4.2 : 1.8}" fill="${i === t ? 'var(--hl-stroke)' : 'var(--p-wave)'}"/>`; });
      for (const ms of [0, 100, 200, 300, 400, 500]) g += `<text x="${X(ms / 10)}" y="${H - 6}" text-anchor="middle" class="ax">${ms}</text>`;
      g += `<text x="${W - 8}" y="${H - 6}" text-anchor="end" class="ax">ms</text>`;
      g += `<text x="${ox - 4}" y="${Y(hi) + 3.5}" text-anchor="end" class="ax">${fr(hi, 1)}</text><text x="${ox - 4}" y="${Y(lo) + 3.5}" text-anchor="end" class="ax">${fr(lo, 1)}</text>`;
      const s = $(svgKey) as unknown as SVGSVGElement;
      s.setAttribute('viewBox', `0 0 ${W} ${H}`);
      s.innerHTML = g;
    }

    function draw() {
      mark('ord', String(order)); mark('nn', String(N));
      const k = +inp('k').value, t = +inp('t').value;
      $('k-out').textContent = `c${k}`;
      $('t-out').textContent = `${t * 10} ms`;
      const track = C.map((row) => row[k]);
      const d1 = delta(track, N), res = order === 1 ? d1 : delta(d1, N);
      const reach = order === 1 ? N : 2 * N;
      plot('top', track, t, [Math.max(0, t - reach), Math.min(T - 1, t + reach)], false);
      plot('bot', res, t, null, true);
      const name = order === 1 ? 'Δ' : 'ΔΔ';
      $('t2').innerHTML = `${name}c<sub>${k}</sub> : ${order === 1 ? 'pente' : 'courbure'} de la courbe, calculée avec N = ${N}`;
      $('l2').innerHTML = `${name}c<sub>${k}</sub> en t`;
      $('l1').innerHTML = `c<sub>${k}</sub> en t`;
      $('k1').textContent = fr(track[t]);
      $('k2').textContent = fr(res[t]);
      $('k3').innerHTML = `${2 * reach + 1} <small>(t ± ${reach})</small>`;
    }
    function mark(key: string, v: string) { $(key).querySelectorAll('button').forEach((b) => b.classList.toggle('active', b.dataset.v === v)); }
    ['k', 't'].forEach((r) => inp(r).addEventListener('input', draw));
    draw();
  });
</script>

<style is:global>
  .deltas .row { margin-bottom: 6px; }
  .deltas .seg { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .deltas .seg button { font-size: 13px; padding: 4px 12px; }
  .deltas .sp { margin-left: 16px; }
  .deltas .posl { display: grid; grid-template-columns: 200px 1fr 70px; align-items: center; gap: 12px; font-size: 14px; color: var(--text-2); margin: 6px 0; }
  .deltas .posl b { text-align: right; color: var(--text); font-weight: 500; }
  .deltas .ft { font-size: 13px; font-weight: 500; margin: 12px 0 2px; }
  .deltas .lg { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; font-size: 12px; color: var(--text-2); margin: 0 0 2px; }
  .deltas .sq { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: 4px; vertical-align: -1px; }
  .deltas .sq.win { background: var(--p-frame-b); border: 1px solid var(--border); }
  .deltas .sq.cur { background: var(--hl-stroke); border-radius: 6px; }
  .deltas svg text.ax { font: 11px var(--font); fill: var(--text-2); }
  .deltas .kpis small { font-size: 12px; color: var(--text-2); font-weight: 400; }
  @media (max-width: 600px) { .deltas .posl { grid-template-columns: 1fr; } }
</style>
