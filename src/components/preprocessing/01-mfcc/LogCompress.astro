---
// Chapitre MFCC, section 4 : le logarithme des énergies de Mel. Il écrase l'écart entre les énergies fortes et faibles,
// et transforme un changement de volume en simple décalage vertical.
---
<div class="widget logc pp" data-widget="logc">
  <div class="ctl">
    <input type="range" data-ref="pos" min="0" max="575" step="5" value="100" hidden />
    <div class="row"><span>Volume du signal :</span><span class="seg" data-ref="gain"></span></div>
  </div>

  <div class="ft">Signal <span>(clique ou glisse sur le signal pour placer la trame de 25 ms)</span></div>
  <svg data-ref="wave" width="100%" role="img" aria-label="Signal d'origine x entier, avec la trame choisie surlignée"></svg>

  <div class="ft">Énergies de Mel E<sub>m</sub> <span>(échelle linéaire)</span></div>
  <svg data-ref="lin" width="100%" role="img" aria-label="Énergies de Mel en échelle linéaire"></svg>
  <div class="ft">Après le logarithme : ln E<sub>m</sub></div>
  <svg data-ref="log" width="100%" role="img" aria-label="Logarithme des énergies de Mel"></svg>
</div>

<script>
  import { makeSignal } from './signal';
  import { drawWaveStrip, pickOnWave } from './waveStrip';
  import { melEnergiesAt } from './mel';

  document.querySelectorAll<HTMLElement>('[data-widget="logc"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const inp = (r: string) => $(r) as HTMLInputElement;
    const x = makeSignal();
    const M = 40;
    const GAINS = [1, 3, 10]; // facteurs d'amplitude
    let gain = 1;

    GAINS.forEach((g) => {
      const b = document.createElement('button');
      b.textContent = `× ${g}`;
      b.dataset.v = String(g);
      b.addEventListener('click', () => { gain = g; draw(); });
      $('gain').appendChild(b);
    });

    function bars(svgKey: string, vals: number[], lo: number, hi: number, color: string, ticks: [number, string][]) {
      const W = 640, ox = 52, wpx = W - ox - 8, H = 120, y0 = 6, hh = H - 26, bw = wpx / vals.length;
      const Y = (v: number) => y0 + (1 - (v - lo) / (hi - lo)) * hh;
      let g = '';
      for (const [t, lab] of ticks) g += `<line x1="${ox}" y1="${Y(t)}" x2="${W - 8}" y2="${Y(t)}" stroke="var(--border)" stroke-width="0.5"/><text x="${ox - 4}" y="${Y(t) + 3.5}" text-anchor="end" class="ax">${lab}</text>`;
      const base = Y(Math.max(lo, Math.min(0, hi)));
      vals.forEach((v, i) => {
        const y = Y(Math.max(lo, Math.min(hi, v)));
        g += `<rect x="${(ox + i * bw + 0.5).toFixed(1)}" y="${Math.min(y, base).toFixed(1)}" width="${Math.max(1, bw - 1).toFixed(1)}" height="${Math.max(0.5, Math.abs(base - y)).toFixed(1)}" rx="1" fill="${color}"/>`;
      });
      g += `<text x="${ox}" y="${H - 2}" class="ax">filtre 1 (graves)</text><text x="${W - 8}" y="${H - 2}" text-anchor="end" class="ax">filtre ${vals.length} (aigus)</text>`;
      const s = $(svgKey) as unknown as SVGSVGElement;
      s.setAttribute('viewBox', `0 0 ${W} ${H}`);
      s.innerHTML = g;
    }

    function draw() {
      $('gain').querySelectorAll('button').forEach((b) => b.classList.toggle('active', +b.dataset.v! === gain));
      const t0 = +inp('pos').value;
      drawWaveStrip($('wave') as unknown as SVGSVGElement, x, t0);
      const E = melEnergiesAt(x, t0, M, gain).map((e) => Math.max(e, 1e-12));
      const E1 = melEnergiesAt(x, t0, M, 1).map((e) => Math.max(e, 1e-12));
      const emax = Math.max(...E);
      bars('lin', E.map((e) => e / emax), 0, 1, 'var(--p-mel)', [[0, '0'], [1, 'max']]);
      // l'échelle du log est fixée sur le volume le plus fort, pour que le décalage se voie
      const L1 = E1.map(Math.log), top = Math.max(...L1) + 2 * Math.log(Math.max(...GAINS)) + 0.5, bot = Math.min(...L1) - 0.5;
      const step = 5, ticks: [number, string][] = [];
      for (let t = Math.ceil(bot / step) * step; t <= top; t += step) ticks.push([t, String(t)]);
      bars('log', E.map(Math.log), bot, top, 'var(--p-wave)', ticks);

    }
    inp('pos').addEventListener('input', draw);
    pickOnWave($('wave') as unknown as SVGSVGElement, () => 25, inp('pos'), draw);
    draw();
  });
</script>

<style is:global>
  .logc .ctl { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 32px; margin-bottom: 6px; }
  .logc .ctl .row { margin: 0; }
  .logc .seg { display: inline-flex; gap: 6px; }
  .logc .seg button { font-size: 13px; padding: 4px 12px; }
  .logc .ft { font-size: 13px; font-weight: 500; margin: 12px 0 2px; }
  .logc .ft span { font-weight: 400; color: var(--text-2); }
  .logc svg text.ax { font: 11px var(--font); fill: var(--text-2); }
  @media (max-width: 600px) { .logc .posl { grid-template-columns: 1fr; } }
</style>
