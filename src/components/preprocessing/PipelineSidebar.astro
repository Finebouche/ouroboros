---
// Schéma du pipeline MFCC. Vue d'ensemble : les 5 étapes de l'introduction ; quand un repère (ArchMarker) désigne une sous-étape,
// l'étape correspondante se déplie. Même mécanisme que ArchSidebar : ArchMarker + arch:focus. Données et dessin : pipeline.ts.
import { renderPipeline } from './pipeline';
const init = renderPipeline(new Set());
---
<aside class="arch pipe" data-arch-sidebar aria-label="Position dans le pipeline MFCC">
  <svg viewBox={`0 0 210 ${init.height}`} width="100%" role="img" aria-label="Pipeline MFCC : du signal audio aux coefficients" data-pipe-svg>
    <defs>
      <marker id="pipe-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>
    <g data-pipe set:html={init.html} />
  </svg>
  <p class="caption" data-arch-label>Vue d'ensemble</p>
</aside>

<script>
  import { renderPipeline } from './pipeline';

  const root = document.querySelector<HTMLElement>('[data-arch-sidebar].pipe');
  if (root) {
    const markers = Array.from(document.querySelectorAll<HTMLElement>('[data-arch-marker]'));
    const svg = root.querySelector<SVGSVGElement>('[data-pipe-svg]')!;
    const g = root.querySelector<SVGGElement>('[data-pipe]')!;
    const label = root.querySelector<HTMLElement>('[data-arch-label]')!;
    let current: HTMLElement | null | undefined;

    function apply(names: string, text: string) {
      const r = renderPipeline(new Set(names.split(/\s+/).filter(Boolean)));
      g.innerHTML = r.html;
      svg.setAttribute('viewBox', `0 0 210 ${r.height}`);
      label.textContent = text;
    }

    function update() {
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      const line = window.innerHeight * (atBottom ? 0.95 : 0.4);
      let active: HTMLElement | null = null;
      for (const m of markers) {
        if (m.getBoundingClientRect().top <= line) active = m;
        else break;
      }
      const follow = active?.dataset.follow ? document.querySelector<HTMLElement>(active.dataset.follow) : null;
      if (active === current && !follow) return;
      current = active;
      apply(follow?.dataset.archParts ?? active?.dataset.parts ?? '', follow?.dataset.archLabel ?? active?.dataset.label ?? "Vue d'ensemble");
    }

    // Un widget peut aussi pointer une étape ; le prochain défilement reprend la main.
    window.addEventListener('arch:focus', (ev) => {
      const d = (ev as CustomEvent<{ parts: string; label: string }>).detail;
      apply(d.parts, d.label);
      current = undefined;
    });

    let queued = false;
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); });
    }, { passive: true });
    update();
  }
</script>

<style is:global>
  .pipe svg .edges path { fill: none; stroke: var(--text-2); stroke-width: 1; marker-end: url(#pipe-arrow); }
  .pipe svg text { font: 12px var(--font); fill: var(--text); }
  .pipe svg text.sub { font-size: 10px; fill: var(--text-2); }
  .pipe svg text.gl { font-size: 10px; fill: var(--text-2); letter-spacing: 0.03em; }
  .pipe svg .pb > rect { fill: var(--surface-2); stroke: var(--border); transition: fill 0.2s, stroke 0.2s; }
  .pipe svg .pb.opt > rect { stroke-dasharray: 4 3; }
  .pipe svg .pb.on > rect { fill: var(--hl-bg); stroke: var(--hl-stroke); stroke-width: 1.5; }
  .pipe svg .pb.on > text { fill: var(--hl-text); }
  .pipe svg .pg > rect { fill: none; stroke: var(--border); stroke-dasharray: 4 4; }
  .pipe .caption { font-size: 13px; line-height: 1.4; color: var(--text-2); margin: 0.4rem 0 0; min-height: 2.8em; }
</style>
