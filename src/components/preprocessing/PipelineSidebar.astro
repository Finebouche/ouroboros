---
// Schéma du pipeline MFCC, avec mise en évidence de l'étape en cours d'explication (même mécanisme que ArchSidebar : ArchMarker + arch:focus).
// Parties : signal, preemph, frames, window, dft, mel, log, dct, mfcc, post.
// Les dimensions affichées sont celles de l'exemple du cours (1 s de parole à 16 kHz, trames de 25 ms, pas de 10 ms, FFT 512, 40 filtres, 13 coefficients).
const stages: { part: string; title: string; sub: string; optional?: boolean }[] = [
  { part: 'signal', title: 'Signal audio', sub: '16 000 valeurs par seconde' },
  { part: 'preemph', title: 'Pré-accentuation', sub: 'optionnelle', optional: true },
  { part: 'frames', title: 'Découpage en trames', sub: '98 trames × 400 valeurs' },
  { part: 'window', title: 'Fenêtre', sub: 'adoucit les bords de chaque trame' },
  { part: 'dft', title: 'Spectre de puissance', sub: '98 × 257 fréquences' },
  { part: 'mel', title: 'Filtres Mel', sub: '98 × 40' },
  { part: 'log', title: 'Logarithme', sub: '98 × 40' },
  { part: 'dct', title: 'DCT, on garde 13', sub: '98 × 13' },
  { part: 'mfcc', title: 'MFCC', sub: 'un vecteur de 13 par trame' },
  { part: 'post', title: 'Deltas, normalisation', sub: 'optionnels', optional: true },
];
const H = 38, GAP = 14, X = 20, W = 170, TOP = 8;
const y = (i: number) => TOP + i * (H + GAP);
const total = TOP + stages.length * (H + GAP) - GAP + 8;
---
<aside class="arch pipe" data-arch-sidebar aria-label="Position dans le pipeline MFCC">
  <svg viewBox={`0 0 210 ${total}`} width="100%" role="img" aria-label="Pipeline MFCC : du signal audio aux coefficients">
    <defs>
      <marker id="pipe-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>
    <g class="edges">
      {stages.slice(1).map((_, i) => <path d={`M105 ${y(i) + H} V${y(i + 1) - 1}`} />)}
    </g>
    {stages.map((s, i) => (
      <g data-part={s.part} class:list={[{ opt: s.optional }]}>
        <rect x={X} y={y(i)} width={W} height={H} rx="6" />
        <text x="105" y={y(i) + 16} text-anchor="middle">{s.title}</text>
        <text x="105" y={y(i) + 30} text-anchor="middle" class="sub">{s.sub}</text>
      </g>
    ))}
  </svg>
  <p class="caption" data-arch-label>Vue d'ensemble</p>
</aside>

<script>
  const root = document.querySelector<HTMLElement>('[data-arch-sidebar].pipe');
  if (root) {
    const markers = Array.from(document.querySelectorAll<HTMLElement>('[data-arch-marker]'));
    const parts = Array.from(root.querySelectorAll<SVGGElement>('[data-part]'));
    const label = root.querySelector<HTMLElement>('[data-arch-label]')!;
    let current: HTMLElement | null | undefined;

    function apply(names: string, text: string) {
      const on = new Set(names.split(/\s+/).filter(Boolean));
      parts.forEach((p) => p.classList.toggle('on', p.dataset.part!.split(/\s+/).some((n) => on.has(n))));
      label.textContent = text;
    }

    function update() {
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      const line = window.innerHeight * (atBottom ? 0.95 : 0.4);
      let active: HTMLElement | null = null;
      for (const m of markers) {
        if (m.getBoundingClientRect().top <= line) active = m;
        else break;
      }
      const follow = active?.dataset.follow ? document.querySelector<HTMLElement>(active.dataset.follow) : null;
      if (active === current && !follow) return;
      current = active;
      apply(follow?.dataset.archParts ?? active?.dataset.parts ?? '', follow?.dataset.archLabel ?? active?.dataset.label ?? "Vue d'ensemble");
    }

    // Un widget peut aussi pointer une étape ; le prochain défilement reprend la main.
    window.addEventListener('arch:focus', (ev) => {
      const d = (ev as CustomEvent<{ parts: string; label: string }>).detail;
      apply(d.parts, d.label);
      current = undefined;
    });

    let queued = false;
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); });
    }, { passive: true });
    update();
  }
</script>

<style is:global>
  .pipe svg .edges path { fill: none; stroke: var(--text-2); stroke-width: 1; marker-end: url(#pipe-arrow); }
  .pipe svg text { font: 12px var(--font); fill: var(--text); }
  .pipe svg text.sub { font-size: 10px; fill: var(--text-2); }
  .pipe svg [data-part] > rect { fill: var(--surface-2); stroke: var(--border); transition: fill 0.2s, stroke 0.2s; }
  .pipe svg [data-part].opt > rect { stroke-dasharray: 4 3; }
  .pipe svg [data-part].on > rect { fill: var(--hl-bg); stroke: var(--hl-stroke); stroke-width: 1.5; }
  .pipe svg [data-part].on > text { fill: var(--hl-text); }
  .pipe .caption { font-size: 13px; line-height: 1.4; color: var(--text-2); margin: 0.4rem 0 0; min-height: 2.8em; }
</style>
