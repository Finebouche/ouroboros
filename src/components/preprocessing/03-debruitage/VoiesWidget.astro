---
// Chapitre 3, section 3 : voies classiques contre traitement adaptatif, face à un bruit qui vient d'une direction.
// Antenne linéaire de 8 capteurs espacés d'une demi-longueur d'onde, raie au gisement 0°, interférent à 21°
// (sommet du premier lobe secondaire des voies classiques). Trois états : interférent absent, égal au bruit, 100 fois le bruit.
// Tracé : diagramme de directivité |wᴴa(θ)|² des deux traitements pointés sur la raie (K_n exacte, calcul de antenne.ts, aucun tirage).
// Voies classiques en gris, traitement adaptatif en brun (--p-mel), interférent en rouge (--h-py), raie en repère --text.
import katex from 'katex';
const tx = (t: string) => katex.renderToString(t, { throwOnError: false });
const fDiag = tx('|\\mathbf{w}^H\\mathbf{a}(\\theta)|^2');
const fClass = tx('\\mathbf{w}=\\mathbf{a}(\\theta_s)');
const fAdapt = tx('\\mathbf{w}=\\mathbf{K}_n^{-1}\\mathbf{a}(\\theta_s)\\,/\\,\\mathbf{a}(\\theta_s)^H\\mathbf{K}_n^{-1}\\mathbf{a}(\\theta_s)');
const fKn = tx('\\mathbf{K}_n');
---
<div class="widget voiw" data-widget="voiw">
  <div class="vhead">
    <div class="vtitle"><b>Que change l'adaptation quand le bruit vient d'une direction ?</b></div>
    <div class="vstats">
      <span class="vcap">gain sur un capteur seul</span>
      <div class="vstat"><span>voies classiques</span><b data-ref="gc"></b></div>
      <div class="vstat"><span>adaptatif</span><b data-ref="ga"></b></div>
    </div>
  </div>
  <div class="vctl"><span>Interférent, sur chaque capteur :</span><span class="vseg" data-ref="seg"></span></div>
  <svg class="voiw-svg" data-ref="svg" role="img" aria-label="Réponse des voies classiques et du traitement adaptatif en fonction du gisement de l'onde reçue"></svg>
  <p class="note">8 capteurs espacés d'une demi-longueur d'onde, raie au gisement 0°, interférent à 21° (sommet du premier lobe secondaire des voies classiques). Courbes : réponse <Fragment set:html={fDiag} /> à une onde venue de θ, avec <Fragment set:html={fClass} /> (voies classiques) ou <Fragment set:html={fAdapt} /> (adaptatif), <Fragment set:html={fKn} /> connue exactement. Gain : rapport signal/bruit en sortie divisé par celui d'un capteur seul, qui reçoit l'interférent en entier.</p>
</div>

<script>
  import { pointage, covarianceExacte, poidsAdaptatif, directivite, gain } from './antenne';

  const C = 8, TS = 0, TI = 21, PLANCHER = -80, PAS = 0.25;
  const dB = (v: number) => 10 * Math.log10(Math.max(v, 1e-30));
  const fr = (v: number, d = 1) => v.toFixed(d).replace('.', ',').replace('-', '−');
  const ETATS = [
    { nom: 'absent', p: 0 },
    { nom: 'égal au bruit', p: 1 },
    { nom: '100 × le bruit', p: 100 },
  ];
  const as = pointage(C, TS);
  const thetas: number[] = [];
  for (let t = -90; t <= 90 + 1e-9; t += PAS) thetas.push(t);
  // états précalculés : poids, diagrammes, gains
  const calc = ETATS.map(({ p }) => {
    const K = covarianceExacte(C, p > 0 ? [{ theta: TI, p }] : []);
    const wa = poidsAdaptatif(K, as)!;
    return {
      p,
      classique: thetas.map((t) => dB(directivite(as, t))),
      adaptatif: thetas.map((t) => dB(directivite(wa, t))),
      gc: dB(gain(as, as, K)), ga: dB(gain(wa, as, K)),
      ic: dB(directivite(as, TI)), ia: dB(directivite(wa, TI)),
    };
  });

  document.querySelectorAll<HTMLElement>('[data-widget="voiw"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    let etat = 2;
    ETATS.forEach((e, i) => {
      const b = document.createElement('button');
      b.textContent = e.nom; b.dataset.v = String(i);
      b.addEventListener('click', () => { etat = i; draw(); });
      $('seg').appendChild(b);
    });
    let etroit = false;
    function draw() {
      $('seg').querySelectorAll('button').forEach((b) => b.classList.toggle('active', +b.dataset.v! === etat));
      const st = calc[etat];
      $('gc').textContent = `${fr(st.gc)} dB`; $('ga').textContent = `${fr(st.ga)} dB`;
      const W = etroit ? 340 : 640, H = etroit ? 280 : 310, ox = 34, top = 38, rm = 12, pw = W - ox - rm, ph = H - top - 36;
      const X = (t: number) => ox + ((t + 90) / 180) * pw, Y = (d: number) => top + (Math.max(PLANCHER, Math.min(0, d)) / PLANCHER) * ph;
      let s = '';
      for (let d = 0; d >= PLANCHER; d -= 20) s += `<line x1="${ox}" y1="${Y(d)}" x2="${ox + pw}" y2="${Y(d)}" stroke="var(--border)" stroke-dasharray="${d === 0 ? '' : '2 4'}"/><text x="${ox - 6}" y="${Y(d) + 3.5}" text-anchor="end" class="ax">${fr(d, 0)}</text>`;
      s += `<text x="${ox - 6}" y="${top - 10}" text-anchor="end" class="ax">dB</text>`;
      for (let t = -90; t <= 90; t += 30) s += `<text x="${X(t)}" y="${top + ph + 18}" text-anchor="middle" class="ax">${fr(t, 0)}°</text>`;
      s += `<text x="${ox + pw / 2}" y="${top + ph + 33}" text-anchor="middle" class="ax">gisement θ de l'onde reçue</text>`;
      // repères : raie (trait fin pointillé), interférent (rouge, plus épais quand il est fort)
      s += `<line x1="${X(TS)}" y1="${top - 4}" x2="${X(TS)}" y2="${top + ph}" stroke="var(--text)" stroke-width="1" stroke-dasharray="3 3"/><text x="${X(TS) - 5}" y="${top - 9}" text-anchor="end" class="lb mk">raie</text>`;
      if (st.p > 0) s += `<line x1="${X(TI)}" y1="${top - 4}" x2="${X(TI)}" y2="${top + ph}" stroke="var(--h-py)" stroke-width="${st.p > 1 ? 2.4 : 1.2}"/><text x="${X(TI) + 5}" y="${top - 9}" class="lb mk" style="fill:var(--h-py);font-weight:600">interférent</text>`;
      const pl = (v: number[]) => v.map((d, i) => `${X(thetas[i]).toFixed(1)},${Y(d).toFixed(1)}`).join(' ');
      // gris large dessous, brun fin dessus : les deux restent visibles quand elles sont confondues
      s += `<polyline points="${pl(st.classique)}" fill="none" stroke="var(--text-2)" stroke-width="4.5" stroke-opacity="0.45" stroke-linejoin="round"/>`;
      s += `<polyline points="${pl(st.adaptatif)}" fill="none" stroke="var(--p-mel)" stroke-width="2" stroke-linejoin="round"/>`;
      // étiquettes des séries, au-dessus du tracé
      s += `<text x="${ox}" y="12" class="lb se" style="fill:var(--text-2);font-weight:600">voies classiques</text>`;
      s += `<text x="${ox + 112}" y="12" class="lb se" style="fill:var(--p-mel);font-weight:600">traitement adaptatif</text>`;
      if (st.p === 0) s += `<text x="${etroit ? ox : ox + 240}" y="${etroit ? 27 : 12}" class="lb se" style="fill:var(--text-2)">courbes confondues</text>`;
      // ce que chaque traitement laisse passer de l'interférent
      if (st.p > 0) {
        s += `<circle cx="${X(TI)}" cy="${Y(st.ic)}" r="3.6" fill="var(--text-2)" stroke="var(--surface)" stroke-width="1"/><text x="${X(TI) + 8}" y="${Y(st.ic) - 7}" class="lb halo va" style="fill:var(--text-2);font-weight:600">${fr(st.ic)} dB</text>`;
        s += `<circle cx="${X(TI)}" cy="${Y(st.ia)}" r="3.6" fill="var(--p-mel)" stroke="var(--surface)" stroke-width="1"/><text x="${X(TI) + 8}" y="${Y(st.ia) + 4}" class="lb halo va" style="fill:var(--p-mel);font-weight:600">${fr(st.ia)} dB</text>`;
      }
      const svg = $('svg') as unknown as SVGSVGElement;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`); svg.innerHTML = s;
    }
    const mesure = () => { const e = root.clientWidth < 520; if (e !== etroit) { etroit = e; draw(); } };
    etroit = root.clientWidth < 520;
    draw();
    new ResizeObserver(mesure).observe(root);
  });
</script>

<style is:global>
  .voiw .vhead { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px 16px; flex-wrap: wrap; margin-bottom: 10px; }
  .voiw .vtitle b { font-size: 15px; font-weight: 600; }
  .voiw .vstats { display: flex; align-items: center; gap: 6px 8px; flex-wrap: wrap; }
  .voiw .vcap { font-size: 12px; color: var(--text-2); }
  .voiw .vstat { display: flex; align-items: baseline; gap: 8px; background: var(--surface-2); border-radius: 8px; padding: 4px 10px; }
  .voiw .vstat span { font-size: 12px; color: var(--text-2); }
  .voiw .vstat b { font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .voiw .vctl { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; margin-bottom: 8px; font-size: 13px; color: var(--text-2); }
  .voiw .vseg { display: inline-flex; flex-wrap: wrap; gap: 6px; }
  .voiw .vseg button { font-size: 13px; padding: 4px 12px; }
  .voiw svg.voiw-svg { width: 100%; height: auto; display: block; margin: 0; }
  .voiw svg.voiw-svg text.ax { font: 11px var(--font); fill: var(--text-2); }
  .voiw svg.voiw-svg text.lb { font: 11.5px var(--font); fill: var(--text); }
  .voiw svg.voiw-svg text.halo { paint-order: stroke; stroke: var(--surface); stroke-width: 3.5px; stroke-linejoin: round; }
</style>
