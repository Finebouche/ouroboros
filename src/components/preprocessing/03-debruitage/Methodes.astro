---
// Chapitre 3 (Preprocessing), section 6 : la référence et les quatre méthodes côte à côte, même mise en forme que les tableaux du cours RL
// (Families.astro, Evaluation.astro : bandes arrondies, petits schémas). Pas de chiffre de performance ici.
// Schémas en gris : ce que la méthode exploite (durée, prévisibilité, direction, exemples).
import katex from 'katex';
const tx = (s: string) => katex.renderToString(s, { throwOnError: false });
type Glyph = 'duree' | 'prev' | 'dir' | 'ex';
const G = 'var(--text-2)';
// chaque schéma tient dans 44 × 18 ; deux schémas se placent côte à côte
const part = (g: Glyph, x0: number) => {
  let o = '';
  if (g === 'duree') for (let k = 0; k < 6; k++) o += `<rect x="${x0 + 1 + k * 7}" y="4" width="5" height="10" rx="1.5" fill="${G}" fill-opacity="${(0.3 + 0.12 * k).toFixed(2)}"/>`;
  if (g === 'prev') {
    const pt = (a: number, b: number) => Array.from({ length: b - a + 1 }, (_, i) => `${(x0 + 1 + (a + i) * 0.7).toFixed(1)},${(9 - 5.5 * Math.sin(((a + i) / 60) * 6 * Math.PI)).toFixed(1)}`).join(' ');
    o += `<polyline points="${pt(0, 40)}" fill="none" stroke="${G}" stroke-width="1.4"/><polyline points="${pt(40, 60)}" fill="none" stroke="${G}" stroke-width="1.4" stroke-dasharray="2.6 2.2"/>`;
  }
  if (g === 'dir') {
    for (let k = 0; k < 5; k++) o += `<circle cx="${x0 + 6 + k * 8}" cy="14.5" r="2.2" fill="${G}"/>`;
    for (let k = 0; k < 3; k++) o += `<line x1="${x0 + 3 + k * 7}" y1="${7.5 - k * 2.4}" x2="${x0 + 25 + k * 7}" y2="${12.3 - k * 2.4}" stroke="${G}" stroke-width="1.1" stroke-opacity="${(0.9 - 0.25 * k).toFixed(2)}"/>`;
  }
  if (g === 'ex') {
    // pile d'essais dont on connaît la vérité (coche)
    for (let k = 2; k >= 0; k--) o += `<rect x="${x0 + 3 + k * 5}" y="${1.5 + k * 2.5}" width="26" height="11" rx="2" fill="var(--surface)" stroke="${G}" stroke-width="1.1"/>`;
    o += `<polyline points="${x0 + 10},7.5 ${x0 + 13.5},10.5 ${x0 + 20.5},4" fill="none" stroke="${G}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`;
  }
  return o;
};
const glyph = (gs: Glyph[]) => `<svg viewBox="0 0 ${gs.length * 48} 18" class="mtgl" style="width:${gs.length * 55}px" aria-hidden="true">${gs.map((g, i) => part(g, i * 48)).join('')}</svg>`;

type Row = { nom: string; sub: string; glyph: Glyph[]; quoi: string; capt: string; appr: string; ecoute: boolean; comment?: string; limite: string };
const rows: Row[] = [
  { nom: 'Périodogramme moyenné', sub: 'référence (Welch)', glyph: ['duree'], quoi: 'la durée', capt: '1', appr: 'rien', ecoute: false,
    limite: 'le temps de détection croît comme l\'inverse du carré du rapport signal sur bruit' },
  { nom: 'Rehausseur de raies adaptatif', sub: 'ALE, en NLMS', glyph: ['prev'], quoi: 'la prévisibilité', capt: '1', appr: `${tx('L')} poids ${tx('\\mathbf{w}')}, adaptés en ligne`, ecoute: true, comment: `la prédiction ${tx('\\hat x(n)')}`,
    limite: 'suit mal une raie qui dérive vite ; ne sépare pas la raie cherchée de celles d\'autres navires' },
  { nom: 'Traitement d\'antenne adaptatif', sub: 'filtre adapté adaptatif (AMF)', glyph: ['dir'], quoi: 'la direction', capt: 'C', appr: `la covariance du bruit ${tx('\\mathbf{K}_n(f)')}, sur les fréquences voisines`, ecoute: false,
    limite: 'il faut plusieurs capteurs et une bonne estimation du bruit entre capteurs' },
  { nom: 'Masque appris, un capteur', sub: 'réservoir', glyph: ['ex'], quoi: 'des exemples', capt: '1', appr: `la lecture ${tx('W_{out}')}, sur des essais synthétiques`, ecoute: true, comment: 'masque appliqué à la TFCT',
    limite: 'écart entre essais synthétiques et réels ; peut inventer des raies s\'il est mal validé' },
  { nom: 'Masque appris, antenne', sub: 'réservoir, filtre spectro-spatial appris', glyph: ['ex', 'dir'], quoi: 'des exemples et la direction', capt: 'C', appr: `la lecture ${tx('W_{out}')}, sur des essais synthétiques`, ecoute: true, comment: 'sur le capteur de référence',
    limite: 'les mêmes ; la géométrie de l\'antenne n\'est pas utilisée' },
];
---
<figure class="mt">
  <div class="mtr mthd">
    <div>méthode</div>
    <div>ce qu'elle exploite</div>
    <div>capteurs</div>
    <div>à estimer ou apprendre</div>
    <div>sortie écoutable</div>
    <div>limite principale</div>
  </div>
  {rows.map((r, i) => (
    <div class={`mtr mtg${i % 2 ? ' alt' : ''}`}>
      <div class="mtn"><b>{r.nom}</b><small>{r.sub}</small></div>
      <div class="mtq"><div set:html={glyph(r.glyph)} /><span>{r.quoi}</span></div>
      <div><i class="mtl">capteurs : </i><span class={`mtp${r.capt === 'C' ? ' on' : ''}`} set:html={r.capt === 'C' ? tx('C') : '1'} /></div>
      <div class="mtt"><i class="mtl">à estimer ou apprendre : </i><span set:html={r.appr} /></div>
      <div class="mte"><i class="mtl">sortie écoutable : </i><span class={`mtp${r.ecoute ? ' on' : ''}`}>{r.ecoute ? 'oui' : 'non'}</span>{r.comment && <small set:html={r.comment} />}</div>
      <div class="mtt"><i class="mtl">limite : </i>{r.limite}</div>
    </div>
  ))}
</figure>

<style is:global>
  .mt { margin: 1.5rem 0; font-family: var(--font); }
  .mt .mtr { display: grid; grid-template-columns: 134px 112px 46px minmax(0, 1fr) 92px minmax(0, 1.2fr); column-gap: 12px; align-items: center; }
  .mt .mthd { padding: 0 14px 8px; font-size: 11.5px; font-weight: 600; color: var(--text); line-height: 1.3; align-items: end; }
  .mt .mtg { border-radius: 8px; background: color-mix(in srgb, var(--text-2) 7%, transparent); padding: 10px 14px; margin-bottom: 6px; }
  .mt .mtg.alt { background: color-mix(in srgb, var(--text-2) 3.5%, transparent); }
  .mt .mtn b { display: block; font-size: 13px; font-weight: 600; color: var(--text); line-height: 1.3; }
  .mt .mtn small { display: block; font-size: 11.5px; color: var(--text-2); margin-top: 2px; line-height: 1.35; }
  .mt .mtgl { display: block; height: auto; margin-bottom: 3px; flex: none; }
  .mt .mtq span { display: block; font-size: 12.5px; color: var(--text); line-height: 1.35; }
  .mt .mtt { font-size: 12.5px; color: var(--text); line-height: 1.45; }
  .mt .mtt .katex, .mt .mte .katex, .mt .mtp .katex { font-size: 1em; }
  .mt .mtp { display: inline-block; font-size: 11.5px; padding: 1px 9px; border-radius: 999px; border: 1px solid var(--border); color: var(--text-2); text-align: center; line-height: 1.5; }
  .mt .mtp.on { color: var(--text); border-color: var(--text-2); }
  .mt .mte small { display: block; font-size: 11.5px; color: var(--text-2); margin-top: 3px; line-height: 1.35; }
  .mt .mtl { display: none; font-style: normal; font-size: 11.5px; color: var(--text-2); }
  @media (max-width: 720px) {
    .mt .mtr { grid-template-columns: 1fr; row-gap: 6px; }
    .mt .mthd { display: none; }
    .mt .mtl { display: inline; }
    .mt .mtq { display: flex; align-items: center; gap: 8px; }
    .mt .mtgl { margin-bottom: 0; }
  }
</style>
