---
// Chapitre 3 (Preprocessing), section 4 : le mécanisme du masque appris, sur de vraies valeurs calculées à la construction (masque.ts).
// Essai de test du widget (fréquences quelconques), raie de +3 dB, 30 premières trames. De haut en bas : un morceau de spectrogramme reçu et
// la case suivie ; ce que le réservoir reçoit pour cette case ; cinq états du réservoir (--r-res) ; le masque sorti par la lecture (--r-out)
// et sa cible, le masque idéal (pointillés --text) ; en bas, d'où vient la cible : P_s et P_b de l'essai synthétique.
// Le modèle est celui du widget (modeleCours('hasard')) : la prédiction affichée est la sienne, pas une cible retouchée.
import katex from 'katex';
import { modeleCours, essaiBanc, essai, tfct, etats, predire, DUR, SEG, BANDE, NIVEAUX, GRAINE_TEST, D_MONO, REGLAGES } from './masque';
const tx = (t: string) => katex.renderToString(t, { throwOnError: false });
const fr = (v: number, d = 2) => v.toFixed(d).replace('.', ',').replace('-', '−');
const n1 = (v: number) => v.toFixed(1);

const NIVEAU = 3, K = 30, DEMI = 4, NEUR = 5;
const m = modeleCours('hasard'), eb = essaiBanc(GRAINE_TEST, NIVEAUX, 'hasard');
const raie = eb.plan.raies.find((r) => r.niveau === NIVEAU)!;
const f = eb.vue.f, X = eb.vue.X;
let kc = 0;
for (let k = 0; k < f.length; k++) if (Math.abs(f[k] - raie.f0) < Math.abs(f[kc] - raie.f0)) kc = k;
const S = tfct(essai(eb.plan.raies, DUR, 7000 + GRAINE_TEST).s, SEG, BANDE[0], BANDE[1]); // la raie seule : même essai que essaiBanc
const Ps = Array.from({ length: K }, (_, t) => S.re[t][kc] ** 2 + S.im[t][kc] ** 2);
const Pb = Array.from({ length: K }, (_, t) => (X.re[t][kc] - S.re[t][kc]) ** 2 + (X.im[t][kc] - S.im[t][kc]) ** 2);
const ideal = Array.from(eb.vue.ideal[kc].slice(0, K));
const U = eb.vue.U[kc], R = etats(m.res, U), pred = Array.from(predire(m, U).slice(0, K));
const feat = (j: number) => Array.from({ length: K }, (_, t) => U[t * D_MONO + 3 + j]); // case centrale : Re z, Im z, log10(|z|² + 10⁻³)
const re = feat(0), im = feat(1), lg = feat(2);
const neur = Array.from({ length: NEUR }, (_, i) => Array.from({ length: K }, (_, t) => R[t * m.res.N + i]));
const spec = Array.from({ length: 2 * DEMI + 1 }, (_, j) => Array.from({ length: K }, (_, t) => { const k = kc + DEMI - j; return 10 * Math.log10(X.re[t][k] ** 2 + X.im[t][k] ** 2 + 1e-12); }));
const mean = (v: number[]) => v.reduce((a, b) => a + b, 0) / v.length;
// trame de l'exemple chiffré : celle dont le masque idéal est le plus proche de sa moyenne
const tEx = ideal.reduce((a, v, t) => (Math.abs(v - mean(ideal)) < Math.abs(ideal[a] - mean(ideal)) ? t : a), 0);
const sub = (b: string, s: string) => `${b}<tspan baseline-shift="sub" font-size="8.5">${s}</tspan>`;

function svg(W: number, narrow: boolean) {
  const ox = 6, rm = 62, pw = W - ox - rm, cw = pw / K, xc = (t: number) => ox + (t + 0.5) * cw;
  const TH = 23; // hauteur d'une ligne de titre
  let y = 0, s = '';
  const title = (html: string, cls = '') => { y += TH; s += `<text x="${ox}" y="${y - 9}" class="tt ${cls}">${html}</text>`; };
  const band = (h: number) => { const y0 = y; y += h + 8; return y0; };
  const scale = (y0: number, h: number, lo: number, hi: number) => (v: number) => y0 + h - ((Math.min(hi, Math.max(lo, v)) - lo) / (hi - lo)) * h;
  const line = (v: number[], Y: (v: number) => number) => v.map((x, t) => `${n1(xc(t))},${n1(Y(x))}`).join(' ');
  const stepd = (v: number[], Y: (v: number) => number) => v.map((x, t) => `${t ? 'L' : 'M'}${n1(ox + t * cw)},${n1(Y(x))}H${n1(ox + (t + 1) * cw)}`).join('');
  const lab = (yy: number, html: string, col: string, w = 400) => (s += `<text x="${ox + pw + 6}" y="${n1(yy + 3.5)}" class="lb" style="fill:${col};font-weight:${w}">${html}</text>`);
  const base = (yy: number) => (s += `<line x1="${ox}" y1="${n1(yy)}" x2="${ox + pw}" y2="${n1(yy)}" stroke="var(--border)"/>`);

  // 1. spectrogramme reçu
  title(narrow ? `<tspan class="k">Reçu</tspan> : ${sub('|X', 'k')}(f)|², 9 cases × ${K} trames` : `<tspan class="k">Spectrogramme reçu</tspan> ${sub('|X', 'k')}(f)|² : 9 cases de ${fr(1 / SEG, 1)} Hz × ${K} trames de ${SEG} s`);
  const rh = 8, ys = band(spec.length * rh);
  spec.forEach((row, j) => row.forEach((v, t) => { const o = Math.min(0.95, Math.max(0, (v + 8) / 18)); if (o > 0.02) s += `<rect x="${n1(ox + t * cw)}" y="${ys + j * rh}" width="${n1(cw - 0.6)}" height="${rh - 0.6}" fill="var(--text-2)" fill-opacity="${o.toFixed(2)}"/>`; }));
  s += `<rect x="${ox - 1.5}" y="${ys + DEMI * rh - 1.5}" width="${n1(pw + 2.4)}" height="${rh + 2.4}" fill="none" stroke="var(--text)" stroke-width="1" stroke-dasharray="2 3"/>`;
  lab(ys + DEMI * rh + rh / 2, 'raie', 'var(--text)');

  // 2. ce que le réservoir reçoit pour la case suivie
  title(narrow ? `↓ <tspan class="k">case suivie</tspan> : 3 des 9 entrées ${sub('u', 'k')}` : `↓ <tspan class="k">case suivie</tspan>, trame par trame : 3 des 9 entrées ${sub('u', 'k')} (les 6 autres : mêmes valeurs pour les deux cases voisines)`);
  const yz = band(34), az = Math.max(...re.map(Math.abs), ...im.map(Math.abs)), Yz = scale(yz, 34, -az, az);
  base(Yz(0));
  s += `<polyline points="${line(re, Yz)}" fill="none" stroke="var(--text-2)" stroke-width="1.5"/><polyline points="${line(im, Yz)}" fill="none" stroke="var(--text-2)" stroke-width="1.5" stroke-dasharray="3 2.5"/>`;
  // étiquettes à droite, avec un échantillon du trait (plein : Re z ; tirets : Im z)
  [['Re z', ''], ['Im z', '3 2.5']].forEach(([t, dash], i) => {
    const yy = yz + 17 + (i ? 8 : -8);
    s += `<line x1="${ox + pw + 6}" y1="${yy}" x2="${ox + pw + 20}" y2="${yy}" stroke="var(--text-2)" stroke-width="1.5" stroke-dasharray="${dash}"/><text x="${ox + pw + 24}" y="${yy + 3.5}" class="lb" style="fill:var(--text-2)">${t}</text>`;
  });
  y -= 4;
  const yl = band(20), Yl = scale(yl, 20, Math.min(...lg), Math.max(...lg));
  s += `<polyline points="${line(lg, Yl)}" fill="none" stroke="var(--text-2)" stroke-width="1.5"/>`;
  lab(yl + 10, 'log |z|²', 'var(--text-2)');

  // 3. états du réservoir
  title(narrow ? `↓ réservoir figé : <tspan class="k res">états ${sub('r', 'k')}</tspan> (${NEUR} sur ${REGLAGES.N})` : `↓ réservoir, ${sub('W', 'in')} et W tirés au hasard et figés : <tspan class="k res">états ${sub('r', 'k')}</tspan> (${NEUR} neurones sur ${REGLAGES.N})`);
  const yr = band(46), ar = Math.max(...neur.flat().map(Math.abs)), Yr = scale(yr, 46, -ar, ar);
  base(Yr(0));
  neur.forEach((v) => (s += `<polyline points="${line(v, Yr)}" fill="none" stroke="var(--r-res)" stroke-width="1.3" stroke-opacity="0.85"/>`));

  // 4. masque prédit et cible
  title(narrow ? `↓ lecture ${sub('W', 'out')} : <tspan class="k out">masque ${sub('m', 'k')}</tspan>, moyenne ${fr(mean(pred))}` : `↓ lecture ${sub('W', 'out')}, entraînée : <tspan class="k out">masque ${sub('m', 'k')}</tspan> (moyenne sur les trames : ${fr(mean(pred))}) ; pointillés : la cible ${sub('m*', 'k')} (moyenne ${fr(mean(ideal))})`);
  const ym = band(60), Ym = scale(ym, 60, -0.15, 1);
  const y4 = ym;
  base(Ym(0));
  s += `<line x1="${ox}" y1="${n1(Ym(1))}" x2="${ox + pw}" y2="${n1(Ym(1))}" stroke="var(--border)" stroke-dasharray="2 4"/>`;
  s += `<path d="${stepd(ideal, Ym)}" fill="none" stroke="var(--text)" stroke-width="1.2" stroke-dasharray="2.5 2.5" stroke-opacity="0.85"/>`;
  s += `<polyline points="${line(pred, Ym)}" fill="none" stroke="var(--r-out)" stroke-width="2"/>`;
  pred.forEach((v, t) => (s += `<circle cx="${n1(xc(t))}" cy="${n1(Ym(v))}" r="2.2" fill="var(--r-out)"/>`));
  lab(Ym(1), '1', 'var(--text-2)'); lab(Ym(0), '0', 'var(--text-2)');

  // 5. d'où vient la cible
  title(narrow ? `↑ cible ${sub('m*', 'k')} = ${sub('P', 's')} / (${sub('P', 's')} + ${sub('P', 'b')})` : `↑ cible ${sub('m*', 'k')} = ${sub('P', 's')} / (${sub('P', 's')} + ${sub('P', 'b')}), calculée sur l'essai synthétique : raie seule ${sub('P', 's')} (trait), bruit ${sub('P', 'b')} (barres)`);
  const hp = 50, yp = band(hp), top = Math.min(8, Math.max(...Pb, ...Ps)), Yp = scale(yp, hp, 0, top);
  Pb.forEach((v, t) => (s += `<rect x="${n1(ox + t * cw + 1)}" y="${n1(Yp(v))}" width="${n1(cw - 2)}" height="${n1(yp + hp - Yp(v))}" fill="var(--text-2)" fill-opacity="0.4"/>`));
  s += `<path d="${stepd(Ps, Yp)}" fill="none" stroke="var(--text)" stroke-width="1.6"/>`;
  base(yp + hp);
  lab(Yp(Ps[K - 1]), sub('P', 's'), 'var(--text)');
  // la trame de l'exemple chiffré, encadrée sur les bandes 4 et 5
  [[y4 - 2, 64], [yp - 2, hp + 2]].forEach(([yy, h]) => (s += `<rect x="${n1(ox + tEx * cw)}" y="${yy}" width="${n1(cw)}" height="${h}" fill="none" stroke="var(--text)" stroke-width="1" rx="2"/>`));
  // axe des trames
  [1, 10, 20, 30].forEach((k) => (s += `<text x="${n1(xc(k - 1))}" y="${yp + hp + 14}" text-anchor="middle" class="ax">${k}</text>`));
  s += `<text x="${ox + pw + 6}" y="${yp + hp + 14}" class="ax">trame k</text>`;
  return { vb: `0 0 ${W} ${yp + hp + 20}`, s };
}
const LAYOUTS = [{ cls: 'mqf-wide', ...svg(680, false) }, { cls: 'mqf-narrow', ...svg(360, true) }];
const exemple = tx(`m^\\star = \\dfrac{${fr(Ps[tEx])}}{${fr(Ps[tEx])} + ${fr(Pb[tEx])}} = ${fr(ideal[tEx])}`);
---
<figure class="mqf">
  {LAYOUTS.map((L) => (
    <svg class={`mqf-svg ${L.cls}`} viewBox={L.vb} role="img" aria-label="Du spectrogramme au masque : une case suivie trame par trame, ses caractéristiques, les états du réservoir, le masque prédit et sa cible" set:html={L.s} />
  ))}
  <figcaption>Essai de test, raie de +{NIVEAU} dB à {fr(raie.f0, 1)} Hz ; puissances en unité de bruit moyen. Trame encadrée (trame {tEx + 1}) : <Fragment set:html={exemple} />.</figcaption>
</figure>

<style is:global>
  .mqf { margin: 1.5rem 0; }
  .mqf .mqf-svg { width: 100%; height: auto; display: block; margin: 0 auto; }
  .mqf .mqf-narrow { display: none; max-width: 420px; }
  @media (max-width: 600px) { .mqf .mqf-wide { display: none; } .mqf .mqf-narrow { display: block; } }
  .mqf .mqf-svg text.tt { font: 11.5px var(--font); fill: var(--text-2); }
  .mqf .mqf-svg text.tt .k { font-weight: 600; fill: var(--text); }
  .mqf .mqf-svg text.tt .k.res { fill: var(--r-res); }
  .mqf .mqf-svg text.tt .k.out { fill: var(--r-out); }
  .mqf .mqf-svg text.lb { font: 11px var(--font); }
  .mqf .mqf-svg text.ax { font: 11px var(--font); fill: var(--text-2); }
  .mqf figcaption .katex { font-size: 1em; }
</style>
