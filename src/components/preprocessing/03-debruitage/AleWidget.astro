---
// Chapitre 3, section 2 : la raie ressort-elle mieux après le rehausseur de raies adaptatif ? Périodogramme moyenné de l'entrée x (gris,
// la référence) et de la sortie x̂ (brun) autour de la raie, pour un essai ; sur chaque courbe, en pointillé, le niveau que le pic doit dépasser
// pour que la raie soit détectée (médiane de l'anneau + seuil des témoins). Un bouton par niveau de raie et par longueur L ; δ et μ fixés.
// Essai : 60 s de bruit blanc + une raie à F0 = 150,1 Hz, graine 4 : le même que celui d'IntegrationWidget (mêmes niveaux, même bruit).
// États calculés au build (etatsAle). Seuils, probabilités de détection et AUC : BANC_ALE (200 essais, calculé hors ligne par bancAle, ale.ts).
// Vérifié (scratchpad ale-v2/banc.ts, recalcul du 13 novembre 2026, identique à BANC_ALE) avec ces réglages, T = 60 s : l'AUC de la sortie
// ne dépasse celle de l'entrée dans aucun des 9 états (+6 dB : 1,00 partout ; −3 dB : 0,95 ; 0,96 ; 0,98 contre 1,00 ; −12 dB : 0,59 ; 0,54 ; 0,60
// contre 0,67). Le tirage affiché peut contredire la tendance (−12 dB, L = 128 : sortie détectée, entrée non) : d'où les probabilités.
import katex from 'katex';
import { F0, SEG, DUR } from './reference';
import { etatsAle, ALE_LS, ALE_DELTA, ALE_MU, BANC_ALE, BANC_N } from './ale';
const tex = (s: string) => katex.renderToString(s, { throwOnError: false });
const fm = (v: number, d = 1) => v.toFixed(d).replace('.', ',').replace('-', '−');
const NIV = [6, -3, -12], SEED = 4, SPAN = 10, T = 60;
const E = etatsAle(NIV, F0, SEG, DUR, SEED, SPAN);
const r2 = (v: number) => +v.toFixed(2);
const banc = NIV.map((n) => ALE_LS.map((L) => {
  const b = BANC_ALE[`${n}|${L}`].find((r) => r.T === T)!;
  return { aucX: b.aucX, aucY: b.aucY, seuilX: b.seuilX, seuilY: b.seuilY, detX: b.detX, detY: b.detY };
}));
const data = {
  f: E.f, f0: F0, span: SPAN, NIV, LS: ALE_LS,
  x: E.x.map((e) => ({ S: e.S, c: r2(e.c), ref: r2(e.ref) })),
  y: E.y.map((row) => row.map((e) => ({ S: e.S, c: r2(e.c), ref: r2(e.ref) }))),
  banc,
};
const regle = tex('\\text{détectée si } c(f_0) > \\text{seuil}');
---
<div class="widget pp alew" data-widget="alew" data-etats={JSON.stringify(data)}>
  <div class="fhead">
    <div class="ftitle"><b>La raie ressort-elle mieux après le filtre ?</b></div>
    <div class="fstat"><span>AUC, {BANC_N} essais</span><span class="x">entrée <b data-ref="ax"></b></span><span class="y">sortie <b data-ref="ay"></b></span></div>
  </div>
  <div class="ctl">
    <div class="row"><span>Raie</span><span class="seg" data-ref="niv"></span></div>
    <div class="row"><span>Filtre</span><span class="seg" data-ref="L"></span></div>
  </div>
  <svg data-ref="svg" data-alew role="img" aria-label="Périodogrammes moyennés de l'entrée et de la sortie du rehausseur autour de la raie, en dB, avec pour chacun le niveau que le pic doit dépasser"></svg>
  <div class="calc">
    <div class="rg" set:html={regle} />
    <div class="ln x"><span class="nm">entrée <span set:html={tex('x')} /></span><span>cet essai : <b data-ref="cx"></b> contre <b data-ref="sx"></b>, <span data-ref="vx"></span></span><span>probabilité de détection : <b data-ref="dx"></b></span></div>
    <div class="ln y"><span class="nm">sortie <span set:html={tex('\\hat x')} /></span><span>cet essai : <b data-ref="cy"></b> contre <b data-ref="sy"></b>, <span data-ref="vy"></span></span><span>probabilité de détection : <b data-ref="dy"></b></span></div>
  </div>
  <p class="note">Un essai de {DUR} s, raie à {fm(F0)} Hz ; <span set:html={tex(`\\delta = ${ALE_DELTA}`)} />, <span set:html={tex(`\\mu = ${String(ALE_MU).replace('.', '{,}')}`)} />, poids nuls au départ ; trames de {SEG} s. Seuil (dépassé par 5 % des fréquences sans raie), détection et AUC : {BANC_N} essais de {DUR} s, 5 raies et 5 fréquences témoins par essai.</p>
</div>

<script>
  type Etat = { S: number[]; c: number; ref: number };
  type Banc = { aucX: number; aucY: number; seuilX: number; seuilY: number; detX: number; detY: number };
  type Data = { f: number[]; f0: number; span: number; NIV: number[]; LS: number[]; x: Etat[]; y: Etat[][]; banc: Banc[][] };
  document.querySelectorAll<HTMLElement>('[data-widget="alew"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const D = JSON.parse(root.dataset.etats!) as Data;
    const fm = (v: number, d = 1) => v.toFixed(d).replace('.', ',').replace('-', '−');
    const db = (n: number) => `${n > 0 ? '+' : n < 0 ? '−' : ''}${Math.abs(n)} dB`;
    let iN = 1, iL = 1;
    const mk = (ref: string, labs: string[], set: (i: number) => void) => labs.forEach((t, i) => { const b = document.createElement('button'); b.textContent = t; b.dataset.v = String(i); b.addEventListener('click', () => { set(i); draw(); }); $(ref).appendChild(b); });
    mk('niv', D.NIV.map(db), (i) => (iN = i));
    mk('L', D.LS.map((L) => `${L} poids`), (i) => (iL = i));
    const svg = $('svg') as unknown as SVGSVGElement;
    const LO = -26, HI = 16; // axe vertical fixe (dB re niveau moyen du bruit)
    const med = (v: number[]) => { const s = [...v].sort((a, b) => a - b); return (s[(s.length - 1) >> 1] + s[s.length >> 1]) / 2; };

    function draw() {
      $('niv').querySelectorAll('button').forEach((b) => b.classList.toggle('active', +b.dataset.v! === iN));
      $('L').querySelectorAll('button').forEach((b) => b.classList.toggle('active', +b.dataset.v! === iL));
      const ex = D.x[iN], ey = D.y[iN][iL], bc = D.banc[iN][iL];
      $('ax').textContent = fm(bc.aucX, 2); $('ay').textContent = fm(bc.aucY, 2);
      $('cx').textContent = `${fm(ex.c)} dB`; $('sx').textContent = `${fm(bc.seuilX)} dB`; $('vx').textContent = ex.c > bc.seuilX ? 'détectée' : 'manquée';
      $('cy').textContent = `${fm(ey.c)} dB`; $('sy').textContent = `${fm(bc.seuilY)} dB`; $('vy').textContent = ey.c > bc.seuilY ? 'détectée' : 'manquée';
      $('dx').textContent = `${Math.round(bc.detX * 100)} %`; $('dy').textContent = `${Math.round(bc.detY * 100)} %`;

      const W = Math.max(300, Math.round(svg.clientWidth || 640)), etroit = W < 520;
      const H = etroit ? 260 : 290, ox = 44, rm = etroit ? 58 : 76, oy = 22, pw = W - ox - rm, ph = H - oy - 36;
      const X = (f: number) => ox + ((f - D.f0 + D.span) / (2 * D.span)) * pw, Y = (v: number) => oy + (1 - (Math.max(LO, Math.min(HI, v)) - LO) / (HI - LO)) * ph;
      const it = (t: string) => `<tspan font-style="italic">${t}</tspan>`;
      let s = '';
      [-20, -10, 10].forEach((v) => (s += `<line x1="${ox}" y1="${Y(v)}" x2="${ox + pw}" y2="${Y(v)}" stroke="var(--border)" stroke-dasharray="2 4"/>`));
      [-20, -10, 0, 10].forEach((v) => (s += `<text x="${ox - 6}" y="${Y(v) + 3.5}" text-anchor="end" class="ax">${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v)} dB</text>`));
      s += `<line x1="${ox}" y1="${Y(0)}" x2="${ox + pw}" y2="${Y(0)}" stroke="var(--border)"/>`;
      s += `<line x1="${ox}" y1="${oy + ph}" x2="${ox + pw}" y2="${oy + ph}" stroke="var(--border)"/>`;
      for (let v = Math.ceil((D.f0 - D.span) / 5) * 5; v <= D.f0 + D.span; v += 5) s += `<line x1="${X(v).toFixed(1)}" y1="${oy + ph}" x2="${X(v).toFixed(1)}" y2="${oy + ph + 4}" stroke="var(--text-2)"/><text x="${X(v).toFixed(1)}" y="${oy + ph + 16}" text-anchor="middle" class="ax">${v}</text>`;
      s += `<text x="${ox + pw / 2}" y="${H - 3}" text-anchor="middle" class="ax">fréquence (Hz)</text>`;
      // la raie : repère pointillé
      const xf = X(D.f0);
      s += `<line x1="${xf.toFixed(1)}" y1="${oy}" x2="${xf.toFixed(1)}" y2="${oy + ph}" stroke="var(--text)" stroke-width="1" stroke-dasharray="2 3"/>`;
      s += `<text x="${(xf - 6).toFixed(1)}" y="${oy - 8}" text-anchor="end" class="lb">raie ${it('f')}<tspan dy="3" font-size="8">0</tspan></text>`;
      // les deux spectres
      const pl = (S: number[]) => D.f.map((f, k) => `${X(f).toFixed(1)},${Y(S[k]).toFixed(1)}`).join(' ');
      s += `<polyline points="${pl(ex.S)}" fill="none" stroke="var(--text-2)" stroke-width="1.5" stroke-linejoin="round"/>`;
      s += `<polyline points="${pl(ey.S)}" fill="none" stroke="var(--p-mel)" stroke-width="2.2" stroke-linejoin="round"/>`;
      // niveau à dépasser : médiane de l'anneau (|f − f0| ≤ 3 Hz) + seuil des témoins, tracé sur l'anneau
      const x0 = X(D.f0 - 3), x1 = X(D.f0 + 3);
      const seuil = (lvl: number, cls: string) => {
        const y = Y(lvl).toFixed(1);
        s += `<line x1="${x0.toFixed(1)}" y1="${y}" x2="${x1.toFixed(1)}" y2="${y}" class="sl ${cls}"/>`;
        s += `<text x="${(x1 + 5).toFixed(1)}" y="${(+y + 4).toFixed(1)}" class="lb h ${cls}">seuil</text>`;
      };
      seuil(ex.ref + bc.seuilX, 'g');
      seuil(ey.ref + bc.seuilY, 'm');
      // étiquettes directes à droite, à la hauteur du fond de chaque courbe
      const xl = ox + pw + 8;
      s += `<text x="${xl}" y="${(Y(med(ex.S)) + 4).toFixed(1)}" class="lb g">entrée ${it('x')}</text>`;
      s += `<text x="${xl}" y="${(Y(med(ey.S)) + 4).toFixed(1)}" class="lb m">sortie ${it('x̂')}</text>`;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.innerHTML = s;
    }
    draw();
    new ResizeObserver(() => draw()).observe(svg);
  });
</script>

<style is:global>
  .alew .fhead { line-height: 1.4; display: flex; justify-content: space-between; align-items: flex-start; gap: 8px 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .alew .ftitle b { font-size: 15px; font-weight: 600; margin-right: 10px; }
  .alew .fstat { display: flex; align-items: baseline; flex-wrap: wrap; gap: 2px 12px; background: var(--surface-2); border-radius: 8px; padding: 4px 10px; }
  .alew .fstat > span { font-size: 12px; color: var(--text-2); white-space: nowrap; }
  .alew .fstat b { font-size: 14px; font-weight: 600; margin-left: 2px; }
  .alew .fstat .x b { color: var(--text-2); }
  .alew .fstat .y b { color: var(--p-mel); }
  .alew .ctl .katex, .alew .note .katex, .alew .calc .katex { font-size: 1em; }
  .alew .ctl { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 28px; margin-bottom: 6px; }
  .alew .ctl .row { margin: 0; font-size: 13px; }
  .alew .seg { display: inline-flex; flex-wrap: wrap; gap: 6px; }
  .alew .seg button { font-size: 13px; padding: 4px 10px; }
  .alew svg[data-alew] { display: block; width: 100%; height: auto; margin: 0; }
  .alew svg[data-alew] text.ax { font: 11px var(--font); fill: var(--text-2); }
  .alew svg[data-alew] text.lb { font: 11.5px var(--font); fill: var(--text); }
  .alew svg[data-alew] text.lb.g { fill: var(--text-2); }
  .alew svg[data-alew] text.lb.m { fill: var(--p-mel); font-weight: 600; }
  .alew svg[data-alew] text.lb.h { paint-order: stroke; stroke: var(--surface); stroke-width: 3px; stroke-linejoin: round; }
  .alew svg[data-alew] line.sl { stroke-width: 1.6; stroke-dasharray: 5 3; }
  .alew svg[data-alew] line.sl.g { stroke: var(--text-2); }
  .alew svg[data-alew] line.sl.m { stroke: var(--p-mel); }
  .alew .calc { margin-top: 8px; padding: 6px 10px; border-radius: 8px; background: color-mix(in srgb, var(--surface-2) 70%, transparent); font-size: 13px; display: grid; gap: 2px; }
  .alew .calc .rg { color: var(--text); margin-bottom: 2px; }
  .alew .calc .ln { display: flex; flex-wrap: wrap; gap: 0 18px; color: var(--text-2); }
  .alew .calc .nm { min-width: 5.2em; font-weight: 600; }
  .alew .calc .ln.y .nm, .alew .calc .ln.y b { color: var(--p-mel); }
  .alew .calc b { font-weight: 600; color: var(--text); }
  .alew .calc .ln.x b { color: var(--text-2); }
</style>
