---
// Chapitre 3 (Preprocessing), section 5 : ce que l'antenne apporte au réservoir. Petites figures répétées, sur deux essais simulés (masque.ts),
// 8 capteurs, une raie de +6 dB à 150 Hz venue du gisement −30°, graine 1 :
//  - essai 1, bruit indépendant entre capteurs : case de la raie (150 Hz) et case de bruit seul (155 Hz) ;
//  - essai 2, même raie, bruit dont 80 % de la puissance vient d'un interférent (retard d'un échantillon par capteur, soit le gisement +30°) :
//    case de bruit seul (155 Hz).
// Pour quatre capteurs i, les interspectres comprimés z_{i,j} z_{0,j}* / √|z_{i,j} z_{0,j}*| des 12 premières trames j (les valeurs que reçoit
// le réservoir, caracAntenne) sont dessinés en phaseurs ; trait épais : leur moyenne. Pointillés --text : phase attendue pour la raie,
// −2π f0 τ_i ; pointillés --h-py : phase attendue pour l'interférent à 155 Hz, −2π · 155 · i / fs.
// Vérifié sur 200 graines (scratchpad reservoir-v2/demodstat.ts), longueur de la moyenne rapportée à la longueur moyenne des traits :
// case de la raie 0,91 (7° de la phase attendue) ; bruit indépendant 0,28 ; bruit avec interférent 0,81 (8° de la phase de l'interférent).
import { essaiAntenne, caracAntenne, tfct, dAntenne, PAS_CAPTEUR, C_SON, SEG, REF } from './masque';
import { FS } from './raies';

const C = 8, F0 = 150, F_BRUIT = 155, NIVEAU = 6, GISEMENT = -30, K = 12, CAPTEURS = [1, 2, 3, 4], GRAINE = 1, PART = 0.8, RETARD = 1;
const D = dAntenne(C), nx = 2 * (C - 1);
const caracs = (part: number) => {
  const e = essaiAntenne([{ f0: F0, niveau: NIVEAU }], 16, GRAINE, { C, gisement: GISEMENT, interferent: part ? { part, retard: RETARD } : undefined });
  const Xs = e.x.map((x) => tfct(x, SEG, 140, 165));
  return { U: caracAntenne(Xs, REF), kase: (f: number) => Math.round((f - Xs[0].f[0]) / Xs[0].df) };
};
const sans = caracs(0), avec = caracs(PART);
// interspectre comprimé du capteur i avec la référence (REF = 0), trame t : indice i − 1 parmi les « autres capteurs »
const phaseurs = (U: Float64Array[], k: number, i: number) => Array.from({ length: K }, (_, t) => [U[k][t * D + C + (i - 1)], U[k][t * D + C + nx + (i - 1)]]);
const moy = (p: number[][]) => [p.reduce((s, v) => s + v[0], 0) / p.length, p.reduce((s, v) => s + v[1], 0) / p.length];
const attRaie = (i: number) => -2 * Math.PI * F0 * ((i * PAS_CAPTEUR * Math.sin((GISEMENT * Math.PI) / 180)) / C_SON);
const attInter = (i: number) => (-2 * Math.PI * F_BRUIT * i * RETARD) / FS;
const rows = [
  { titre: 'case de la raie', sous: `${F0} Hz`, src: sans, k: sans.kase(F0), inter: false },
  { titre: 'case de bruit', sous: `${F_BRUIT} Hz`, src: sans, k: sans.kase(F_BRUIT), inter: false },
  { titre: 'case de bruit', sous: 'avec un interférent', src: avec, k: avec.kase(F_BRUIT), inter: true },
].map((r) => ({ ...r, dials: CAPTEURS.map((i) => { const p = phaseurs(r.src.U, r.k, i), m = moy(p); return { i, p, m }; }) }));
const AMAX = 3.2; // amplitude au bord du cadran (au-delà, le trait est tronqué au bord : sa direction reste juste)
const n1 = (v: number) => v.toFixed(1);
const fr = (v: number, d = 1) => v.toFixed(d).replace('.', ',').replace('-', '−');
const sub = (b: string, s: string) => `${b}<tspan baseline-shift="sub" font-size="8.5">${s}</tspan>`;

function svg(W: number, narrow: boolean) {
  const lab = narrow ? 0 : 128, cw = (W - lab) / CAPTEURS.length, Rd = Math.min(cw / 2 - 8, 50), top = 30, rh = 2 * Rd + (narrow ? 50 : 34);
  const H = top + rows.length * rh;
  let s = '';
  CAPTEURS.forEach((i, j) => (s += `<text x="${lab + (j + 0.5) * cw}" y="14" text-anchor="middle" class="hd">${sub('z', `${i},j`)} ${sub('z', '0,j')}*</text>`));
  rows.forEach((r, q) => {
    const y0 = top + q * rh + (narrow ? 18 : 0), cy = y0 + Rd;
    if (narrow) s += `<text x="4" y="${y0 - 6}" class="rt"><tspan font-weight="600">${r.titre}</tspan> (${r.sous})</text>`;
    else s += `<text x="0" y="${cy - 3}" class="rt" font-weight="600">${r.titre}</text><text x="0" y="${cy + 13}" class="rs">${r.sous}</text>`;
    r.dials.forEach((d, j) => {
      const cx = lab + (j + 0.5) * cw, px = (a: number) => (Math.min(AMAX, a) / AMAX) * Rd;
      const tip = ([re, im]: number[]) => { const a = Math.hypot(re, im), g = a > 0 ? px(a) / a : 0; return [cx + re * g, cy - im * g]; };
      const rayon = (ph: number, col: string) => `<line x1="${n1(cx)}" y1="${cy}" x2="${n1(cx + Rd * Math.cos(ph))}" y2="${n1(cy - Rd * Math.sin(ph))}" stroke="${col}" stroke-width="1.2" stroke-dasharray="2 3"/>`;
      s += `<circle cx="${n1(cx)}" cy="${cy}" r="${n1(Rd)}" fill="none" stroke="var(--border)"/>`;
      s += `<line x1="${n1(cx - Rd)}" y1="${cy}" x2="${n1(cx + Rd)}" y2="${cy}" stroke="var(--border)" stroke-dasharray="2 4"/><line x1="${n1(cx)}" y1="${cy - Rd}" x2="${n1(cx)}" y2="${cy + Rd}" stroke="var(--border)" stroke-dasharray="2 4"/>`;
      if (q !== 1) s += rayon(attRaie(d.i), 'var(--text)');
      if (r.inter) s += rayon(attInter(d.i), 'var(--h-py)');
      d.p.forEach((v) => { const [x, y] = tip(v); s += `<line x1="${n1(cx)}" y1="${cy}" x2="${n1(x)}" y2="${n1(y)}" stroke="var(--text-2)" stroke-width="1" stroke-opacity="0.55"/><circle cx="${n1(x)}" cy="${n1(y)}" r="1.7" fill="var(--text-2)"/>`; });
      // moyenne des K trames : trait épais et pointe
      const [mx, my] = tip(d.m), l = Math.hypot(mx - cx, my - cy);
      if (l > 1) {
        const ux = (mx - cx) / l, uy = (my - cy) / l, h = Math.min(7, l * 0.6), bx = mx - ux * h, by = my - uy * h, w = h * 0.5;
        s += `<line x1="${n1(cx)}" y1="${cy}" x2="${n1(bx)}" y2="${n1(by)}" stroke="var(--text-2)" stroke-width="3.2" stroke-linecap="round"/><polygon points="${n1(mx)},${n1(my)} ${n1(bx - uy * w)},${n1(by + ux * w)} ${n1(bx + uy * w)},${n1(by - ux * w)}" fill="var(--text-2)"/>`;
      }
      s += `<circle cx="${n1(cx)}" cy="${cy}" r="2" fill="var(--text-2)"/>`;
      s += `<text x="${n1(cx)}" y="${cy + Rd + 14}" text-anchor="middle" class="vl">moyenne : ${fr(Math.hypot(d.m[0], d.m[1]))}</text>`;
    });
  });
  return { vb: `0 0 ${W} ${H}`, s };
}
const LAYOUTS = [{ cls: 'phf-wide', ...svg(660, false) }, { cls: 'phf-narrow', ...svg(360, true) }];
---
<figure class="phf">
  {LAYOUTS.map((L) => (
    <svg class={`phf-svg ${L.cls}`} viewBox={L.vb} role="img" aria-label="Phase entre capteurs, trame par trame : stable et dans la direction de la raie dans sa case ; au hasard dans une case de bruit indépendant ; stable mais dans la direction de l'interférent dans une case de bruit qui vient d'une direction" set:html={L.s} />
  ))}
  <figcaption>Un trait fin par trame ({K} trames de {SEG} s), trait épais : leur moyenne. Pointillés : phase attendue pour la raie (gisement {fr(GISEMENT, 0)}°) ; rouge : pour l'interférent ({fr(PART * 100, 0)} % du bruit, gisement +30°). Raie de +{NIVEAU} dB.</figcaption>
</figure>

<style is:global>
  .phf { margin: 1.5rem 0; }
  .phf .phf-svg { width: 100%; height: auto; display: block; margin: 0 auto; }
  .phf .phf-wide { max-width: 660px; }
  .phf .phf-narrow { display: none; max-width: 420px; }
  @media (max-width: 600px) { .phf .phf-wide { display: none; } .phf .phf-narrow { display: block; } }
  .phf .phf-svg text.hd { font: 11.5px var(--font); fill: var(--text); }
  .phf .phf-svg text.rt { font: 12.5px var(--font); fill: var(--text); }
  .phf .phf-svg text.rs { font: 11.5px var(--font); fill: var(--text-2); }
  .phf .phf-svg text.vl { font: 11px var(--font); fill: var(--text-2); }
</style>
