---
// Chapitre 3 (Preprocessing), section 4 : le masque appris par un réservoir (un capteur) contre le périodogramme moyenné, à trames égales (2 s).
// AUC raies contre témoins en fonction de la durée d'observation T : périodogramme en gris (la référence), masque moyen prédit en --r-out.
// Réglage principal : fréquence des raies quelconque ou au centre d'une case (un modèle entraîné pour chaque cas) ; second réglage : le niveau
// de la raie (tous : moyenne des six niveaux −12 à +3 dB ; ou −9, −6, −3 dB). Valeurs : MESURES (masque.ts), 300 essais de test par cas,
// recalculées le 13/11/2026 avec le même code (scratchpad reservoir-v2/mono.ts, analyse.ts) : identiques.
// Écart masque − périodogramme (bootstrap apparié sur les essais, intervalle à 95 %), tous niveaux :
//   quelconque : −0,048 [−0,059 ; −0,037] à 5 s … −0,035 [−0,042 ; −0,028] à 60 s ; le masque est derrière dans les 36 cas (durée × niveau) ;
//   centrée : −0,022 [−0,036 ; −0,007] à 5 s, +0,011 [0,000 ; 0,022] à 10 s, puis +0,031 à +0,038 de 20 à 60 s (intervalles hors de 0).
import { MESURES, NIVEAUX, DUREES, SEG, REGLAGES, N_ENTRAINEMENT, type Cas } from './masque';
const CAS: Cas[] = ['hasard', 'centre'];
const NIV = [-9, -6, -3]; // niveaux proposés en plus de « tous »
const r3 = (v: number) => Math.round(v * 1000) / 1000;
const moyNiv = (t: number[][]) => t.map((row) => r3(row.reduce((a, b) => a + b, 0) / row.length));
const courbes = (t: number[][]) => [moyNiv(t), ...NIV.map((n) => t.map((row) => row[NIVEAUX.indexOf(n)]))];
const payload = JSON.stringify({ T: DUREES, niv: NIV, cas: CAS.map((c) => ({ w: courbes(MESURES[c].periodogramme.auc), p: courbes(MESURES[c].masque.auc) })) });
const n = MESURES.hasard.n;
---
<div class="widget pp mqw" data-widget="mqw" data-payload={payload}>
  <div class="fhead">
    <div class="ftitle"><b>Le masque appris voit-il la raie plus tôt que le périodogramme ?</b><span>AUC raies contre témoins, {n} essais de test</span></div>
    <div class="fstat"><span>AUC moyenne</span><span>périodogramme <b data-ref="aw"></b></span><span>masque <b class="out" data-ref="ap"></b></span></div>
  </div>
  <div class="ctl">
    <div class="row"><span>Fréquence des raies</span><span class="seg" data-ref="cas"></span></div>
    <div class="row"><span>Niveau</span><span class="seg" data-ref="niv"></span></div>
  </div>
  <svg data-ref="svg" data-mqw role="img" aria-label="AUC en fonction de la durée d'observation, pour le périodogramme moyenné et pour le masque appris"></svg>
  <p class="note">Trames de {SEG} s pour les deux méthodes. Réservoir de {REGLAGES.N} neurones, lecture entraînée sur {N_ENTRAINEMENT} essais synthétiques. AUC : 0,5 = hasard, 1 = la raie passe toujours devant les témoins.</p>
</div>

<script>
  type Data = { T: number[]; niv: number[]; cas: { w: number[][]; p: number[][] }[] };
  document.querySelectorAll<HTMLElement>('[data-widget="mqw"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const D = JSON.parse(root.dataset.payload!) as Data;
    const fr = (v: number, d = 2) => v.toFixed(d).replace('.', ',').replace('-', '−');
    const st = { cas: 0, niv: 0 };
    const mk = (ref: 'cas' | 'niv', labels: string[]) => labels.forEach((t, i) => {
      const b = document.createElement('button'); b.type = 'button'; b.textContent = t; b.dataset.v = String(i);
      b.addEventListener('click', () => { st[ref] = i; draw(); }); $(ref).appendChild(b);
    });
    mk('cas', ['quelconque', 'au centre d\'une case']);
    mk('niv', ['tous', ...D.niv.map((v) => `−${Math.abs(v)} dB`)]);
    const svg = $('svg') as unknown as SVGSVGElement;
    const GRIS = 'var(--text-2)', OUT = 'var(--r-out)';
    const moy = (v: number[]) => v.reduce((a, b) => a + b, 0) / v.length;

    function draw() {
      (['cas', 'niv'] as const).forEach((r) => $(r).querySelectorAll('button').forEach((b) => b.classList.toggle('active', +b.dataset.v! === st[r])));
      const c = D.cas[st.cas], w = c.w[st.niv], p = c.p[st.niv];
      $('aw').textContent = fr(moy(w));
      $('ap').textContent = fr(moy(p));
      // le viewBox prend la largeur affichée : le texte garde sa taille sur mobile
      const W = Math.max(300, Math.min(680, Math.round(svg.getBoundingClientRect().width) || 640)), narrow = W < 480;
      const ox = 34, rm = narrow ? 102 : 112, top = 14, ph = narrow ? 170 : 190, pw = W - ox - rm, H = top + ph + 36;
      const X = (T: number) => ox + (T / 60) * pw, Y = (v: number) => top + ph - ((Math.min(1, Math.max(0.5, v)) - 0.5) / 0.5) * ph;
      let s = '';
      [0.5, 0.6, 0.7, 0.8, 0.9, 1].forEach((v) => (s += `<line x1="${ox}" y1="${Y(v).toFixed(1)}" x2="${ox + pw}" y2="${Y(v).toFixed(1)}" stroke="var(--border)" stroke-dasharray="${v === 0.5 ? '' : '2 4'}"/><text x="${ox - 5}" y="${(Y(v) + 3.5).toFixed(1)}" text-anchor="end" class="ax">${v === 1 ? '1' : fr(v, 1)}</text>`));
      [0, 10, 20, 30, 40, 50, 60].forEach((T) => (s += `<text x="${X(T).toFixed(1)}" y="${top + ph + 14}" text-anchor="middle" class="ax">${T}</text>`));
      s += `<text x="${(ox + pw / 2).toFixed(1)}" y="${top + ph + 30}" text-anchor="middle" class="ax">durée d'observation T (s)</text>`;
      const serie = (v: number[], col: string, sw: number) => {
        s += `<polyline points="${v.map((a, i) => `${X(D.T[i]).toFixed(1)},${Y(a).toFixed(1)}`).join(' ')}" fill="none" stroke="${col}" stroke-width="${sw}" stroke-linejoin="round"/>`;
        v.forEach((a, i) => (s += `<circle cx="${X(D.T[i]).toFixed(1)}" cy="${Y(a).toFixed(1)}" r="3" fill="${col}"/>`));
      };
      serie(w, GRIS, 2); serie(p, OUT, 2.4);
      // étiquettes directes au bout des courbes, écartées d'au moins 15 px
      let yw = Y(w[w.length - 1]), yp = Y(p[p.length - 1]);
      if (Math.abs(yw - yp) < 15) { const m = (yw + yp) / 2, sg = yw <= yp ? -1 : 1; yw = m + sg * 7.5; yp = m - sg * 7.5; }
      const xl = ox + pw + 8;
      s += `<text x="${xl}" y="${(yw + 4).toFixed(1)}" class="lb" style="fill:${GRIS}">périodogramme</text>`;
      s += `<text x="${xl}" y="${(yp + 4).toFixed(1)}" class="lb" style="fill:${OUT};font-weight:600">masque appris</text>`;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.innerHTML = s;
    }
    let was = root.clientWidth;
    new ResizeObserver(() => { const now = root.clientWidth; if (Math.abs(now - was) > 8) { was = now; draw(); } }).observe(root);
    draw();
  });
</script>

<style is:global>
  .mqw .fhead { line-height: 1.4; display: flex; justify-content: space-between; align-items: flex-start; gap: 8px 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .mqw .ftitle { flex: 1 1 280px; }
  .mqw .ftitle b { display: block; font-size: 15px; font-weight: 600; }
  .mqw .ftitle > span { font-size: 12.5px; color: var(--text-2); }
  .mqw .fstat { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 12px; background: var(--surface-2); border-radius: 8px; padding: 4px 10px; }
  .mqw .fstat > span { font-size: 12px; color: var(--text-2); white-space: nowrap; }
  .mqw .fstat b { font-size: 14px; font-weight: 600; color: var(--text); margin-left: 4px; }
  .mqw .fstat b.out { color: var(--r-out); }
  .mqw .ctl { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 20px; margin-bottom: 6px; }
  .mqw .ctl .row { margin: 0; font-size: 13px; }
  .mqw .seg { display: inline-flex; flex-wrap: wrap; gap: 6px; }
  .mqw .seg button { font-size: 13px; padding: 4px 9px; }
  .mqw .ctl .row { gap: 8px; }
  .mqw svg[data-mqw] { display: block; width: 100%; height: auto; margin: 0; }
  .mqw svg[data-mqw] text.ax { font: 11px var(--font); fill: var(--text-2); }
  .mqw svg[data-mqw] text.lb { font: 11.5px var(--font); }
</style>
