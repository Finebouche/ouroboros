---
// Chapitre 3 (Preprocessing), section 4 : le masque appris par un réservoir (un capteur) contre le périodogramme moyenné, à trames égales (2 s).
// Un vrai petit modèle est entraîné à la construction du site (masque.ts : 100 neurones, lecture ridge, 24 essais synthétiques), une fois avec des
// raies de fréquence quelconque, une fois avec des raies au centre d'une case. Le tracé montre un essai de test jamais vu (six raies, une par
// niveau), zoomé sur la raie choisie : périodogramme moyenné (brun, ce que produit la référence), masque moyen prédit (violet, sortie de la
// lecture), masque idéal moyen (pointillés). Dans chaque tracé : médiane de l'anneau (trait fin), maximum dans la fenêtre de la raie (point) et
// seuil de détection à 5 % de fausses alarmes (tirets gris). Pastilles : AUC raies contre témoins. AUC et seuils sont mesurés hors ligne
// sur MESURES[cas].n essais de test (masque.ts).
import katex from 'katex';
import { modeleCours, essaiBanc, masque, moyenne, periodogramme, contraste, nTrames, DUREES, NIVEAUX, GRAINE_TEST, HW, SEG, MESURES, REGLAGES, N_ENTRAINEMENT, type Cas } from './masque';
const tx = (t: string) => katex.renderToString(t, { throwOnError: false });
const fr = (v: number, d = 2) => v.toFixed(d).replace('.', ',').replace('-', '−');
const CAS: Cas[] = ['hasard', 'centre'];
const DEMI = 8; // cases affichées de part et d'autre de la raie (±4 Hz)
const med = (v: number[]) => { const s = [...v].sort((a, b) => a - b), m = s.length >> 1; return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2; };
const r3 = (v: number) => Math.round(v * 1000) / 1000;
const data = CAS.map((cas) => {
  const m = modeleCours(cas), e = essaiBanc(GRAINE_TEST, NIVEAUX, cas), M = masque(m, e.vue), f = e.vue.f;
  return NIVEAUX.map((niv) => {
    const raie = e.plan.raies.find((r) => r.niveau === niv)!;
    let kc = 0;
    for (let k = 0; k < f.length; k++) if (Math.abs(f[k] - raie.f0) < Math.abs(f[kc] - raie.f0)) kc = k;
    const ks = Array.from({ length: 2 * DEMI + 1 }, (_, j) => kc - DEMI + j);
    const anneau = ks.filter((k) => { const d = Math.abs(f[k] - raie.f0); return d >= HW + 0.25 && d <= 3; });
    const fen = ks.filter((k) => Math.abs(f[k] - raie.f0) <= HW);
    return {
      f0: r3(raie.f0), fa: f[ks[0]], fen: fen.map((k) => k - ks[0]), anneau: anneau.map((k) => k - ks[0]),
      T: DUREES.map((T) => {
        const n = nTrames(T), S = periodogramme(e.vue.X, n), P = moyenne(M, n), I = moyenne(e.vue.ideal, n);
        const ref = med(anneau.map((k) => S[k]));
        return {
          w: ks.map((k) => r3(10 * Math.log10(S[k] / ref))), p: ks.map((k) => r3(P[k])), i: ks.map((k) => r3(I[k])), rp: r3(med(anneau.map((k) => P[k]))),
          cw: r3(contraste(f, S, raie.f0, 'ratio', HW)), cp: r3(contraste(f, P, raie.f0, 'diff', HW)),
        };
      }),
    };
  });
});
const aucs = CAS.map((cas) => ({ w: MESURES[cas].periodogramme.auc, p: MESURES[cas].masque.auc, sw: MESURES[cas].periodogramme.seuil, sp: MESURES[cas].masque.seuil }));
const payload = JSON.stringify({ data, aucs, T: DUREES, niv: NIVEAUX, trames: DUREES.map((T) => nTrames(T)), df: 1 / SEG });
const g = REGLAGES;
---
<div class="widget mqw" data-widget="mqw" data-payload={payload}>
  <div class="mqhead">
    <div class="mqtitle"><b>Le masque appris voit-il la raie plus tôt que le périodogramme ?</b><span data-ref="sub"></span></div>
    <div class="mqstats">
      <span class="mqcap">AUC raies contre témoins, {MESURES.hasard.n} essais de test</span>
      <div class="mqstat"><span>périodogramme</span><b data-ref="aw"></b></div>
      <div class="mqstat"><span>masque appris</span><b data-ref="ap"></b></div>
    </div>
  </div>
  <div class="mqctl">
    <div><span>Durée <Fragment set:html={tx('T')} /> (s)</span><span class="mqseg" data-ref="T"></span></div>
    <div><span>Niveau de la raie (dB)</span><span class="mqseg" data-ref="niv"></span></div>
    <div><span>Fréquence des raies</span><span class="mqseg" data-ref="cas"></span></div>
  </div>
  <svg class="mqw-svg" data-ref="svg" role="img" aria-label="Périodogramme moyenné et masque moyen prédit autour de la raie, pour la durée et le niveau choisis"></svg>
  <p class="note">Un essai de test jamais vu, six raies (une par niveau, en dB re bruit dans 1 Hz), trames de {SEG} s. Point : maximum dans la fenêtre de la raie, plein s'il dépasse le seuil (5 % de fausses alarmes sur les témoins). Réservoir de {g.N} neurones, lecture ridge entraînée sur {N_ENTRAINEMENT} essais synthétiques.</p>
</div>

<script>
  type Pt = { w: number[]; p: number[]; i: number[]; rp: number; cw: number; cp: number };
  type Raie = { f0: number; fa: number; fen: number[]; anneau: number[]; T: Pt[] };
  document.querySelectorAll<HTMLElement>('[data-widget="mqw"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const P = JSON.parse(root.dataset.payload!) as { data: Raie[][]; aucs: { w: number[][]; p: number[][]; sw: number[]; sp: number[] }[]; T: number[]; niv: number[]; trames: number[]; df: number };
    const fr = (v: number, d = 2) => v.toFixed(d).replace('.', ',').replace('-', '−');
    const sg = (v: number, d = 0) => (v > 0 ? '+' : '') + fr(v, d);
    const st = { T: 2, niv: 3, cas: 0 };
    const mk = (ref: 'T' | 'niv' | 'cas', labels: string[]) => labels.forEach((t, i) => {
      const b = document.createElement('button'); b.type = 'button'; b.textContent = t; b.dataset.v = String(i);
      b.addEventListener('click', () => { st[ref] = i; draw(); }); $(ref).appendChild(b);
    });
    mk('T', P.T.map(String)); mk('niv', P.niv.map((v) => sg(v))); mk('cas', ['quelconque', 'au centre d\'une case']);
    const WAVE = 'var(--p-mel)', OUT = 'var(--r-out)';

    function draw() {
      (['T', 'niv', 'cas'] as const).forEach((r) => $(r).querySelectorAll('button').forEach((b) => b.classList.toggle('active', +b.dataset.v! === st[r])));
      const R = P.data[st.cas][st.niv], d = R.T[st.T], n = d.w.length;
      $('sub').textContent = `${P.trames[st.T]} trames de ${fr(1 / P.df, 0)} s, raie à ${fr(R.f0, 1)} Hz`;
      $('aw').textContent = fr(P.aucs[st.cas].w[st.T][st.niv]);
      $('ap').textContent = fr(P.aucs[st.cas].p[st.T][st.niv]);
      const narrow = root.clientWidth < 560;
      // mise en page étroite : le viewBox prend la largeur affichée, le texte garde sa taille
      const W = narrow ? Math.max(300, Math.round($('svg').getBoundingClientRect().width) || 340) : 640, ox = 34, rm = 40, pw = W - ox - rm, ph = narrow ? 96 : 104, y1 = 24, y2 = y1 + ph + 34, H = y2 + ph + 36;
      const fa = R.fa - P.df / 2, fb = R.fa + (n - 0.5) * P.df;
      const X = (f: number) => ox + ((f - fa) / (fb - fa)) * pw;
      const panel = (y0: number, lo: number, hi: number) => (v: number) => y0 + ph - ((Math.min(hi, Math.max(lo, v)) - lo) / (hi - lo)) * ph;
      const Yw = panel(y1, -4, 9), Yp = panel(y2, -0.1, 0.8);
      const step = (v: number[], Y: (v: number) => number) => v.map((x, k) => `${k ? 'L' : 'M'}${X(R.fa + (k - 0.5) * P.df).toFixed(1)},${Y(x).toFixed(1)}H${X(R.fa + (k + 0.5) * P.df).toFixed(1)}`).join('');
      let s = '';
      // cadres et graduations
      const axes = (y0: number, Y: (v: number) => number, ticks: number[], unit: string) => {
        s += `<line x1="${ox}" y1="${y0 + ph}" x2="${ox + pw}" y2="${y0 + ph}" stroke="var(--border)"/>`;
        ticks.forEach((v) => (s += `<line x1="${ox}" y1="${Y(v).toFixed(1)}" x2="${ox + pw}" y2="${Y(v).toFixed(1)}" stroke="var(--border)" stroke-dasharray="${v === 0 ? '' : '2 4'}"/><text x="${ox - 5}" y="${(Y(v) + 3.5).toFixed(1)}" text-anchor="end" class="ax">${fr(v, v % 1 ? 1 : 0)}${unit}</text>`));
      };
      axes(y1, Yw, [0, 4, 8], '');
      axes(y2, Yp, [0, 0.5], '');
      // médiane de l'anneau (référence du contraste) : trait fin sur les cases de l'anneau
      const ring = (Y: (v: number) => number, v: number, col: string) => {
        const runs: number[][] = [];
        R.anneau.forEach((k) => { const last = runs[runs.length - 1]; if (last && last[1] === k - 1) last[1] = k; else runs.push([k, k]); });
        runs.forEach(([a, b]) => (s += `<line x1="${X(R.fa + (a - 0.5) * P.df).toFixed(1)}" y1="${Y(v).toFixed(1)}" x2="${X(R.fa + (b + 0.5) * P.df).toFixed(1)}" y2="${Y(v).toFixed(1)}" stroke="${col}" stroke-width="1" stroke-opacity="0.55"/>`));
      };
      ring(Yw, 0, WAVE); ring(Yp, d.rp, OUT);
      // la raie : repère vertical
      s += `<line x1="${X(R.f0).toFixed(1)}" y1="${y1 - 4}" x2="${X(R.f0).toFixed(1)}" y2="${y2 + ph}" stroke="var(--text)" stroke-width="1" stroke-dasharray="2 3"/>`;
      s += `<text x="${X(R.f0).toFixed(1)}" y="${y1 - 9}" text-anchor="middle" class="lb" style="fill:var(--text)">raie</text>`;
      // séries
      s += `<path d="${step(d.w, Yw)}" fill="none" stroke="${WAVE}" stroke-width="2" stroke-linejoin="round"/>`;
      s += `<path d="${step(d.i, Yp)}" fill="none" stroke="var(--text)" stroke-width="1.2" stroke-dasharray="3 3" stroke-opacity="0.8"/>`;
      s += `<path d="${step(d.p, Yp)}" fill="none" stroke="${OUT}" stroke-width="2.4" stroke-linejoin="round"/>`;
      // seuil de détection : médiane de l'anneau + contraste dépassé par 5 % des témoins
      const A = P.aucs[st.cas], sw = A.sw[st.T], sp = A.sp[st.T];
      const seuil = (Y: (v: number) => number, v: number) => (s += `<line x1="${ox}" y1="${Y(v).toFixed(1)}" x2="${ox + pw}" y2="${Y(v).toFixed(1)}" stroke="var(--text-2)" stroke-width="1" stroke-dasharray="5 3"/><text x="${ox + pw + 5}" y="${(Y(v) + 3.5).toFixed(1)}" class="ax">seuil</text>`);
      seuil(Yw, sw); seuil(Yp, d.rp + sp);
      // maximum dans la fenêtre de la raie : le contraste est l'écart entre ce point et la médiane de l'anneau ; point plein s'il dépasse le seuil
      const top = (v: number[]) => R.fen.reduce((a, k) => (v[k] > v[a] ? k : a), R.fen[0]);
      const kw = top(d.w), kp = top(d.p);
      const dot = (x: number, y: number, col: string, plein: boolean) => (s += `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="3.6" fill="${plein ? col : 'var(--surface)'}" stroke="${col}" stroke-width="1.8"/>`);
      dot(X(R.fa + kw * P.df), Yw(d.w[kw]), WAVE, d.cw > sw);
      dot(X(R.fa + kp * P.df), Yp(d.p[kp]), OUT, d.cp > sp);
      // rangée d'étiquettes au-dessus de chaque tracé
      const cmp = (c: number, t: number) => (c > t ? '>' : '<');
      s += `<text x="${ox}" y="${y1 - 9}" class="lb" style="fill:${WAVE};font-weight:600">${narrow ? 'périodogramme' : 'périodogramme moyenné, dB re anneau'}</text>`;
      s += `<text x="${W - 4}" y="${y1 - 9}" text-anchor="end" class="lb" style="fill:${WAVE}">${narrow ? '' : 'contraste '}${sg(d.cw, 1)} dB ${cmp(d.cw, sw)} seuil ${fr(sw, 1)}</text>`;
      s += `<text x="${ox}" y="${y2 - 9}" class="lb" style="fill:${OUT};font-weight:600">${narrow ? 'masque prédit' : 'masque moyen prédit'}</text>`;
      // masque idéal : étiquette dans la rangée (large) ou dans le coin du tracé (étroit), hors du repère de la raie
      const xi = narrow ? ox + 4 : ox + 136, yi = narrow ? y2 + 12 : y2 - 9;
      s += `<line x1="${xi}" y1="${yi - 4}" x2="${xi + 16}" y2="${yi - 4}" stroke="var(--text)" stroke-width="1.2" stroke-dasharray="3 3"/><text x="${xi + 20}" y="${yi}" class="lb" style="fill:var(--text)">masque idéal</text>`;
      s += `<text x="${W - 4}" y="${y2 - 9}" text-anchor="end" class="lb" style="fill:${OUT}">${narrow ? '' : 'contraste '}${sg(d.cp, 2)} ${cmp(d.cp, sp)} seuil ${fr(sp, 2)}</text>`;
      // axe des fréquences
      for (let k = 0; k < n; k++) { const f = R.fa + k * P.df; if (Math.abs(f - Math.round(f)) < 1e-6 && (!narrow || Math.round(f) % 2 === 0)) s += `<text x="${X(f).toFixed(1)}" y="${y2 + ph + 14}" text-anchor="middle" class="ax">${Math.round(f)}</text>`; }
      s += `<text x="${ox + pw / 2}" y="${y2 + ph + 30}" text-anchor="middle" class="ax">fréquence (Hz), une marche par case de ${fr(P.df, 1)} Hz</text>`;
      const svg = $('svg') as unknown as SVGSVGElement;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.innerHTML = s;
    }
    let was = root.clientWidth;
    new ResizeObserver(() => { const now = root.clientWidth; if (now !== was && (now < 560 || was < 560)) draw(); was = now; }).observe(root);
    draw();
  });
</script>

<style is:global>
  .mqw .mqhead { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px 16px; flex-wrap: wrap; margin-bottom: 10px; }
  .mqw .mqtitle { flex: 1 1 260px; }
  .mqw .mqtitle b { display: block; font-size: 15px; font-weight: 600; line-height: 1.35; }
  .mqw .mqtitle span { font-size: 12.5px; color: var(--text-2); }
  .mqw .mqstats { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; justify-content: flex-end; max-width: 330px; }
  .mqw .mqcap { flex: 1 0 100%; font-size: 12px; color: var(--text-2); text-align: right; }
  .mqw .mqstat { display: flex; align-items: baseline; gap: 8px; background: var(--surface-2); border-radius: 8px; padding: 4px 10px; }
  .mqw .mqstat span { font-size: 12px; color: var(--text-2); }
  .mqw .mqstat b { font-size: 14px; font-weight: 600; }
  .mqw .mqctl { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-bottom: 10px; font-size: 13px; color: var(--text-2); }
  .mqw .mqctl > div { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; }
  .mqw .mqctl .katex { font-size: 1em; }
  .mqw .mqseg { display: inline-flex; flex-wrap: wrap; gap: 5px; }
  .mqw .mqseg button { font-size: 13px; padding: 4px 9px; min-width: 34px; }
  .mqw .mqw-svg { width: 100%; height: auto; display: block; margin: 0; }
  .mqw .mqw-svg text.ax { font: 11px var(--font); fill: var(--text-2); }
  .mqw .mqw-svg text.lb { font: 11.5px var(--font); }
  .mqw .note .katex { font-size: 1em; }
  @media (max-width: 600px) { .mqw .mqstats { justify-content: flex-start; max-width: none; } .mqw .mqcap { text-align: left; } }
</style>
