---
// Chapitre 3, introduction : la chaîne commune à toutes les méthodes. essai x(n) → méthode → spectre de détection S(f) → contraste c(f0) → décision.
// Tout est calculé au build sur un vrai essai (raies.ts) : 60 s de bruit blanc + une raie à F0 = 150,1 Hz de niveau 0 dB re bruit dans 1 Hz, graine 4.
// La méthode dessinée est la référence (périodogramme moyenné, trames de 4 s, T = 60 s). Fenêtre et anneau : réglages par défaut de contraste().
// Témoins : 20 fréquences sans raie du même essai (F0 ± 5 j Hz, j = 1 à 10), même mesure.
// Vérifié (scratchpad reference/sim6.ts) : contraste de la raie 5,9 dB ; témoins entre −0,4 et 2,1 dB.
import katex from 'katex';
import { FS, essai, contraste } from './raies';
import { F0, SEG, DUR, HW, GARDE, OUTER, welchCumul, termesContraste, dB } from './reference';
const tex = (s: string) => katex.renderToString(s, { throwOnError: false });
const fm = (v: number, d = 1) => v.toFixed(d).replace('.', ',').replace('-', '−');
const NIVEAU = 0, SEED = 4;
const e = essai([{ f0: F0, niveau: NIVEAU }], DUR, SEED);
const W = welchCumul(e.x, SEG, [DUR], F0 - 54, F0 + 54), S = W.S[0];
const t = termesContraste(W.f, S, F0);
const temoins = Array.from({ length: 20 }, (_, i) => F0 + 5 * (i < 10 ? i - 10 : i - 9)).map((f) => contraste(W.f, S, f));
const f0s = `<tspan font-style="italic">f</tspan><tspan dy="3" font-size="8">0</tspan><tspan dy="-3">`; // à refermer par </tspan>
const H = 190, top = 18, bot = 30, ph = H - top - bot;

// --- 1. l'essai : 100 ms de x(n), et la raie seule s(n) à la même échelle ---
const W1 = 150, N1 = Math.round(0.1 * FS), sc = 14, yx = top + 3.3 * sc, ys = H - 44;
const X1 = (i: number) => 4 + (i / (N1 - 1)) * (W1 - 8);
const line = (v: ArrayLike<number>, y0: number) => Array.from({ length: N1 }, (_, i) => `${X1(i).toFixed(1)},${(y0 - Math.max(-3.3, Math.min(3.3, v[i])) * sc).toFixed(1)}`).join(' ');
const p1 = `<polyline points="${line(e.x, yx)}" fill="none" stroke="var(--p-wave)" stroke-width="1.1" stroke-linejoin="round"/>` +
  `<polyline points="${line(e.s, ys)}" fill="none" stroke="var(--text)" stroke-width="1.1"/>` +
  `<text x="4" y="${ys + 18}" class="lb">la raie seule <tspan font-style="italic">s</tspan>(<tspan font-style="italic">n</tspan>),</text><text x="4" y="${ys + 32}" class="lb">à la même échelle</text>`;

// --- 3. le spectre de détection autour de f0 : fenêtre, anneau, pic, médiane, contraste ---
const W3 = 330, l3 = 34, r3 = 72, pw3 = W3 - l3 - r3, SPAN = 3.6;
const idx = Array.from(W.f, (f, k) => k).filter((k) => Math.abs(W.f[k] - F0) <= SPAN + 1e-9);
const d3 = idx.map((k) => dB(S[k])), picDb = dB(t.pic), refDb = dB(t.ref);
const lo3 = Math.floor(Math.min(...d3)) - 1, hi3 = Math.ceil(picDb + 1.2);
const X3 = (f: number) => l3 + ((f - F0 + SPAN) / (2 * SPAN)) * pw3, Y3 = (v: number) => top + (1 - (v - lo3) / (hi3 - lo3)) * ph;
const zone = (a: number, b: number, cls: string) => `<rect x="${X3(F0 + a).toFixed(1)}" y="${top}" width="${(X3(F0 + b) - X3(F0 + a)).toFixed(1)}" height="${ph}" class="${cls}"/>`;
const xa = X3(F0 + HW + GARDE / 2); // la flèche du contraste, dans la garde à droite de la fenêtre
let p3 = zone(-OUTER, -HW - GARDE, 'an') + zone(HW + GARDE, OUTER, 'an') + zone(-HW, HW, 'fe');
p3 += [0, 5].filter((v) => v > lo3 && v < hi3).map((v) => `<text x="${l3 - 6}" y="${Y3(v) + 3.5}" text-anchor="end" class="ax">${v} dB</text>`).join('');
p3 += `<line x1="${l3}" y1="${top + ph}" x2="${l3 + pw3}" y2="${top + ph}" stroke="var(--border)"/>`;
p3 += `<line x1="${X3(F0)}" y1="${top}" x2="${X3(F0)}" y2="${top + ph + 4}" stroke="var(--text)" stroke-width="1" stroke-dasharray="2 3"/>`;
p3 += `<line x1="${X3(F0 - OUTER)}" y1="${Y3(refDb).toFixed(1)}" x2="${l3 + pw3 + 4}" y2="${Y3(refDb).toFixed(1)}" stroke="var(--text-2)" stroke-width="1.2" stroke-dasharray="5 3"/>`;
p3 += `<polyline points="${idx.map((k, i) => `${X3(W.f[k]).toFixed(1)},${Y3(d3[i]).toFixed(1)}`).join(' ')}" fill="none" stroke="var(--p-mel)" stroke-width="1.8" stroke-linejoin="round"/>`;
p3 += idx.map((k, i) => `<circle cx="${X3(W.f[k]).toFixed(1)}" cy="${Y3(d3[i]).toFixed(1)}" r="1.9" fill="var(--p-mel)"/>`).join('');
p3 += `<circle cx="${X3(t.fpic).toFixed(1)}" cy="${Y3(picDb).toFixed(1)}" r="4.2" fill="none" stroke="var(--text)" stroke-width="1.3"/>`;
p3 += `<text x="${(X3(t.fpic) - 8).toFixed(1)}" y="${(Y3(picDb) + 4).toFixed(1)}" text-anchor="end" class="lb k">pic</text>`;
p3 += `<line x1="${(X3(t.fpic) + 4.2).toFixed(1)}" y1="${Y3(picDb).toFixed(1)}" x2="${(xa + 4).toFixed(1)}" y2="${Y3(picDb).toFixed(1)}" stroke="var(--text)" stroke-width="1"/>`;
p3 += `<line x1="${xa.toFixed(1)}" y1="${(Y3(picDb) + 1).toFixed(1)}" x2="${xa.toFixed(1)}" y2="${(Y3(refDb) - 1).toFixed(1)}" stroke="var(--text)" stroke-width="1.4"/>`;
p3 += `<path d="M${(xa - 3.2).toFixed(1)},${(Y3(picDb) + 6).toFixed(1)} L${xa.toFixed(1)},${(Y3(picDb) + 1).toFixed(1)} L${(xa + 3.2).toFixed(1)},${(Y3(picDb) + 6).toFixed(1)} M${(xa - 3.2).toFixed(1)},${(Y3(refDb) - 6).toFixed(1)} L${xa.toFixed(1)},${(Y3(refDb) - 1).toFixed(1)} L${(xa + 3.2).toFixed(1)},${(Y3(refDb) - 6).toFixed(1)}" fill="none" stroke="var(--text)" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"/>`;
const yc = (Y3(picDb) + Y3(refDb)) / 2;
p3 += `<text x="${(xa + 9).toFixed(1)}" y="${(yc - 3).toFixed(1)}" class="lb k">contraste</text><text x="${(xa + 9).toFixed(1)}" y="${(yc + 11).toFixed(1)}" class="lb"><tspan font-style="italic">c</tspan>(${f0s})</tspan> = ${fm(t.c)} dB</text>`;
p3 += `<text x="${X3(F0).toFixed(1)}" y="${top - 5}" text-anchor="middle" class="lb">fenêtre</text>`;
p3 += [-1, 1].map((sg) => `<text x="${X3(F0 + sg * (OUTER + HW + GARDE) / 2).toFixed(1)}" y="${top + 13}" text-anchor="middle" class="lb g">anneau</text>`).join('');
p3 += `<text x="${l3 + pw3 + 7}" y="${(Y3(refDb) - 3).toFixed(1)}" class="lb g">médiane</text><text x="${l3 + pw3 + 7}" y="${(Y3(refDb) + 11).toFixed(1)}" class="lb g">de l'anneau</text>`;
p3 += `<text x="${X3(F0).toFixed(1)}" y="${top + ph + 16}" text-anchor="middle" class="ax t">${f0s}</tspan></text>`;
p3 += [-OUTER, OUTER].map((v) => `<line x1="${X3(F0 + v).toFixed(1)}" y1="${top + ph}" x2="${X3(F0 + v).toFixed(1)}" y2="${top + ph + 4}" stroke="var(--text-2)"/><text x="${X3(F0 + v).toFixed(1)}" y="${top + ph + 16}" text-anchor="middle" class="ax">${v > 0 ? '+' : '−'}${Math.abs(v)} Hz</text>`).join('');

// --- 4. la décision : contraste de la raie contre ceux des témoins (essaim de points, même axe) ---
const W4 = 164, l4 = 34, cx = 62, R = 3.1;
const lo4 = Math.floor(Math.min(...temoins, 0)) - 0.5, hi4 = Math.ceil(t.c + 0.6);
const Y4 = (v: number) => top + (1 - (v - lo4) / (hi4 - lo4)) * ph;
// essaim : chaque point prend la position horizontale libre la plus proche du centre
const placed: { x: number; y: number }[] = [];
[...temoins].sort((a, b) => a - b).forEach((v) => {
  const y = Y4(v);
  for (let s = 0; ; s++) { const x = cx + (s % 2 ? 1 : -1) * Math.ceil(s / 2) * (R + 0.6); if (placed.every((p) => (p.x - x) ** 2 + (p.y - y) ** 2 >= (2 * R + 0.8) ** 2)) { placed.push({ x, y }); break; } }
});
const med4 = [...temoins].sort((a, b) => a - b)[10], xr = Math.max(...placed.map((p) => p.x)) + R + 6;
let p4 = [0, 2, 4, 6].filter((v) => v > lo4 && v < hi4).map((v) => `<line x1="${l4}" y1="${Y4(v)}" x2="${W4 - 4}" y2="${Y4(v)}" stroke="var(--border)" stroke-dasharray="${v ? '2 4' : ''}"/><text x="${l4 - 6}" y="${Y4(v) + 3.5}" text-anchor="end" class="ax">${v} dB</text>`).join('');
p4 += placed.map((p) => `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="${R}" fill="var(--text-2)" fill-opacity="0.5"/>`).join('');
p4 += `<circle cx="${cx}" cy="${Y4(t.c).toFixed(1)}" r="4.4" fill="var(--text)"/>`;
p4 += `<text x="${cx + 10}" y="${(Y4(t.c) + 4).toFixed(1)}" class="lb k">raie ${f0s}</tspan></text>`;
p4 += `<text x="${xr.toFixed(1)}" y="${(Y4(med4) - 3).toFixed(1)}" class="lb g">${temoins.length} témoins</text><text x="${xr.toFixed(1)}" y="${(Y4(med4) + 11).toFixed(1)}" class="lb g">sans raie</text>`;
const aria = `Chaîne de détection : un essai, une méthode, un spectre de détection où le contraste de la fréquence f0 vaut ${fm(t.c)} dB, puis la comparaison aux contrastes de ${temoins.length} fréquences témoins.`;
---
<figure class="chnf" role="group" aria-label={aria}>
  <div class="chn">
    <div class="pan p1"><div class="pt">un essai <span set:html={tex('x(n)')} /></div><svg viewBox={`0 0 ${W1} ${H}`} data-chnf set:html={p1} /></div>
    <div class="fl" aria-hidden="true"></div>
    <div class="pan p2"><div class="pt">&nbsp;</div><div class="bx"><b>méthode</b><span>ici : Welch</span></div></div>
    <div class="fl dn" aria-hidden="true"></div>
    <div class="pan p3"><div class="pt">spectre de détection <span set:html={tex('S(f)')} /></div><svg viewBox={`0 0 ${W3} ${H}`} data-chnf set:html={p3} /></div>
    <div class="fl dn" aria-hidden="true"></div>
    <div class="pan p4"><div class="pt">décision : contraste</div><svg viewBox={`0 0 ${W4} ${H}`} data-chnf set:html={p4} /></div>
  </div>
  <figcaption>Essai : {DUR} s de bruit blanc et une raie à {fm(F0)} Hz, de niveau {NIVEAU} dB re bruit dans 1 Hz ; 100 ms tracées. Méthode : ici le périodogramme moyenné (Welch), trames de {SEG} s. Fenêtre : à {fm(HW)} Hz de <span set:html={tex('f_0')} /> au plus ; anneau : de {fm(HW + GARDE, 2)} à {OUTER} Hz. Témoins : {temoins.length} fréquences sans raie du même essai, tous les 5 Hz.</figcaption>
</figure>

<style is:global>
  .chnf { margin: 1.5rem 0; }
  .chnf .chn { display: grid; grid-template-columns: 150fr 22px 96fr 22px 330fr 22px 164fr; align-items: start; }
  .chnf .pan { min-width: 0; }
  .chnf .pt { font-size: 12.5px; font-weight: 600; line-height: 1.3; margin-bottom: 2px; white-space: nowrap; }
  .chnf .pt .katex { font-size: 1em; }
  .chnf svg[data-chnf] { display: block; width: 100%; height: auto; }
  .chnf svg[data-chnf] text.ax { font: 11px var(--font); fill: var(--text-2); }
  .chnf svg[data-chnf] text.ax.t { fill: var(--text); font-size: 12px; }
  .chnf svg[data-chnf] text.lb { font: 11.5px var(--font); fill: var(--text); }
  .chnf svg[data-chnf] text.lb.g { fill: var(--text-2); }
  .chnf svg[data-chnf] text.lb.k { font-weight: 600; }
  .chnf svg[data-chnf] rect.an { fill: color-mix(in srgb, var(--text-2) 13%, transparent); }
  .chnf svg[data-chnf] rect.fe { fill: color-mix(in srgb, var(--text) 5%, transparent); stroke: var(--text); stroke-width: 1; stroke-dasharray: 2 3; }
  .chnf .fl { align-self: center; text-align: center; color: var(--text-2); font-size: 17px; line-height: 1; }
  .chnf .fl::before { content: '→'; }
  .chnf .p2 { align-self: stretch; display: flex; flex-direction: column; }
  .chnf .bx { margin: auto 0; border: 1.5px solid var(--text-2); border-radius: 8px; background: var(--surface); padding: 14px 4px; text-align: center; line-height: 1.3; }
  .chnf .bx b { display: block; font-size: 13px; font-weight: 600; }
  .chnf .bx span { display: block; font-size: 11.5px; color: var(--text-2); }
  @media (max-width: 720px) {
    .chnf .chn { grid-template-columns: 150px 22px minmax(0, 1fr); row-gap: 4px; max-width: 400px; margin: 0 auto; }
    .chnf .fl.dn, .chnf .p3, .chnf .p4 { grid-column: 1 / -1; }
    .chnf .fl.dn::before { content: '↓'; }
    .chnf .p4 { width: 164px; margin: 0 auto; }
  }
</style>
