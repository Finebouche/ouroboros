---
// Chapitre 2 : le signal arrive un pas après l'autre ; à chaque pas, les n = 8 coefficients de Legendre sont mis à jour par m ← A_d m + B_d u.
// Haut : le signal (la partie déjà arrivée en trait plein), la fenêtre des θ = 100 derniers pas, et sa reconstruction (brun) avec les coefficients du moment.
// Bas : une petite courbe par coefficient, qui se trace au fil du temps (échelle verticale propre à chaque coefficient, fixée sur tout le signal).
// Animation lancée par le bouton « lecture » (jamais au chargement de la page) ; les boutons de pas permettent d'avancer à la main.
const NMAX = 8;
---
<div class="widget lgs pp" data-widget="lgs">
  <div class="row">
    <button data-ref="play">▶ lecture</button>
    <button data-ref="prev">◀ pas</button>
    <button data-ref="next">pas ▶</button>
    <button data-ref="reset">↺ début</button>
    <span class="sp"></span>
    <span>Vitesse :</span><span class="seg" data-ref="speed"></span>
  </div>
  <div class="ft">Le signal arrive <span data-ref="tt"></span></div>
  <svg data-ref="sig" width="100%" role="img" aria-label="Signal arrivant pas à pas, fenêtre des 100 derniers pas et sa reconstruction"></svg>
  <div class="ft">Les {NMAX} coefficients, au fil du temps <span>(chacun a sa propre échelle verticale)</span></div>
  <svg data-ref="co" width="100%" role="img" aria-label="Évolution de chacun des coefficients de Legendre au fil du temps"></svg>
  <p class="note" data-ref="note"></p>
</div>

<script>
  import { runLmu, reconstruct } from './lmu';

  document.querySelectorAll<HTMLElement>('[data-widget="lgs"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const TH = 100, T = 400, N = 8;
    const names = ['moyenne', 'tendance', 'courbure', 'ordre 3', 'ordre 4', 'ordre 5', 'ordre 6', 'ordre 7'];
    const sub = (k: number) => '₀₁₂₃₄₅₆₇₈₉'[k];
    // même signal en paliers que dans l'autre widget du chapitre (valeurs parmi 0, ¼, ½, ¾, 1, tenues 15 à 30 pas ; graine fixe)
    let sd = 3; const rnd = () => { sd = (sd * 16807) % 2147483647; return sd / 2147483647; };
    const u: number[] = [];
    while (u.length < T) { const v = Math.round(rnd() * 4) / 4, L = 15 + Math.floor(rnd() * 16); for (let k = 0; k < L && u.length < T; k++) u.push(v); }
    const M = runLmu(u, N, TH);
    const cmax = Array.from({ length: N }, (_, i) => Math.max(1e-6, ...M.map((m) => Math.abs(m[i]))));
    const f = (v: number, d = 2) => v.toFixed(d).replace('.', ',').replace('-', '−');

    let t = 0, playing = false, timer = 0, rate = 25, acc = 0, last = 0;
    const W = 640, ox = 8, wpx = W - 16;
    const XS = (k: number) => ox + (k / (T - 1)) * wpx;

    function draw() {
      $('play').textContent = playing ? '⏸ pause' : '▶ lecture';
      $('speed').querySelectorAll('button').forEach((b) => b.classList.toggle('active', +b.dataset.v! === rate));
      ($('prev') as HTMLButtonElement).disabled = t === 0;
      ($('next') as HTMLButtonElement).disabled = t === T - 1;
      $('tt').textContent = `(pas ${t} sur ${T - 1})`;
      const m = M[t];

      // --- signal, fenêtre, reconstruction ---
      const sh = 130, y0 = 10, ph = sh - 30, lo = -0.15, hi = 1.15;
      const Y = (v: number) => y0 + (1 - (Math.max(lo, Math.min(hi, v)) - lo) / (hi - lo)) * ph;
      const w0 = Math.max(0, t - TH + 1);
      let s = `<rect x="${XS(w0)}" y="${y0 - 4}" width="${Math.max(2, XS(t) - XS(w0))}" height="${ph + 8}" fill="var(--hl-bg)" stroke="var(--hl-stroke)" stroke-width="1"/>`;
      [0, 0.5, 1].forEach((v) => (s += `<line x1="${ox}" y1="${Y(v)}" x2="${W - ox}" y2="${Y(v)}" stroke="var(--border)" stroke-dasharray="${v ? '2 4' : ''}"/>`));
      let dfut = '', dpast = `M${XS(0)},${Y(u[0])}`;
      for (let k = 1; k < T; k++) { const seg = `H${XS(k).toFixed(1)}V${Y(u[k]).toFixed(1)}`; if (k <= t) dpast += seg; else dfut += (dfut ? '' : `M${XS(k - 1).toFixed(1)},${Y(u[k - 1]).toFixed(1)}`) + seg; }
      if (dfut) s += `<path d="${dfut}" fill="none" stroke="var(--p-wave)" stroke-width="1.2" stroke-opacity="0.22"/>`;
      s += `<path d="${dpast}" fill="none" stroke="var(--p-wave)" stroke-width="1.8"/>`;
      let pr = '';
      for (let tau = Math.min(TH - 1, t); tau >= 0; tau--) pr += `${XS(t - tau).toFixed(1)},${Y(reconstruct(m, tau / TH)).toFixed(1)} `;
      s += `<polyline points="${pr}" fill="none" stroke="var(--p-mel)" stroke-width="2.4" stroke-linejoin="round"/>`;
      s += `<circle cx="${XS(t)}" cy="${Y(u[t])}" r="3.6" fill="var(--p-wave)"/>`;
      s += `<text x="${W / 2}" y="${sh - 4}" text-anchor="middle" class="ax"><tspan style="fill:var(--p-wave);font-weight:600">— signal</tspan>   <tspan style="fill:var(--p-mel);font-weight:600">— reconstruction de la fenêtre avec les 8 coefficients</tspan>   <tspan style="fill:var(--hl-text)">▮ fenêtre des ${TH} derniers pas</tspan></text><text x="${W - ox}" y="${sh - 4}" text-anchor="end" class="ax">temps →</text>`;
      const sig = $('sig') as unknown as SVGSVGElement;
      sig.setAttribute('viewBox', `0 0 ${W} ${sh}`);
      sig.innerHTML = s;

      // --- une petite courbe par coefficient ---
      const cols = 4, gap = 12, cw = (W - 2 * ox - (cols - 1) * gap) / cols, chh = 60, lab = 14;
      let c = '';
      m.forEach((v, i) => {
        const cx0 = ox + (i % cols) * (cw + gap), cy0 = Math.floor(i / cols) * (chh + lab + 8) + lab + 2, mid = cy0 + chh / 2;
        const XC = (k: number) => cx0 + (k / (T - 1)) * cw, YC = (q: number) => mid - (q / cmax[i]) * (chh / 2 - 2);
        c += `<text x="${cx0}" y="${cy0 - 4}" class="cl">m${sub(i)} <tspan style="fill:var(--text-2);font-weight:400">${names[i]}</tspan></text><text x="${cx0 + cw}" y="${cy0 - 4}" text-anchor="end" class="cv">${f(v)}</text>`;
        c += `<rect x="${cx0}" y="${cy0}" width="${cw}" height="${chh}" fill="none" stroke="var(--border)"/><line x1="${cx0}" y1="${mid}" x2="${cx0 + cw}" y2="${mid}" stroke="var(--border)" stroke-dasharray="2 3"/>`;
        let p = '';
        for (let k = 0; k <= t; k++) p += `${XC(k).toFixed(1)},${YC(M[k][i]).toFixed(1)} `;
        c += `<polyline points="${p}" fill="none" stroke="var(--p-mel)" stroke-width="1.6" stroke-linejoin="round"/>`;
        c += `<circle cx="${XC(t)}" cy="${YC(v)}" r="2.8" fill="var(--p-mel)"/>`;
      });
      const rows = Math.ceil(N / cols), ch = rows * (chh + lab + 8) + 2;
      const co = $('co') as unknown as SVGSVGElement;
      co.setAttribute('viewBox', `0 0 ${W} ${ch}`);
      co.innerHTML = c;

      // --- ligne de calcul : m₀ contre la moyenne de la fenêtre (avant le pas 0, le signal est supposé constant = u₀) ---
      let mean = 0;
      for (let k = t - TH + 1; k <= t; k++) mean += u[Math.max(0, k)];
      mean /= TH;
      $('note').innerHTML = `Pas ${t} : u(${t}) = ${f(u[t])} entre dans m ← A<sub>d</sub> m + B<sub>d</sub> u. m<sub>0</sub> = ${f(m[0], 3)}, moyenne des ${TH} derniers pas = ${f(mean, 3)}. Signal en paliers tiré au hasard (graine fixe), θ = ${TH} pas, n = ${N}.`;
    }

    const stop = () => { playing = false; cancelAnimationFrame(timer); };
    const loop = (now: number) => {
      if (!playing) return;
      acc += ((now - last) / 1000) * rate; last = now;
      const k = Math.floor(acc);
      if (k >= 1) { acc -= k; t = Math.min(T - 1, t + k); if (t === T - 1) playing = false; draw(); }
      if (playing) timer = requestAnimationFrame(loop);
    };
    const start = () => { if (t === T - 1) t = 0; playing = true; acc = 0; last = performance.now(); timer = requestAnimationFrame(loop); draw(); };
    $('play').addEventListener('click', () => (playing ? (stop(), draw()) : start()));
    $('prev').addEventListener('click', () => { stop(); t = Math.max(0, t - 1); draw(); });
    $('next').addEventListener('click', () => { stop(); t = Math.min(T - 1, t + 1); draw(); });
    $('reset').addEventListener('click', () => { stop(); t = 0; draw(); });
    [['normal', 25], ['rapide', 80]].forEach(([label, v]) => { const b = document.createElement('button'); b.textContent = String(label); b.dataset.v = String(v); b.addEventListener('click', () => { rate = +v; draw(); }); $('speed').appendChild(b); });
    t = TH + 40; // l'état au chargement : déjà quelques coefficients tracés, sans rien lancer
    draw();
  });
</script>

<style is:global>
  .lgs .seg { display: inline-flex; gap: 6px; }
  .lgs .seg button { font-size: 13px; padding: 4px 12px; }
  .lgs .row .sp { flex: 1; }
  .lgs .row > button { font-size: 13px; padding: 4px 10px; }
  .lgs .row > button:disabled { opacity: 0.4; cursor: default; }
  .lgs .ft { font-size: 13px; font-weight: 500; margin: 10px 0 2px; }
  .lgs .ft span { font-weight: 400; color: var(--text-2); }
  .lgs svg { display: block; width: 100%; height: auto; }
  .lgs svg text.ax { font: 11px var(--font); fill: var(--text-2); }
  .lgs svg text.cl { font: 600 11.5px var(--font); fill: var(--text); }
  .lgs svg text.cv { font: 11.5px var(--font); fill: var(--text-2); }
</style>
