---
// Chapitre 2 : la mémoire de Legendre sur un signal en paliers, θ = 100 pas.
// On choisit l'instant t (clic ou glissé sur l'entrée, ou pas précédent / suivant) et l'ordre n.
// En bas : la fenêtre des θ derniers pas (gris) et sa reconstruction Σ m_i(t) P̃_i(τ/θ) (brun), puis les coefficients m_i(t),
// calculés par la récurrence m ← A_d m + B_d u (pas par projection sur la fenêtre) ; la ligne de calcul donne le passage du pas précédent au pas t.
---
<div class="widget lgw pp" data-widget="lgw">
  <div class="row"><span>Coefficients n :</span><span class="seg" data-ref="n"></span><span class="sp"></span><button data-ref="prev">◀ pas précédent</button><button data-ref="next">pas suivant ▶</button></div>
  <div class="ft">Entrée u <span>(clique ou glisse pour choisir l'instant t ; la bande est la fenêtre des θ = 100 derniers pas)</span></div>
  <svg data-ref="strip" width="100%" role="img" aria-label="Entrée u sur tout l'épisode, avec la fenêtre des 100 derniers pas surlignée"></svg>
  <div class="lgh"><div class="ft">La fenêtre et sa reconstruction <span data-ref="sub"></span></div><div class="lgs"><span>écart moyen</span><b data-ref="err"></b></div></div>
  <svg data-ref="win" width="100%" role="img" aria-label="Fenêtre des 100 derniers pas de l'entrée et sa reconstruction à partir des n coefficients"></svg>
  <div class="ft">Les coefficients m<sub>i</sub>(t)</div>
  <svg data-ref="bars" width="100%" role="img" aria-label="Valeurs des coefficients de Legendre à l'instant t"></svg>
  <p class="note" data-ref="calc"></p>
</div>

<script>
  import { runLmu, reconstruct } from './lmu';

  document.querySelectorAll<HTMLElement>('[data-widget="lgw"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const TH = 100, T = 400, NS = [4, 8, 16];
    // entrée en paliers : valeurs parmi 0, ¼, ½, ¾, 1 tenues 15 à 30 pas (graine fixe)
    let sd = 3; const rnd = () => { sd = (sd * 16807) % 2147483647; return sd / 2147483647; };
    const u: number[] = [];
    while (u.length < T) { const v = Math.round(rnd() * 4) / 4, L = 15 + Math.floor(rnd() * 16); for (let k = 0; k < L && u.length < T; k++) u.push(v); }
    const runs: Record<number, number[][]> = {};
    NS.forEach((n) => (runs[n] = runLmu(u, n, TH)));
    // échelle des barres : la plus grande valeur atteinte sur l'épisode, pour chaque n
    const cmax: Record<number, number> = {};
    NS.forEach((n) => (cmax[n] = Math.max(...runs[n].flat().map(Math.abs))));
    let n = 8, t = 260;
    const f = (v: number, d = 2) => v.toFixed(d).replace('.', ',').replace('-', '−');
    const sub = (k: number) => String(k).split('').map((c) => '₀₁₂₃₄₅₆₇₈₉'[+c]).join('');

    NS.forEach((v) => { const b = document.createElement('button'); b.textContent = String(v); b.dataset.v = String(v); b.addEventListener('click', () => { n = v; draw(); }); $('n').appendChild(b); });
    $('prev').addEventListener('click', () => { t = Math.max(TH, t - 1); draw(); });
    $('next').addEventListener('click', () => { t = Math.min(T - 1, t + 1); draw(); });

    const W = 640, ox = 8, wpx = W - 16;
    const XS = (k: number) => ox + (k / (T - 1)) * wpx;
    function draw() {
      $('n').querySelectorAll('button').forEach((b) => b.classList.toggle('active', +b.dataset.v! === n));
      const M = runs[n], m = M[t], mp = M[t - 1];

      // --- entrée entière, fenêtre surlignée ---
      const sh = 54, sy = (v: number) => 6 + (1 - v) * (sh - 12);
      let s = `<rect x="${XS(t - TH)}" y="2" width="${XS(t) - XS(t - TH)}" height="${sh - 4}" fill="var(--hl-bg)" stroke="var(--hl-stroke)" stroke-width="1"/>`;
      let d = `M${XS(0)},${sy(u[0])}`;
      for (let k = 1; k < T; k++) d += `H${XS(k).toFixed(1)}V${sy(u[k]).toFixed(1)}`;
      s += `<path d="${d}" fill="none" stroke="var(--p-wave)" stroke-width="1.4"/>`;
      s += `<text x="${XS(t)}" y="${sh + 10}" text-anchor="middle" class="ax">t = ${t}</text>`;
      const strip = $('strip') as unknown as SVGSVGElement;
      strip.setAttribute('viewBox', `0 0 ${W} ${sh + 14}`);
      strip.innerHTML = s;

      // --- fenêtre (à gauche : il y a θ pas ; à droite : maintenant) et reconstruction ---
      const wh = 150, wy0 = 10, wh1 = wh - 34, lo = -0.25, hi = 1.25;
      const XW = (tau: number) => ox + (1 - tau / TH) * wpx, YW = (v: number) => wy0 + (1 - (Math.max(lo, Math.min(hi, v)) - lo) / (hi - lo)) * wh1;
      let w = '';
      [0, 0.5, 1].forEach((v) => (w += `<line x1="${ox}" y1="${YW(v)}" x2="${W - ox}" y2="${YW(v)}" stroke="var(--border)" stroke-dasharray="${v ? '2 4' : ''}"/><text x="${ox + 2}" y="${YW(v) - 3}" class="ax">${f(v, 1)}</text>`));
      let dt = `M${XW(TH)},${YW(u[t - TH])}`;
      for (let tau = TH - 1; tau >= 0; tau--) dt += `H${XW(tau).toFixed(1)}V${YW(u[t - tau]).toFixed(1)}`;
      w += `<path d="${dt}" fill="none" stroke="var(--p-wave)" stroke-width="1.6" stroke-opacity="0.75"/>`;
      let pr = '', err = 0;
      for (let tau = TH; tau >= 0; tau--) { const r = reconstruct(m, tau / TH); pr += `${XW(tau).toFixed(1)},${YW(r).toFixed(1)} `; err += Math.abs(r - u[t - tau]); }
      w += `<polyline points="${pr}" fill="none" stroke="var(--p-mel)" stroke-width="2.2" stroke-linejoin="round"/>`;
      w += `<text x="${ox}" y="${wh - 6}" class="ax">il y a ${TH} pas</text><text x="${W - ox}" y="${wh - 6}" text-anchor="end" class="ax">maintenant (t = ${t})</text>`;
      w += `<text x="${W / 2}" y="${wh - 6}" text-anchor="middle" class="ax"><tspan style="fill:var(--p-wave);font-weight:600">— entrée</tspan>   <tspan style="fill:var(--p-mel);font-weight:600">— reconstruction avec ${n} coefficients</tspan></text>`;
      const win = $('win') as unknown as SVGSVGElement;
      win.setAttribute('viewBox', `0 0 ${W} ${wh}`);
      win.innerHTML = w;
      $('sub').textContent = `(n = ${n})`;
      $('err').textContent = f(err / (TH + 1));

      // --- coefficients ---
      const bh = 96, bmid = 8 + (bh - 30) / 2, half = (bh - 30) / 2, cm = cmax[n], bw = Math.min(56, wpx / n);
      let b = `<line x1="${ox}" y1="${bmid}" x2="${W - ox}" y2="${bmid}" stroke="var(--border)"/>`;
      m.forEach((v, i) => {
        const x = ox + i * bw + 4, ww = bw - 8, Y = (q: number) => bmid - (Math.max(-cm, Math.min(cm, q)) / cm) * half;
        b += `<rect x="${x}" y="${Math.min(Y(v), bmid)}" width="${ww}" height="${Math.max(0.6, Math.abs(Y(v) - bmid))}" rx="2" fill="var(--p-mel)"/>`;
        b += `<text x="${x + ww / 2}" y="${bh - 14}" text-anchor="middle" class="ax">m${sub(i)}</text>`;
        if (n <= 8) b += `<text x="${x + ww / 2}" y="${bh - 2}" text-anchor="middle" class="ax">${f(v)}</text>`;
      });
      const bars = $('bars') as unknown as SVGSVGElement;
      bars.setAttribute('viewBox', `0 0 ${W} ${bh}`);
      bars.innerHTML = b;

      $('calc').innerHTML = `Pas ${t - 1} → ${t} : u(${t}) = ${f(u[t])} entre dans la récurrence m ← A<sub>d</sub> m + B<sub>d</sub> u ; m₀ passe de ${f(mp[0], 3)} à ${f(m[0], 3)}, m₁ de ${f(mp[1], 3)} à ${f(m[1], 3)}. La fenêtre elle-même n'est jamais relue. Entrée en paliers tirée au hasard (graine fixe), θ = ${TH} pas.`;
    }

    // choix de t par clic ou glissé sur l'entrée
    const strip = $('strip') as unknown as SVGSVGElement;
    strip.style.cursor = 'ew-resize';
    strip.style.touchAction = 'pan-y';
    const pick = (e: PointerEvent) => {
      const r = strip.getBoundingClientRect();
      const k = Math.round(((((e.clientX - r.left) / r.width) * W - ox) / wpx) * (T - 1));
      const nt = Math.max(TH, Math.min(T - 1, k));
      if (nt !== t) { t = nt; draw(); }
    };
    strip.addEventListener('pointerdown', (e) => { strip.setPointerCapture(e.pointerId); pick(e); });
    strip.addEventListener('pointermove', (e) => { if (strip.hasPointerCapture(e.pointerId)) pick(e); });
    draw();
  });
</script>

<style is:global>
  .lgw .seg { display: inline-flex; gap: 6px; }
  .lgw .seg button { font-size: 13px; padding: 4px 12px; }
  .lgw .row .sp { flex: 1; }
  .lgw .row > button { font-size: 13px; padding: 4px 10px; }
  .lgw .ft { font-size: 13px; font-weight: 500; margin: 10px 0 2px; }
  .lgw .ft span { font-weight: 400; color: var(--text-2); }
  .lgw .lgh { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .lgw .lgs { display: flex; align-items: baseline; gap: 6px; background: var(--surface-2); border-radius: 8px; padding: 2px 10px; }
  .lgw .lgs span { font-size: 12px; color: var(--text-2); }
  .lgw .lgs b { font-size: 13.5px; font-weight: 600; }
  .lgw svg { display: block; width: 100%; height: auto; }
  .lgw svg text.ax { font: 11px var(--font); fill: var(--text-2); }
</style>
