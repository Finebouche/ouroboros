---
// Chapitre 4 : le MVDR guidé par masques (éq. 6-10 et 5 de l'article) sur un cas simulé en bande étroite. Signaux synthétiques (sim.ts : trames, mvdrMasque).
// Une case de fréquence (1 kHz), J = 60 trames, antenne de 8 micros espacés de 5 cm. Cible à 30° qui parle par intermittence ; bruit directionnel à 0°,
// continu, de même puissance moyenne sur les J trames ; bruit propre à chaque micro à −20 dB. Graine 1 (choisie parmi 200 tirages parce que ses
// chiffres sont proches des médianes ; script : scratchpad intuition/scan2.ts).
// Trois cas, états précalculés (boutons, pas d'animation) :
//   oracle : masques de rapport idéaux de l'article (éq. 20) ; imparfait : bruit gaussien sur leur logit (σ = 2 commun aux micros d'une trame, σ/2 propre
//   à chaque micro) ; sans : pas de masque, R̂_s = R̂_v = covariance du mélange.
// Panneaux : poids des trames η_j, ξ_j (éq. 8-9) ; cartes de R̂_s et R̂_v (éq. 6-7, convention du chapitre 3) ; d̂ (éq. 10) contre le vrai d ;
// diagramme de directivité du filtre h (éq. 5).
// Couleurs : masque estimé (comme par un réseau) --r-out ; masque idéal et vérité terrain (d vrai) en pointillé --text ; ce que calcule l'algèbre
// (covariances, d̂, h) --p-mel ; direction de la cible --text, du bruit --h-py ; pas de masque : gris.
import katex from 'katex';
import { REGLAGES_MASQUE as G, CAS, trames, mvdrMasque, mvdrOracle, mediane, vecteurPropre, directiviteDb, herm } from './sim';

const km = (s: string, display = false) => katex.renderToString(s, { throwOnError: false, displayMode: display });
const T = trames(G), res = CAS.map((c) => mvdrMasque(c, G, T)), oracle = mvdrOracle(G, T);
const ideal = T.mIdeal.map((row) => mediane(row));
const r3 = (v: number) => Math.round(v * 1000) / 1000;
const AZ = Array.from({ length: 181 }, (_, k) => k - 90);
// part de la cible dans une covariance pondérée : Σ w_j ‖S_j‖² / Σ w_j ‖V_j‖², en dB
const partCible = (w: number[]) => {
  let a = 0, b = 0;
  w.forEach((p, j) => { a += p * herm(T.S[j], T.S[j])[0]; b += p * herm(T.V[j], T.V[j])[0]; });
  return 10 * Math.log10(a / b);
};
const trace = (R: Float64Array) => { let t = 0; for (let i = 0; i < G.C; i++) t += R[2 * (i * G.C + i)]; return t; };
const payload = JSON.stringify({
  C: G.C, J: G.J, azS: G.azS, azN: G.azN, actif: T.actif, ideal: ideal.map(r3), d: Array.from(T.d, r3), oracle: oracle.gainDb,
  cas: res.map((r) => ({
    eta: r.eta.map(r3), xi: r.xi.map(r3), Rs: Array.from(r.Rs, (v) => Math.round(v * 1e4) / 1e4), Rv: Array.from(r.Rv, (v) => Math.round(v * 1e4) / 1e4),
    dHat: Array.from(r.dHat, r3), ecart: r.ecartDeg, gain: r.gainDb, versCible: r.versCibleDb, versBruit: r.versBruitDb,
    etaMoy: r.eta.reduce((a, b) => a + b, 0) / G.J, xiMoy: r.xi.reduce((a, b) => a + b, 0) / G.J,
    partS: partCible(r.eta), partV: partCible(r.xi), rang1: vecteurPropre(r.Rs).lambda / trace(r.Rs),
    diag: AZ.map((a) => Math.round(directiviteDb(r.h, G, a) * 10) / 10),
  })),
});
const F = {
  poids: km(String.raw`\eta_j=\operatorname{m\acute{e}d}_i\,\hat m_i(j),\quad \xi_j=\operatorname{m\acute{e}d}_i\,\bigl(1-\hat m_i(j)\bigr)`),
  Rs: km(String.raw`\hat{\mathbf R}_s=\tfrac1J\textstyle\sum_j \eta_j\,\mathbf y_j\mathbf y_j^{\mathsf H}`),
  Rv: km(String.raw`\hat{\mathbf R}_v=\tfrac1J\textstyle\sum_j \xi_j\,\mathbf y_j\mathbf y_j^{\mathsf H}`),
  d: km(String.raw`\hat{\mathbf r}=\mathcal P\{\hat{\mathbf R}_s\},\quad \hat{\mathbf d}=\hat{\mathbf r}/\hat r_0`),
  h: km(String.raw`\mathbf h=\dfrac{\hat{\mathbf R}_v^{-1}\hat{\mathbf d}}{\hat{\mathbf d}^{\mathsf H}\hat{\mathbf R}_v^{-1}\hat{\mathbf d}}`),
};
const LABELS: Record<string, string> = { oracle: 'masques idéaux', imparfait: 'masques imparfaits', sans: 'sans masque' };
---
<div class="widget pp mcw" data-widget="mcw" data-payload={payload}>
  <div class="mcw-head">
    <div class="mcw-title"><b>Que devient le filtre quand le masque se trompe ?</b><span>une fréquence, {G.J} trames, {G.C} micros</span></div>
    <div class="mcw-stat"><span>écart entre d̂ et d <b data-ref="ecart"></b></span><span>gain en RSB <b data-ref="gain"></b></span></div>
  </div>
  <div class="mcw-ctl" role="group" aria-label="Masques utilisés">
    {CAS.map((c, k) => <button type="button" data-cas={c} class={k === 0 ? 'active' : ''} aria-pressed={k === 0 ? 'true' : 'false'}>{LABELS[c]}</button>)}
  </div>

  <div class="mcw-pan">
    <div class="mcw-ttl"><span>Poids des trames</span><span class="mcw-f" set:html={F.poids} /></div>
    <svg data-ref="bande" class="mcw-bande" role="img" aria-label="Poids de chaque trame dans les deux covariances"></svg>
    <p class="mcw-calc" data-ref="l-poids"></p>
  </div>

  <div class="mcw-row">
    <div class="mcw-pan">
      <div class="mcw-mats">
        <div><span class="mcw-f" set:html={F.Rs} /><svg data-ref="Rs" class="mcw-mat" role="img" aria-label="Carte de la covariance pondérée de la cible"></svg></div>
        <div><span class="mcw-f" set:html={F.Rv} /><svg data-ref="Rv" class="mcw-mat" role="img" aria-label="Carte de la covariance pondérée du reste"></svg></div>
      </div>
      <p class="mcw-calc" data-ref="l-cov"></p>
    </div>
    <div class="mcw-pan">
      <div class="mcw-ttl"><span class="mcw-f" set:html={F.d} /></div>
      <svg data-ref="d" class="mcw-ph" role="img" aria-label="Composantes de d chapeau comparées à celles du vrai d, micro par micro"></svg>
      <p class="mcw-calc" data-ref="l-d"></p>
    </div>
  </div>

  <div class="mcw-pan">
    <div class="mcw-ttl"><span>Diagramme de directivité du filtre</span><span class="mcw-f" set:html={F.h} /></div>
    <svg data-ref="diag" class="mcw-diag" role="img" aria-label="Réponse du filtre selon la direction d'arrivée, en décibels"></svg>
    <p class="mcw-calc" data-ref="l-h"></p>
  </div>
  <p class="note">Signaux synthétiques, une case de fréquence ({G.f / 1000} kHz), un tirage. Cible à {G.azS}° qui parle par intermittence ; bruit à {G.azN}°, continu, de même puissance moyenne ; bruit propre à chaque micro à −20 dB. Masque idéal : celui de la section 3 ; masque imparfait : bruit gaussien ajouté à son logit (écart-type {G.sigma} commun aux micros d'une trame, {G.sigma / 2} propre à chaque micro). Gain en RSB : sortie du filtre contre micro de référence, sur ces {G.J} trames ; avec la vraie cible (MVDR oracle) : <span data-ref="oracle"></span>.</p>
</div>

<script>
  import { phaseur, carteCov, fr } from './phaseurs';
  type Cas = { eta: number[]; xi: number[]; Rs: number[]; Rv: number[]; dHat: number[]; ecart: number; gain: number; versCible: number; versBruit: number; etaMoy: number; xiMoy: number; partS: number; partV: number; rang1: number; diag: number[] };
  type Data = { C: number; J: number; azS: number; azN: number; actif: boolean[]; ideal: number[]; d: number[]; oracle: number; cas: Cas[] };
  document.querySelectorAll<HTMLElement>('[data-widget="mcw"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const D = JSON.parse(root.dataset.payload!) as Data;
    const NOMS = ['oracle', 'imparfait', 'sans'];
    const CIBLE = 'var(--text)', BRUIT = 'var(--h-py)', CALC = 'var(--p-mel)', NET = 'var(--r-out)', GRIS = 'var(--text-2)';
    const n = (v: number) => v.toFixed(1);
    let k = 0;
    $('oracle').textContent = `${fr(D.oracle)} dB`;
    const btns = [...root.querySelectorAll<HTMLButtonElement>('.mcw-ctl button')];
    btns.forEach((b, i) => b.addEventListener('click', () => { k = i; draw(); }));
    const largeur = (el: Element, min: number, max: number) => Math.max(min, Math.min(max, Math.round(el.getBoundingClientRect().width) || max));

    function bande(c: Cas) {
      const svg = $('bande') as unknown as SVGSVGElement, W = largeur(svg, 300, 760);
      const ox = 22, pw = W - ox - 4, bw = pw / D.J, hb = 30, y1 = 14, y2 = y1 + 10 + hb, y3 = y2 + 8 + hb;
      let s = `<text x="0" y="${y1 + 6}" class="ax">cible</text>`;
      // trames où la cible parle
      D.actif.forEach((a, j) => { if (a) s += `<rect x="${n(ox + j * bw)}" y="${y1}" width="${n(bw)}" height="6" fill="${CIBLE}"/>`; });
      const rangee = (y: number, w: number[], ref: number[] | null, lab: string) => {
        s += `<text x="0" y="${y + hb / 2 + 4}" class="sym">${lab}</text>`;
        s += `<line x1="${ox}" y1="${y + hb}" x2="${ox + pw}" y2="${y + hb}" stroke="var(--border)"/>`;
        w.forEach((v, j) => {
          const x = ox + j * bw + 0.6, ww = Math.max(1, bw - 1.2), h = v * hb;
          if (NOMS[k] === 'oracle') s += `<rect x="${n(x)}" y="${n(y + hb - h)}" width="${n(ww)}" height="${n(h)}" fill="${CIBLE}" fill-opacity="0.16" stroke="${CIBLE}" stroke-width="0.9" stroke-dasharray="2 1.5"/>`;
          else s += `<rect x="${n(x)}" y="${n(y + hb - h)}" width="${n(ww)}" height="${n(h)}" fill="${NOMS[k] === 'sans' ? GRIS : NET}" fill-opacity="${NOMS[k] === 'sans' ? 0.3 : 0.75}"/>`;
          if (ref) { const hr = ref[j] * hb; s += `<rect x="${n(x)}" y="${n(y + hb - hr)}" width="${n(ww)}" height="${n(hr)}" fill="none" stroke="${CIBLE}" stroke-width="0.9" stroke-dasharray="2 1.5"/>`; }
        });
      };
      const imp = NOMS[k] === 'imparfait';
      rangee(y2, c.eta, imp ? D.ideal : null, 'η');
      rangee(y3, c.xi, imp ? D.ideal.map((v) => 1 - v) : null, 'ξ');
      s += `<text x="${ox + pw}" y="${y3 + hb + 14}" text-anchor="end" class="ax">trame j, de 1 à ${D.J}</text>`;
      if (imp) s += `<text x="${ox}" y="${y3 + hb + 14}" class="ax">pointillé : poids idéal</text>`;
      svg.setAttribute('viewBox', `0 0 ${W} ${y3 + hb + 20}`); svg.innerHTML = s;
    }

    function cartes(c: Cas) {
      const U = 18, C = D.C;
      for (const [ref, R] of [['Rs', c.Rs], ['Rv', c.Rv]] as [string, number[]][]) {
        const svg = $(ref) as unknown as SVGSVGElement;
        svg.setAttribute('viewBox', `0 0 ${C * U + 2} ${C * U + 2}`);
        svg.innerHTML = carteCov(Float64Array.from(R), C, 1, 1, U, CALC);
      }
    }

    function phaseurs(c: Cas) {
      const svg = $('d') as unknown as SVGSVGElement, U = 38, R = 14, W = D.C * U, cy = 34;
      let s = '';
      for (let i = 0; i < D.C; i++) {
        const cx = (i + 0.5) * U;
        s += `<text x="${cx}" y="11" text-anchor="middle" class="ax">${i === 0 ? '0 réf.' : i}</text>`;
        s += phaseur(cx, cy, R, D.d[2 * i], D.d[2 * i + 1], CIBLE, { tirets: true, w: 1.3, borne: 1.3 });
        s += phaseur(cx, cy, R, c.dHat[2 * i], c.dHat[2 * i + 1], CALC, { cercle: false, w: 1.8, borne: 1.3 });
      }
      s += `<text x="0" y="${cy + R + 22}" class="ax"><tspan style="fill:${CALC};font-weight:600">flèche : d̂</tspan>  ·  pointillé : le vrai d</text>`;
      svg.setAttribute('viewBox', `0 0 ${W} ${cy + R + 28}`); svg.innerHTML = s;
    }

    function diagramme(c: Cas) {
      const svg = $('diag') as unknown as SVGSVGElement, W = largeur(svg, 300, 760);
      const ox = 34, pw = W - ox - 10, top = 16, ph = 150, lo = -40, hi = 10;
      const X = (a: number) => ox + ((a + 90) / 180) * pw, Y = (db: number) => top + ((hi - Math.max(lo, Math.min(hi, db))) / (hi - lo)) * ph;
      let s = '';
      for (const db of [10, 0, -10, -20, -30, -40]) s += `<line x1="${ox}" y1="${n(Y(db))}" x2="${ox + pw}" y2="${n(Y(db))}" stroke="var(--border)" stroke-dasharray="${db === 0 ? '' : '2 4'}"/>` + (db < 10 && db > -40 ? `<text x="${ox - 5}" y="${n(Y(db) + 3.5)}" text-anchor="end" class="ax">${fr(db, 0)}</text>` : '');
      for (const a of [-90, -60, -30, 0, 30, 60, 90]) s += `<text x="${n(X(a))}" y="${top + ph + 14}" text-anchor="middle" class="ax">${fr(a, 0)}°</text>`;
      s += `<text x="${ox + pw}" y="${top + ph + 28}" text-anchor="end" class="ax">azimut de l'onde qui arrive</text><text x="${ox - 5}" y="${n(Y(10) + 3.5)}" text-anchor="end" class="ax">dB</text>`;
      // directions vraies
      const repere = (az: number, col: string, lab: string, v: number) => {
        s += `<line x1="${n(X(az))}" y1="${top}" x2="${n(X(az))}" y2="${top + ph}" stroke="${col}" stroke-width="1.2" stroke-dasharray="4 3"/>`;
        s += `<text x="${n(X(az) + 4)}" y="${top + 10}" class="lb" style="fill:${col}">${lab}</text>`;
        s += `<circle cx="${n(X(az))}" cy="${n(Y(v))}" r="3.4" fill="${col}"/>`;
      };
      const pts = c.diag.map((v, i) => `${n(X(i - 90))},${n(Y(v))}`).join(' ');
      s += `<polyline points="${pts}" fill="none" stroke="${CALC}" stroke-width="2.4" stroke-linejoin="round"/>`;
      repere(D.azS, CIBLE, 'cible', c.versCible);
      repere(D.azN, BRUIT, 'bruit', c.versBruit);
      svg.setAttribute('viewBox', `0 0 ${W} ${top + ph + 32}`); svg.innerHTML = s;
    }

    function draw() {
      btns.forEach((b, i) => { b.classList.toggle('active', i === k); b.setAttribute('aria-pressed', String(i === k)); });
      const c = D.cas[k];
      $('ecart').textContent = `${fr(c.ecart)}°`;
      $('gain').textContent = `${fr(c.gain)} dB`;
      $('l-poids').textContent = NOMS[k] === 'sans' ? 'Sans masque : η = ξ = 1 pour toutes les trames, les deux covariances sont celle du mélange.' : `η moyen ${fr(c.etaMoy, 2)} ; ξ moyen ${fr(c.xiMoy, 2)}.`;
      $('l-cov').textContent = `Puissance de la cible / puissance du reste : ${fr(c.partS)} dB dans R̂ₛ, ${fr(c.partV)} dB dans R̂ᵥ.`;
      $('l-d').textContent = `Valeur propre principale / trace de R̂ₛ : ${fr(c.rang1, 2)} (1 = une seule direction).`;
      $('l-h').textContent = `Réponse vers la vraie cible : ${fr(c.versCible)} dB ; vers le bruit : ${fr(c.versBruit)} dB.`;
      bande(c); cartes(c); phaseurs(c); diagramme(c);
    }
    let was = root.clientWidth;
    new ResizeObserver(() => { const now = root.clientWidth; if (Math.abs(now - was) > 8) { was = now; draw(); } }).observe(root);
    draw();
  });
</script>

<style is:global>
  .mcw .mcw-head { line-height: 1.4; display: flex; justify-content: space-between; align-items: flex-start; gap: 8px 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .mcw .mcw-title { flex: 1 1 260px; }
  .mcw .mcw-title b { display: block; font-size: 15px; font-weight: 600; }
  .mcw .mcw-title > span { font-size: 12.5px; color: var(--text-2); }
  .mcw .mcw-stat { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 14px; background: var(--surface-2); border-radius: 8px; padding: 4px 10px; }
  .mcw .mcw-stat > span { font-size: 12px; color: var(--text-2); white-space: nowrap; }
  .mcw .mcw-stat b { font-size: 14px; font-weight: 600; color: var(--text); margin-left: 4px; }
  .mcw .mcw-ctl { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
  .mcw .mcw-ctl button { font-size: 13px; padding: 4px 10px; }
  .mcw .mcw-pan { margin-top: 10px; min-width: 0; }
  .mcw .mcw-ttl { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 14px; font-size: 13px; font-weight: 600; color: var(--text); }
  .mcw .mcw-f { font-weight: 400; font-size: 12.5px; }
  .mcw .mcw-f .katex { font-size: 1.05em; }
  .mcw .mcw-row { display: flex; flex-wrap: wrap; gap: 4px 30px; align-items: flex-start; }
  .mcw .mcw-mats { display: flex; flex-wrap: wrap; gap: 6px 16px; }
  .mcw .mcw-mats > div { display: flex; flex-direction: column; gap: 4px; }
  .mcw .mcw-calc { font-size: 12.5px; color: var(--text-2); margin: 4px 0 0; }
  .mcw svg.mcw-bande, .mcw svg.mcw-diag { display: block; width: 100%; height: auto; margin-top: 4px; }
  .mcw svg.mcw-mat { display: block; width: 146px; height: 146px; }
  .mcw svg.mcw-ph { display: block; width: 304px; max-width: 100%; height: auto; margin-top: 6px; }
  .mcw svg.mcw-bande text, .mcw svg.mcw-diag text, .mcw svg.mcw-ph text { font-family: var(--font); }
  .mcw svg text.ax { font-size: 11px; fill: var(--text-2); }
  .mcw svg text.lb { font-size: 11.5px; font-weight: 600; }
  .mcw svg text.sym { font-size: 13px; font-style: italic; fill: var(--text); }
</style>
