---
// Chapitre 4 : l'intuition de MC-CSM (section IV-A et fig. 2 de l'article) : la différence entre les spectrogrammes complexes de deux micros
// a une structure nette, fixée par le retard entre micros. Signaux synthétiques (sim.ts : parole, deuxMicros), aucune parole réelle.
// Deux micros à 10 cm (fig. 5a), source en champ libre à 60° de la perpendiculaire : le micro 1 reçoit s(t − τ), τ = −10 cm · sin 60° / c ≈ −0,25 ms.
// TFCT de l'article (p. 611) : Hamming 20 ms, recouvrement 50 %, 161 cases de 0 à 8 kHz ; compression symétrique log de l'éq. 14, α = 100 ;
// normalisation de l'article : valeur efficace 1 au micro de référence.
// Ce qui vient de l'article : le choix des six panneaux (Re et Im de S1, S2, S1 − S2) et la compression. Ce qui est ajouté ici : le repère à f = 1/|τ|
// (S1 − S2 = S1 · (1 − e^{−2πi f τ}) s'annule quand f τ est entier) et le signal synthétique.
// Couleurs (signaux bruts, gris) : valeur positive en --text, négative en --p-wave, d'autant plus foncée que |z| est grand ; zéro = fond.
// Rendu dans un <canvas> calculé dans le navigateur (repeint au changement de thème).
import { retardLibre, PAS2, AZ2, DUREE2 } from './sim';
import { fr } from './phaseurs';
const tau = Math.abs(retardLibre(1, PAS2, AZ2)), f1 = 1 / tau;
const COLS = [{ t: 'micro 0 (réf.)', k: 'S1' }, { t: 'micro 1', k: 'S2' }, { t: 'différence 0 − 1', k: 'D' }];
const ROWS = [{ t: 'Re', k: 're' }, { t: 'Im', k: 'im' }];
---
<figure class="phif" data-phif>
  <div class="phif-grid">
    <span></span>
    {COLS.map((c) => <span class="phif-col">{c.t}</span>)}
    {ROWS.map((r) => (
      <>
        <span class="phif-y"><b>{r.t}</b><i>8 kHz</i><i>4</i><i>0</i></span>
        {COLS.map((c) => (
          <div class="phif-card">
            <canvas data-k={c.k} data-p={r.k} role="img" aria-label={`Partie ${r.k === 're' ? 'réelle' : 'imaginaire'} du spectrogramme, ${c.t}`}></canvas>
            {c.k === 'D' && <><span class="phif-raie g" style={`bottom:${(f1 / 8000) * 100}%`}></span><span class="phif-raie d" style={`bottom:${(f1 / 8000) * 100}%`}></span></>}
            {c.k === 'D' && r.k === 're' && <span class="phif-lab" style={`bottom:${(f1 / 8000) * 100}%`}>1/τ</span>}
          </div>
        ))}
      </>
    ))}
    <span></span>
    {COLS.map(() => <span class="phif-x"><i>0</i><i>{fr(DUREE2)} s</i></span>)}
  </div>
  <figcaption>Parole synthétique (trois syllabes voisées, fondamental de 108 à 150 Hz, et deux fricatives de 2 à 7,5 kHz), deux micros à {fr(PAS2 * 100, 0)} cm, source à {AZ2}° de la perpendiculaire : l'onde atteint le micro 1 τ = {fr(tau * 1000, 2)} ms avant le micro 0. TFCT et compression log symétrique (α = 100) ; teinte d'autant plus marquée que |valeur| est grande, couleur du texte pour une valeur positive, bleu-gris pour une négative. Repère 1/τ = {fr(f1 / 1000, 2)} kHz : la différence s'y annule (la phase entre micros y fait un tour complet).</figcaption>
</figure>

<script>
  import { deuxMicros, zlog } from './sim';
  document.querySelectorAll<HTMLElement>('[data-phif]').forEach((root) => {
    const { S1, S2, D } = deuxMicros();
    const sp: Record<string, { re: Float64Array[]; im: Float64Array[] }> = { S1, S2, D };
    const Z: Record<string, Float32Array> = {};
    const J = S1.re.length, F = S1.re[0].length;
    // échelle de teinte : fond pour |z| < Z0, teinte pleine au-delà de Z1 (z de l'éq. 14 va ici jusqu'à environ 4)
    const Z0 = 1, Z1 = 3.4;
    for (const k of ['S1', 'S2', 'D']) for (const p of ['re', 'im'] as const) {
      const z = new Float32Array(J * F);
      for (let j = 0; j < J; j++) for (let f = 0; f < F; f++) { const v = zlog(sp[k][p][j][f]); z[f * J + j] = v; }
      Z[k + p] = z;
    }
    const rgb = (v: string) => {
      const c = document.createElement('canvas').getContext('2d')!; c.fillStyle = v.trim(); const h = c.fillStyle as string;
      return h.startsWith('#') ? [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16)) : (h.match(/\d+/g) || ['0', '0', '0']).slice(0, 3).map(Number);
    };
    function peindre() {
      const cs = getComputedStyle(root), fond = rgb(cs.getPropertyValue('--surface')), pos = rgb(cs.getPropertyValue('--text')), neg = rgb(cs.getPropertyValue('--p-wave'));
      root.querySelectorAll<HTMLCanvasElement>('canvas').forEach((cv) => {
        const z = Z[cv.dataset.k! + cv.dataset.p!];
        cv.width = J; cv.height = F;
        const ctx = cv.getContext('2d')!, img = ctx.createImageData(J, F);
        for (let f = 0; f < F; f++) for (let j = 0; j < J; j++) {
          const v = z[f * J + j], a = Math.min(1, Math.max(0, (Math.abs(v) - Z0) / (Z1 - Z0))), col = v >= 0 ? pos : neg, o = 4 * ((F - 1 - f) * J + j);
          for (let c = 0; c < 3; c++) img.data[o + c] = Math.round(fond[c] + (col[c] - fond[c]) * a);
          img.data[o + 3] = 255;
        }
        ctx.putImageData(img, 0, 0);
      });
    }
    peindre();
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', peindre);
  });
</script>

<style is:global>
  .phif { margin: 1.5rem 0; }
  .phif .phif-grid { display: grid; grid-template-columns: 34px repeat(3, minmax(0, 1fr)); gap: 4px 8px; max-width: 700px; margin: 0 auto; }
  .phif .phif-col { font-size: 12px; font-weight: 600; color: var(--text); text-align: center; }
  .phif .phif-y { position: relative; font-size: 11px; color: var(--text-2); height: 132px; }
  .phif .phif-y > * { position: absolute; right: 0; line-height: 1; }
  .phif .phif-y b { font-size: 12.5px; color: var(--text); font-weight: 600; top: 25%; transform: translateY(-50%); }
  .phif .phif-y i { font-style: normal; white-space: nowrap; }
  .phif .phif-y i:nth-of-type(1) { top: 0; }
  .phif .phif-y i:nth-of-type(2) { top: 50%; transform: translateY(-50%); }
  .phif .phif-y i:nth-of-type(3) { bottom: 0; }
  .phif .phif-card { position: relative; height: 132px; border: 1px solid var(--border); border-radius: 4px; overflow: hidden; background: var(--surface); }
  .phif .phif-card canvas { display: block; width: 100%; height: 100%; image-rendering: pixelated; }
  .phif .phif-raie { position: absolute; width: 9px; height: 0; border-top: 2px solid var(--text); pointer-events: none; }
  .phif .phif-raie.g { left: 0; }
  .phif .phif-raie.d { right: 0; }
  .phif .phif-lab { position: absolute; right: 2px; transform: translateY(-4px); font-size: 11px; font-weight: 600; color: var(--text); background: color-mix(in srgb, var(--surface) 85%, transparent); padding: 0 3px; border-radius: 3px; line-height: 1.2; }
  .phif .phif-x { display: flex; justify-content: space-between; font-size: 11px; color: var(--text-2); }
  .phif .phif-x i { font-style: normal; }
</style>
