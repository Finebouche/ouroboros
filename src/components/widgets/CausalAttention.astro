---
// Widget du module 0 : matrice d'attention causale, entraînement parallèle vs génération pas à pas.
---
<div class="widget causal" data-widget="causal-attention">
  <div class="row">
    <button data-mode="train" class="active">Entraînement (teacher forcing)</button>
    <button data-mode="gen">Génération (token par token)</button>
  </div>
  <div class="row">
    <label>Longueur s <input type="range" data-ref="s" min="4" max="14" step="1" value="8" /></label>
    <b data-ref="s-out">8</b>
    <span data-ref="gen-ctl" hidden>
      <button data-ref="prev">&larr; pas</button>
      <button data-ref="next">pas suivant &rarr;</button>
    </span>
  </div>
  <svg data-ref="mat" width="100%" viewBox="0 0 680 400" role="img" aria-label="Matrice d'attention causale"></svg>
  <div class="kpis">
    <div><span>Étapes séquentielles</span><b data-ref="k-seq">1</b></div>
    <div><span>Cases calculées</span><b data-ref="k-cells">36</b></div>
    <div><span>K et V en mémoire</span><b data-ref="k-kv">8</b></div>
  </div>
</div>

<script>
  import { WORDS, attentionWeights } from './qkvData';

  document.querySelectorAll<HTMLElement>('[data-widget="causal-attention"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const svg = $('mat') as unknown as SVGSVGElement;
    const slider = $('s') as HTMLInputElement;
    const weights = attentionWeights();
    let mode: 'train' | 'gen' = 'train';
    let s = 8;
    let t = 1;

    function draw() {
      const cell = Math.min(34, Math.floor(300 / s));
      const ox = 130, oy = 78;
      let h = '';
      h += `<text class="ts" x="${ox}" y="16">Mot regardé (clé K, valeur V) →</text>`;
      h += `<text class="ts" x="8" y="${oy + (s * cell) / 2}">Mot qui</text>`;
      h += `<text class="ts" x="8" y="${oy + (s * cell) / 2 + 16}">regarde (Q)</text>`;
      for (let i = 0; i < s; i++) {
        h += `<text class="ts" x="${ox - 8}" y="${oy + i * cell + cell / 2 + 4}" text-anchor="end">${WORDS[i]}</text>`;
        const cx = ox + i * cell + cell / 2;
        h += `<text class="ts" x="${cx}" y="${oy - 8}" transform="rotate(-45 ${cx} ${oy - 8})">${WORDS[i]}</text>`;
        for (let j = 0; j < s; j++) {
          const allowed = j <= i;
          const visible = allowed && (mode === 'train' || i + 1 <= t);
          const current = mode === 'gen' && i + 1 === t;
          const fill = !allowed ? 'var(--surface-2)' : current ? 'var(--hl-bg)' : 'var(--surface)';
          const x0 = ox + j * cell, y0 = oy + i * cell;
          h += `<rect x="${x0}" y="${y0}" width="${cell - 2}" height="${cell - 2}" rx="3" fill="${fill}" stroke="var(--border)" stroke-width="0.5" opacity="${allowed ? 1 : 0.6}"/>`;
          if (visible) {
            const w = weights[i][j];
            const r = ((cell - 2) / 2 - 1) * Math.sqrt(w);
            const color = current ? 'var(--hl-stroke)' : mode === 'train' ? '#1d9e75' : '#5dcaa5';
            h += `<circle cx="${x0 + (cell - 2) / 2}" cy="${y0 + (cell - 2) / 2}" r="${r.toFixed(2)}" fill="${color}"><title>« ${WORDS[i]} » regarde « ${WORDS[j]} » : ${Math.round(w * 100)} %</title></circle>`;
          }
        }
      }
      const by = oy + s * cell + 28;
      if (mode === 'train') {
        h += `<text class="tt" x="${ox}" y="${by}">Toutes les lignes en un seul produit matriciel : Q × Kᵀ</text>`;
        h += `<text class="ts" x="${ox}" y="${by + 20}">Gris = masqué (le futur est interdit).</text>`;
        h += `<text class="ts" x="${ox}" y="${by + 38}">Disque = poids softmax(QKᵀ/√d_k) : chaque ligne somme à 100 %. Q et K tirés au hasard (non entraînés).</text>`;
      } else {
        h += `<text class="tt" x="${ox}" y="${by}">Pas ${t} : « ${WORDS[t - 1]} » regarde ${t === 1 ? 'seulement lui-même' : t <= 5 ? WORDS.slice(0, t).map((w) => `« ${w} »`).join(', ') : `les ${t} mots de « ${WORDS[0]} » à « ${WORDS[t - 1]} »`}</text>`;
        h += `<text class="ts" x="${ox}" y="${by + 20}">Ambre = ligne calculée maintenant. Vert clair = lignes déjà faites.</text>`;
        h += `<text class="ts" x="${ox}" y="${by + 38}">Disque = poids softmax(QKᵀ/√d_k) : chaque ligne somme à 100 %. Q et K tirés au hasard (non entraînés).</text>`;
      }
      svg.setAttribute('viewBox', `0 0 680 ${by + 56}`);
      svg.innerHTML = h;
      const cells = (s * (s + 1)) / 2;
      $('k-seq').textContent = String(mode === 'train' ? 1 : s);
      $('k-cells').textContent = mode === 'train' ? String(cells) : `${(t * (t + 1)) / 2} / ${cells}`;
      $('k-kv').textContent = String(mode === 'train' ? s : t);
    }

    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
      b.addEventListener('click', () => {
        mode = b.dataset.mode as 'train' | 'gen';
        t = 1;
        root.querySelectorAll('[data-mode]').forEach((o) => o.classList.toggle('active', o === b));
        $('gen-ctl').hidden = mode !== 'gen';
        draw();
      }),
    );
    slider.addEventListener('input', () => {
      s = +slider.value;
      $('s-out').textContent = String(s);
      if (t > s) t = s;
      draw();
    });
    $('next').addEventListener('click', () => { if (t < s) t++; draw(); });
    $('prev').addEventListener('click', () => { if (t > 1) t--; draw(); });
    draw();
  });
</script>

<style is:global>
  .widget svg text.ts { font: 12px var(--font); fill: var(--text-2); }
  .widget svg text.tt { font: 500 14px var(--font); fill: var(--text); }
</style>
