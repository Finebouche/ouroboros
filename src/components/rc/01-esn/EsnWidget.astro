---
// Cours Reservoir computing, chapitre 1 : courbe de mémoire. Pour chaque retard k, une lecture ridge apprend à sortir u(n − k) ;
// on trace le R² sur des pas jamais vus, selon le rayon spectral ρ. Courbes calculées au build (memoire.ts), aucune animation.
// Réglages vérifiés par simulation (Node, graine 7) : capacité 5,0 / 10,4 / 19,5 / 12,0 pour ρ = 0,3 / 0,6 / 0,9 / 1,2.
import { curveFor, capacity, N, KMAX, ALPHA, T, WASH, SPLIT } from './memoire.ts';
const RHOS = [0.3, 0.6, 0.9, 1.2], REF = 0.9;
const data = RHOS.map((rho) => { const r2 = curveFor(rho); return { rho, r2: r2.map((v) => +Math.max(0, v).toFixed(4)), mc: capacity(r2) }; });
const fm = (v: number, d = 1) => v.toFixed(d).replace('.', ',');
---
<div class="widget rcw esnw" data-widget="esnw" data-curves={JSON.stringify(data)} data-ref-rho={REF}>
  <div class="mhead">
    <div class="mtitle"><b>Combien de pas le réservoir se <span class="nw">souvient-il&nbsp;?</span></b></div>
    <div class="mstat"><span>capacité mémoire</span><b data-ref="mc"></b></div>
  </div>
  <div class="row"><span>Rayon spectral ρ</span><span class="seg" data-ref="rho">
    {data.map((d, i) => <button data-v={i} class={i === 0 ? 'active' : ''}>{fm(d.rho)}</button>)}
  </span></div>
  <div class="plot"><svg data-ref="svg" role="img" aria-label="R² de la reconstruction de u(n − k) en fonction du retard k"></svg></div>
  <p class="note">{N} neurones, entrée : bruit blanc uniforme sur [−1, 1], échelle d'entrée 0,1. Lecture ridge (α = 10<sup>−4</sup>) entraînée sur {(SPLIT - WASH).toLocaleString('fr-FR')} pas, R² mesuré sur {(T - SPLIT).toLocaleString('fr-FR')} autres (négatif ramené à 0). Capacité mémoire : somme des R² de k = 1 à {KMAX}.</p>
</div>

<script>
  type Curve = { rho: number; r2: number[]; mc: number };
  document.querySelectorAll<HTMLElement>('[data-widget="esnw"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const data: Curve[] = JSON.parse(root.dataset.curves!), REF = +root.dataset.refRho!;
    const ref = data.find((d) => d.rho === REF)!;
    const fm = (v: number, d = 1) => v.toFixed(d).replace('.', ',');
    let cur = 0;
    const plot = root.querySelector<HTMLElement>('.plot')!;
    // retard où R² passe sous 0,5 (interpolé), pour placer l'étiquette directe
    const half = (r2: number[]) => { for (let k = 1; k < r2.length; k++) if (r2[k] < 0.5) return k - 1 + (r2[k - 1] - 0.5) / (r2[k - 1] - r2[k]); return r2.length - 1; };

    function draw() {
      const d = data[cur], K = d.r2.length - 1;
      $('rho').querySelectorAll('button').forEach((b) => b.classList.toggle('active', +b.dataset.v! === cur));
      $('mc').textContent = fm(d.mc);
      // largeur du viewBox = largeur affichée : le texte garde sa taille sur mobile
      const W = Math.max(320, Math.min(680, Math.round(plot.clientWidth || 640))), H = W < 480 ? 220 : 250;
      const ox = 34, oy = 10, pw = W - ox - 10, ph = H - oy - 38;
      const X = (k: number) => ox + (k / K) * pw, Y = (v: number) => oy + ph - v * ph;
      let s = '';
      [0, 0.5, 1].forEach((v) => (s += `<line x1="${ox}" y1="${Y(v)}" x2="${ox + pw}" y2="${Y(v)}" stroke="var(--border)" stroke-dasharray="${v === 0 ? '' : '2 4'}"/><text x="${ox - 6}" y="${Y(v) + 3.5}" text-anchor="end" class="ax">${String(v).replace('.', ',')}</text>`));
      [0, 10, 20, 30, 40].forEach((k) => (s += `<text x="${X(k)}" y="${oy + ph + 15}" text-anchor="middle" class="ax">${k}</text>`));
      s += `<text x="${ox + pw / 2}" y="${oy + ph + 31}" text-anchor="middle" class="ax">retard k (pas) : la lecture doit sortir u(n − k)</text>`;
      s += `<text x="4" y="${Y(0.75) + 4}" class="ax">R<tspan baseline-shift="super" font-size="8">2</tspan></text>`;
      const pl = (r2: number[]) => r2.map((v, k) => `${X(k).toFixed(1)},${Y(v).toFixed(1)}`).join(' ');
      const labs: { t: string; k: number; c: string; w: number }[] = [];
      if (d !== ref) {
        s += `<polyline points="${pl(ref.r2)}" fill="none" stroke="var(--text-2)" stroke-width="1.4" stroke-dasharray="4 3"/>`;
        labs.push({ t: `ρ = ${fm(REF)} (référence)`, k: half(ref.r2), c: 'var(--text-2)', w: 400 });
      }
      s += `<polyline points="${pl(d.r2)}" fill="none" stroke="var(--r-out)" stroke-width="2.6" stroke-linejoin="round"/>`;
      labs.push({ t: `ρ = ${fm(d.rho)}`, k: half(d.r2), c: 'var(--r-out)', w: 600 });
      // étiquettes directes, juste à droite du point où la courbe passe sous 0,5
      labs.forEach((l) => {
        const x = X(l.k) + 6, anchor = x > ox + pw - 120 ? 'end' : 'start';
        s += `<text x="${(anchor === 'end' ? X(l.k) - 6 : x).toFixed(1)}" y="${(Y(0.5) - 6).toFixed(1)}" text-anchor="${anchor}" class="lb" style="fill:${l.c};font-weight:${l.w}">${l.t}</text>`;
      });
      const svg = $('svg') as unknown as SVGSVGElement;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`); svg.innerHTML = s;
    }
    $('rho').querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { cur = +b.dataset.v!; draw(); }));
    let rw = 0;
    new ResizeObserver(() => { if (plot.clientWidth !== rw) { rw = plot.clientWidth; draw(); } }).observe(plot);
    draw();
  });
</script>

<style is:global>
  .esnw .mhead { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .esnw .mtitle { line-height: 1.35; }
  .esnw .mtitle b { font-size: 15px; font-weight: 600; margin-right: 10px; }
  .esnw .mtitle .nw { white-space: nowrap; }
  .esnw .mstat { display: flex; align-items: baseline; gap: 8px; background: var(--surface-2); border-radius: 8px; padding: 4px 10px; }
  .esnw .mstat span { font-size: 12px; color: var(--text-2); }
  .esnw .mstat b { font-size: 14px; font-weight: 600; color: var(--r-out); }
  .esnw .row { margin-bottom: 6px; font-size: 13px; }
  .esnw .row > .seg { display: inline-flex; flex-wrap: wrap; gap: 6px; }
  .esnw .row > .seg button { font-size: 13px; padding: 4px 12px; }
  .esnw .plot { width: 100%; }
  .esnw svg[data-ref="svg"] { width: 100%; height: auto; display: block; margin: 0; }
  .esnw svg[data-ref="svg"] text.ax { font: 11px var(--font); fill: var(--text-2); }
  .esnw svg[data-ref="svg"] text.lb { font: 11.5px var(--font); }
</style>
