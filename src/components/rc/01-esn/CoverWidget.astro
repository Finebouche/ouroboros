---
// Cours Reservoir computing, chapitre 1 : combien de neurones pour séparer XOR ? P = 20 points du plan (5 par quadrant, graine 124),
// un réservoir statique φ(u) = tanh(W_in u + b) à N neurones (gain 2, graine 68 par défaut), une lecture linéaire sans constante.
// Test exact de séparabilité (simplexe, cover.ts) ; lecture affichée : Ho-Kashyap, ou le certificat du test exact s'il est le seul à séparer.
// Vérifié en Node avec ces réglages : erreurs 8, 6, 4, 2, 0 pour N = 2, 3, 4, 6, 8 ; sur 300 tirages du réservoir, XOR séparé
// 0 fois à N = 2, 18 à N = 3, 82 à N = 4, 239 à N = 6, 294 à N = 8.
---
<div class="widget rcw cvw" data-widget="cvw">
  <div class="cvhead">
    <b>Combien de neurones pour séparer XOR ?</b>
    <div class="cvstat"><span>mal classés</span><b data-ref="err">–</b></div>
  </div>
  <div class="cvrow">
    <span class="cvlab">Neurones N</span>
    <span class="seg" data-ref="N"></span>
    <button data-ref="draw">nouveau tirage</button>
  </div>
  <div class="cvplot"><svg data-ref="svg" viewBox="0 0 290 284" role="img" aria-label="Plan d'entrée : points des deux classes, région où la lecture sort +, frontière de la lecture"></svg></div>
  <p class="note" data-ref="note"></p>
</div>

<script>
  import { makePoints, makeProj, phi, fit, separable } from './cover';

  let uid = 0;
  document.querySelectorAll<HTMLElement>('[data-widget="cvw"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const P = 20, NS = [2, 3, 4, 6, 8], NMAX = 8, id = `cvm${uid++}`;
    const pts = makePoints('xor', P, 124);
    let N = 2, seed = 68;
    NS.forEach((n) => {
      const b = document.createElement('button'); b.textContent = String(n); b.dataset.v = String(n);
      b.addEventListener('click', () => { N = n; draw(); });
      $('N').appendChild(b);
    });
    $('draw').addEventListener('click', () => { seed++; draw(); });

    // plan d'entrée [−1,15 ; 1,15]², carré de S unités
    const X0 = 40, Y0 = 8, S = 240, LIM = 1.15;
    const sx = (v: number) => X0 + ((v + LIM) / (2 * LIM)) * S, sy = (v: number) => Y0 + (1 - (v + LIM) / (2 * LIM)) * S;

    function draw() {
      $('N').querySelectorAll('button').forEach((b) => b.classList.toggle('active', +(b as HTMLElement).dataset.v! === N));
      const proj = makeProj(NMAX, seed);
      const F = pts.x.map((x) => phi(proj, N, x));
      const ex = separable(F, pts.y), hk = fit(F, pts.y);
      const w = ex.sep && hk.err > 0 ? ex.w : hk.w;
      const out = (u: [number, number]) => phi(proj, N, u).reduce((s, z, j) => s + z * w[j], 0);
      const bad = pts.x.map((u, i) => pts.y[i] * out(u) <= 1e-12);
      const nbad = bad.filter(Boolean).length;

      // région « sortie + » : masque calculé sur une toile (2 pixels par unité), une seule image, pas de tapis de rectangles
      const R = 2 * S, cv = document.createElement('canvas'); cv.width = cv.height = R;
      const ctx = cv.getContext('2d')!, img = ctx.createImageData(R, R);
      for (let j = 0; j < R; j++) for (let i = 0; i < R; i++) {
        const v = out([-LIM + ((i + 0.5) / R) * 2 * LIM, LIM - ((j + 0.5) / R) * 2 * LIM]) > 0 ? 255 : 0, k = 4 * (j * R + i);
        img.data[k] = img.data[k + 1] = img.data[k + 2] = v; img.data[k + 3] = 255;
      }
      ctx.putImageData(img, 0, 0);

      // frontière y = 0 par carrés marchants (grille G × G)
      const G = 96, val: number[][] = [];
      for (let j = 0; j <= G; j++) { val.push([]); for (let i = 0; i <= G; i++) val[j].push(out([-LIM + (i / G) * 2 * LIM, LIM - (j / G) * 2 * LIM])); }
      const px = (i: number) => X0 + (i / G) * S, py = (j: number) => Y0 + (j / G) * S;
      let d = '';
      for (let j = 0; j < G; j++) for (let i = 0; i < G; i++) {
        const c = [[i, j], [i + 1, j], [i + 1, j + 1], [i, j + 1]] as const, cut: [number, number][] = [];
        for (let e = 0; e < 4; e++) {
          const [a1, b1] = c[e], [a2, b2] = c[(e + 1) % 4], v1 = val[b1][a1], v2 = val[b2][a2];
          if ((v1 > 0) !== (v2 > 0)) { const t = v1 / (v1 - v2); cut.push([px(a1 + t * (a2 - a1)), py(b1 + t * (b2 - b1))]); }
        }
        for (let k = 0; k + 1 < cut.length; k += 2) d += `M${cut[k][0].toFixed(1)},${cut[k][1].toFixed(1)}L${cut[k + 1][0].toFixed(1)},${cut[k + 1][1].toFixed(1)}`;
      }

      let g = `<defs><clipPath id="${id}c"><rect x="${X0}" y="${Y0}" width="${S}" height="${S}"/></clipPath><mask id="${id}"><image href="${cv.toDataURL()}" x="${X0}" y="${Y0}" width="${S}" height="${S}" preserveAspectRatio="none"/></mask></defs>`;
      g += `<rect x="${X0}" y="${Y0}" width="${S}" height="${S}" fill="var(--r-out)" fill-opacity="0.13" mask="url(#${id})"/>`;
      g += `<line x1="${sx(-LIM)}" y1="${sy(0)}" x2="${sx(LIM)}" y2="${sy(0)}" stroke="var(--border)"/><line x1="${sx(0)}" y1="${sy(-LIM)}" x2="${sx(0)}" y2="${sy(LIM)}" stroke="var(--border)"/>`;
      g += `<path d="${d}" fill="none" stroke="var(--r-out)" stroke-width="1.6" stroke-linecap="round" clip-path="url(#${id}c)"/>`;
      g += `<rect x="${X0}" y="${Y0}" width="${S}" height="${S}" fill="none" stroke="var(--border)"/>`;
      [-1, 0, 1].forEach((v) => {
        g += `<text x="${sx(v)}" y="${Y0 + S + 14}" text-anchor="middle" class="ax">${v === -1 ? '−1' : v}</text>`;
        g += `<text x="${X0 - 6}" y="${sy(v) + 4}" text-anchor="end" class="ax">${v === -1 ? '−1' : v}</text>`;
      });
      g += `<text x="${X0 + S / 2}" y="${Y0 + S + 28}" text-anchor="middle" class="ax">u<tspan baseline-shift="sub" font-size="8.5">1</tspan></text>`;
      g += `<text x="${X0 - 32}" y="${Y0 + S / 2 + 4}" text-anchor="middle" class="ax">u<tspan baseline-shift="sub" font-size="8.5">2</tspan></text>`;
      pts.x.forEach((u, i) => {
        if (bad[i]) g += `<circle cx="${sx(u[0])}" cy="${sy(u[1])}" r="8" fill="none" stroke="var(--h-py)" stroke-width="1.6"/>`;
        g += pts.y[i] > 0
          ? `<circle cx="${sx(u[0])}" cy="${sy(u[1])}" r="4" fill="var(--text)"/>`
          : `<circle cx="${sx(u[0])}" cy="${sy(u[1])}" r="3.6" fill="var(--surface)" stroke="var(--text)" stroke-width="1.4"/>`;
      });
      ($('svg') as unknown as SVGSVGElement).innerHTML = g;

      $('err').innerHTML = nbad ? `<span class="r">${nbad} sur ${P}</span>` : `0 sur ${P}`;
      $('note').innerHTML = (nbad
        ? `<b>Non séparable</b> avec ces ${N} neurones (test exact). Cerclés : erreurs de la meilleure lecture trouvée. `
        : `<b>Séparable</b> avec ces ${N} neurones. `)
        + `Plein : +1, creux : −1, teinte : sortie +. W<sub>in</sub> et b tirés au hasard et figés (« nouveau tirage » en tire d'autres), lecture sans constante.`;
    }
    draw();
  });
</script>

<style is:global>
  .cvw .cvhead { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .cvw .cvhead > b { font-size: 15px; font-weight: 600; color: var(--text); }
  .cvw .cvstat { display: flex; align-items: baseline; gap: 8px; background: var(--surface-2); border-radius: 8px; padding: 4px 10px; }
  .cvw .cvstat span { font-size: 12px; color: var(--text-2); }
  .cvw .cvstat b { font-size: 14px; font-weight: 600; color: var(--text); }
  .cvw .cvstat .r { color: var(--h-py); }
  .cvw .cvrow { display: flex; flex-wrap: wrap; gap: 8px 10px; align-items: center; }
  .cvw .cvlab { font-size: 13px; color: var(--text-2); }
  .cvw .seg { display: inline-flex; flex-wrap: wrap; gap: 6px; }
  .cvw .cvrow > button[data-ref="draw"] { margin-left: auto; }
  .cvw svg[data-ref="svg"] { width: 100%; max-width: 330px; height: auto; display: block; margin: 10px auto 0; }
  .cvw svg[data-ref="svg"] text.ax { font: 11px var(--font); fill: var(--text-2); }
  .cvw .note { font-size: 12.5px; color: var(--text-2); line-height: 1.5; margin: 8px 0 0; }
  .cvw .note b { color: var(--text); font-weight: 600; }
</style>
