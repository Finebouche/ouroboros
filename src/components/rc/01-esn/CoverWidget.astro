---
// Cours Reservoir computing, chapitre 1 : théorème de Cover. P = 20 points du plan, deux classes. Un réservoir statique φ(u) = tanh(W_in u + b)
// les envoie dans R^N ; une lecture linéaire sans constante (hyperplan par l'origine) tente de les séparer (algorithme de Ho-Kashyap, voir cover.ts).
// Tout ce qui est affiché est calculé ici : erreurs de la lecture trouvée, C(P, N). Réglages vérifiés par simulation (Node) : gain 2, 60 tirages.
import katex from 'katex';
const tex = (s: string) => katex.renderToString(s, { throwOnError: false });
const F1 = tex('\\varphi(u) = \\tanh\\big(W_{in}\\,u + b\\big) \\in \\mathbb{R}^N');
const F1b = tex('y = w^{\\top}\\varphi(u)');
const F2 = tex('C(P,N) = 2\\sum_{j=0}^{N-1} \\binom{P-1}{j}');
---
<div class="widget rcw cvw" data-widget="cvw">
  <div class="cvrow">
    <span class="seg" data-ref="task"></span>
    <span class="seg" data-ref="feat"></span>
    <button data-ref="draw">nouveau tirage</button>
  </div>
  <label class="cvsl"><span>Neurones N</span><input type="range" data-ref="N" min="1" max="30" step="1" value="4" /><b data-ref="N-out"></b></label>
  <div class="calc">
    <div class="fm" set:html={F1} />
    <div class="fm" set:html={F1b} />
    <div class="fm" set:html={F2} />
    <div class="ln" data-ref="line"></div>
  </div>
  <div class="scr"><svg data-ref="svg" role="img" aria-label="À gauche, les points du plan et la frontière de la lecture ; à droite, la part des étiquetages séparables selon N"></svg></div>
  <div class="kpis">
    <div><span>Points mal classés</span><b data-ref="k1">–</b><i data-ref="k1i"></i></div>
    <div><span>Part séparable (Cover)</span><b data-ref="k2">–</b><i data-ref="k2i"></i></div>
  </div>
  <p class="note">Réservoir statique (pas de récurrence), W<sub>in</sub> et b tirés une fois et figés ; seule la lecture <i>w</i>, sans constante, est cherchée. Zéro erreur prouve que les points sont séparables ; des erreurs restantes ne prouvent pas le contraire.</p>
</div>

<script>
  import { coverCount, makePoints, makeProj, phi, fit } from './cover';

  document.querySelectorAll<HTMLElement>('[data-widget="cvw"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const P = 20, NMAX = 30;
    const proj = makeProj(NMAX, 101);
    let kind: 'xor' | 'rand' = 'xor', raw = false, N = 4, seed = 1;
    const fm = (v: number, d = 1) => v.toFixed(d).replace('.', ',');
    const big = (v: number) => v.toLocaleString('fr-FR');
    const mkSeg = (ref: string, items: [string, () => void][], act: () => number) => {
      items.forEach(([lab, f], i) => {
        const b = document.createElement('button'); b.textContent = lab; b.dataset.v = String(i);
        b.addEventListener('click', () => { f(); draw(); });
        $(ref).appendChild(b);
      });
      return () => $(ref).querySelectorAll('button').forEach((b) => b.classList.toggle('active', +(b as HTMLElement).dataset.v! === act()));
    };
    const syncTask = mkSeg('task', [['XOR', () => (kind = 'xor')], ['étiquettes au hasard', () => (kind = 'rand')]], () => (kind === 'xor' ? 0 : 1));
    const syncFeat = mkSeg('feat', [['entrée brute', () => (raw = true)], ['réservoir statique', () => (raw = false)]], () => (raw ? 0 : 1));
    $('draw').addEventListener('click', () => { seed++; draw(); });
    const nIn = $('N') as HTMLInputElement;
    nIn.addEventListener('input', () => { N = +nIn.value; draw(); });

    function draw() {
      syncTask(); syncFeat();
      nIn.disabled = raw; $('N-out').textContent = raw ? '–' : String(N);
      const pts = makePoints(kind, P, seed);
      const dim = raw ? 0 : N;
      const F = pts.x.map((x) => phi(proj, dim, x));
      const { w, err } = fit(F, pts.y);
      const dot = (u: [number, number]) => phi(proj, dim, u).reduce((s, z, j) => s + z * w[j], 0);

      // panneau de gauche : plan d'entrée, région où la lecture sort + ; points ; erreurs cerclées
      const W = 640, H = 250, L = { x: 8, y: 22, s: 220 };
      const sx = (v: number) => L.x + ((v + 1.15) / 2.3) * L.s, sy = (v: number) => L.y + (1 - (v + 1.15) / 2.3) * L.s;
      let g = `<text x="${L.x + L.s / 2}" y="12" text-anchor="middle" class="zl">plan d'entrée u</text>`;
      g += `<rect x="${L.x}" y="${L.y}" width="${L.s}" height="${L.s}" fill="none" stroke="var(--border)"/>`;
      const G = 44, cell = L.s / G;
      for (let i = 0; i < G; i++) for (let j = 0; j < G; j++) {
        const ux = -1.15 + ((i + 0.5) / G) * 2.3, uy = 1.15 - ((j + 0.5) / G) * 2.3;
        if (dot([ux, uy]) > 0) g += `<rect x="${(L.x + i * cell).toFixed(1)}" y="${(L.y + j * cell).toFixed(1)}" width="${(cell + 0.4).toFixed(1)}" height="${(cell + 0.4).toFixed(1)}" fill="var(--r-out)" fill-opacity="0.16"/>`;
      }
      g += `<line x1="${sx(-1.15)}" y1="${sy(0)}" x2="${sx(1.15)}" y2="${sy(0)}" stroke="var(--border)"/><line x1="${sx(0)}" y1="${sy(-1.15)}" x2="${sx(0)}" y2="${sy(1.15)}" stroke="var(--border)"/>`;
      pts.x.forEach((u, i) => {
        const bad = pts.y[i] * dot(u) <= 1e-12;
        if (bad) g += `<circle cx="${sx(u[0])}" cy="${sy(u[1])}" r="8" fill="none" stroke="var(--h-py)" stroke-width="1.6"/>`;
        g += pts.y[i] > 0
          ? `<circle cx="${sx(u[0])}" cy="${sy(u[1])}" r="4" fill="var(--text)"/>`
          : `<circle cx="${sx(u[0])}" cy="${sy(u[1])}" r="3.6" fill="var(--surface)" stroke="var(--text)" stroke-width="1.4"/>`;
      });
      g += `<text x="${L.x + L.s / 2}" y="${L.y + L.s + 14}" text-anchor="middle" class="zl">plein : +1 · creux : −1 · teinte : sortie +</text>`;

      // panneau de droite : part des étiquetages séparables C(P,N) / 2^P selon N
      const R = { x: 296, y: 22, w: 310, h: 200 };
      const cx = (n: number) => R.x + 34 + (n / NMAX) * (R.w - 34), cy = (p: number) => R.y + (1 - p) * R.h;
      g += `<text x="${R.x + R.w / 2 + 17}" y="12" text-anchor="middle" class="zl">part des 2^P étiquetages séparables, P = ${P}</text>`;
      [0, 0.5, 1].forEach((p) => (g += `<line x1="${cx(0)}" y1="${cy(p)}" x2="${cx(NMAX)}" y2="${cy(p)}" stroke="var(--border)" ${p === 0.5 ? 'stroke-dasharray="2 3"' : ''}/><text x="${cx(0) - 5}" y="${cy(p) + 3}" text-anchor="end" class="zl">${p * 100} %</text>`));
      [0, 10, 20, 30].forEach((n) => (g += `<text x="${cx(n)}" y="${R.y + R.h + 14}" text-anchor="middle" class="zl">${n}</text>`));
      g += `<text x="${cx(NMAX / 2)}" y="${R.y + R.h + 28}" text-anchor="middle" class="zl">neurones N</text>`;
      let d = '';
      for (let n = 1; n <= NMAX; n++) d += `${n === 1 ? 'M' : 'L'}${cx(n).toFixed(1)},${cy(coverCount(P, n) / 2 ** P).toFixed(1)} `;
      g += `<path d="${d}" fill="none" stroke="var(--text-2)" stroke-width="1.6"/>`;
      g += `<text x="${cx(10) + 6}" y="${cy(0.5) - 6}" class="zl">N = P/2 = 10</text>`;
      if (!raw) g += `<circle cx="${cx(N)}" cy="${cy(coverCount(P, N) / 2 ** P)}" r="5" fill="var(--r-out)"/>`;
      const svg = $('svg') as unknown as SVGSVGElement;
      svg.setAttribute('viewBox', `0 0 ${W} ${R.y + R.h + 40}`); svg.innerHTML = g;

      const C = raw ? coverCount(P, 2) : coverCount(P, N), tot = 2 ** P;
      $('line').textContent = raw
        ? `Sans réservoir : les points restent dans R², N = 2. C(${P}, 2) = ${big(C)} étiquetages séparables sur ${big(tot)}.`
        : `P = ${P} points, N = ${N} : C(${P}, ${N}) = ${big(C)} étiquetages séparables sur 2^${P} = ${big(tot)}, soit ${fm((100 * C) / tot)} %.`;
      $('k1').innerHTML = err ? `<span class="r">${err} sur ${P}</span>` : `0 sur ${P}`;
      $('k1i').textContent = err ? 'lecture trouvée, séparation non trouvée' : 'séparés : la lecture trouvée classe tout juste';
      $('k2').textContent = `${fm((100 * C) / tot)} %`;
      $('k2i').textContent = `formule C(${P}, ${raw ? 2 : N}) / 2^${P}, étiquettes au hasard : théorique, pas mesurée`;
    }
    draw();
  });
</script>

<style is:global>
  .cvw .cvrow { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; margin-bottom: 8px; }
  .cvw .seg { display: inline-flex; flex-wrap: wrap; gap: 6px; }
  .cvw .cvrow > button[data-ref="draw"] { margin-left: auto; }
  .cvw .cvsl { max-width: 340px; }
  .cvw .calc { margin-top: 10px; padding: 8px 12px; border-radius: 10px; background: color-mix(in srgb, var(--text-2) 4.5%, transparent); }
  .cvw .fm { font-size: 0.92rem; overflow-x: auto; overflow-y: hidden; margin: 2px 0; }
  .cvw .ln { font: 11.5px/1.5 var(--mono); color: var(--text-2); min-height: 1.5em; margin-top: 4px; }
  .cvw .scr { overflow-x: auto; }
  .cvw svg { min-width: 600px; width: 100%; height: auto; display: block; margin: 8px auto 0; max-width: 680px; }
  .cvw svg text.zl { font: 11px var(--font); fill: var(--text-2); }
  .cvw .kpis .r { color: var(--h-py); }
  .cvw .note { font-size: 12.5px; color: var(--text-2); line-height: 1.5; margin: 8px 0 0; }
</style>
