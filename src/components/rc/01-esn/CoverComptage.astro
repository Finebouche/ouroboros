---
// Cours Reservoir computing, chapitre 1 : figure statique du théorème de comptage dans le plan (N = 2). Pour P = 3 puis P = 4 points fixes,
// tous les étiquetages possibles (2^P), chacun avec la droite par l'origine qui le sépare, ou une croix s'il n'y en a pas.
// Les droites sont calculées ici (secteurs de l'espace des poids), pas dessinées à la main ; on retrouve C(P, 2) = 2P.
const ANG = [15, 62, 118, 170], RAD = [0.9, 0.62, 0.85, 0.55], TAU = 2 * Math.PI;
const PTS = ANG.map((a, i) => [RAD[i] * Math.cos((a * Math.PI) / 180), RAD[i] * Math.sin((a * Math.PI) / 180)]);
const norm = (a: number) => ((a % TAU) + TAU) % TAU;
const S = 76, C = S / 2, SC = 29;
function panels(P: number) {
  const pts = PTS.slice(0, P);
  const labOf = (ang: number) => pts.map((x) => (Math.cos(ang) * x[0] + Math.sin(ang) * x[1] > 0 ? 1 : 0));
  const bounds = [...new Set(pts.flatMap((x) => { const a = Math.atan2(x[1], x[0]); return [norm(a + Math.PI / 2), norm(a - Math.PI / 2)]; }))].sort((u, v) => u - v);
  const found = new Map<string, number>();
  bounds.forEach((a1, k) => { const a2 = k + 1 < bounds.length ? bounds[k + 1] : bounds[0] + TAU; const mid = (a1 + a2) / 2; found.set(labOf(mid).join(''), mid); });
  const out = [];
  for (let m = 0; m < 2 ** P; m++) {
    const lab = pts.map((_, i) => (m >> (P - 1 - i)) & 1);
    const w = found.get(lab.join(''));
    out.push({ lab, w });
  }
  return { pts, out, n: found.size };
}
const rows = [3, 4].map((P) => ({ P, ...panels(P) }));
const R = 120;
const half = (w: number) => {
  const u = [-Math.sin(w), Math.cos(w)], c = [Math.cos(w), Math.sin(w)];
  return [[1, 0], [-1, 0], [-1, 1], [1, 1]].map(([a, b]) => `${(C + R * (a * u[0] + b * c[0])).toFixed(1)},${(C - R * (a * u[1] + b * c[1])).toFixed(1)}`).join(' ');
};
---
<figure class="cnf">
  {rows.map((r) => (
    <div class="cnfr">
      <div class="cnft"><b>P = {r.P} points</b><span>{2 ** r.P} étiquetages, <em>{r.n}</em> séparables</span></div>
      <div class="cnfg">
        {r.out.map((p) => (
          <svg viewBox={`0 0 ${S} ${S}`} role="img" aria-label={p.w === undefined ? 'étiquetage non séparable' : 'étiquetage séparable'} class={p.w === undefined ? 'no' : 'ok'}>
            <rect x="0.5" y="0.5" width={S - 1} height={S - 1} rx="4" fill="none" stroke="var(--border)" />
            <line x1="0" y1={C} x2={S} y2={C} stroke="var(--border)" /><line x1={C} y1="0" x2={C} y2={S} stroke="var(--border)" />
            {p.w !== undefined && <polygon points={half(p.w)} fill="var(--r-out)" fill-opacity="0.16" />}
            {p.w !== undefined && <line x1={C + R * Math.sin(p.w)} y1={C + R * Math.cos(p.w)} x2={C - R * Math.sin(p.w)} y2={C - R * Math.cos(p.w)} stroke="var(--r-out)" stroke-width="1.8" />}
            {r.pts.map((x, i) => p.lab[i]
              ? <circle cx={C + SC * x[0]} cy={C - SC * x[1]} r="4" fill="var(--text)" />
              : <circle cx={C + SC * x[0]} cy={C - SC * x[1]} r="3.5" fill="var(--surface)" stroke="var(--text)" stroke-width="1.3" />)}
            {p.w === undefined && <g stroke="var(--h-py)" stroke-width="2.2" stroke-linecap="round"><line x1={S - 20} y1="8" x2={S - 8} y2="20" /><line x1={S - 8} y1="8" x2={S - 20} y2="20" /></g>}
          </svg>
        ))}
      </div>
    </div>
  ))}
  <figcaption>Mêmes points, tous les étiquetages (plein : +, creux : −, teinte : côté + de la droite). Une croix rouge : aucune droite passant par l'origine ne sépare ces étiquettes. Le compte suit la formule : 6 sur 8 pour P = 3, 8 sur 16 pour P = 4, soit 2P dans le plan.</figcaption>
</figure>

<style is:global>
  .cnf { margin: 1.5rem 0; }
  .cnf .cnfr + .cnfr { margin-top: 14px; }
  .cnf .cnft { display: flex; flex-wrap: wrap; gap: 2px 12px; align-items: baseline; margin-bottom: 6px; font-size: 13px; color: var(--text-2); }
  .cnf .cnft b { color: var(--text); font-size: 13px; }
  .cnf .cnft em { font-style: normal; font-weight: 600; color: var(--text); }
  .cnf .cnfg { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 6px; }
  .cnf .cnfg svg { width: 100%; height: auto; display: block; }
  .cnf .cnfg svg.no { opacity: 0.85; }
  @media (max-width: 560px) { .cnf .cnfg { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .cnf figcaption { font-size: 12.5px; color: var(--text-2); line-height: 1.5; margin-top: 10px; }
</style>
