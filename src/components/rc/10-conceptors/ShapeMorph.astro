---
// Cours Reservoir computing, chapitre 10 : mélange de deux conceptors, (1 − μ) C_A + μ C_B, sur quatre formes 2D tracées par le réservoir
// (shapes.ts, calculé à la construction). Rangée du haut : A, μ = 0,1 … 0,9, B en petites figures (un bouton par μ, pas de curseur) ;
// en dessous, la figure choisie en grand, avec A et B seuls en pointillés gris pour comparer.
// Animation lancée par un clic (jamais au chargement), 30 pas par seconde : « lecture » fait tracer la forme choisie par un stylo
// avec une traînée qui s'efface ; « transition » rejoue la transition précalculée où μ passe de 0 à 1 en 180 pas, comme dans la vidéo de Jaeger.
import { getShapes, SHAPES, MUS } from './shapes';
const E = getShapes();
const NAMES = SHAPES.map((s) => s.name);
const data = { NAMES, MUS, single: E.single, mixes: E.mixes, trans: E.trans, TRANS: E.TRANS };
---
<div class="widget rcw shapew" data-widget="shapew">
  <div class="row"><span class="lb">Forme A :</span><span class="seg" data-ref="a"></span></div>
  <div class="row"><span class="lb">Forme B :</span><span class="seg" data-ref="b"></span></div>
  <div class="row"><span class="lb">Animation :</span><span class="seg"><button data-ref="go"></button><button data-ref="play">▶ lecture</button></span></div>
  <div class="ft gt" data-ref="title"></div>
  <div class="strip" data-ref="strip"></div>
  <svg data-ref="big" viewBox="0 0 300 250" role="img" aria-label="Forme tracée par le réservoir avec le conceptor choisi, et les deux formes de départ en pointillés"></svg>
  <p class="note">Formes tracées par le réservoir seul : sortie (x, y) lue par la lecture entraînée, après 1500 pas. Un tour = 30 pas, joué à 30 pas par seconde ; pendant la transition, μ passe de 0 à 1 en 180 pas (6 tours). Réservoir de 200 neurones tiré au hasard (graine fixe), α = 20.</p>
</div>

<script define:vars={{ data }}>
  document.querySelectorAll('[data-widget="shapew"]').forEach((root) => {
    const $ = (r) => root.querySelector(`[data-ref="${r}"]`);
    const f1 = (v) => v.toFixed(1).replace('.', ',');
    const { HA, TR } = data.TRANS;
    let A = 0, B = 2, k = 5; // k : 0 = A seul, 1 à 9 = μ = 0,1 à 0,9, 10 = B seul
    // animation : mode 'steady' (boucle sur la case k) ou 'trans' (transition A → B) ; t = position (fractionnaire) dans seq
    let playing = false, mode = 'steady', seq = null, t = 0, raf = 0, last = 0, trail = [];
    // points tracés pour la case k, lus dans la paire rangée (a < c)
    const pts = (k) => {
      if (k === 0) return data.single[A];
      if (k === 10) return data.single[B];
      const mu = data.MUS[k - 1];
      return A < B ? data.mixes[`${A}-${B}-${mu.toFixed(1)}`] : data.mixes[`${B}-${A}-${(1 - mu).toFixed(1)}`];
    };
    // un mélange ne boucle pas toujours en 30 pas : on boucle sur la longueur (60 à 119 pas) dont la fin rejoint le mieux le début
    const loopOf = (p) => {
      let L = 60, best = Infinity;
      for (let l = 60; l < p.length; l++) { const d = Math.hypot(p[l][0] - p[0][0], p[l][1] - p[0][1]); if (d < best) { best = d; L = l; } }
      return p.slice(0, L);
    };
    const nearest = (arr, q) => { let j = 0, b = Infinity; arr.forEach((p, i) => { const d = Math.hypot(p[0] - q[0], p[1] - q[1]); if (d < b) { b = d; j = i; } }); return j; };
    const at = (i) => (mode === 'trans' ? seq[Math.min(i, seq.length - 1)] : seq[((i % seq.length) + seq.length) % seq.length]);
    const pen = () => { const i = Math.floor(t), f = t - i, a = at(i), b = at(i + 1); return [a[0] + f * (b[0] - a[0]), a[1] + f * (b[1] - a[1])]; };
    const muAt = () => Math.min(1, Math.max(0, (t - HA) / TR));
    // régime établi sur la case k, depuis le point le plus proche de `from` (pas de saut du stylo)
    function setSteady(from) { mode = 'steady'; seq = loopOf(pts(k)); t = from ? nearest(seq, from) : 0; }

    const path = (p, cx, cy, s) => p.map(([x, y], i) => `${i ? 'L' : 'M'}${(cx + x * s).toFixed(1)},${(cy - y * s).toFixed(1)}`).join('');
    const mk = (key, label, onClick) => { const b = document.createElement('button'); b.textContent = label; b.addEventListener('click', onClick); $(key).appendChild(b); return b; };
    // changer A, B ou la case : la transition s'arrête ; en lecture, le stylo continue sur la nouvelle forme
    const changed = () => { if (playing) setSteady(pen()); else { trail = []; mode = 'steady'; } draw(); };
    const btA = data.NAMES.map((n, i) => mk('a', n, () => { if (i === B) B = A; A = i; changed(); }));
    const btB = data.NAMES.map((n, i) => mk('b', n, () => { if (i === A) A = B; B = i; changed(); }));
    const cells = Array.from({ length: 11 }, (_, i) => {
      const b = document.createElement('button');
      b.className = 'cell';
      b.innerHTML = '<svg viewBox="0 0 64 64" aria-hidden="true"></svg><span></span>';
      b.addEventListener('click', () => { k = i; changed(); });
      $('strip').appendChild(b);
      return b;
    });
    $('go').addEventListener('click', () => {
      mode = 'trans'; seq = data.trans[`${A}-${B}`]; t = 0; trail = []; k = 0;
      start(); draw();
    });
    $('play').addEventListener('click', () => {
      if (playing) { playing = false; cancelAnimationFrame(raf); }
      else { if (!trail.length) setSteady(); start(); }
      draw();
    });
    function start() { if (playing) return; playing = true; last = performance.now(); raf = requestAnimationFrame(loop); }
    function loop(now) {
      if (!playing) return;
      const i0 = Math.floor(t);
      t += Math.min(0.1, (now - last) / 1000) * 30; last = now;
      for (let i = i0 + 1; i <= Math.floor(t); i++) { trail.push(at(i)); if (trail.length > 45) trail.shift(); }
      if (mode === 'trans') {
        k = Math.round(muAt() * 10);
        // fin de la transition : on continue sous C_B seul
        if (t >= seq.length - 1) { k = 10; setSteady(seq[seq.length - 1]); }
        drawStrip(); drawTitle();
      }
      drawBig();
      raf = requestAnimationFrame(loop);
    }

    function drawStrip() {
      cells.forEach((c, i) => {
        c.classList.toggle('active', i === k);
        const p = c.querySelector('path');
        if (p) { p.setAttribute('stroke', i === k ? 'var(--r-out)' : 'var(--text-2)'); p.setAttribute('stroke-width', i === k ? 1.8 : 1.1); }
      });
    }
    function drawTitle() {
      const nA = data.NAMES[A], nB = data.NAMES[B];
      $('title').innerHTML = mode === 'trans'
        ? `Transition : (1 − μ) C<sub>${nA}</sub> + μ C<sub>${nB}</sub>, μ = ${muAt().toFixed(2).replace('.', ',')}`
        : k === 0 ? `Conceptor « ${nA} » seul` : k === 10 ? `Conceptor « ${nB} » seul` : `(1 − μ) C<sub>${nA}</sub> + μ C<sub>${nB}</sub>, avec μ = ${f1(data.MUS[k - 1])}`;
    }
    // grand format : A et B seuls en pointillés gris ; en animation, le stylo et sa traînée (45 pas) qui s'efface, sinon la forme entière
    function drawBig() {
      const s = 85, cx = 150, cy = 118, X = (q) => (cx + q[0] * s).toFixed(1), Y = (q) => (cy - q[1] * s).toFixed(1);
      const nA = data.NAMES[A], nB = data.NAMES[B], trans = mode === 'trans';
      let g = '';
      if (trans || k !== 0) g += `<path d="${path(data.single[A], cx, cy, s)}" fill="none" stroke="var(--text-2)" stroke-width="1" stroke-dasharray="3 3" opacity="0.7"/>`;
      if (trans || k !== 10) g += `<path d="${path(data.single[B], cx, cy, s)}" fill="none" stroke="var(--text-2)" stroke-width="1" stroke-dasharray="3 3" opacity="0.7"/>`;
      let tip;
      if (trail.length) {
        const pp = [...trail, pen()];
        for (let i = 1; i < pp.length; i++) g += `<line x1="${X(pp[i - 1])}" y1="${Y(pp[i - 1])}" x2="${X(pp[i])}" y2="${Y(pp[i])}" stroke="var(--r-out)" stroke-width="2.4" stroke-linecap="round" opacity="${(i / pp.length).toFixed(2)}"/>`;
        tip = pp[pp.length - 1];
      } else {
        const p = pts(k).slice(-60);
        g += `<path d="${path(p, cx, cy, s)}" fill="none" stroke="var(--r-out)" stroke-width="2.2" stroke-linejoin="round"/>`;
        tip = p[p.length - 1];
      }
      g += `<circle cx="${X(tip)}" cy="${Y(tip)}" r="4" fill="var(--r-out)"/>`;
      const ref = trans || (k !== 0 && k !== 10) ? `${nA} et ${nB} seuls` : `${k === 0 ? nB : nA} seul`;
      g += `<text x="150" y="244" text-anchor="middle" class="pl"><tspan style="fill:var(--r-out);font-weight:600">— sortie du réservoir</tspan>   - - ${ref}</text>`;
      $('big').innerHTML = g;
    }
    function draw() {
      btA.forEach((b, i) => b.classList.toggle('active', i === A));
      btB.forEach((b, i) => b.classList.toggle('active', i === B));
      const nA = data.NAMES[A], nB = data.NAMES[B];
      $('go').textContent = `▶ transition ${nA} → ${nB}`;
      $('play').textContent = playing ? '⏸ pause' : '▶ lecture';
      cells.forEach((c, i) => {
        c.querySelector('svg').innerHTML = `<path d="${path(pts(i).slice(-60), 32, 32, 24)}" fill="none" stroke-linejoin="round"/>`;
        c.querySelector('span').textContent = i === 0 ? nA : i === 10 ? nB : `μ = ${f1(data.MUS[i - 1])}`;
      });
      drawStrip(); drawTitle(); drawBig();
    }
    draw();
  });
</script>

<style is:global>
  .shapew .row > .seg { display: inline-flex; flex-wrap: wrap; gap: 6px; }
  .shapew .row .lb { min-width: 6.5em; }
  .shapew .seg button { font-size: 13px; padding: 4px 10px; }
  .shapew .ft.gt { font-size: 15px; font-weight: 600; margin: 10px 0 6px; }
  .shapew .strip { display: grid; grid-template-columns: repeat(11, minmax(0, 1fr)); gap: 4px; }
  .shapew .strip .cell { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 3px 1px 4px; min-width: 0; }
  .shapew .strip .cell svg { width: 100%; max-width: 64px; height: auto; display: block; }
  .shapew .strip .cell span { font-size: 11px; color: var(--text-2); white-space: nowrap; }
  .shapew .strip .cell.active span { color: var(--r-out); font-weight: 600; }
  .shapew svg[data-ref="big"] { width: 100%; max-width: 270px; height: auto; display: block; margin: 8px auto 0; }
  .shapew svg text.pl { font: 11.5px var(--font); fill: var(--text-2); }
  @media (max-width: 640px) { .shapew .strip { grid-template-columns: repeat(6, minmax(0, 1fr)); } .shapew .row .lb { min-width: 0; } }
</style>
