---
// Cours Reservoir computing, chapitre 2 : « Pourquoi normaliser le taux ? ». Lecture d'ordre 2 (N = 60, 1 890 monômes centrés)
// apprise par NLMS en forme duale, avec le taux normalisé η_ℓ = c / ((K_c)_ℓℓ + 1) ou un taux unique c / (⟨(K_c)_ℓℓ⟩ + 1).
// Courbes précalculées à la construction (ordre2.ts, rateCurves) ; la forme primale est menée en parallèle pour mesurer l'écart.
// ℓ : indice des phrases d'apprentissage (i et j sont réservés aux sorties et aux neurones). Sur la phrase vue, l'erreur est multipliée par 1 − η ((K_c)_ℓℓ + 1) : elle grandit dès que η ((K_c)_ℓℓ + 1) > 2.
import katex from 'katex';
import { rateCurves, STOP } from './ordre2';

const tx = (s: string) => katex.renderToString(s, { throwOnError: false });
const CS = [0.1, 0.4, 1, 1.5], C0 = 1.5, EMAX = 20;
const R = rateCurves(CS, EMAX);
const fm = (v: number, d = 1) => v.toFixed(d).replace('.', ',');
const big = (v: number) => Math.round(v).toLocaleString('fr-FR').replace(/\s/g, ' ');
const cl = (c: number) => String(c).replace('.', ',');
// 4,4·10⁵ en HTML ou en SVG (exposant en <tspan>)
const pow = (v: number, svg: boolean) => {
  const e = Math.floor(Math.log10(v)), m = Math.round(v / 10 ** e);
  return svg ? `${m}·10<tspan dy="-4" font-size="8.5">${e}</tspan><tspan dy="4"> </tspan>` : `${m}·10<sup>${String(e).replace('-', '−')}</sup>`;
};
const sci = (v: number) => { const e = Math.floor(Math.log10(v)); return `${fm(v / 10 ** e)}·10<sup>${String(e).replace('-', '−')}</sup>`; };

const FN = tx('\\text{normalisé : } \\eta_\\ell = \\dfrac{c}{(K_c)_{\\ell\\ell} + 1}'), FU = tx('\\text{unique : } \\eta = \\dfrac{c}{\\langle (K_c)_{\\ell\\ell} \\rangle + 1}');
const KM = tx('1 - \\eta\\,\\big((K_c)_{\\ell\\ell} + 1\\big)');

// ---- graphique : erreur d'apprentissage contre époques, échelle logarithmique fixe de 0,2 à 10
const LO = Math.log10(0.2), HI = Math.log10(10);
function render(W: number, nar: boolean) {
  const H = 240, ox = nar ? 34 : 42, oy = 24, rm = nar ? 70 : 104, pw = W - ox - rm, ph = H - oy - 36;
  const X = (t: number) => ox + (t / EMAX) * pw, Y = (v: number) => oy + ph * (1 - (Math.log10(v) - LO) / (HI - LO));
  let base = '';
  [0.2, 0.5, 1, 2, 5, 10].forEach((v) => (base += `<line x1="${ox}" x2="${ox + pw}" y1="${Y(v).toFixed(1)}" y2="${Y(v).toFixed(1)}" stroke="var(--border)"${v === 1 ? '' : ' stroke-dasharray="2 4"'}/><text x="${ox - 5}" y="${(Y(v) + 3.5).toFixed(1)}" text-anchor="end" class="ax">${cl(v)}</text>`));
  [0, 5, 10, 15, 20].forEach((e) => (base += `<text x="${X(e).toFixed(1)}" y="${oy + ph + 14}" text-anchor="middle" class="ax">${e}</text>`));
  base += `<text x="${(ox + pw / 2).toFixed(1)}" y="${oy + ph + 30}" text-anchor="middle" class="ax">époques</text>`;
  base += `<text x="4" y="10" class="ax">erreur quadratique moyenne d'apprentissage</text>`;
  const groups = R.runs.map((r) => {
    let g = '';
    const pts = (a: number[]) => a.map((v, e) => `${X(e).toFixed(1)},${Y(v).toFixed(1)}`).join(' ');
    // taux unique : coupé à la sortie du cadre si l'erreur diverge
    const k = r.uniq.findIndex((v) => v > 10), div = r.uniq[r.uniq.length - 1] >= STOP;
    if (k < 0) g += `<polyline points="${pts(r.uniq)}" fill="none" stroke="var(--text-2)" stroke-width="1.6" stroke-linejoin="round"/>`;
    else {
      const a = Math.log10(r.uniq[k - 1]), b = Math.log10(r.uniq[k]), t = k - 1 + (HI - a) / (b - a), xe = X(t);
      g += `<polyline points="${pts(r.uniq.slice(0, k))} ${xe.toFixed(1)},${oy}" fill="none" stroke="var(--text-2)" stroke-width="1.6" stroke-linejoin="round"/>`;
      g += `<path d="M${(xe - 4.5).toFixed(1)},${oy + 1} L${xe.toFixed(1)},${oy - 8} L${(xe + 4.5).toFixed(1)},${oy + 1} Z" fill="var(--text-2)"/>`;
      const vals = r.uniq.slice(1).map((v, e) => (nar ? `${pow(v, true)}(ép. ${e + 1})` : `${pow(v, true)}à l'époque ${e + 1}`)).join(', ');
      g += `<text x="${(xe + 9).toFixed(1)}" y="${oy + 6}" class="lb u">taux unique : <tspan class="bad">${div ? 'diverge' : 'sort du cadre'}</tspan></text>`;
      g += `<text x="${(xe + 9).toFixed(1)}" y="${oy + 21}" class="lb v">${vals}</text>`;
    }
    g += `<polyline points="${pts(r.norm)}" fill="none" stroke="var(--r-out)" stroke-width="2.2" stroke-linejoin="round"/>`;
    // étiquettes directes au bout des courbes, écartées d'au moins 15 px
    const labs = [{ t: nar ? 'normalisé' : 'taux normalisé', y: Y(r.norm[EMAX]), c: 'n' }];
    if (k < 0) labs.push({ t: nar ? 'unique' : 'taux unique', y: Y(r.uniq[EMAX]), c: 'u' });
    labs.sort((p, q) => p.y - q.y);
    if (labs.length === 2 && labs[1].y - labs[0].y < 15) { const m = (labs[0].y + labs[1].y) / 2; labs[0].y = m - 7.5; labs[1].y = m + 7.5; }
    labs.forEach((l) => (g += `<text x="${(X(EMAX) + 6).toFixed(1)}" y="${(l.y + 4).toFixed(1)}" class="lb ${l.c}">${l.t}</text>`));
    return { c: r.c, g };
  });
  return { W, H, base, groups, nar };
}
const views = [render(600, false), render(340, true)];
// facteur de l'erreur sur la pire phrase, taux unique : 1 − c × (plus grande (K_c)_ℓℓ + 1) / (moyenne + 1) ; rouge s'il est < −1 (l'erreur de cette phrase grandit)
const runs = R.runs.map((r) => ({ c: r.c, gain: r.gain, gap: r.gap, fac: 1 - r.gain }));
const sg = (v: number) => fm(v).replace('-', '−');
---
<div class="widget o2w" data-widget="o2w">
  <div class="o2head">
    <b>Pourquoi normaliser le taux&nbsp;?</b>
    <div class="o2stat"><span>taux unique, pire phrase : facteur <Fragment set:html={KM} /></span>{runs.map((r) => <b data-c={r.c} hidden={r.c !== C0}>1 − {fm(R.ratio)} × {cl(r.c)} = {r.fac < -1 ? <span class="r">{sg(r.fac)}</span> : sg(r.fac)}</b>)}</div>
  </div>
  <div class="row o2ctl"><span>c :</span><span class="seg">{CS.map((c) => <button data-c={c} class={c === C0 ? 'active' : ''}>{cl(c)}</button>)}</span></div>
  <div class="calc">
    <div class="fc"><div class="fm" set:html={FN} /><div class="ln">η<sub>ℓ</sub>((K<sub>c</sub>)<sub>ℓℓ</sub> + 1) = c = {runs.map((r) => <b data-c={r.c} hidden={r.c !== C0}>{cl(r.c)}</b>)} pour chaque phrase</div></div>
    <div class="fc"><div class="fm" set:html={FU} /><div class="ln">⟨(K<sub>c</sub>)<sub>ℓℓ</sub>⟩&nbsp;+&nbsp;1 = {big(R.meanK1)} ; la plus grande (K<sub>c</sub>)<sub>ℓℓ</sub>&nbsp;+&nbsp;1 vaut {big(R.maxK1)}, {fm(R.ratio)} fois plus</div></div>
  </div>
  {views.map((v) => (
    <svg data-o2w={v.nar ? 'etroit' : 'large'} viewBox={`0 0 ${v.W} ${v.H}`} role="img" aria-label="Erreur d'apprentissage au fil des époques, taux normalisé et taux unique">
      <Fragment set:html={v.base} />
      {v.groups.map(({ c, g }) => <g data-c={c} set:html={g} style={c === C0 ? '' : 'display:none'} />)}
    </svg>
  ))}
  <div class="kpis">
    <div><span>Écart primal / dual</span>{runs.map((r) => <b data-c={r.c} hidden={r.c !== C0} set:html={sci(r.gap)} />)}<i>plus grand écart relatif entre les sorties des deux formes, sur les deux courbes</i></div>
  </div>
  <p class="note">{R.n} phrases d'apprentissage, N = 60, {big(R.D)} monômes centrés ; NLMS parti de zéro, même ordre des chants pour les deux taux. Sur la phrase vue, l'erreur est multipliée par ce facteur. Rouge : sous −1, l'erreur de cette phrase grandit ; la moyenne peut tenir (c = 1) ou diverger (c = 1,5).</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-widget="o2w"]').forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>('button[data-c]').forEach((b) => b.addEventListener('click', () => {
      const c = b.dataset.c!;
      root.querySelectorAll<HTMLButtonElement>('button[data-c]').forEach((x) => x.classList.toggle('active', x === b));
      root.querySelectorAll<SVGGElement>('svg g[data-c]').forEach((g) => (g.style.display = g.dataset.c === c ? '' : 'none'));
      root.querySelectorAll<HTMLElement>('b[data-c]').forEach((x) => (x.hidden = x.dataset.c !== c));
    }));
  });
</script>

<style is:global>
  .o2w .o2head { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .o2w .o2head > b { font-size: 15px; font-weight: 600; color: var(--text); }
  .o2w .o2stat { display: flex; align-items: baseline; gap: 8px; background: var(--surface-2); border-radius: 8px; padding: 4px 10px; }
  .o2w .o2stat > span { font-size: 12.5px; color: var(--text-2); }
  .o2w .o2stat .katex { font-size: 1em; }
  .o2w .o2stat b { font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .o2w .o2stat b[hidden], .o2w .kpis b[hidden] { display: none; }
  .o2w .o2stat .r, .o2w .kpis .r { color: var(--h-py); }
  .o2w .o2ctl { margin-bottom: 8px; }
  .o2w .seg { display: inline-flex; flex-wrap: wrap; gap: 6px; }
  .o2w .seg button { font-size: 13px; padding: 4px 11px; }
  .o2w .calc { display: flex; flex-wrap: wrap; gap: 6px 28px; padding: 6px 12px 8px; border-radius: 10px; background: color-mix(in srgb, var(--text-2) 4.5%, transparent); }
  .o2w .fc { flex: 1 1 220px; }
  .o2w .fm { font-size: 13px; margin: 2px 0; }
  .o2w .fm .katex { font-size: 1.05em; }
  .o2w .ln { font-size: 12.5px; line-height: 1.5; color: var(--text-2); }
  .o2w .ln b { font-weight: 600; color: var(--text); }
  .o2w .ln b[hidden] { display: none; }
  .o2w svg[data-o2w] { width: 100%; height: auto; display: block; margin-top: 8px; }
  .o2w svg[data-o2w="etroit"] { display: none; }
  @media (max-width: 640px) {
    .o2w svg[data-o2w="large"] { display: none; }
    .o2w svg[data-o2w="etroit"] { display: block; }
  }
  .o2w svg[data-o2w] text.ax { font: 11px var(--font); fill: var(--text-2); }
  .o2w svg[data-o2w] text.lb { font: 11.5px var(--font); }
  .o2w svg[data-o2w] text.lb.n { fill: var(--r-out); font-weight: 600; }
  .o2w svg[data-o2w] text.lb.u, .o2w svg[data-o2w] text.lb.v { fill: var(--text-2); }
  .o2w svg[data-o2w] text.lb.u { font-weight: 600; }
  .o2w svg[data-o2w] tspan.bad { fill: var(--h-py); }
</style>
