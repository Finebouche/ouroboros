---
// Cours Reservoir computing, chapitre 2 : à quoi sert la boucle fermée (FORCE). Quatre cas précalculés à la construction (force.ts) sur le
// même réseau chaotique sans entrée : la sortie y (violet) et sa cible (pointillés, dessinés par-dessus) pendant l'apprentissage puis
// une fois l'apprentissage coupé, et trois neurones (bleu-vert). Un bouton par cas, pas d'animation. RMSE après coupure en pastille.
import { runs, target, TTRAIN, TTEST, type Case } from './force';

const R = runs();
const CASES: [Case, string, string][] = [
  ['none', 'sans retour', 'la lecture apprend (RLS) sur un réservoir chaotique, sans rien lui renvoyer'],
  ['teacher', 'retour de la cible', 'pendant l’apprentissage, on renvoie la cible d ; ensuite, la sortie y'],
  ['force', 'FORCE (RLS)', 'on renvoie y dès le début ; RLS la garde proche de la cible'],
  ['lms', 'LMS en boucle fermée', 'on renvoie y ; LMS, pas de 0,02'],
];
const fm = (v: number, d = 2) => v.toFixed(d).replace('.', ',');
// deux mises en page : large (680) et étroite (400, sous 640 px), mêmes données
function render(W: number) {
  const nar = W < 500, ox = nar ? 30 : 44, pw = W - ox - 8, T = TTRAIN + TTEST, X = (t: number) => ox + (t / T) * pw;
  const top = { y: nar ? 46 : 42, h: nar ? 120 : 140 }, Yz = (v: number) => top.y + top.h / 2 - (Math.max(-1.5, Math.min(1.5, v)) / 1.5) * (top.h / 2);
  const nb = { y: top.y + top.h + 22, h: 16, gap: 4 }, H = nb.y + 3 * (nb.h + nb.gap) + 2;
  const poly = (pts: [number, number][]) => pts.map(([a, b]) => `${a.toFixed(1)},${b.toFixed(1)}`).join(' ');
  let base = `<rect x="${ox}" y="${top.y}" width="${X(TTRAIN) - ox}" height="${H - top.y - 4}" fill="var(--text-2)" fill-opacity="0.06"/>`;
  base += `<line x1="${X(TTRAIN)}" x2="${X(TTRAIN)}" y1="${top.y - 6}" y2="${H - 4}" stroke="var(--text-2)" stroke-dasharray="3 3"/>`;
  base += nar
    ? `<text x="${ox + 4}" y="${top.y - 8}" class="fa">apprentissage</text><text x="${X(TTRAIN) + 4}" y="${top.y - 8}" class="fa">coupé</text>`
    : `<text x="${ox + 4}" y="${top.y - 8}" class="fa">apprentissage : la règle corrige W<tspan baseline-shift="sub" font-size="8.5">out</tspan></text><text x="${X(TTRAIN) + 4}" y="${top.y - 8}" class="fa">coupé : la boucle tourne seule</text>`;
  [-1, 0, 1].forEach((v) => (base += `<line x1="${ox}" x2="${ox + pw}" y1="${Yz(v)}" y2="${Yz(v)}" stroke="var(--border)"${v ? ' stroke-dasharray="2 4"' : ''}/><text x="${ox - 6}" y="${Yz(v) + 3.5}" text-anchor="end" class="fa">${v ? String(v).replace('-', '−') : v}</text>`));
  base += `<text x="${ox + 4}" y="${nb.y - 6}" class="fa">3 neurones du réservoir</text>`;
  [0, 300, 600, 900].forEach((t) => (base += `<text x="${X(t)}" y="${H + 9}" text-anchor="${t === 900 ? 'end' : 'middle'}" class="fa">${t}</text>`));
  // cible : dessinée après la sortie, pour rester visible quand elle est suivie
  let over = `<polyline points="${poly(Array.from({ length: T + 1 }, (_, t) => [X(t), Yz(target(t))]))}" fill="none" stroke="var(--text)" stroke-width="1.2" stroke-dasharray="4 3"/>`;
  // étiquettes directes, sur une ligne au-dessus du tracé
  const lx = ox, ly = nar ? 15 : 13;
  over += `<line x1="${lx}" x2="${lx + 16}" y1="${ly - 4}" y2="${ly - 4}" stroke="var(--r-out)" stroke-width="2.2"/><text x="${lx + 20}" y="${ly}" class="fl o">sortie y</text>`;
  const cx = lx + (nar ? 88 : 78);
  over += `<line x1="${cx}" x2="${cx + 16}" y1="${ly - 4}" y2="${ly - 4}" stroke="var(--text)" stroke-width="1.2" stroke-dasharray="4 3"/><text x="${cx + 20}" y="${ly}" class="fl d">cible</text>`;
  const groups = CASES.map(([c]) => {
    const r = R[c];
    let g = `<polyline points="${poly(r.y.map((v, t) => [X(t), Yz(Number.isFinite(v) ? v : 0)]))}" fill="none" stroke="var(--r-out)" stroke-width="2.2" stroke-opacity="0.85"/>`;
    r.neu.forEach((a, k) => { const y0 = nb.y + k * (nb.h + nb.gap) + nb.h / 2; g += `<polyline points="${poly(a.map((v, t) => [X(t), y0 - (v * nb.h) / 2]))}" fill="none" stroke="var(--r-res)" stroke-width="1"/>`; });
    return { c, g };
  });
  return { W, H: H + 14, base, over, groups, nar };
}
const views = [render(680), render(400)];
const KPI = Object.fromEntries(CASES.map(([c]) => [c, fm(R[c].rmseTest, 3)]));
---
<div class="widget fcw" data-widget="fcw" data-kpi={JSON.stringify(KPI)} data-desc={JSON.stringify(Object.fromEntries(CASES.map(([c, , d]) => [c, d])))}>
  <div class="fchead">
    <b>La sortie tient-elle quand on coupe l'apprentissage&nbsp;?</b>
    <div class="fcstat"><span>RMSE après coupure</span><b data-ref="te">{KPI.force}</b></div>
  </div>
  <div class="row"><span class="seg" data-ref="cases">{CASES.map(([c, l]) => <button data-c={c} class={c === 'force' ? 'active' : ''}>{l}</button>)}</span></div>
  <p class="fcdesc" data-ref="desc">{CASES[2][2]}</p>
  {views.map((v) => (
    <svg data-fcw={v.nar ? 'etroit' : 'large'} viewBox={`0 0 ${v.W} ${v.H}`} role="img" aria-label="Sortie et cible pendant puis après l'apprentissage, et trois neurones du réservoir">
      <Fragment set:html={v.base} />
      {v.groups.map(({ c, g }) => <g data-g={c} set:html={g} style={c === 'force' ? '' : 'display:none'} />)}
      <Fragment set:html={v.over} />
    </svg>
  ))}
  <p class="note">200 neurones, réseau chaotique (gain 1,5), aucune entrée ; retour par des poids figés tirés dans [−1, 1] ; temps en constantes de temps des neurones. Écart-type de la cible : 0,49.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-widget="fcw"]').forEach((root) => {
    const kpi = JSON.parse(root.dataset.kpi!), desc = JSON.parse(root.dataset.desc!);
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    root.querySelectorAll<HTMLButtonElement>('[data-c]').forEach((b) => b.addEventListener('click', () => {
      const c = b.dataset.c!;
      root.querySelectorAll<HTMLElement>('[data-c]').forEach((x) => x.classList.toggle('active', x === b));
      root.querySelectorAll<SVGGElement>('[data-g]').forEach((g) => (g.style.display = g.dataset.g === c ? '' : 'none'));
      $('te').textContent = kpi[c]; $('desc').textContent = desc[c];
    }));
  });
</script>

<style is:global>
  .fcw .fchead { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .fcw .fchead > b { font-size: 15px; font-weight: 600; color: var(--text); }
  .fcw .fcstat { display: flex; align-items: baseline; gap: 8px; background: var(--surface-2); border-radius: 8px; padding: 4px 10px; }
  .fcw .fcstat span { font-size: 12.5px; color: var(--text-2); }
  .fcw .fcstat b { font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .fcw .seg { display: inline-flex; flex-wrap: wrap; gap: 6px; }
  .fcw .seg button { font-size: 13px; padding: 4px 11px; }
  .fcw .fcdesc { font-size: 13px; color: var(--text-2); margin: 6px 0 0; min-height: 1.5em; }
  .fcw svg[data-fcw] { width: 100%; height: auto; display: block; margin-top: 6px; }
  .fcw svg[data-fcw] text.fa { font: 11px var(--font); fill: var(--text-2); }
  .fcw svg[data-fcw="etroit"] { display: none; }
  @media (max-width: 640px) {
    .fcw svg[data-fcw="large"] { display: none; }
    .fcw svg[data-fcw="etroit"] { display: block; }
  }
  .fcw svg[data-fcw] text.fl { font: 11.5px var(--font); }
  .fcw svg[data-fcw] text.fl.o { fill: var(--r-out); font-weight: 600; }
  .fcw svg[data-fcw] text.fl.d { fill: var(--text); }
  .fcw svg[data-fcw="etroit"] text.fa, .fcw svg[data-fcw="etroit"] text.fl { font-size: 13.5px; }
  .fcw .note { font-size: 12.5px; color: var(--text-2); margin: 6px 0 0; }
</style>
