---
// Cours Reservoir computing, chapitre 2 : les règles d'ordre 1 (ridge, RLS, LMS, NLMS, EH ; variantes d'EH détaillées dans Variantes.astro ; ordre 2 dans le texte de la section 5), même mise en forme que Families.astro (cours RL) :
// bandes arrondies, en-têtes, petits schémas de ce que reçoit la règle (toutes les données, l'erreur de chaque sortie, une récompense).
import katex from 'katex';
const tx = (s: string) => katex.renderToString(s, { throwOnError: false });
// une formule en morceaux (coupée aux « ,\; ») : chaque morceau insécable, retour à la ligne entre eux si la place manque
const txs = (s: string) => s.split(',\\; ').map((p, i, a) => `<span>${tx(i < a.length - 1 ? p + ',' : p)}</span>`).join('');
const BR = '<i class="rgbr"></i>';
type Glyph = 'batch' | 'err' | 'rew';
// petits schémas en gris : une grille d'exemples (tout le lot), six barres signées (l'erreur de chaque sortie), un seul rond (une récompense 0 / 1)
const glyph = (g: Glyph) => {
  const T2 = 'var(--text-2)';
  let o = `<svg viewBox="0 0 84 20" class="rggl" aria-hidden="true">`;
  if (g === 'batch') for (let r = 0; r < 3; r++) for (let c = 0; c < 8; c++) o += `<circle cx="${6 + c * 10}" cy="${4 + r * 6}" r="2" fill="${T2}" fill-opacity="0.55"/>`;
  if (g === 'err') [0.7, -0.4, 0.2, -0.8, 0.5, -0.2].forEach((v, k) => { const x = 6 + k * 12, h = Math.abs(v) * 8; o += `<rect x="${x}" y="${v > 0 ? 10 - h : 10}" width="7" height="${h}" rx="1" fill="${T2}" fill-opacity="0.6"/>`; });
  if (g === 'err') o += `<line x1="2" x2="80" y1="10" y2="10" stroke="${T2}" stroke-width="0.8"/>`;
  if (g === 'rew') o += `<circle cx="10" cy="10" r="6.5" fill="none" stroke="${T2}" stroke-width="1.4"/><text x="10" y="13.5" text-anchor="middle" style="font:600 9.5px var(--font);fill:${T2}">M</text>`;
  return o + '</svg>';
};
const rows: { name: string; src: string; how: string; upd: string; loc: string; sig: Glyph; sigt: string; hp: string }[] = [
  { name: 'Ridge', src: 'régression ridge (Hoerl et Kennard, 1970)', how: 'hors ligne : tous les états à la fois', upd: txs('W = Y \\tilde X^{\\top}\\big(\\tilde X \\tilde X^{\\top} + \\alpha I\\big)^{-1}'), loc: 'non : un système linéaire global', sig: 'batch', sigt: 'toutes les cibles', hp: 'α (ici 1)' },
  { name: 'RLS', src: 'moindres carrés récursifs (Plackett, 1950)', how: 'en ligne, une passe', upd: txs('g = \\frac{P \\tilde x}{1 + \\tilde x^{\\top} P \\tilde x}') + BR + txs('W \\leftarrow W - e\\,g^{\\top},\\; P \\leftarrow P - g\\,\\tilde x^{\\top} P'), loc: 'non : chaque poids passe par P, de taille (N+1)²', sig: 'err', sigt: 'erreur exacte de chaque sortie', hp: 'α, P(0) = I/α (ici 1)' },
  { name: 'LMS', src: 'Widrow et Hoff (1960)', how: 'en ligne, plusieurs époques', upd: txs('W_{out} \\leftarrow W_{out} - \\eta\\, e\\, x^{\\top},\\; b_{out} \\leftarrow b_{out} - \\eta\\, e') + BR + txs('\\eta = c\\,/\\,(\\langle \\lVert x \\rVert^2 \\rangle + 1)'), loc: 'oui : le poids de j vers i n’utilise que xⱼ et eᵢ', sig: 'err', sigt: 'erreur exacte de chaque sortie', hp: 'c (ici 0,1)' },
  { name: 'NLMS', src: 'LMS normalisé (Nagumo et Noda, 1967 ; Albert et Gardner, 1967)', how: 'en ligne, plusieurs époques', upd: txs('W_{out} \\leftarrow W_{out} - \\eta\\, e\\, x^{\\top},\\; b_{out} \\leftarrow b_{out} - \\eta\\, e') + BR + txs('\\eta = c\\,/\\,\\big(\\lVert x \\rVert^2 + 1\\big)'), loc: 'oui, plus un scalaire commun : ‖x‖²', sig: 'err', sigt: 'erreur exacte de chaque sortie', hp: 'c (ici 0,1)' },
  { name: 'EH', src: 'Hoerzer et al. (2014) et variantes (section 3)', how: 'en ligne, plusieurs époques', upd: txs('z = W_{out}\\,x + b_{out} + \\xi') + BR + txs('W_{out} \\leftarrow W_{out} + \\eta\\, M\\,(z - \\bar z)\\, x^{\\top}'), loc: 'oui, plus M', sig: 'rew', sigt: 'une récompense M ∈ {0, 1}, commune ou par sortie, calculée avec la cible', hp: 'section 3' },
];
---
<figure class="rg">
  <div class="rgr rghd">
    <div>règle <span>· source</span></div>
    <div>apprentissage <span>· mise à jour</span></div>
    <div>locale ?</div>
    <div>ce qu'elle reçoit</div>
    <div>réglages</div>
  </div>
  {rows.map((r, i) => (
    <div class={`rgr rgg${i % 2 ? ' alt' : ''}`}>
      <div class="rgn"><b>{r.name}</b><small>{r.src}</small></div>
      <div class="rgh"><span>{r.how}</span><div class="rgf" set:html={r.upd} /></div>
      <div class="rgl">{r.loc}</div>
      <div class="rgs"><div set:html={glyph(r.sig)} /><span>{r.sigt}</span></div>
      <div class="rgp">{r.hp}</div>
    </div>
  ))}
  <figcaption>Règles en ligne (LMS, NLMS, EH) : <i>x</i> est l'état standardisé neurone par neurone et le biais <i>b</i><sub>out</sub> est appris par la même règle. Ridge et RLS : <i>x̃</i> = [<i>x</i> ; 1] et <i>W</i> = [<i>W</i><sub>out</sub>, <i>b</i><sub>out</sub>], le biais est pénalisé comme un poids. Les synapses d'EH ne reçoivent pas l'erreur, mais la récompense est calculée avec la cible <i>d</i> : l'apprentissage reste supervisé, par un signal scalaire ou un par sortie.</figcaption>
</figure>

<style is:global>
  .rg { margin: 1.4rem 0; font-family: var(--font); }
  .rg .rgr { display: grid; grid-template-columns: 118px minmax(0, 1fr) 118px 112px 92px; column-gap: 14px; align-items: center; }
  .rg .rghd { padding: 0 14px 8px; font-size: 11.5px; font-weight: 600; color: var(--text); }
  .rg .rghd span { font-weight: 400; color: var(--text-2); }
  .rg .rgg { border-radius: 8px; background: color-mix(in srgb, var(--text-2) 7%, transparent); padding: 10px 14px; margin-bottom: 6px; }
  .rg .rgg.alt { background: color-mix(in srgb, var(--text-2) 3.5%, transparent); }
  .rg .rgn b { display: block; font-size: 13px; font-weight: 600; color: var(--text); }
  .rg .rgn small { display: block; font-size: 11.5px; color: var(--text-2); margin-top: 2px; line-height: 1.35; }
  .rg .rgh > span { display: block; font-size: 12.5px; color: var(--text); line-height: 1.4; }
  .rg .rgf { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 0.9em; font-size: 0.86rem; margin-top: 3px; }
  .rg .rgf > span { white-space: nowrap; }
  .rg .rgf > .rgbr { flex-basis: 100%; height: 0; }
  .rg .rgf > .rgt { font-size: 11.5px; color: var(--text-2); }
  .rg .rgf .katex { font-size: 1em; }
  .rg .rgl, .rg .rgp { font-size: 11.5px; color: var(--text-2); line-height: 1.35; }
  .rg .rggl { display: block; width: 84px; height: auto; margin-bottom: 3px; }
  .rg .rgs span { display: block; font-size: 11.5px; color: var(--text-2); line-height: 1.35; }
  .rg figcaption { margin-top: 8px; padding: 0 14px; font-size: 12.5px; color: var(--text-2); line-height: 1.5; }
  @media (max-width: 720px) { .rg .rgr { grid-template-columns: 1fr; row-gap: 6px; } .rg .rghd { display: none; } }
</style>
