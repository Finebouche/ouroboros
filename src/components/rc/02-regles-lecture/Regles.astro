---
// Cours Reservoir computing, chapitre 2 : les six règles d'ordre 1 (ridge, RLS, LMS, NLMS, eh, neh), même mise en forme que Families.astro (cours RL) :
// bandes arrondies, en-têtes, une ligne de mise à jour par règle, un petit schéma de ce que reçoit la règle.
// Toutes les règles sont écrites sur x̃ = [x ; 1] et W̃ = [W_out, b_out] (le biais de la lecture est appris comme un poids).
// Sources dans les Refs du chapitre ; lecture d'ordre 2 en section 5 ; réglages dans les notes des widgets.
import katex from 'katex';
// String.raw : les antislashs passent tels quels à KaTeX
const tx = (s: string) => katex.renderToString(s, { throwOnError: false });
type Glyph = 'batch' | 'err' | 'rew' | 'rews';
// petits schémas en gris : une grille d'exemples (tout le lot), six barres signées (l'erreur de chaque sortie),
// un rond M (une récompense commune aux six sorties), six petits ronds (une récompense par sortie)
const glyph = (g: Glyph) => {
  const T2 = 'var(--text-2)';
  let o = `<svg viewBox="0 0 64 18" class="rggl" aria-hidden="true">`;
  if (g === 'batch') for (let r = 0; r < 3; r++) for (let c = 0; c < 7; c++) o += `<circle cx="${5 + c * 9}" cy="${3.5 + r * 5.5}" r="1.8" fill="${T2}" fill-opacity="0.55"/>`;
  if (g === 'err') {
    [0.7, -0.4, 0.2, -0.8, 0.5, -0.2].forEach((v, k) => { const x = 3 + k * 10, h = Math.abs(v) * 7.5; o += `<rect x="${x}" y="${(v > 0 ? 9 - h : 9).toFixed(1)}" width="6" height="${h.toFixed(1)}" rx="1" fill="${T2}" fill-opacity="0.6"/>`; });
    o += `<line x1="1" x2="63" y1="9" y2="9" stroke="${T2}" stroke-width="0.8"/>`;
  }
  if (g === 'rew') o += `<circle cx="9" cy="9" r="7" fill="none" stroke="${T2}" stroke-width="1.3"/><text x="9" y="12.3" text-anchor="middle" style="font:600 9.5px var(--font);fill:${T2}">M</text>`;
  if (g === 'rews') for (let k = 0; k < 6; k++) o += `<circle cx="${5 + k * 10}" cy="9" r="3.4" fill="none" stroke="${T2}" stroke-width="1.2"/>`;
  return o + '</svg>';
};
// mise à jour : morceaux de formule, qui passent à la ligne entre eux si la place manque (jamais de coupure)
const rows: { name: string; upd: string[]; sig: Glyph; sigt: string; loc: string }[] = [
  { name: 'Ridge', upd: [String.raw`\tilde W = Y\,\tilde X^{\top}\big(\tilde X\tilde X^{\top} + \alpha I\big)^{-1}`], sig: 'batch', sigt: 'tout le lot', loc: 'non : système global' },
  { name: 'RLS', upd: [String.raw`\tilde W \leftarrow \tilde W - e\,g^{\top},`, String.raw`g = P\tilde x\,/\,(1 + \tilde x^{\top} P\,\tilde x)`], sig: 'err', sigt: 'erreur par sortie', loc: 'non : tout passe par P' },
  { name: 'LMS', upd: [String.raw`\tilde W \leftarrow \tilde W - \eta\,e\,\tilde x^{\top},`, String.raw`\eta = c\,/\,\langle \lVert \tilde x \rVert^2 \rangle`], sig: 'err', sigt: 'erreur par sortie', loc: 'oui : xⱼ et eᵢ' },
  { name: 'NLMS', upd: [String.raw`\tilde W \leftarrow \tilde W - \eta\,e\,\tilde x^{\top},`, String.raw`\eta = c\,/\,\lVert \tilde x \rVert^2`], sig: 'err', sigt: 'erreur par sortie', loc: 'oui, plus ‖x̃‖²' },
  { name: 'eh', upd: [String.raw`\tilde W \leftarrow \tilde W + \eta\,M\,(z - \bar z)\,\tilde x^{\top},`, String.raw`M = [\,r > \bar r\,]`], sig: 'rew', sigt: 'récompense commune', loc: 'oui, plus M' },
  { name: 'neh', upd: [String.raw`\tilde W \leftarrow \tilde W + \eta\,M \odot (z - \bar z)\,\tilde x^{\top},`, String.raw`M_i = \big[(z_i - d_i)^2 < (\bar z_i - d_i)^2\big]`], sig: 'rews', sigt: 'récompense par sortie', loc: 'oui : Mᵢ, plus ‖x̃‖²' },
].map((r) => ({ ...r, upd: r.upd.map(tx) }));
---
<figure class="rg">
  <div class="rgr rghd">
    <div>règle</div>
    <div>mise à jour</div>
    <div>ce qu'elle reçoit</div>
    <div>locale ?</div>
  </div>
  {rows.map((r, i) => (
    <div class={`rgr rgg${i % 2 ? ' alt' : ''}`}>
      <div class="rgn">{r.name}</div>
      <div class="rgf">{r.upd.map((h) => <span set:html={h} />)}</div>
      <div class="rgs"><Fragment set:html={glyph(r.sig)} /><span>{r.sigt}</span></div>
      <div class="rgl">{r.loc}</div>
    </div>
  ))}
  <figcaption><i>x̃</i> = [<i>x</i> ; 1], <i>W̃</i> = [<i>W</i><sub>out</sub>, <i>b</i><sub>out</sub>] : le biais est appris comme un poids (pénalisé comme eux par ridge et RLS). <i>e</i>&nbsp;=&nbsp;<i>y</i>&nbsp;−&nbsp;<i>d</i>.</figcaption>
</figure>

<style is:global>
  .rg { margin: 1.4rem 0; font-family: var(--font); }
  .rg .rgr { display: grid; grid-template-columns: 52px minmax(0, 1fr) 200px 128px; column-gap: 12px; align-items: center; }
  .rg .rghd { padding: 0 12px 6px; font-size: 11.5px; font-weight: 600; color: var(--text); }
  .rg .rgg { border-radius: 8px; background: color-mix(in srgb, var(--text-2) 7%, transparent); padding: 6px 12px; margin-bottom: 4px; min-height: 36px; }
  .rg .rgg.alt { background: color-mix(in srgb, var(--text-2) 3.5%, transparent); }
  .rg .rgn { font-size: 13px; font-weight: 600; color: var(--text); }
  .rg .rgf { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 0.9em; font-size: 0.84rem; }
  .rg .rgf > span { white-space: nowrap; }
  .rg .rgf .katex { font-size: 1em; }
  .rg .rgs { display: flex; align-items: center; gap: 8px; }
  .rg .rggl { flex: none; display: block; width: 64px; height: 18px; }
  .rg .rgs span, .rg .rgl { font-size: 11.5px; color: var(--text-2); line-height: 1.3; white-space: nowrap; }
  .rg figcaption { margin-top: 6px; padding: 0 12px; font-size: 12.5px; color: var(--text-2); line-height: 1.5; }
  @media (max-width: 640px) {
    .rg .rgr { grid-template-columns: 44px minmax(0, 1.15fr) minmax(0, 1fr); grid-template-areas: "n s l" "f f f"; row-gap: 4px; }
    .rg .rgs span, .rg .rgl { white-space: normal; }
    .rg .rggl { width: 46px; height: 13px; }
    .rg .rghd { display: none; }
    .rg .rgn { grid-area: n; } .rg .rgs { grid-area: s; } .rg .rgl { grid-area: l; text-align: right; } .rg .rgf { grid-area: f; }
  }
</style>
