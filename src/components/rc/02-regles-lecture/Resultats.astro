---
// Cours Reservoir computing, chapitre 2 : les règles en ligne sur les mêmes états (jeu des chants), figure statique calculée à la construction.
// Mêmes phrases, même ordre (chants mélangés à chaque époque, rng(77)), réglages de regles.ts (RULES). Pour chaque règle : précision de test
// après une époque (point) et étendue sur les époques 2 à 50 (barre) ; RLS ne fait qu'une passe. Repères : classe la plus fréquente, ridge.
// Dernière ligne : LMS sur les états bruts (sans standardisation), pour montrer pourquoi on standardise.
import { dataset, NC, N } from './chants';
import { stats, feat, dot, ridgeW, accuracy, makeRule, epochOrder, RULES, LAMBDA } from './regles';
import { rng } from '../esn';

const EMAX = 50;
const { train, test } = dataset();
const st = stats(train.map((s) => s.x));
const Ttr = train.map((s) => s.next), Tte = test.map((s) => s.next), nTr = train.length;
const songIdx: number[][] = [];
train.forEach((s, n) => (songIdx[s.song] ??= []).push(n));
const cnt = new Array(NC).fill(0); Ttr.forEach((t) => cnt[t]++);
const maj = Tte.filter((t) => t === cnt.indexOf(Math.max(...cnt))).length / Tte.length;
function run(S: typeof st | null, only?: string) {
  const Ztr = train.map((s) => feat(s.x, S)), Zte = test.map((s) => feat(s.x, S));
  const meanZ2 = Ztr.reduce((a, z) => a + dot(z, z), 0) / nTr;
  const ridge = accuracy(ridgeW(Ztr, Ttr, NC, LAMBDA), Zte, Tte);
  const rules = RULES.filter((R) => !only || R.id === only).map((R) => ({ id: R.id, label: R.label, m: makeRule(R.id, NC, N + 1, { ...R.o, meanZ2 }), acc: [] as number[] }));
  const ro = rng(77);
  for (let ep = 0; ep < EMAX; ep++) {
    const order = epochOrder(songIdx, ro);
    rules.forEach((R) => { if (R.id === 'rls' && ep > 0) return; order.forEach((n) => R.m.step(Ztr[n], Ttr[n])); R.acc.push(accuracy(R.m.W, Zte, Tte)); });
  }
  return { ridge, rules };
}
const std = run(st), raw = run(null, 'lms');
const SIG: Record<string, string> = { rls: 'erreur de chaque sortie, et P', lms: 'erreur de chaque sortie', nlms: 'erreur de chaque sortie', eh: 'une récompense', eh_np: 'une récompense', eh_np_local: 'une récompense par sortie', neh: 'une récompense par sortie' };
type Row = { label: string; sig: string; first: number; lo: number | null; hi: number | null; gray?: boolean };
const rows: Row[] = std.rules.map((R) => ({ label: R.label, sig: SIG[R.id], first: R.acc[0], lo: R.acc.length > 1 ? Math.min(...R.acc.slice(1)) : null, hi: R.acc.length > 1 ? Math.max(...R.acc.slice(1)) : null }));
rows.push({ label: 'LMS, états bruts', sig: 'erreur de chaque sortie', first: raw.rules[0].acc[0], lo: Math.min(...raw.rules[0].acc.slice(1)), hi: Math.max(...raw.rules[0].acc.slice(1)), gray: true });
const pc = (v: number) => `${Math.round(100 * v)} %`;
const W = 360, X = (v: number) => 6 + v * (W - 12);
---
<figure class="rsf">
  <div class="rst"><b>Les règles en ligne atteignent-elles le ridge sur les mêmes états ?</b><span>précision de test ; point : après une époque ; barre : époques 2 à 50</span></div>
  <div class="rsr rshd"><div>règle</div><div>ce qu'elle reçoit</div><div class="rsax"><span class="l" style={`left:${(X(maj) / W) * 100}%`}>classe la plus fréquente {pc(maj)}</span><span class="r" style={`left:${(X(std.ridge) / W) * 100}%`}>ridge {pc(std.ridge)}</span></div><div>1 époque</div><div>ensuite</div></div>
  {rows.map((r, i) => (
    <div class={`rsr rsg${i % 2 ? ' alt' : ''}`}>
      <div class="rsn"><b>{r.label}</b></div>
      <div class="rss">{r.sig}</div>
      <svg viewBox={`0 0 ${W} 22`} role="img" aria-label={`${r.label} : ${pc(r.first)} après une époque`}>
        <line x1={X(0)} x2={X(1)} y1="11" y2="11" stroke="var(--border)" />
        <line x1={X(maj)} x2={X(maj)} y1="0" y2="22" stroke="var(--text-2)" stroke-dasharray="1.5 3" />
        <line x1={X(std.ridge)} x2={X(std.ridge)} y1="0" y2="22" stroke="var(--text-2)" stroke-dasharray="5 3" />
        {r.lo !== null && <line x1={X(r.lo)} x2={X(r.hi!)} y1="11" y2="11" stroke={r.gray ? 'var(--text-2)' : 'var(--r-out)'} stroke-opacity="0.45" stroke-width="7" stroke-linecap="round" />}
        <circle cx={X(r.first)} cy="11" r="5" fill={r.gray ? 'var(--text-2)' : 'var(--r-out)'} stroke="var(--surface)" stroke-width="1.5" />
      </svg>
      <div class="rsv">{pc(r.first)}</div>
      <div class="rsv">{r.lo === null ? 'une seule passe' : `${Math.round(100 * r.lo)} à ${pc(r.hi!)}`}</div>
    </div>
  ))}
  <figcaption>Jeu des chants (section 1), états standardisés sauf la dernière ligne, réglages du tableau des règles. Sans standardisation, la direction de l'activité moyenne domine les états, et LMS répond presque toujours la classe la plus fréquente.</figcaption>
</figure>

<style is:global>
  .rsf { margin: 1.5rem 0; font-family: var(--font); }
  .rsf .rst { display: flex; flex-wrap: wrap; gap: 2px 12px; align-items: baseline; margin-bottom: 10px; font-size: 12.5px; color: var(--text-2); }
  .rsf .rst b { font-size: 15px; font-weight: 600; color: var(--text); }
  .rsf .rsr { display: grid; grid-template-columns: 112px 150px minmax(0, 1fr) 62px 104px; column-gap: 12px; align-items: center; }
  .rsf .rshd { padding: 0 14px 6px; font-size: 11.5px; font-weight: 600; color: var(--text); }
  .rsf .rsax { position: relative; height: 15px; font-weight: 400; color: var(--text-2); }
  .rsf .rsax span { position: absolute; white-space: nowrap; }
  .rsf .rsax span.l { transform: translateX(-100%); padding-right: 5px; }
  .rsf .rsax span.r { padding-left: 5px; }
  .rsf .rsg { border-radius: 8px; background: color-mix(in srgb, var(--text-2) 7%, transparent); padding: 6px 14px; margin-bottom: 5px; }
  .rsf .rsg.alt { background: color-mix(in srgb, var(--text-2) 3.5%, transparent); }
  .rsf .rsn b { font-size: 13px; font-weight: 600; color: var(--text); }
  .rsf .rss { font-size: 11.5px; color: var(--text-2); line-height: 1.35; }
  .rsf svg { width: 100%; height: 22px; display: block; }
  .rsf .rsv { font-size: 12.5px; color: var(--text); font-variant-numeric: tabular-nums; }
  .rsf figcaption { margin-top: 8px; padding: 0 14px; font-size: 12.5px; color: var(--text-2); line-height: 1.5; }
  @media (max-width: 640px) { .rsf .rsr { grid-template-columns: 96px minmax(0, 1fr) 54px; } .rsf .rss, .rsf .rsr > div:last-child, .rsf .rshd > div:nth-child(2) { display: none; } }
</style>
