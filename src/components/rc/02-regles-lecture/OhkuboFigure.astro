---
// Cours Reservoir computing, chapitre 2 : figure statique de l'expérience « open-loop » d'Ohkubo et Inubushi (2024), en petit
// (lorenz.ts, calculé à la construction). Notations du cours : l'état de Lorenz est l'entrée u = (u_1, u_2, u_3), x l'état du réservoir.
// En haut : mêmes états (N = 10), lecture d'ordre 1 ou 2 ; série u_1 et plan (u_1, u_3) prédits.
// En bas : erreur de test selon le nombre de poids appris, médiane sur cinq tirages de W et W_in ; étiquettes directes au bout des courbes.
import katex from 'katex';
import { experiment } from './lorenz';

const km = (s: string) => katex.renderToString(s, { throwOnError: false });

const { pair, curve } = experiment();
const fm = (v: number, d = 1) => v.toFixed(d).replace('.', ',');
const big = (v: number) => v.toLocaleString('fr-FR').replace(/\u202f/g, '\u00a0');
const sub = (k: number) => `<tspan baseline-shift="sub" font-size="8.5">${k}</tspan>`;

// ---- haut : deux lignes (ordre 1, ordre 2). Deux vues : large (680) et étroite (400, étiquettes au-dessus de chaque ligne).
const NT = 300, NP = 1000; // pas de dt = 0,02 : 6 et 20 unités de temps
const rnd = (v: number) => fm(v, v < 0.1 ? 3 : v < 1 ? 2 : 1);
function renderTop(nar: boolean) {
  const W = nar ? 400 : 680, TS = nar ? { x: 24, w: 252 } : { x: 126, w: 366 }, PH = nar ? { x: 290, w: 106 } : { x: 524, w: 146 };
  const RH = nar ? 124 : 132, TOP = 22, LX = 88, tt = nar ? 20 : 8, th = RH - (nar ? 30 : 24), pt = nar ? 16 : 4, phh = RH - (nar ? 20 : 16), id = nar ? 'e' : 'l';
  const ty = (r: number, v: number) => TOP + r * RH + tt + ((22 - v) / 44) * th;
  const tx = (t: number) => TS.x + (t / (NT - 1)) * TS.w;
  const px = (v: number) => PH.x + ((v + 25) / 50) * PH.w, pz = (r: number, v: number) => TOP + r * RH + pt + ((52 - v) / 52) * phh;
  const path = (pts: number[][], r: number) => pts.slice(0, NP).map((p, i) => `${i ? 'L' : 'M'}${px(p[0]).toFixed(1)},${pz(r, p[2]).toFixed(1)}`).join('');
  let g = `<text x="${TS.x}" y="12" class="oh-h">composante u${sub(1)} : ${fm(NT * 0.02, 0)} unités de temps${nar ? '' : ' de test'}</text><text x="${PH.x + PH.w}" y="12" text-anchor="end" class="oh-h">plan (u${sub(1)}, u${sub(3)})${nar ? '' : ` : ${fm(NP * 0.02, 0)} unités de temps`}</text>`;
  pair.forEach((p, r) => {
    const y0 = TOP + r * RH;
    g += `<defs><clipPath id="ohc${id}${r}"><rect x="${PH.x}" y="${y0 + pt}" width="${PH.w}" height="${phh}"/></clipPath></defs>`;
    if (nar) g += `<text x="${TS.x - 20}" y="${y0 + 12}" class="oh-l">ordre ${p.order}<tspan class="oh-s" dx="8">${big(p.nw)} poids · RMSE ${rnd(p.rmse)}</tspan></text>`;
    else {
      g += `<text x="${LX}" y="${y0 + 40}" text-anchor="end" class="oh-l">ordre ${p.order}</text>`;
      g += `<text x="${LX}" y="${y0 + 56}" text-anchor="end" class="oh-s">${big(p.nw)} poids</text>`;
      g += `<text x="${LX}" y="${y0 + 72}" text-anchor="end" class="oh-s">RMSE ${rnd(p.rmse)}</text>`;
    }
    [-20, 0, 20].forEach((v) => (g += `<line x1="${TS.x}" x2="${TS.x + TS.w}" y1="${ty(r, v).toFixed(1)}" y2="${ty(r, v).toFixed(1)}" stroke="var(--border)"${v ? ' stroke-dasharray="2 3"' : ''}/><text x="${TS.x - 4}" y="${(ty(r, v) + 3.5).toFixed(1)}" text-anchor="end" class="oh-a">${v}</text>`));
    const pl = (f: (t: number) => number) => Array.from({ length: NT }, (_, t) => `${tx(t).toFixed(1)},${ty(r, f(t)).toFixed(1)}`).join(' ');
    g += `<polyline points="${pl((t) => p.T[t][0])}" fill="none" stroke="var(--text)" stroke-width="1.2" stroke-dasharray="4 3"/>`;
    g += `<polyline points="${pl((t) => Math.max(-30, Math.min(30, p.P[t][0])))}" fill="none" stroke="var(--r-out)" stroke-width="1.7"/>`;
    g += `<rect x="${PH.x}" y="${y0 + pt}" width="${PH.w}" height="${phh}" fill="none" stroke="var(--border)"/>`;
    g += `<g clip-path="url(#ohc${id}${r})"><path d="${path(p.T, r)}" fill="none" stroke="var(--text)" stroke-opacity="0.22" stroke-width="2.2"/><path d="${path(p.P, r)}" fill="none" stroke="var(--r-out)" stroke-opacity="0.8" stroke-width="0.9"/></g>`;
  });
  return { W, H: TOP + 2 * RH, g, nar };
}

// ---- bas : RMSE de test contre le nombre de poids appris, échelles logarithmiques ; marge à droite pour les étiquettes directes
const NMIN = 8, NMAX = 720;
function renderBot(nar: boolean) {
  const W = nar ? 400 : 680, B = nar ? { x0: 40, x1: 288, y0: 22, y1: 188 } : { x0: 58, x1: 548, y0: 22, y1: 188 }, H = 222;
  const lx = (m: number) => B.x0 + ((Math.log10(m) - Math.log10(NMIN)) / (Math.log10(NMAX) - Math.log10(NMIN))) * (B.x1 - B.x0);
  const ly = (v: number) => B.y0 + ((1 - Math.log10(v)) / 4) * (B.y1 - B.y0); // de 10 à 0,001
  let g = '';
  [10, 1, 0.1, 0.01, 0.001].forEach((v) => (g += `<line x1="${B.x0}" x2="${B.x1}" y1="${ly(v).toFixed(1)}" y2="${ly(v).toFixed(1)}" stroke="var(--border)"/><text x="${B.x0 - 6}" y="${(ly(v) + 3.5).toFixed(1)}" text-anchor="end" class="oh-a">${fm(v, v < 1 ? Math.round(-Math.log10(v)) : 0)}</text>`));
  [10, 30, 100, 195, 690].forEach((m) => (g += `<text x="${lx(m).toFixed(1)}" y="${B.y1 + 14}" text-anchor="middle" class="oh-a">${m}</text>`));
  g += `<text x="${B.x1}" y="${B.y1 + 29}" text-anchor="end" class="oh-a">nombre de poids appris${nar ? '' : ' (3 sorties × monômes)'}</text>`;
  g += `<text x="${B.x0 - 6}" y="${B.y0 - 10}" text-anchor="end" class="oh-a">RMSE</text>`;
  g += `<line x1="${lx(195).toFixed(1)}" x2="${lx(195).toFixed(1)}" y1="${B.y0}" y2="${B.y1}" stroke="var(--text-2)" stroke-dasharray="3 3"/>`;
  const ends: { t: string; y: number; o: 1 | 2 }[] = [];
  ([1, 2] as const).forEach((o) => {
    const c = curve.filter((k) => k.order === o), col = o === 2 ? 'var(--r-out)' : 'var(--text-2)';
    g += `<polyline points="${c.map((k) => `${lx(k.nw).toFixed(1)},${ly(k.med).toFixed(1)}`).join(' ')}" fill="none" stroke="${col}" stroke-width="${o === 2 ? 2 : 1.6}"/>`;
    c.forEach((k) => (g += `<circle cx="${lx(k.nw).toFixed(1)}" cy="${ly(k.med).toFixed(1)}" r="3" fill="${col}"/>`));
    const e = c[c.length - 1];
    ends.push({ t: nar ? `ordre ${o}, N ≤ ${e.N}` : `ordre ${o}, N = ${c[0].N} à ${e.N}`, y: ly(e.med), o });
  });
  // étiquettes directes au bout des courbes, écartées d'au moins 15 px
  ends.sort((a, b) => a.y - b.y);
  if (ends[1].y - ends[0].y < 15) { const m = (ends[0].y + ends[1].y) / 2; ends[0].y = m - 7.5; ends[1].y = m + 7.5; }
  const xEnd = Math.max(...curve.map((k) => lx(k.nw))) + 8;
  ends.forEach((l) => (g += `<text x="${xEnd.toFixed(1)}" y="${(l.y + 4).toFixed(1)}" class="oh-n${l.o === 2 ? ' o2' : ''}">${l.t}</text>`));
  // à 195 poids : N de chaque point, placé hors des courbes (ordre 1 au-dessus à droite, ordre 2 en dessous à gauche)
  curve.filter((c) => c.nw === 195).forEach((c) => (g += c.order === 2
    ? `<text x="${(lx(195) - 6).toFixed(1)}" y="${(ly(c.med) + 15).toFixed(1)}" text-anchor="end" class="oh-n o2" data-n="2">N = ${c.N}</text>`
    : `<text x="${(lx(195) + 6).toFixed(1)}" y="${(ly(c.med) - 7).toFixed(1)}" class="oh-n" data-n="1">N = ${c.N}</text>`));
  return { W, H, g, nar };
}
const tops = [renderTop(false), renderTop(true)], bots = [renderBot(false), renderBot(true)];
---
<figure class="ohf">
  <div class="ohb">
    <div class="oht"><b>Mêmes états (N = 10), deux lectures</b><span>pointillés : cible ; trait : prédiction de u<sub>1</sub>, 0,2 plus loin</span></div>
    {tops.map((v) => <svg data-oh={v.nar ? 'etroit' : 'large'} viewBox={`0 0 ${v.W} ${v.H}`} role="img" aria-label="Composante u1 et plan (u1, u3) de Lorenz prédits par une lecture d'ordre 1 et d'ordre 2 sur les mêmes états" set:html={v.g} />)}
  </div>
  <div class="ohb">
    <div class="oht"><b>Erreur de test selon le nombre de poids appris</b><span>médiane sur cinq tirages de W et W<sub>in</sub> ; réglages propres à chaque point</span></div>
    {bots.map((v) => <svg data-oh={v.nar ? 'etroit' : 'large'} viewBox={`0 0 ${v.W} ${v.H}`} role="img" aria-label="RMSE de test contre le nombre de poids appris, lectures d'ordre 1 et 2" set:html={v.g} />)}
  </div>
  <figcaption>Lorenz, <Fragment set:html={km('\\Delta t = 0{,}02')} /> ; entrée <Fragment set:html={km('u(n) \\in \\mathbb{R}^3')} />, cible <Fragment set:html={km('u(n + 10)')} /> ; réservoir <Fragment set:html={km('x(n) = \\tanh\\big(W x(n-1) + W_{in}\\,u(n)\\big)')} />, lecture ridge sans biais. Échelles de <Fragment set:html={km('W')} />, <Fragment set:html={km('W_{in}')} /> et <Fragment set:html={km('\\alpha')} /> réglées sur une grille ; en haut, celles de l'ordre 1.</figcaption>
</figure>

<style is:global>
  .ohf { margin: 1.5rem 0; }
  .ohf .ohb + .ohb { margin-top: 14px; }
  .ohf .oht { display: flex; flex-wrap: wrap; gap: 2px 12px; align-items: baseline; margin-bottom: 4px; font-size: 13px; color: var(--text-2); }
  .ohf .oht b { color: var(--text); font-size: 13px; }
  .ohf svg[data-oh] { width: 100%; height: auto; display: block; }
  .ohf svg[data-oh="etroit"] { display: none; }
  @media (max-width: 640px) {
    .ohf svg[data-oh="large"] { display: none; }
    .ohf svg[data-oh="etroit"] { display: block; }
  }
  .ohf svg[data-oh] text.oh-h { font: 11.5px var(--font); fill: var(--text-2); }
  .ohf svg[data-oh] text.oh-l { font: 600 13px var(--font); fill: var(--text); }
  .ohf svg[data-oh] text.oh-s { font: 11.5px var(--font); fill: var(--text-2); }
  .ohf svg[data-oh] text.oh-a { font: 11px var(--font); fill: var(--text-2); }
  .ohf svg[data-oh] text.oh-n { font: 600 11.5px var(--font); fill: var(--text-2); }
  .ohf svg[data-oh] text.oh-n.o2 { fill: var(--r-out); }
  .ohf svg[data-oh] tspan.oh-s { font-weight: 400; fill: var(--text-2); }
  /* vue étroite : réduite d'environ 10 % à 390 px, textes un peu plus grands */
  .ohf svg[data-oh="etroit"] text.oh-a { font-size: 12px; }
  .ohf svg[data-oh="etroit"] text.oh-h, .ohf svg[data-oh="etroit"] text.oh-n, .ohf svg[data-oh="etroit"] tspan.oh-s { font-size: 12.5px; }
  .ohf figcaption .katex { font-size: 1em; }
  .ohf figcaption { font-size: 12.5px; color: var(--text-2); line-height: 1.5; margin-top: 10px; }
</style>
