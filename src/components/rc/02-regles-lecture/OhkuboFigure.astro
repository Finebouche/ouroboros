---
// Cours Reservoir computing, chapitre 2 : figure statique de l'expérience « open-loop » d'Ohkubo et Inubushi (2024), en petit
// (lorenz.ts, calculé à la construction). En haut : mêmes états (N = 10), lecture d'ordre 1 ou 2 ; série x et plan (x, z) prédits.
// En bas : erreur de test selon le nombre de paramètres appris, médiane sur cinq tirages de A et B.
import katex from 'katex';
import { experiment } from './lorenz';

const km = (s: string) => katex.renderToString(s, { throwOnError: false });

const { pair, curve } = experiment();
const fm = (v: number, d = 1) => v.toFixed(d).replace('.', ',');
const big = (v: number) => v.toLocaleString('fr-FR').replace(/\u202f/g, '\u00a0');

// ---- haut : deux lignes (ordre 1, ordre 2)
const W = 680, LX = 88, TS = { x: 126, w: 366 }, PH = { x: 524, w: 146 }, RH = 132, TOP = 22, NT = 300, NP = 1000; // pas de dt = 0,02 : 6 et 20 unités de temps
const ty = (r: number, v: number) => TOP + r * RH + 8 + ((22 - v) / 44) * (RH - 24);
const tx = (t: number) => TS.x + (t / (NT - 1)) * TS.w;
const px = (v: number) => PH.x + ((v + 25) / 50) * PH.w, pz = (r: number, v: number) => TOP + r * RH + 4 + ((52 - v) / 52) * (RH - 16);
const path = (pts: number[][], r: number) => pts.slice(0, NP).map((p, i) => `${i ? 'L' : 'M'}${px(p[0]).toFixed(1)},${pz(r, p[2]).toFixed(1)}`).join('');
let top = `<text x="${TS.x}" y="12" class="oh-h">composante x : ${fm(NT * 0.02, 0)} unités de temps de test</text><text x="${PH.x + PH.w}" y="12" text-anchor="end" class="oh-h">plan (x, z) : ${fm(NP * 0.02, 0)} unités de temps</text>`;
pair.forEach((p, r) => {
  const y0 = TOP + r * RH;
  top += `<defs><clipPath id="ohc${r}"><rect x="${PH.x}" y="${y0 + 4}" width="${PH.w}" height="${RH - 16}"/></clipPath></defs>`;
  top += `<text x="${LX}" y="${y0 + 40}" text-anchor="end" class="oh-l">ordre ${p.order}</text>`;
  top += `<text x="${LX}" y="${y0 + 56}" text-anchor="end" class="oh-s">${big(p.M)} paramètres</text>`;
  top += `<text x="${LX}" y="${y0 + 72}" text-anchor="end" class="oh-s">RMSE ${fm(p.rmse, p.rmse < 0.1 ? 3 : p.rmse < 1 ? 2 : 1)}</text>`;
  [-20, 0, 20].forEach((v) => (top += `<line x1="${TS.x}" x2="${TS.x + TS.w}" y1="${ty(r, v).toFixed(1)}" y2="${ty(r, v).toFixed(1)}" stroke="var(--border)"${v ? ' stroke-dasharray="2 3"' : ''}/><text x="${TS.x - 4}" y="${(ty(r, v) + 3.5).toFixed(1)}" text-anchor="end" class="oh-a">${v}</text>`));
  const pl = (f: (t: number) => number) => Array.from({ length: NT }, (_, t) => `${tx(t).toFixed(1)},${ty(r, f(t)).toFixed(1)}`).join(' ');
  top += `<polyline points="${pl((t) => p.T[t][0])}" fill="none" stroke="var(--text)" stroke-width="1.2" stroke-dasharray="4 3"/>`;
  top += `<polyline points="${pl((t) => Math.max(-30, Math.min(30, p.P[t][0])))}" fill="none" stroke="var(--r-out)" stroke-width="1.7"/>`;
  top += `<rect x="${PH.x}" y="${y0 + 4}" width="${PH.w}" height="${RH - 16}" fill="none" stroke="var(--border)"/>`;
  top += `<g clip-path="url(#ohc${r})"><path d="${path(p.T, r)}" fill="none" stroke="var(--text)" stroke-opacity="0.22" stroke-width="2.2"/><path d="${path(p.P, r)}" fill="none" stroke="var(--r-out)" stroke-opacity="0.8" stroke-width="0.9"/></g>`;
});
const HT = TOP + 2 * RH;

// ---- bas : RMSE de test contre M, échelles logarithmiques
const B = { x0: 58, x1: 660, y0: 30, y1: 196 }, HB = 226;
const lx = (m: number) => B.x0 + ((Math.log10(m) - Math.log10(8)) / (Math.log10(800) - Math.log10(8))) * (B.x1 - B.x0);
const ly = (v: number) => B.y0 + ((1 - Math.log10(v)) / 3) * (B.y1 - B.y0); // de 10 à 0,01
let bot = '';
[10, 1, 0.1, 0.01].forEach((v) => (bot += `<line x1="${B.x0}" x2="${B.x1}" y1="${ly(v).toFixed(1)}" y2="${ly(v).toFixed(1)}" stroke="var(--border)"/><text x="${B.x0 - 6}" y="${(ly(v) + 3.5).toFixed(1)}" text-anchor="end" class="oh-a">${fm(v, v < 1 ? (v < 0.1 ? 2 : 1) : 0)}</text>`));
[10, 30, 100, 300].forEach((m) => (bot += `<text x="${lx(m).toFixed(1)}" y="${B.y1 + 14}" text-anchor="middle" class="oh-a">${m}</text>`));
bot += `<text x="${B.x1}" y="${B.y1 + 28}" text-anchor="end" class="oh-a">paramètres appris M (3 sorties × monômes)</text>`;
bot += `<text x="${B.x0 - 6}" y="${B.y0 - 12}" text-anchor="end" class="oh-a">RMSE</text>`;
const m195 = curve.filter((c) => c.M === 195);
bot += `<line x1="${lx(195).toFixed(1)}" x2="${lx(195).toFixed(1)}" y1="${B.y0}" y2="${B.y1}" stroke="var(--text-2)" stroke-dasharray="3 3"/>`;
([1, 2] as const).forEach((o) => {
  const c = curve.filter((k) => k.order === o), col = o === 2 ? 'var(--r-out)' : 'var(--text-2)';
  bot += `<polyline points="${c.map((k) => `${lx(k.M).toFixed(1)},${ly(k.med).toFixed(1)}`).join(' ')}" fill="none" stroke="${col}" stroke-width="${o === 2 ? 2 : 1.6}"/>`;
  c.forEach((k) => (bot += `<circle cx="${lx(k.M).toFixed(1)}" cy="${ly(k.med).toFixed(1)}" r="3" fill="${col}"/>`));
});
m195.forEach((c) => (bot += `<text x="${(lx(195) + 6).toFixed(1)}" y="${(ly(c.med) + (c.order === 2 ? 14 : -6)).toFixed(1)}" class="oh-n"${c.order === 2 ? ' style="fill: var(--r-out)"' : ''}>N = ${c.N}</text>`));
const o1 = curve.filter((k) => k.order === 1), o2 = curve.filter((k) => k.order === 2);
---
<figure class="ohf">
  <div class="ohb">
    <div class="oht"><b>Mêmes états (N = 10), deux lectures</b><span>pointillés : cible ; trait : prédiction de x, 0,2 plus loin</span></div>
    <div class="ohs"><svg viewBox={`0 0 ${W} ${HT}`} role="img" aria-label="Série x et plan (x, z) de Lorenz prédits par une lecture d'ordre 1 et d'ordre 2 sur les mêmes états" set:html={top} /></div>
  </div>
  <div class="ohb">
    <div class="oht"><b>Erreur de test selon le nombre de paramètres appris</b><span class="ohk"><i class="k1"></i>ordre 1, N = {o1[0].N} à {o1[o1.length - 1].N}<i class="k2"></i>ordre 2, N = {o2[0].N} à {o2[o2.length - 1].N}</span></div>
    <div class="ohs"><svg viewBox={`0 0 ${W} ${HB}`} role="img" aria-label="RMSE de test contre le nombre de paramètres appris, lectures d'ordre 1 et 2" set:html={bot} /></div>
  </div>
  <figcaption>Lorenz intégré avec <Fragment set:html={km('\\Delta t = 0{,}02')} /> ; entrée <Fragment set:html={km('x(t)')} /> à chaque pas, cible <Fragment set:html={km('x(t + 0{,}2)')} /> ; ESN sans fuite <Fragment set:html={km('r_{t+1} = \\tanh(A\\,r_t + B\\,x_t)')} />, lecture ridge sans biais, comme chez Ohkubo et Inubushi (2024). Comme eux (supplément), <Fragment set:html={km('\\sigma_A')} />, <Fragment set:html={km('\\sigma_B')} /> et <Fragment set:html={km('\\beta')} /> sont choisis sur une grille pour chaque ordre et chaque N ; nos grilles et nos longueurs diffèrent (en haut, réglages de l'ordre 1). En bas, médiane sur cinq tirages de A et B.</figcaption>
</figure>

<style is:global>
  .ohf { margin: 1.5rem 0; }
  .ohf .ohb + .ohb { margin-top: 14px; }
  .ohf .oht { display: flex; flex-wrap: wrap; gap: 2px 12px; align-items: baseline; margin-bottom: 4px; font-size: 13px; color: var(--text-2); }
  .ohf .oht b { color: var(--text); font-size: 13px; }
  .ohf .ohk { display: inline-flex; align-items: center; gap: 6px; }
  .ohf .ohk i { display: inline-block; width: 16px; height: 0; border-top: 2px solid var(--text-2); margin-left: 6px; }
  .ohf .ohk i.k2 { border-top-color: var(--r-out); }
  .ohf .ohs { overflow-x: auto; }
  .ohf svg { width: 100%; min-width: 520px; height: auto; display: block; }
  .ohf svg text.oh-h { font: 11.5px var(--font); fill: var(--text-2); }
  .ohf svg text.oh-l { font: 600 13px var(--font); fill: var(--text); }
  .ohf svg text.oh-s { font: 11.5px var(--font); fill: var(--text-2); }
  .ohf svg text.oh-a { font: 11px var(--font); fill: var(--text-2); }
  .ohf svg text.oh-n { font: 600 11.5px var(--font); fill: var(--text-2); }
  .ohf figcaption .katex { font-size: 1em; }
  .ohf figcaption { font-size: 12.5px; color: var(--text-2); line-height: 1.5; margin-top: 10px; }
</style>
