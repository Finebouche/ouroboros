---
// Cours Reservoir computing, chapitre 11 : les trois étapes de Jaeger (2014) en trois panneaux.
// 1. Conduire le réservoir par chaque motif p_j et garder ses états (R_j). 2. Charger : apprendre W pour que le réservoir
// reproduise ces états sans entrée. 3. Rappeler : sans entrée, le conceptor C_j inséré dans la boucle choisit le motif.
// Réservoir en bleu-vert (--r-res), lecture entraînée en violet (--r-out), entrée en gris ; le conceptor en ambre (élément sélectionné).
// Deux mises en page des mêmes panneaux : en ligne (large), ou empilés quand la figure a moins de 560 px (container query),
// pour que le texte ne descende pas sous 9 px.
const box = (x: number, y: number, w: number, h: number, t: string, s: string, col: string) =>
  `<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="8" fill="color-mix(in srgb, ${col} 12%, var(--surface))" stroke="${col}" stroke-width="1.3"/>` +
  `<text x="${x + w / 2}" y="${y + (s ? h / 2 - 2 : h / 2 + 4)}" text-anchor="middle" class="cb">${t}</text>` +
  (s ? `<text x="${x + w / 2}" y="${y + h / 2 + 12}" text-anchor="middle" class="cs">${s}</text>` : '');
const wave = (x: number, y: number, w: number, col: string) => {
  let d = '';
  for (let i = 0; i <= 40; i++) d += `${(x + (i / 40) * w).toFixed(1)},${(y - 9 * Math.sin((i / 40) * 4 * Math.PI)).toFixed(1)} `;
  return `<polyline points="${d}" fill="none" stroke="${col}" stroke-width="1.6"/>`;
};
const R = 'var(--r-res)', O = 'var(--r-out)', A = 'var(--hl-stroke)', T2 = 'var(--text-2)';
// id de flèche propre à chaque SVG : un marqueur pris dans un SVG masqué (display: none) ne s'affiche pas
function panels(id: string) {
  const ar = (d: string, col = T2) => `<path d="${d}" fill="none" stroke="${col}" stroke-width="1.3" marker-end="url(#${id})"/>`;
  const defs = `<defs><marker id="${id}" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="${T2}"/></marker></defs>`;
  // 1. conduire
  const p1 = wave(10, 78, 44, T2) + `<text x="32" y="104" text-anchor="middle" class="cs">motif pⱼ</text>` +
    ar('M58,78 H82') + box(84, 54, 92, 48, 'réservoir', 'poids W* tirés', R) +
    ar('M130,102 V128') + `<text x="130" y="144" text-anchor="middle" class="cs">états xⱼ(n) → Rⱼ</text>`;
  // 2. charger
  const p2 = box(30, 54, 120, 48, 'réservoir', 'nouveaux poids W', R) +
    `<path d="M150,70 C190,40 190,120 150,88" fill="none" stroke="${R}" stroke-width="1.3" marker-end="url(#${id})"/>` +
    `<text x="90" y="124" text-anchor="middle" class="cs">W x ≈ W* x + Wᵢₙ p :</text><text x="90" y="138" text-anchor="middle" class="cs">l'entrée passe dans les poids</text>`;
  // 3. rappeler
  const p3 = box(0, 54, 84, 44, 'tanh(W x + b)', '', R) + ar('M86,76 H108') + box(110, 54, 44, 44, 'Cⱼ', '', A) +
    ar('M132,100 V122 H42 V100') +
    `<text x="88" y="136" text-anchor="middle" class="cs">x(n+1) = Cⱼ tanh(W x(n) + b)</text>` +
    ar('M156,76 H176', O) + `<text x="196" y="72" text-anchor="middle" class="cb" style="fill:${O}">y</text>` + wave(180, 92, 30, O);
  return { defs, p: [p1, p2, p3] };
}
const TITLES = ['1. Conduire', '2. Charger', '3. Rappeler, sans entrée'];
const at = (dx: number, dy: number, s: string) => `<g transform="translate(${dx},${dy})">${s}</g>`;
// large : panneaux côte à côte, titre en haut de chaque colonne
const w = panels('cl-ar-w');
const gW = w.defs + [[0, 10], [226, 0], [448, 0]].map(([dx, tx], k) => at(dx, 0, `<text x="${tx}" y="16" class="ct">${TITLES[k]}</text>` + w.p[k])).join('');
// étroit : panneaux empilés, titres alignés à gauche, contenu centré (étendues horizontales : 10–176, 0–180, 0–210)
const n = panels('cl-ar-n');
const gN = n.defs + [57, 60, 45].map((dx, k) => `<text x="10" y="${162 * k + 16}" class="ct">${TITLES[k]}</text>` + at(dx, 162 * k, n.p[k])).join('');
const LABEL = 'Trois étapes : conduire le réservoir par chaque motif, charger les motifs dans les poids, rappeler un motif en insérant son conceptor dans la boucle';
---
<figure class="cloop">
  <svg class="cl-w" viewBox="0 0 660 152" role="img" aria-label={LABEL} set:html={gW} />
  <svg class="cl-n" viewBox="0 0 300 470" role="img" aria-label={LABEL} set:html={gN} />
</figure>

<style is:global>
  .cloop { margin: 1.5rem 0; container-type: inline-size; }
  .cloop svg { width: 100%; height: auto; display: block; }
  .cloop svg.cl-n { display: none; max-width: 380px; margin: 0 auto; }
  @container (max-width: 560px) {
    .cloop svg.cl-w { display: none; }
    .cloop svg.cl-n { display: block; }
  }
  .cloop svg text.ct { font: 600 13px var(--font); fill: var(--text); }
  .cloop svg text.cb { font: 600 12px var(--font); fill: var(--text); }
  .cloop svg text.cs { font: 11px var(--font); fill: var(--text-2); }
</style>
