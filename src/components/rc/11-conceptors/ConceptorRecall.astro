---
// Cours Reservoir computing, chapitre 11 : rappel des motifs par le réservoir chargé, sans entrée, x(n+1) = C tanh(W x(n) + b).
// États précalculés à la construction (conceptors.ts, graine fixe, α = 10) : un conceptor par motif, aucun conceptor,
// ou le mélange (1 − μ) C₁ + μ C₂ entre les deux sinus. Sortie lue par W_out, 40 pas après 600 pas d'amorçage,
// alignée en phase sur le motif d'origine (décalage entier) pour mesurer l'écart.
import { getExperiment, aligned, period } from './conceptors';
const E = getExperiment();
const Cs = E.Rs.map((R) => E.conceptor(R, 10));
const NAMES = ['C₁ : sinus 8,83', 'C₂ : sinus 9,83', 'C₃ : 5-périodique', 'C₄ : sa variante'];
const rec = Cs.map((C, j) => {
  const y = E.run(C), a = aligned(y, E.P[j]);
  return { y: a.seg, tgt: a.tgt, nrmse: a.nrmse, T: j < 2 ? period(y) : NaN };
});
const yNone = E.run(null);
const none = { y: yNone.slice(-40), T: period(yNone) };
const MUS = [-1, 0, 0.5, 1, 2];
const morph = MUS.map((mu) => { const y = E.run(E.mix(Cs[0], Cs[1], mu)); return { y: y.slice(-40), T: period(y) }; });
const data = { NAMES, rec, none, MUS, morph };
---
<div class="widget rcw crec" data-widget="crec">
  <div class="row"><span>Conceptor dans la boucle :</span><span class="seg" data-ref="pick"></span></div>
  <div class="row"><span>Mélange (1 − μ) C₁ + μ C₂ :</span><span class="seg" data-ref="mu"></span></div>
  <div class="ft" data-ref="title"></div>
  <svg data-ref="svg" role="img" aria-label="Sortie du réservoir chargé, sans entrée, avec le conceptor choisi, et motif d'origine"></svg>
  <div class="kpis">
    <div><span>Écart au motif (NRMSE)</span><b data-ref="k1"></b></div>
    <div><span>Période mesurée</span><b data-ref="k2"></b></div>
  </div>
  <p class="note">Aucune entrée : le réservoir chargé tourne seul. Sortie lue par la lecture entraînée, 40 pas après 600 pas d'amorçage ; le motif d'origine est aligné en phase pour mesurer l'écart. Réservoir de 100 neurones tiré au hasard (graine fixe), α = 10.</p>
</div>

<script define:vars={{ data }}>
  document.querySelectorAll('[data-widget="crec"]').forEach((root) => {
    const $ = (r) => root.querySelector(`[data-ref="${r}"]`);
    const f = (v, d = 2) => (Number.isFinite(v) ? v.toFixed(d).replace('.', ',').replace('-', '−') : '—');
    let mode = { kind: 'c', j: 0 };
    const btn = (key, label, m) => { const b = document.createElement('button'); b.textContent = label; b.addEventListener('click', () => { mode = m; draw(); }); b._m = m; $(key).appendChild(b); };
    data.NAMES.forEach((n, j) => btn('pick', n, { kind: 'c', j }));
    btn('pick', 'aucun', { kind: 'none' });
    data.MUS.forEach((mu, k) => btn('mu', `μ = ${String(mu).replace('.', ',').replace('-', '−')}`, { kind: 'mu', k }));
    const same = (a, b) => a.kind === b.kind && a.j === b.j && a.k === b.k;
    function draw() {
      root.querySelectorAll('.seg button').forEach((b) => b.classList.toggle('active', same(b._m, mode)));
      let y, tgt = null, nr = NaN, T = NaN, title;
      if (mode.kind === 'c') { const r = data.rec[mode.j]; y = r.y; tgt = r.tgt; nr = r.nrmse; T = r.T; title = `Avec ${data.NAMES[mode.j]}`; }
      else if (mode.kind === 'none') { y = data.none.y; T = data.none.T; title = 'Sans conceptor (C = I)'; }
      else { const r = data.morph[mode.k], mu = data.MUS[mode.k]; y = r.y; T = r.T; title = `Mélange μ = ${f(mu, mu % 1 ? 1 : 0)} : ${mu < 0 || mu > 1 ? 'extrapolation' : mu === 0 ? 'C₁ seul' : mu === 1 ? 'C₂ seul' : 'entre C₁ et C₂'}`; }
      $('title').textContent = title;
      const W = 640, H = 170, ox = 30, pw = W - ox - 10, top = 10, ph = H - 40;
      const X = (n) => ox + (n / 39) * pw, Y = (v) => top + (1 - (Math.max(-1.3, Math.min(1.3, v)) + 1.3) / 2.6) * ph;
      let g = '';
      [-1, 0, 1].forEach((v) => (g += `<line x1="${ox}" y1="${Y(v)}" x2="${W - 10}" y2="${Y(v)}" stroke="var(--border)" stroke-dasharray="${v ? '2 4' : ''}"/><text x="${ox - 5}" y="${Y(v) + 4}" text-anchor="end" class="ax">${f(v, 0)}</text>`));
      const pl = (arr) => arr.map((v, n) => `${X(n).toFixed(1)},${Y(v).toFixed(1)}`).join(' ');
      g += `<polyline points="${pl(y)}" fill="none" stroke="var(--r-out)" stroke-width="2"/>`;
      y.forEach((v, n) => (g += `<circle cx="${X(n).toFixed(1)}" cy="${Y(v).toFixed(1)}" r="2.4" fill="var(--r-out)"/>`));
      // motif d'origine par-dessus, en pointillés : visible même quand la sortie le recouvre
      if (tgt) g += `<polyline points="${pl(tgt)}" fill="none" stroke="var(--text)" stroke-width="1.2" stroke-dasharray="4 3"/>`;
      g += `<text x="${ox}" y="${H - 8}" class="ax">pas (40 pas)</text>`;
      g += `<text x="${W - 10}" y="${H - 8}" text-anchor="end" class="ax"><tspan style="fill:var(--r-out);font-weight:600">— sortie y(n)</tspan>${tgt ? '   <tspan style="fill:var(--text);font-weight:600">- - motif d\'origine</tspan>' : ''}</text>`;
      const svg = $('svg');
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.innerHTML = g;
      $('k1').textContent = tgt ? f(nr, 3) : '—';
      $('k2').textContent = Number.isFinite(T) ? `${f(T)} pas` : mode.kind === 'c' ? '5 pas' : '—';
    }
    draw();
  });
</script>

<style is:global>
  .crec .row > .seg { display: inline-flex; flex-wrap: wrap; gap: 6px; }
  .crec .row > span:first-child { min-width: 13em; }
  .crec .seg button { font-size: 13px; padding: 4px 10px; }
  .crec .ft { font-size: 13px; font-weight: 500; margin: 6px 0 2px; }
  .crec svg { width: 100%; height: auto; display: block; }
  .crec svg text.ax { font: 11px var(--font); fill: var(--text-2); }
</style>
