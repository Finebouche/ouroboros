---
// Chapitre HPC 1 : le modèle roofline. Performance atteignable = min(crête, intensité × débit).
// Points : noyaux typiques ; les flèches montrent ce que la fusion (jit) et vmap font à l'intensité.
---
<div class="widget roof hp" data-widget="roof">
  <div class="row"><span>Machine :</span><span class="seg" data-ref="hw"></span></div>
  <div class="row"><span>Calcul en :</span><span class="seg" data-ref="pr"></span></div>
  <div class="sl sl-side">
    <label><span>Chaîne de k opérations élément par élément</span><input type="range" data-ref="k" min="1" max="32" step="1" value="8" /><b data-ref="k-out"></b></label>
    <label><span>Lot B regroupé par vmap</span><input type="range" data-ref="b" min="0" max="10" step="1" value="6" /><b data-ref="b-out"></b></label>
    <label><span>Taille n du GEMM (n × n × n)</span><input type="range" data-ref="n" min="5" max="13" step="1" value="10" /><b data-ref="n-out"></b></label>
  </div>
  <svg data-ref="svg" width="100%" role="img" aria-label="Roofline : performance atteignable en fonction de l'intensité arithmétique"></svg>
  <div class="row chips" data-ref="pts"></div>
  <div class="kpis">
    <div><span>Intensité</span><b data-ref="k1"></b></div>
    <div><span>Atteignable</span><b data-ref="k2"></b></div>
    <div><span>Part de la crête</span><b data-ref="k3"></b></div>
    <div><span>Limité par</span><b data-ref="k4"></b></div>
  </div>
  <p class="note" data-ref="note"></p>
</div>

<script>
  import { HWS, fmtRate } from '../hw';
  document.querySelectorAll<HTMLElement>('[data-widget="roof"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const inp = (r: string) => $(r) as HTMLInputElement;
    const fr = (v: number, d = 2) => v.toLocaleString('fr-FR', { maximumFractionDigits: d });
    let hw = HWS[3], mat = false, sel = 'fused';
    const NV = 4096; // taille des matrices pour le GEMV

    HWS.forEach((h) => {
      const b = document.createElement('button');
      b.textContent = h.name; b.dataset.v = h.id;
      b.addEventListener('click', () => { hw = h; if (!h.vec) mat = true; if (!h.mat) mat = false; draw(); });
      $('hw').appendChild(b);
    });
    [['FP32, unités vectorielles', 0], ['BF16, unités matricielles', 1]].forEach(([l, v]) => {
      const b = document.createElement('button');
      b.textContent = String(l); b.dataset.v = String(v);
      b.addEventListener('click', () => { if ((v === 1 && hw.mat) || (v === 0 && hw.vec)) { mat = v === 1; draw(); } });
      $('pr').appendChild(b);
    });

    type P = { id: string; label: string; ai: number; desc: string; jax?: boolean };
    function points(bytes: number): P[] {
      const k = +inp('k').value, B = 2 ** +inp('b').value, n = 2 ** +inp('n').value;
      return [
        { id: 'add', label: 'x + y', ai: 1 / (3 * bytes), desc: '1 FLOP pour 2 lectures et 1 écriture.' },
        { id: 'chain', label: `chaîne de ${k}, une passe par opération`, ai: 1 / (2 * bytes), desc: 'Comme NumPy : chaque opération relit son entrée et écrit un tableau temporaire. L’intensité ne dépend pas de k.' },
        { id: 'fused', label: `chaîne de ${k} fusionnée`, ai: k / (2 * bytes), desc: 'Ce que fait jit : une seule lecture, une seule écriture, les k opérations restent dans les registres.', jax: true },
        { id: 'red', label: 'somme (réduction)', ai: 1 / bytes, desc: '1 addition par valeur lue.' },
        { id: 'gemv', label: `W @ s (GEMV, N = ${NV})`, ai: (2 * NV * NV) / (bytes * (NV * NV + 2 * NV)), desc: 'Chaque coefficient de W est lu pour une seule multiplication-addition.' },
        { id: 'bgemv', label: `vmap sur B = ${B} (GEMM)`, ai: (2 * B * NV * NV) / (bytes * (NV * NV + 2 * B * NV)), desc: 'W est lu une fois pour B vecteurs : l’intensité est multipliée par environ B.', jax: true },
        { id: 'gemm', label: `GEMM n = ${n}`, ai: (2 * n ** 3) / (3 * bytes * n * n), desc: 'Avec un découpage en tuiles idéal : 2n³ FLOPs pour 3n² valeurs lues ou écrites.' },
      ];
    }

    function draw() {
      $('hw').querySelectorAll('button').forEach((b) => b.classList.toggle('active', b.dataset.v === hw.id));
      $('pr').querySelectorAll('button').forEach((b) => {
        const v = b.dataset.v === '1';
        b.classList.toggle('active', v === mat);
        (b as HTMLButtonElement).disabled = v ? !hw.mat : !hw.vec;
      });
      $('k-out').textContent = inp('k').value;
      $('b-out').textContent = String(2 ** +inp('b').value);
      $('n-out').textContent = String(2 ** +inp('n').value);
      const bytes = mat ? 2 : 4;
      const peak = (mat ? hw.mat : hw.vec)!;
      const pts = points(bytes);

      const W = 640, H = 330, ox = 56, oy = 10, pw = W - ox - 14, ph = H - 48;
      const xl = -6, xh = 12, yl = 9, yh = 15.3; // log2 de l'intensité, log10 des FLOP/s
      const X = (ai: number) => ox + ((Math.log2(ai) - xl) / (xh - xl)) * pw;
      const Y = (f: number) => oy + (1 - (Math.log10(f) - yl) / (yh - yl)) * ph;
      const att = (h: typeof hw, ai: number, m: boolean) => Math.min((m ? h.mat : h.vec) ?? 0, ai * h.bw);
      let g = '';
      for (let e = xl; e <= xh; e += 2) g += `<line x1="${X(2 ** e)}" y1="${oy}" x2="${X(2 ** e)}" y2="${oy + ph}" stroke="var(--border)" stroke-width="0.5"/><text x="${X(2 ** e)}" y="${oy + ph + 14}" text-anchor="middle" class="ax">${e < 0 ? `1/${2 ** -e}` : 2 ** e}</text>`;
      for (let e = yl; e <= 15; e++) g += `<line x1="${ox}" y1="${Y(10 ** e)}" x2="${ox + pw}" y2="${Y(10 ** e)}" stroke="var(--border)" stroke-width="0.5"/><text x="${ox - 6}" y="${Y(10 ** e) + 3.5}" text-anchor="end" class="ax">${fmtRate(10 ** e, '')}</text>`;
      g += `<text x="${ox + pw / 2}" y="${H - 4}" text-anchor="middle" class="ax">intensité arithmétique (FLOP / octet)</text><text x="12" y="${oy + ph / 2}" transform="rotate(-90 12 ${oy + ph / 2})" text-anchor="middle" class="ax">FLOP/s atteignables</text>`;
      // toits des autres machines, en pâle
      const roofPath = (h: typeof hw, m: boolean) => {
        const p = (m ? h.mat : h.vec);
        if (!p) return '';
        const ridge = p / h.bw;
        const a0 = 2 ** xl, a1 = 2 ** xh;
        return `M${X(a0)} ${Y(a0 * h.bw)}L${X(Math.min(ridge, a1))} ${Y(Math.min(p, a1 * h.bw))}L${X(a1)} ${Y(p)}`;
      };
      HWS.forEach((h) => { if (h.id !== hw.id) g += `<path d="${roofPath(h, mat && !!h.mat || !h.vec)}" fill="none" stroke="var(--text-2)" stroke-width="1" opacity="0.25"/>`; });
      const ridge = peak / hw.bw;
      // toit de la machine choisie : pente limitée par la mémoire, plafond limité par le calcul
      { const a0 = 2 ** xl, a1 = 2 ** xh, r = Math.min(ridge, a1);
        g += `<path d="M${X(a0)} ${Y(a0 * hw.bw)}L${X(r)} ${Y(Math.min(peak, r * hw.bw))}" fill="none" stroke="var(--h-mem)" stroke-width="2.6"/>`;
        if (ridge < a1) g += `<path d="M${X(ridge)} ${Y(peak)}L${X(a1)} ${Y(peak)}" fill="none" stroke="var(--h-calc)" stroke-width="2.6"/>`; }
      g += `<line x1="${X(ridge)}" y1="${Y(peak)}" x2="${X(ridge)}" y2="${oy + ph}" stroke="var(--text-2)" stroke-dasharray="3 3"/><text x="${X(ridge) + 4}" y="${Y(peak) + 14}" class="ax">équilibre ≈ ${fr(ridge, 1)}</text>`;
      g += `<text x="${ox + pw - 4}" y="${Y(peak) - 6}" text-anchor="end" class="ax v">${hw.name} : crête ${fmtRate(peak, 'FLOP/s')}</text>`;
      // flèches fusion et vmap
      const P = Object.fromEntries(pts.map((p) => [p.id, p]));
      const arrow = (a: P, b: P, label: string) => {
        const x1 = X(a.ai), y1 = Y(att(hw, a.ai, mat)), x2 = X(b.ai), y2 = Y(att(hw, b.ai, mat));
        if (Math.abs(x2 - x1) < 6) return '';
        return `<path d="M${x1} ${y1}L${x2 - 7} ${y2 + (y1 - y2) * 7 / Math.max(1, Math.hypot(x2 - x1, y2 - y1))}" stroke="var(--hl-stroke)" stroke-width="1.6" marker-end="url(#roof-ar)"/><text x="${(x1 + x2) / 2}" y="${(y1 + y2) / 2 - 6}" text-anchor="middle" class="ax hl">${label}</text>`;
      };
      g += `<defs><marker id="roof-ar" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M1 1L9 5L1 9" fill="none" stroke="var(--hl-stroke)" stroke-width="1.6"/></marker></defs>`;
      g += arrow(P.chain, P.fused, 'jit : fusion') + arrow(P.gemv, P.bgemv, 'vmap');
      pts.forEach((p) => {
        const x = X(p.ai), y = Y(att(hw, p.ai, mat)), on = p.id === sel;
        g += `<circle cx="${x}" cy="${y}" r="${on ? 7 : 5}" fill="${p.ai < ridge ? 'var(--h-mem)' : 'var(--h-calc)'}" stroke="${on ? 'var(--hl-stroke)' : 'var(--surface)'}" stroke-width="2" data-id="${p.id}" style="cursor:pointer"/>`;
      });
      const s = $('svg') as unknown as SVGSVGElement;
      s.setAttribute('viewBox', `0 0 ${W} ${H}`);
      s.innerHTML = g;

      $('pts').innerHTML = pts.map((p) => `<button data-id="${p.id}" class="${p.id === sel ? 'active' : ''}"><i style="background:${p.ai < ridge ? 'var(--h-mem)' : 'var(--h-calc)'}"></i>${p.label}</button>`).join('');
      const cur = P[sel], a = att(hw, cur.ai, mat);
      $('k1').textContent = `${fr(cur.ai, cur.ai < 1 ? 3 : 1)} FLOP/o`;
      $('k2').textContent = fmtRate(a, 'FLOP/s');
      $('k3').textContent = `${fr((a / peak) * 100, a / peak < 0.01 ? 2 : 1)} %`;
      $('k4').textContent = cur.ai < ridge ? 'la mémoire' : 'le calcul';
      $('note').textContent = cur.desc;
    }
    root.addEventListener('click', (ev) => {
      const id = (ev.target as Element).closest('[data-id]')?.getAttribute('data-id');
      if (id) { sel = id; draw(); }
    });
    ['k', 'b', 'n'].forEach((r) => inp(r).addEventListener('input', draw));
    draw();
  });
</script>

<style is:global>
  .roof .row { margin-bottom: 4px; }
  .roof .seg { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .roof .seg button { font-size: 13px; padding: 4px 12px; }
  .roof .seg button:disabled { opacity: 0.35; cursor: default; }
  .roof .sl { display: grid; grid-template-columns: 1fr; gap: 4px; margin: 8px 0; }
  .widget.roof.hp .sl.sl-side label:has(> input[type="range"]) { grid-template-columns: 20em minmax(0, 1fr) 3.4em; }
  @media (max-width: 600px) {
    .widget.roof.hp .sl.sl-side label:has(> input[type="range"]) { grid-template-columns: minmax(0, 1fr) auto; row-gap: 4px; }
    .widget.roof.hp .sl.sl-side label:has(> input[type="range"]) > input[type="range"] { grid-column: 1 / -1; grid-row: 2; }
    .widget.roof.hp .sl.sl-side label:has(> input[type="range"]) > b { grid-column: 2; }
  }
  .roof .sl label { display: grid; grid-template-columns: 280px 1fr 50px; align-items: center; gap: 12px; font-size: 14px; color: var(--text-2); }
  .roof .sl b { text-align: right; color: var(--text); font-weight: 500; }
  .roof .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .roof .chips button { font-size: 12px; padding: 3px 9px; }
  .roof .chips button i { display: inline-block; width: 9px; height: 9px; border-radius: 5px; margin-right: 6px; }
  .roof svg text.ax { font: 11px var(--font); fill: var(--text-2); }
  .roof svg text.ax.v { fill: var(--text); font-weight: 500; }
  .roof svg text.ax.hl { fill: var(--hl-text); font-weight: 500; }
  .roof .note { font-size: 14px; line-height: 1.5; margin: 8px 0 0; min-height: 3em; }
  @media (max-width: 600px) { .roof .sl label { grid-template-columns: 1fr; } }
</style>
