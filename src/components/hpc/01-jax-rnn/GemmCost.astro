---
// Chapitre HPC 1, section 1 : les produits matriciels d'un pas de RNN, leurs FLOPs, et le pré-calcul de x·Wx sur T·B lignes.
---
<div class="widget gemmc hp" data-widget="gemmc">
  <div class="sl">
    <label><span>Lot B (séquences)</span><input type="range" data-ref="b" min="1" max="256" step="1" value="32" /><b data-ref="b-out"></b></label>
    <label><span>Entrée D</span><input type="range" data-ref="d" min="8" max="512" step="8" value="128" /><b data-ref="d-out"></b></label>
    <label><span>État H</span><input type="range" data-ref="h" min="8" max="512" step="8" value="128" /><b data-ref="h-out"></b></label>
    <label><span>Pas T</span><input type="range" data-ref="t" min="10" max="1000" step="10" value="200" /><b data-ref="t-out"></b></label>
  </div>
  <div class="row"><span>Produit x·Wx :</span><span class="seg" data-ref="mode"></span></div>
  <svg data-ref="svg" width="100%" role="img" aria-label="Formes des matrices dans un pas de RNN"></svg>
  <div class="kpis">
    <div><span>FLOPs par pas</span><b data-ref="k1"></b></div>
    <div><span>Pour T pas</span><b data-ref="k2"></b></div>
    <div><span>Appels GEMM par séquence</span><b data-ref="k3"></b></div>
  </div>
  <p class="note" data-ref="note"></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-widget="gemmc"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const inp = (r: string) => $(r) as HTMLInputElement;
    const fr = (v: number, d = 1) => v.toLocaleString('fr-FR', { maximumFractionDigits: d });
    let big = false;

    ([['small', 'T petits GEMM (B × D)'], ['big', 'Un grand GEMM ((T·B) × D)']] as [string, string][]).forEach(([v, label]) => {
      const b = document.createElement('button');
      b.textContent = label; b.dataset.v = v;
      b.addEventListener('click', () => { big = v === 'big'; draw(); });
      $('mode').appendChild(b);
    });

    function flops(v: number) { return v >= 1e8 ? `${fr(v / 1e9, 2)} GFLOP` : `${fr(v / 1e6, 2)} MFLOP`; }

    function draw() {
      const B = +inp('b').value, D = +inp('d').value, H = +inp('h').value, T = +inp('t').value;
      ['b', 'd', 'h', 't'].forEach((r) => ($(r + '-out').textContent = String(+inp(r).value)));
      $('mode').querySelectorAll('button').forEach((b) => b.classList.toggle('active', (b.dataset.v === 'big') === big));

      // matrices dessinées à l'échelle (bornées pour rester lisibles)
      const px = (n: number) => Math.max(10, Math.min(130, n * 0.5));
      const rows1 = big ? T * B : B;
      const W = 640, y0 = 16;
      let g = '';
      let x = 14;
      let maxH = 0;
      const rect = (label: string, r: number, c: number, fill: string, dim: string) => {
        const w = px(c), h = px(r), bw = Math.max(w, dim.length * 5.6);
        const rx = x + (bw - w) / 2;
        g += `<rect x="${rx}" y="${y0}" width="${w}" height="${h}" rx="3" fill="${fill}" opacity="0.85"/>`;
        if (big && r === rows1 && label === 'x') g += `<path d="M${rx} ${y0 + h - 6}l${w} -4M${rx} ${y0 + h - 2}l${w} -4" stroke="var(--surface)" stroke-width="2"/>`;
        g += `<text x="${x + bw / 2}" y="${y0 + h + 14}" text-anchor="middle" class="ax">${dim}</text>`;
        g += `<text x="${rx + w / 2}" y="${y0 + Math.min(h, 40) / 2 + 4}" text-anchor="middle" class="lab">${label}</text>`;
        maxH = Math.max(maxH, h);
        x += bw;
      };
      const op = (t: string) => { g += `<text x="${x + 12}" y="${y0 + 36}" text-anchor="middle" class="op">${t}</text>`; x += 24; };
      rect('x', rows1, D, 'var(--h-calc)', big ? `(T·B) × D = ${rows1} × ${D}` : `B × D = ${B} × ${D}`);
      op('×');
      rect('Wx', D, H, 'var(--h-calc)', `D × H = ${D} × ${H}`);
      op('=');
      rect('xW', rows1, H, 'var(--h-calc)', big ? `(T·B) × H` : `B × H`);
      x += 40;
      rect('h', B, H, 'var(--h-calc)', `B × H = ${B} × ${H}`);
      op('×');
      rect('Wh', H, H, 'var(--h-calc)', `H × H = ${H} × ${H}`);
      const svg = $('svg') as unknown as SVGSVGElement;
      svg.setAttribute('viewBox', `0 0 ${Math.max(W, x + 10)} ${y0 + maxH + 26}`);
      svg.innerHTML = g;

      const per = 2 * B * H * (D + H);
      $('k1').textContent = flops(per);
      $('k2').textContent = flops(per * T);
      $('k3').innerHTML = big ? `${T + 1} <small>(1 grand + T pour h·Wh)</small>` : `${2 * T} <small>(2 par pas)</small>`;
      $('note').textContent = big
        ? 'x·Wx ne dépend pas de l’état précédent : on le calcule pour tous les pas d’un coup. Les FLOPs sont les mêmes ; le nombre d’appels et la forme des produits changent. h·Wh doit rester dans la boucle.'
        : 'Chaque pas fait deux produits matriciels : x·Wx et h·Wh. Au total 2·B·H·(D + H) FLOPs par pas (une multiplication-addition compte pour 2).';
    }
    ['b', 'd', 'h', 't'].forEach((r) => inp(r).addEventListener('input', draw));
    draw();
  });
</script>

<style is:global>
  .gemmc .sl { display: grid; gap: 4px; margin-bottom: 8px; }
  .gemmc .sl label { display: grid; grid-template-columns: 170px 1fr 50px; align-items: center; gap: 12px; font-size: 14px; color: var(--text-2); }
  .gemmc .sl b { text-align: right; color: var(--text); font-weight: 500; }
  .gemmc .row { margin-bottom: 4px; }
  .gemmc .seg { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .gemmc .seg button { font-size: 13px; padding: 4px 12px; }
  .gemmc svg text.ax { font: 11px var(--font); fill: var(--text-2); }
  .gemmc svg text.lab { font: 500 12px var(--font); fill: #fff; }
  .gemmc svg text.op { font: 18px var(--font); fill: var(--text-2); }
  .gemmc .note { font-size: 14px; line-height: 1.5; margin: 8px 0 0; min-height: 3em; }
  @media (max-width: 600px) { .gemmc .sl label { grid-template-columns: 1fr; } }
</style>
