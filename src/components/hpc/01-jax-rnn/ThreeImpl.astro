---
// Chapitre HPC 1, section 5 : où va le temps de pilotage dans les trois implémentations (frise de structure, sans durées).
---
<div class="widget timpl hp" data-widget="timpl">
  <div class="row"><span>Implémentation :</span><span class="seg" data-ref="im"></span></div>
  <label class="posl"><span>Nombre de pas T</span><input type="range" data-ref="t" min="2" max="12" step="1" value="6" /><b data-ref="t-out"></b></label>
  <p class="hlegend"><span><i class="sq calc"></i>calcul (GEMM, tanh)</span><span><i class="sq py"></i>retour dans Python</span><span><i class="sq comp"></i>tracer + compiler</span><span><i class="sq exec"></i>exécutable compilé</span></p>
  <pre class="code" data-ref="code"></pre>
  <svg data-ref="svg" width="100%" role="img" aria-label="Frise des pas : calcul et pilotage Python"></svg>
  <div class="kpis">
    <div><span>Retours dans Python pour une séquence</span><b data-ref="k1"></b></div>
    <div><span>Appels GEMM</span><b data-ref="k2"></b></div>
  </div>
  <p class="note" data-ref="note"></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-widget="timpl"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const t = $('t') as HTMLInputElement;
    type I = { id: string; label: string; code: string; note: string };
    const IM: I[] = [
      { id: 'naive', label: 'NumPy naïf', code: 'for t in range(T):\n    h = np.tanh(xs[t] @ Wx + h @ Wh + b)', note: 'Les noyaux optimisés font déjà les produits : le coût de pilotage s’ajoute autour, à chaque pas.' },
      { id: 'opt', label: 'NumPy optimisé', code: 'xw = (xs.reshape(T*B, D) @ Wx).reshape(T, B, H) + b\nfor t in range(T):\n    h = np.tanh(xw[t] + h @ Wh)', note: 'x·Wx sort de la boucle (un grand GEMM). Il reste T retours dans Python : h·Wh dépend de l’état précédent.' },
      { id: 'jax', label: 'JAX optimisé', code: 'xw = (xs.reshape(T*B, D) @ Wx).reshape(T, B, H) + b\nh, _ = lax.scan(lambda h, a: (tanh(a + h @ Wh),) * 2, h0, xw)   # sous jit', note: 'Même pré-calcul. La boucle est compilée : une compilation au premier appel, puis aucun retour dans Python pendant les T pas.' },
    ];
    let im = IM[0];
    IM.forEach((i) => {
      const b = document.createElement('button');
      b.textContent = i.label; b.dataset.v = i.id;
      b.addEventListener('click', () => { im = i; draw(); });
      $('im').appendChild(b);
    });
    function draw() {
      $('im').querySelectorAll('button').forEach((b) => b.classList.toggle('active', b.dataset.v === im.id));
      const T = +t.value;
      $('t-out').textContent = String(T);
      $('code').textContent = im.code;
      const W = 640, H = 70;
      let g = '', x = 4;
      const blk = (w: number, fill: string, label = '') => { g += `<rect x="${x}" y="10" width="${w}" height="30" rx="4" fill="${fill}" opacity="0.92"/>`; if (label) g += `<text x="${x + w / 2}" y="29" text-anchor="middle" class="lab">${label}</text>`; x += w + 3; };
      if (im.id === 'naive') {
        for (let i = 1; i <= T; i++) { blk(18, 'var(--h-py)'); blk(34, 'var(--h-calc)', 'GEMM'); }
      } else if (im.id === 'opt') {
        blk(70, 'var(--h-calc)', 'grand GEMM');
        for (let i = 1; i <= T; i++) { blk(18, 'var(--h-py)'); blk(28, 'var(--h-calc)', 'GEMM'); }
      } else {
        blk(86, 'var(--h-comp)', 'compiler');
        const w = Math.min(W - x - 8, 70 + T * 26);
        blk(w, 'var(--h-exec)');
        for (let i = 0; i < T; i++) g += `<rect x="${x - w - 3 + 8 + i * ((w - 16) / T)}" y="16" width="${Math.max(4, (w - 16) / T - 3)}" height="18" rx="2" fill="var(--h-calc)"/>`;
      }
      const s = $('svg') as unknown as SVGSVGElement;
      s.setAttribute('viewBox', `0 0 ${Math.max(W, x + 8)} ${H - 18}`);
      s.innerHTML = g;
      $('k1').textContent = im.id === 'jax' ? '0 dans la boucle (1 appel)' : String(T);
      $('k2').textContent = im.id === 'naive' ? `${2 * T} petits` : im.id === 'opt' ? `1 grand + ${T} petits` : '1 grand + T, dans l’exécutable';
      $('note').textContent = im.note;
    }
    t.addEventListener('input', draw);
    draw();
  });
</script>

<style is:global>
  .timpl .row { margin-bottom: 4px; }
  .timpl .seg { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .timpl .seg button { font-size: 13px; padding: 4px 12px; }
  .timpl .posl { display: grid; grid-template-columns: 160px 1fr 40px; align-items: center; gap: 12px; font-size: 14px; color: var(--text-2); margin: 4px 0 8px; }
  .timpl .posl b { text-align: right; color: var(--text); font-weight: 500; }
  .timpl pre.code { background: var(--surface-2); padding: 8px 12px; border-radius: 8px; font-size: 13px; line-height: 1.5; margin: 4px 0 8px; overflow-x: auto; min-height: 4.2em; }
  .timpl svg text.lab { font: 500 11px var(--font); fill: #fff; }
  .timpl .note { font-size: 14px; line-height: 1.5; margin: 8px 0 0; min-height: 3em; }
  @media (max-width: 600px) { .timpl .posl { grid-template-columns: 1fr; } }
</style>
