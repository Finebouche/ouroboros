---
// Chapitre HPC 1, section 2 : JAX transforme des fonctions. On empile scan, vmap, grad, jit autour d'une cellule de RNN et on suit les formes.
---
<div class="widget compose hp" data-widget="compose">
  <div class="row"><span>Transformations appliquées :</span><span class="seg" data-ref="lv"></span></div>
  <svg data-ref="svg" width="100%" role="img" aria-label="Transformations emboîtées autour de la cellule"></svg>
  <table class="sig">
    <thead><tr><th>Entrées</th><th>Sortie</th></tr></thead>
    <tbody><tr><td data-ref="in"></td><td data-ref="out"></td></tr></tbody>
  </table>
  <p class="note" data-ref="note"></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-widget="compose"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    type L = { name: string; axis: string; inp: string; out: string; note: string; code: string };
    const LV: L[] = [
      { name: 'cell', axis: 'un pas', inp: 'p, h : (H), x : (D)', out: '(h : (H), sortie : (H))', code: 'cell(p, h, x)', note: 'Une fonction pure : mêmes entrées, mêmes sorties, pas d’état caché.' },
      { name: 'scan', axis: 'T pas', inp: 'p, h0 : (H), xs : (T, D)', out: '(hT : (H), hs : (T, H))', code: 'scan(cell)', note: 'scan répète la cellule sur l’axe du temps en portant l’état h : T pas dépendants, compilés en une boucle.' },
      { name: 'vmap', axis: 'B séquences', inp: 'p (partagé), h0 : (B, H), xs : (B, T, D)', out: 'hs : (B, T, H)', code: 'vmap(scan(cell), in_axes=(None, 0, 0))', note: 'vmap ajoute un axe de lot indépendant ; p n’a pas d’axe (None). La fonction d’une séquence n’est pas réécrite.' },
      { name: 'grad', axis: 'passe arrière', inp: 'les mêmes + y : (B, T, O)', out: '(perte : scalaire, g : même structure que p)', code: 'value_and_grad(objective)', note: 'grad demande une perte scalaire et rend un gradient de même structure (pytree) que les paramètres p.' },
      { name: 'jit', axis: 'S appels', inp: 'les mêmes, formes et dtypes fixés', out: 'les mêmes, calculées par un exécutable compilé', code: 'jit(train_step)', note: 'jit spécialise le programme pour des formes, types et arguments statiques donnés, puis le compile une fois.' },
    ];
    let lv = 4;
    LV.forEach((l, i) => {
      const b = document.createElement('button');
      b.textContent = i === 0 ? 'cell seule' : `+ ${l.name}`;
      b.dataset.v = String(i);
      b.addEventListener('click', () => { lv = i; draw(); });
      $('lv').appendChild(b);
    });

    function draw() {
      $('lv').querySelectorAll('button').forEach((b) => b.classList.toggle('active', +b.dataset.v! === lv));
      const W = 640, H = 40 + (lv + 1) * 34 + 20;
      // boîtes emboîtées : la plus extérieure est la dernière transformation
      let g = '';
      const pad = 16, bw = W - 2 * 24, y0 = 6;
      for (let i = lv; i >= 0; i--) {
        const depth = lv - i; // 0 = extérieur
        const x = 24 + depth * pad, w = bw - 2 * depth * pad;
        const y = y0 + depth * 26, h = (lv + 1) * 26 + 24 - depth * 52;
        const fill = i === 0 ? 'var(--h-calc)' : 'none';
        g += `<rect x="${x}" y="${y}" width="${w}" height="${Math.max(h, 30)}" rx="8" fill="${fill}" fill-opacity="${i === 0 ? 0.9 : 0}" stroke="${i === 0 ? 'none' : 'var(--text-2)'}" stroke-dasharray="${i === lv && i > 0 ? '0' : '4 3'}"/>`;
        g += `<text x="${x + 10}" y="${y + 17}" class="${i === 0 ? 'lab' : 'tx'}">${LV[i].name}${i === 0 ? ' : ' + LV[i].axis : ''}</text>`;
        if (i > 0) g += `<text x="${x + w - 10}" y="${y + 17}" text-anchor="end" class="ax">axe : ${LV[i].axis}</text>`;
      }
      const svg = $('svg') as unknown as SVGSVGElement;
      svg.setAttribute('viewBox', `0 0 ${W} ${y0 + (lv + 1) * 26 + 30}`);
      svg.innerHTML = g;
      $('in').textContent = LV[lv].inp;
      $('out').textContent = LV[lv].out;
      $('note').innerHTML = `<code>${LV[lv].code}</code> : ${LV[lv].note}`;
    }
    draw();
  });
</script>

<style is:global>
  .compose .row { margin-bottom: 6px; }
  .compose .seg { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .compose .seg button { font-size: 13px; padding: 4px 12px; }
  .compose svg text.tx { font: 500 12px var(--font); fill: var(--text); }
  .compose svg text.lab { font: 500 12px var(--font); fill: #fff; }
  .compose svg text.ax { font: 11px var(--font); fill: var(--text-2); }
  .compose table.sig { width: 100%; border-collapse: collapse; font-size: 14px; margin: 8px 0; }
  .compose table.sig th { text-align: left; font-weight: 500; color: var(--text-2); font-size: 13px; padding: 4px 8px; border-bottom: 1px solid var(--border); }
  .compose table.sig td { padding: 6px 8px; font-family: var(--mono); font-size: 13px; }
  .compose .note { font-size: 14px; line-height: 1.5; margin: 6px 0 0; min-height: 3em; }
</style>
