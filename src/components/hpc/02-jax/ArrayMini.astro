---
// Chapitre HPC 2 (JAX), partie 1 : petits schémas pour deux lignes du tableau NumPy / JAX, à placer dans une cellule.
// k = 'np-set' | 'jax-set' : x[1] = 9 modifie x sur place (NumPy) ; x.at[1].set(9) rend un nouveau tableau, x intact (JAX).
// k = 'np-oob' | 'jax-oob' : indice 5 sur un tableau de 3 : erreur (NumPy) ; lecture ramenée au dernier élément, écriture ignorée (JAX).
interface Props { k: 'np-set' | 'jax-set' | 'np-oob' | 'jax-oob' }
const { k } = Astro.props;
const X = [3, 1, 4];
const cs = 22, ox = 58;
// une rangée de cases ; hl : indice mis en évidence (case modifiée ou lue)
const row = (y: number, name: string, vals: (number | string)[], hl = -1, dim = false) =>
  `<text x="${ox - 6}" y="${y + 15}" text-anchor="end" class="an">${name}</text>` +
  vals.map((v, i) => `<rect x="${ox + i * cs}" y="${y}" width="${cs - 2}" height="${cs - 2}" rx="3" fill="${i === hl ? 'var(--hl-bg)' : 'var(--surface-2)'}" stroke="${i === hl ? 'var(--hl-stroke)' : 'var(--border)'}"${dim ? ' opacity="0.55"' : ''}/><text x="${ox + i * cs + (cs - 2) / 2}" y="${y + 15}" text-anchor="middle" class="av">${v}</text>`).join('');
let svg = '', H = 0;
if (k === 'np-set') {
  svg = row(4, 'x', [3, 9, 4], 1) + `<text x="${ox + 3 * cs + 6}" y="19" class="an">modifié sur place</text>`;
  H = 30;
} else if (k === 'jax-set') {
  svg = row(4, 'x', X) + `<text x="${ox + 3 * cs + 6}" y="19" class="an">intact</text>` +
    row(32, 'nouveau', [3, 9, 4], 1) + `<text x="${ox + 3 * cs + 6}" y="47" class="an">x.at[1].set(9)</text>`;
  H = 58;
} else if (k === 'np-oob') {
  svg = row(4, 'x', X) + `<text x="${ox + 3 * cs + 6}" y="19" class="an">x[5] :</text><text x="${ox + 3 * cs + 40}" y="19" class="ae">IndexError</text>`;
  H = 30;
} else {
  // lecture : la flèche part de l'indice 5 (hors du tableau) et revient sur le dernier élément
  const xe = ox + 3 * cs + 30;
  svg = row(4, 'x', X, 2) +
    `<text x="${xe}" y="19" class="an">x[5]</text><path d="M${xe - 3} 14 L${ox + 3 * cs} 14" stroke="var(--hl-stroke)" stroke-width="1.3" marker-end="url(#am-ar)"/><text x="${xe + 30}" y="19" class="an">lu : 4</text>` +
    row(32, 'x', X, -1, true) + `<text x="${ox + 3 * cs + 6}" y="47" class="an">x.at[5].set(9) : ignoré</text>`;
  H = 58;
}
const W = 262;
---
<svg class="amini" viewBox={`0 0 ${W} ${H}`} width={W} role="img" aria-label="Petit schéma d'un tableau de trois valeurs">
  <defs><marker id="am-ar" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="var(--hl-stroke)" /></marker></defs>
  <g set:html={svg} />
</svg>

<style is:global>
  svg.amini { display: block; max-width: 100%; height: auto; margin: 6px 0 2px; }
  svg.amini text.av { font: 500 11px var(--mono); fill: var(--text); }
  svg.amini text.an { font: 10.5px var(--font); fill: var(--text-2); }
  svg.amini text.ae { font: 600 10.5px var(--mono); fill: var(--h-py); }
</style>
