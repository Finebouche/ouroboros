---
// Widget du module 0 : attention à fenêtre glissante (W) — bande dans la matrice, taille du cache selon le pas.
---
<div class="widget swin" data-widget="swin">
  <div class="sl">
    <label><span>Longueur s</span><input type="range" data-ref="s" min="6" max="14" step="1" value="12" /><b data-ref="s-out"></b></label>
    <label><span>Fenêtre W</span><input type="range" data-ref="w" min="1" max="12" step="1" value="4" /><b data-ref="w-out"></b></label>
    <label><span>Pas de génération t</span><input type="range" data-ref="t" min="1" max="12" step="1" value="9" /><b data-ref="t-out"></b></label>
  </div>
  <div class="srow">
    <svg data-ref="mat" role="img" aria-label="Matrice d'attention à fenêtre glissante"></svg>
    <div class="side">
      <div class="ct">K et V gardés en mémoire, selon le pas t</div>
      <svg data-ref="chart" width="260" height="170" viewBox="0 0 260 170" role="img" aria-label="Taille du cache selon le pas"></svg>
    </div>
  </div>
  <div class="cachel"><span class="cl">Au pas t :</span><span data-ref="cache"></span></div>
  <p class="clg"><i class="sw new"></i>nouveau mot <i class="sw cache"></i>K, V en cache <i class="sw out"></i>sorti du cache</p>
  <div class="kpis">
    <div><span>Cases calculées (entraînement)</span><b data-ref="k1"></b></div>
    <div><span>K et V gardés au pas t</span><b data-ref="k2"></b></div>
  </div>
</div>

<script>
  import { WORDS, X, WQ, WK, D_K, mul } from './qkvData';

  document.querySelectorAll<HTMLElement>('[data-widget="swin"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const inp = (r: string) => $(r) as HTMLInputElement;
    const svg = $('mat') as unknown as SVGSVGElement;
    const chart = $('chart') as unknown as SVGSVGElement;
    const Q = X.map((x) => mul(x, WQ));
    const K = X.map((x) => mul(x, WK));
    let s = 12, W = 4, t = 9;

    const inWin = (i: number, j: number) => j <= i && j > i - W;
    // softmax restreint à la fenêtre de la ligne i
    const rowWeights = (i: number) => {
      const ex = Array.from({ length: s }, (_, j) => (inWin(i, j) ? Math.exp(Q[i].reduce((a, v, d) => a + v * K[j][d], 0) / Math.sqrt(D_K)) : 0));
      const z = ex.reduce((a, b) => a + b, 0);
      return ex.map((e) => e / z);
    };

    function drawMatrix() {
      const cell = Math.min(26, Math.floor(260 / s));
      const ox = 70, oy = 70;
      const VBW = ox + s * cell + 30, VBH = oy + s * cell + 6;
      const midY = oy + (s * cell) / 2;
      let h = `<text class="ts" x="${ox}" y="14">Mot regardé →</text>`;
      h += `<text class="ts" x="12" y="${midY}" transform="rotate(-90 12 ${midY})" text-anchor="middle">Mot qui regarde</text>`;
      for (let i = 0; i < s; i++) {
        const cur = i === t - 1;
        h += `<text class="ts" x="${ox - 6}" y="${oy + i * cell + cell / 2 + 4}" text-anchor="end">${WORDS[i]}</text>`;
        const cx = ox + i * cell + cell / 2;
        h += `<text class="ts" x="${cx}" y="${oy - 6}" transform="rotate(-45 ${cx} ${oy - 6})">${WORDS[i]}</text>`;
        const p = rowWeights(i);
        for (let j = 0; j < s; j++) {
          const ok = inWin(i, j);
          const x0 = ox + j * cell, y0 = oy + i * cell;
          const fill = !ok ? 'var(--surface-2)' : cur ? 'var(--hl-bg)' : 'var(--surface)';
          h += `<rect x="${x0}" y="${y0}" width="${cell - 2}" height="${cell - 2}" rx="3" fill="${fill}" stroke="var(--border)" stroke-width="0.5" opacity="${ok ? 1 : 0.6}"/>`;
          if (ok) {
            const r = ((cell - 2) / 2 - 1) * Math.sqrt(p[j]);
            h += `<circle cx="${x0 + (cell - 2) / 2}" cy="${y0 + (cell - 2) / 2}" r="${r.toFixed(2)}" fill="${cur ? 'var(--hl-stroke)' : 'var(--c-w)'}"><title>« ${WORDS[i]} » regarde « ${WORDS[j]} » : ${Math.round(p[j] * 100)} %</title></circle>`;
          }
        }
      }
      h += `<rect x="${ox - 3}" y="${oy + (t - 1) * cell - 2}" width="${s * cell + 2}" height="${cell + 2}" rx="5" fill="none" stroke="var(--hl-stroke)" stroke-width="1.5"/>`;
      svg.setAttribute('viewBox', `0 0 ${VBW} ${VBH}`);
      svg.setAttribute('width', String(VBW));
      svg.setAttribute('height', String(VBH));
      svg.innerHTML = h;
    }

    function drawChart() {
      const x0 = 30, y0 = 12, w = 214, hh = 124;
      const X_ = (k: number) => x0 + ((k - 1) / (s - 1)) * w;
      const Y_ = (v: number) => y0 + hh - (v / s) * hh;
      const pts = (f: (k: number) => number) => Array.from({ length: s }, (_, k) => `${X_(k + 1).toFixed(1)},${Y_(f(k + 1)).toFixed(1)}`).join(' ');
      let g = `<line x1="${x0}" y1="${y0 + hh}" x2="${x0 + w}" y2="${y0 + hh}" stroke="var(--border)"/><line x1="${x0}" y1="${y0}" x2="${x0}" y2="${y0 + hh}" stroke="var(--border)"/>`;
      g += `<text class="ts" x="${x0 - 6}" y="${y0 + hh + 4}" text-anchor="end">0</text><text class="ts" x="${x0 - 6}" y="${y0 + 4}" text-anchor="end">${s}</text>`;
      g += `<text class="ts" x="${x0}" y="${y0 + hh + 18}">t = 1</text><text class="ts" x="${x0 + w}" y="${y0 + hh + 18}" text-anchor="end">t = ${s}</text>`;
      g += `<polyline points="${pts((k) => k)}" fill="none" stroke="var(--text-2)" stroke-width="1.5" stroke-dasharray="4 3"/>`;
      g += `<polyline points="${pts((k) => Math.min(k, W))}" fill="none" stroke="var(--c-w)" stroke-width="2.5"/>`;
      g += `<line x1="${X_(t)}" y1="${y0}" x2="${X_(t)}" y2="${y0 + hh}" stroke="var(--hl-stroke)" stroke-dasharray="2 3"/>`;
      g += `<circle cx="${X_(t)}" cy="${Y_(t)}" r="3.5" fill="var(--text-2)"/><circle cx="${X_(t)}" cy="${Y_(Math.min(t, W))}" r="4" fill="var(--c-w)"/>`;
      g += `<text class="ts" x="${x0 + 8}" y="${y0 + 12}">- - sans fenêtre : t</text>`;
      g += `<text class="ts" x="${x0 + 8}" y="${y0 + 28}" style="fill:var(--c-w)">—  avec fenêtre : min(t, W)</text>`;
      chart.innerHTML = g;
    }

    function draw() {
      W = Math.min(W, s);
      t = Math.min(t, s);
      inp('w').max = String(s);
      inp('t').max = String(s);
      inp('w').value = String(W);
      inp('t').value = String(t);
      $('s-out').textContent = String(s);
      $('w-out').textContent = String(W);
      $('t-out').textContent = String(t);
      drawMatrix();
      drawChart();
      $('cache').innerHTML = WORDS.slice(0, s)
        .map((w, j) => {
          const cls = j > t - 1 ? 'future' : j === t - 1 ? 'new' : j >= t - W ? 'cache' : 'out';
          return `<span class="tk ${cls}">${w}</span>`;
        })
        .join('');
      const win = Array.from({ length: s }, (_, i) => Math.min(i + 1, W)).reduce((a, b) => a + b, 0);
      $('k1').innerHTML = `${win} <small>au lieu de ${(s * (s + 1)) / 2}</small>`;
      $('k2').innerHTML = `${Math.min(t, W)} <small>au lieu de ${t}</small>`;
    }

    inp('s').addEventListener('input', () => { s = +inp('s').value; draw(); });
    inp('w').addEventListener('input', () => { W = +inp('w').value; draw(); });
    inp('t').addEventListener('input', () => { t = +inp('t').value; draw(); });
    draw();
  });
</script>

<style is:global>
  .swin .sl { display: grid; gap: 6px; margin-bottom: 12px; }
  .swin .sl label { display: grid; grid-template-columns: 170px 1fr 40px; align-items: center; gap: 12px; font-size: 14px; color: var(--text-2); }
  .swin .sl b { text-align: right; color: var(--text); font-weight: 500; }
  .swin .srow { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-start; }
  .swin .srow > svg { max-width: 100%; height: auto; }
  .swin .side { flex: 0 0 260px; }
  .swin .ct { font-size: 13px; font-weight: 500; margin: 4px 0 6px; }
  .swin svg text.ts { font: 11px var(--font); fill: var(--text-2); }
  .swin .cachel { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; margin-top: 10px; }
  .swin .cl { font-size: 13px; color: var(--text-2); margin-right: 6px; }
  .swin .tk { font-size: 12px; padding: 4px 6px; border-radius: 6px; border: 1px solid var(--border); }
  .swin .tk.new, .swin .sw.new { background: var(--hl-bg); border-color: var(--hl-stroke); color: var(--hl-text); }
  .swin .tk.cache, .swin .sw.cache { background: var(--c-cache-bg); border-color: var(--c-cache-border); color: var(--c-cache-text); }
  .swin .tk.out { color: var(--text-2); text-decoration: line-through; opacity: 0.6; }
  .swin .sw.out { background: var(--surface-2); border-color: var(--border); }
  .swin .tk.future { border-style: dashed; color: var(--text-2); opacity: 0.45; }
  .swin .clg { font-size: 12px; color: var(--text-2); margin: 6px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }
  .swin .sw { display: inline-block; width: 12px; height: 12px; border-radius: 3px; border: 1px solid; margin-right: 4px; vertical-align: -1px; }
  .swin .kpis small { font-size: 13px; color: var(--text-2); font-weight: 400; }
  @media (max-width: 600px) { .swin .sl label { grid-template-columns: 1fr; } }
</style>
