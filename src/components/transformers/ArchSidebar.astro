---
// Schéma d'un transformer décodeur, avec mise en évidence de la partie en cours d'explication.
// Parties : mh (multi-têtes : remplace attn et qkv par h têtes, une concaténation et W_O), head, norm-final, norm1, qkv (projections Q, K, V), attn, wo (projection de sortie W_O), kv (K et V gardés en cache), add1, norm2, mlp, add2, embed.
// Une boîte peut porter plusieurs parties (data-part="qkv kv") : elle s'allume si l'une d'elles est active.
// Variante « loop » (module 1) : embed, inject (réinjection de l'embedding), block (k blocs, dessinés par le script), loop (retour de la boucle), norm-final, head.
// Un widget suivi (follow) publie son état dans data-arch-extra (JSON : heads pour le multi-têtes ; k, t, inj pour la boucle).
interface Props { variant?: 'transformer' | 'loop' }
const { variant = 'transformer' } = Astro.props;
---
<aside class="arch" data-arch-sidebar aria-label="Position dans l'architecture">
  {variant === 'loop' ? (
  <svg viewBox="0 0 210 384" width="100%" role="img" aria-label="Transformer bouclé : un bloc partagé répété T fois">
    <defs>
      <marker id="arch-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>

    <rect x="10" y="92" width="190" height="218" rx="10" class="loop" />
    <text x="20" y="108" class="sub" data-lp-label>× T passes</text>

    <g class="edges">
      <path d="M115 52V40" /><g data-lp-edges></g>
    </g>

    <g data-part="head"><rect x="40" y="8" width="150" height="32" rx="6" /><text x="115" y="21" text-anchor="middle">Tête de sortie</text><text x="115" y="34" text-anchor="middle" class="sub">probas du token suivant</text></g>
    <g data-part="norm-final"><rect x="40" y="52" width="150" height="24" rx="6" /><text x="115" y="68" text-anchor="middle">RMSNorm</text></g>

    <g data-lp-boxes></g>

    <g data-part="embed"><rect x="40" y="318" width="150" height="28" rx="6" /><text x="115" y="336" text-anchor="middle">Embedding e</text></g>
    <text x="115" y="372" text-anchor="middle" class="sub">tokens d'entrée</text>
  </svg>
  ) : (
  <svg viewBox="0 0 210 524" width="100%" role="img" aria-label="Architecture d'un transformer décodeur">
    <defs>
      <marker id="arch-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>

    <rect x="10" y="90" width="190" height="356" rx="10" class="loop" />
    <text x="190" y="106" text-anchor="end" class="sub">× N couches</text>

    <g class="edges">
      <path d="M115 460V426" />
      <path d="M63 400V380" /><path d="M115 400V380" /><path d="M167 400V380" />
      <g class="sh"><path d="M63 346V330" /><path d="M115 346V330" /><path d="M167 346V330" /><path d="M115 288V278" /></g>
      <g class="mh"><g data-mh-edges></g><path d="M115 286V280" /></g>
      <path d="M115 254V245" /><path d="M115 227V212" />
      <path d="M115 188V176" /><path d="M115 146V137" /><path d="M115 119V76" /><path d="M115 52V40" />
      <path d="M115 446H22V236H106" /><path d="M115 219H22V128H106" />
    </g>

    <g data-part="head"><rect x="40" y="8" width="150" height="32" rx="6" /><text x="115" y="21" text-anchor="middle">Tête de sortie</text><text x="115" y="34" text-anchor="middle" class="sub">probas du token suivant</text></g>
    <g data-part="norm-final"><rect x="40" y="52" width="150" height="24" rx="6" /><text x="115" y="68" text-anchor="middle">RMSNorm</text></g>

    <g data-part="add2"><circle cx="115" cy="128" r="9" /><text x="115" y="132" text-anchor="middle">+</text></g>
    <g data-part="mlp"><rect x="40" y="146" width="150" height="30" rx="6" /><text x="115" y="165" text-anchor="middle">MLP</text></g>
    <g data-part="norm2"><rect x="40" y="188" width="150" height="24" rx="6" /><text x="115" y="204" text-anchor="middle">RMSNorm</text></g>

    <g data-part="add1"><circle cx="115" cy="236" r="9" /><text x="115" y="240" text-anchor="middle">+</text></g>
    <g data-part="wo mh"><rect x="40" y="254" width="150" height="24" rx="6" /><text x="115" y="270" text-anchor="middle">Projection W<tspan dy="2" font-size="9">O</tspan></text></g>
    <g data-part="attn" class="sh"><rect x="40" y="288" width="150" height="40" rx="6" /><text x="115" y="303" text-anchor="middle">Attention causale</text><text x="115" y="319" text-anchor="middle" class="sub">softmax(Q·Kᵀ)·V</text></g>

    <g data-part="qkv" class="sh"><rect x="40" y="346" width="46" height="32" rx="5" /><text x="63" y="359" text-anchor="middle" class="cq">Q</text><text x="63" y="372" text-anchor="middle" class="sub">x·W<tspan dy="2" font-size="8">Q</tspan></text></g>
    <g data-part="qkv kv" class="sh"><rect x="92" y="346" width="46" height="32" rx="5" /><text x="115" y="359" text-anchor="middle" class="ck">K</text><text x="115" y="372" text-anchor="middle" class="sub">x·W<tspan dy="2" font-size="8">K</tspan></text></g>
    <g data-part="qkv kv" class="sh"><rect x="144" y="346" width="46" height="32" rx="5" /><text x="167" y="359" text-anchor="middle" class="cv">V</text><text x="167" y="372" text-anchor="middle" class="sub">x·W<tspan dy="2" font-size="8">V</tspan></text></g>

    <g class="mh">
      <g data-part="mh"><rect x="40" y="286" width="150" height="20" rx="5" /><text x="115" y="300" text-anchor="middle">Concaténation</text></g>
      <g data-mh-boxes></g>
    </g>

    <g data-part="norm1"><rect x="40" y="400" width="150" height="24" rx="6" /><text x="115" y="416" text-anchor="middle">RMSNorm</text></g>

    <g data-part="embed"><rect x="40" y="460" width="150" height="28" rx="6" /><text x="115" y="478" text-anchor="middle">Embedding</text></g>
    <text x="115" y="510" text-anchor="middle" class="sub">tokens d'entrée</text>
  </svg>
  )}
  <p class="caption" data-arch-label>Vue d'ensemble</p>
</aside>

<script>
  const root = document.querySelector<HTMLElement>('[data-arch-sidebar]');
  if (root) {
    const markers = Array.from(document.querySelectorAll<HTMLElement>('[data-arch-marker]'));
    const label = root.querySelector<HTMLElement>('[data-arch-label]')!;
    let current: HTMLElement | null | undefined;

    function update() {
      // En bas de page, les derniers repères ne peuvent plus monter jusqu'à 40 % : on prend le dernier visible.
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      const line = window.innerHeight * (atBottom ? 0.95 : 0.4);
      let active: HTMLElement | null = null;
      for (const m of markers) {
        if (m.getBoundingClientRect().top <= line) active = m;
        else break;
      }
      const follow = active?.dataset.follow ? document.querySelector<HTMLElement>(active.dataset.follow) : null;
      if (active === current && !follow) return;
      current = active;
      apply(follow?.dataset.archParts ?? active?.dataset.parts ?? '', follow?.dataset.archLabel ?? active?.dataset.label ?? "Vue d'ensemble", extraOf(follow));
    }

    // Multi-têtes : n colonnes (tête + Q K V), n suivant le widget.
    const mhBoxes = root.querySelector<SVGGElement>('[data-mh-boxes]');
    const mhEdges = root.querySelector<SVGGElement>('[data-mh-edges]');
    type Extra = { heads?: number; k?: number; t?: number; inj?: boolean };
    let nHeads = 0;
    function drawHeads(n: number) {
      if (!mhBoxes || !mhEdges || n === nHeads) return;
      nHeads = n;
      const gap = 6, cw = (150 - gap * (n - 1)) / n, fs = n > 2 ? 10 : 12;
      let b = '', e = '';
      for (let i = 0; i < n; i++) {
        const x = 40 + i * (cw + gap), cx = x + cw / 2;
        b += `<g data-part="mh"><rect x="${x}" y="316" width="${cw}" height="28" rx="5" /><text x="${cx}" y="334" text-anchor="middle" font-size="${fs}">tête ${i + 1}</text></g>`;
        b += `<g data-part="mh"><rect x="${x}" y="354" width="${cw}" height="24" rx="5" /><text x="${cx}" y="370" text-anchor="middle" font-size="${fs}"><tspan class="cq">Q</tspan> <tspan class="ck">K</tspan> <tspan class="cv">V</tspan></text></g>`;
        e += `<path d="M${cx} 354V346" /><path d="M${cx} 316V308" />`;
      }
      mhBoxes.innerHTML = b;
      mhEdges.innerHTML = e;
    }
    drawHeads(2);

    // Boucle : k blocs distincts, T passes, réinjection ou non.
    const lpBoxes = root.querySelector<SVGGElement>('[data-lp-boxes]');
    const lpEdges = root.querySelector<SVGGElement>('[data-lp-edges]');
    const lpLabel = root.querySelector<SVGTextElement>('[data-lp-label]');
    let lpKey = '';
    function drawLoop(k: number, t?: number, inj = true) {
      if (!lpBoxes || !lpEdges || !lpLabel) return;
      const key = `${k}/${t}/${inj}`;
      if (key === lpKey) return;
      lpKey = key;
      lpLabel.textContent = t ? `× ${t} passe${t > 1 ? 's' : ''}` : '× T passes';
      const bottom = 224, bh = k === 1 ? 50 : 28, gap = 10;
      const top = bottom - (k * bh + (k - 1) * gap);
      let b = '', e = `<path d="M115 ${top}V78" />`;
      for (let i = 0; i < k; i++) {
        const y = bottom - bh - i * (bh + gap);
        const [n1, n2] = k === 1 ? [y + 21, y + 38] : [y + 12, y + 24];
        b += `<g data-part="block"><rect x="40" y="${y}" width="150" height="${bh}" rx="6" /><text x="115" y="${n1}" text-anchor="middle">${k === 1 ? 'Bloc partagé' : `Bloc ${i + 1}`}</text><text x="115" y="${n2}" text-anchor="middle" class="sub">attention + MLP</text></g>`;
        if (i < k - 1) e += `<path d="M115 ${y}V${y - gap + 1}" />`;
      }
      const ym = top + bh / 2;
      if (inj) {
        e += `<path d="M115 239V${bottom + 2}" /><path d="M115 318V263" />`;
        b += `<g data-part="loop"><path d="M190 ${ym} H198 V250 H128" /></g>`;
        b += `<g data-part="inject"><circle cx="115" cy="250" r="11" /><text x="115" y="254" text-anchor="middle">+</text><text x="70" y="290" text-anchor="middle" class="sub">e réinjecté</text></g>`;
      } else {
        e += `<path d="M115 318V${bottom + 2}" />`;
        b += `<g data-part="loop"><path d="M190 ${ym} H198 V270 H115 V${bottom + 2}" /></g>`;
      }
      lpBoxes.innerHTML = b;
      lpEdges.innerHTML = e;
    }
    drawLoop(1);

    const extraOf = (el: HTMLElement | null): Extra => {
      try { return el?.dataset.archExtra ? JSON.parse(el.dataset.archExtra) : {}; } catch { return {}; }
    };

    function apply(names: string, text: string, ex: Extra = {}) {
      if (ex.heads) drawHeads(ex.heads);
      drawLoop(ex.k ?? 1, ex.t, ex.inj ?? true);
      const on = new Set(names.split(/\s+/).filter(Boolean));
      root!.classList.toggle('multi', on.has('mh'));
      root!.querySelectorAll<SVGGElement>('[data-part]').forEach((p) => p.classList.toggle('on', p.dataset.part!.split(/\s+/).some((n) => on.has(n))));
      label.textContent = text;
    }

    // Un widget peut aussi pointer une partie (ex. les étapes du bloc d'attention) ; le prochain défilement reprend la main.
    window.addEventListener('arch:focus', (ev) => {
      const d = (ev as CustomEvent<{ parts: string; label: string; extra?: Extra }>).detail;
      apply(d.parts, d.label, d.extra);
      current = undefined;
    });

    let queued = false;
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); });
    }, { passive: true });
    update();
  }
</script>

<style is:global>
  .arch:not(.multi) svg .mh, .arch.multi svg .sh { display: none; }
  .arch svg tspan.cq { fill: var(--c-q); font-weight: 600; }
  .arch svg tspan.ck { fill: var(--c-k); font-weight: 600; }
  .arch svg tspan.cv { fill: var(--c-v); font-weight: 600; }
  .arch svg .loop { fill: none; stroke: var(--border); stroke-dasharray: 4 4; }
  .arch svg .edges path { fill: none; stroke: var(--text-2); stroke-width: 1; marker-end: url(#arch-arrow); }
  .arch svg text { font: 12px var(--font); fill: var(--text); }
  .arch svg text.sub { font-size: 11px; fill: var(--text-2); }
  .arch svg [data-part] > rect, .arch svg [data-part] > circle { fill: var(--surface-2); stroke: var(--border); transition: fill 0.2s, stroke 0.2s; }
  .arch svg [data-part].on > rect, .arch svg [data-part].on > circle { fill: var(--hl-bg); stroke: var(--hl-stroke); stroke-width: 1.5; }
  .arch svg [data-part].on > text { fill: var(--hl-text); }
  .arch svg [data-part] > text.cq { fill: var(--c-q); font-weight: 600; }
  .arch svg [data-part] > text.ck { fill: var(--c-k); font-weight: 600; }
  .arch svg [data-part] > text.cv { fill: var(--c-v); font-weight: 600; }
  .arch svg [data-part] > path { fill: none; stroke: var(--text-2); stroke-width: 1.2; marker-end: url(#arch-arrow); transition: stroke 0.2s; }
  .arch svg [data-part].on > path { stroke: var(--hl-stroke); stroke-width: 2.5; }
  .arch .caption { font-size: 13px; line-height: 1.4; color: var(--text-2); margin: 0.4rem 0 0; min-height: 2.8em; }
</style>
