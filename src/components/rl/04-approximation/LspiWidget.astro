---
// Cours RL, chapitre 4 : LSPI pas à pas sur la grille 4 × 4 du chapitre 1 (but +1, piège −1, mur ; γ = 0,9), à partir de transitions enregistrées
// par une politique aléatoire. Caractéristiques : une par couple (état, action), donc LSTDQ résout exactement la politique à partir des données.
// Deux étapes alternées : ÉVALUER π_k (un système linéaire A w = b, avec la régularisation λ = 10⁻³) puis AMÉLIORER (action de plus grande valeur).
// Politique initiale : toujours « haut ». Vérifié par simulation (Node, 50 jeux de données, mêmes règles) : 3 à 5 itérations en moyenne ;
// avec 200 transitions, ≈ 10,8 cases sur 13 ont leurs 4 actions observées, dont ≈ 10,2 ont l'action optimale ; avec 400 : ≈ 12,9 sur 13, dont ≈ 12,8.
import katex from 'katex';
const tex = (s: string) => katex.renderToString(s, { throwOnError: false });
const FA = tex("A = \\sum_i \\varphi(s_i, a_i)\\,\\big(\\varphi(s_i, a_i) - \\gamma\\,\\varphi(s'_i, \\pi(s'_i))\\big)^{\\top}, \\quad b = \\sum_i \\varphi(s_i, a_i)\\, r_i, \\quad w = A^{-1} b");
const FI = tex("\\pi'(s) = \\arg\\max_a\\ \\varphi(s, a)^{\\top} w");
---
<div class="widget rlw lspw" data-widget="lspw">
  <div class="row"><span class="seg" data-ref="ctl"></span></div>
  <label class="nl"><span>Transitions enregistrées N</span><input type="range" data-ref="n" min="30" max="400" step="10" value="200" /><b data-ref="n-out"></b></label>
  <div class="calc">
    <div class="fl"><span class="fk" data-ref="k1">évaluer</span><div class="fm" set:html={FA} /></div>
    <div class="fl"><span class="fk" data-ref="k2">améliorer</span><div class="fm" set:html={FI} /></div>
    <div class="ln" data-ref="line"></div>
  </div>
  <svg class="lg" data-ref="svg" role="img" aria-label="Grille 4 par 4 : action de la politique courante dans chaque case, et valeur de cette politique évaluée par moindres carrés"></svg>
  <div class="kpis">
    <div><span>Itération</span><b data-ref="kk"></b><i data-ref="kp"></i></div>
    <div><span>Valeur du départ</span><b data-ref="kv"></b><i>case (3,1) ; optimum 0,59</i></div>
    <div><span>Cases à l'action optimale</span><b data-ref="ko"></b><i>parmi celles dont les 4 actions sont observées</i></div>
  </div>
  <p class="note">Flèche : action de la politique courante. Teinte indigo : valeur de cette politique évaluée par LSTDQ (rouge si négative), en pâle tant que la politique n'a pas été réévaluée. Pointillés : la politique joue dans cette case une action jamais observée ; petit chiffre : nombre de transitions parties de la case. Contour ambre : action changée à la dernière amélioration.</p>
</div>

<script>
  import { rng } from '../../rc/esn';

  document.querySelectorAll<HTMLElement>('[data-widget="lspw"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const R = 4, C = 4, G = 0.9, LAM = 1e-3, NA = R * C * 4;
    const GOAL = [0, 3], PIT = [1, 3], WALL = [1, 1], START = [3, 0];
    const DIRS: [number, number, string][] = [[-1, 0, '↑'], [0, 1, '→'], [1, 0, '↓'], [0, -1, '←']];
    const is = (p: number[], r: number, c: number) => p[0] === r && p[1] === c;
    const term = (r: number, c: number) => is(GOAL, r, c) || is(PIT, r, c);
    const idx = (r: number, c: number) => r * C + c;
    const fm = (v: number, d = 2) => v.toFixed(d).replace('.', ',').replace('-', '−');
    const mv = (r: number, c: number, a: number): [number, number, number] => {
      let nr = r + DIRS[a][0], nc = c + DIRS[a][1];
      if (nr < 0 || nr >= R || nc < 0 || nc >= C || is(WALL, nr, nc)) { nr = r; nc = c; }
      return [nr, nc, is(GOAL, nr, nc) ? 1 : is(PIT, nr, nc) ? -1 : 0];
    };
    const free: number[][] = [];
    for (let r = 0; r < R; r++) for (let c = 0; c < C; c++) if (!term(r, c) && !is(WALL, r, c)) free.push([r, c]);
    // valeurs et Q optimaux (itération de valeur), pour vérifier les actions
    let V = Array.from({ length: R }, () => new Array(C).fill(0));
    for (let k = 0; k < 100; k++) V = V.map((row, r) => row.map((_, c) => (term(r, c) || is(WALL, r, c) ? 0 : Math.max(...[0, 1, 2, 3].map((a) => { const [nr, nc, rw] = mv(r, c, a); return rw + G * (term(nr, nc) ? 0 : V[nr][nc]); })))));
    const qstar = (r: number, c: number) => [0, 1, 2, 3].map((a) => { const [nr, nc, rw] = mv(r, c, a); return rw + G * (term(nr, nc) ? 0 : V[nr][nc]); });

    type Tr = { s: number; a: number; r: number; s2: number; tm: boolean };
    function collect(N: number, seed: number): Tr[] {
      const rd = rng(seed), T: Tr[] = [];
      while (T.length < N) {
        let [r, c] = free[Math.floor(rd() * free.length)];
        for (let t = 0; t < 20 && T.length < N; t++) {
          const a = Math.floor(rd() * 4), [nr, nc, rw] = mv(r, c, a), tm = term(nr, nc);
          T.push({ s: idx(r, c), a, r: rw, s2: idx(nr, nc), tm });
          if (tm) break;
          r = nr; c = nc;
        }
      }
      return T;
    }
    // élimination de Gauss avec pivot partiel
    function solve(A: number[][], b: number[]): number[] {
      const n = b.length;
      for (let i = 0; i < n; i++) {
        let p = i;
        for (let k = i + 1; k < n; k++) if (Math.abs(A[k][i]) > Math.abs(A[p][i])) p = k;
        [A[i], A[p]] = [A[p], A[i]]; [b[i], b[p]] = [b[p], b[i]];
        for (let k = i + 1; k < n; k++) { const f = A[k][i] / A[i][i]; for (let j = i; j < n; j++) A[k][j] -= f * A[i][j]; b[k] -= f * b[i]; }
      }
      const x = new Array(n).fill(0);
      for (let i = n - 1; i >= 0; i--) { let s = b[i]; for (let j = i + 1; j < n; j++) s -= A[i][j] * x[j]; x[i] = s / A[i][i]; }
      return x;
    }
    // LSTDQ : caractéristiques « une par couple (état, action) » : φ(s, a) = e_{(s,a)}
    function lstdq(T: Tr[], pi: number[]): number[] {
      const A = Array.from({ length: NA }, (_, i) => { const row = new Array(NA).fill(0); row[i] = LAM; return row; }), b = new Array(NA).fill(0);
      for (const t of T) {
        const i = t.s * 4 + t.a;
        A[i][i] += 1;
        if (!t.tm) A[i][t.s2 * 4 + pi[t.s2]] -= G;
        b[i] += t.r;
      }
      return solve(A, b);
    }

    let N = 200, seed = 100, T: Tr[] = [], pi: number[] = [], w: number[] | null = null, k = 0, phase: 'eval' | 'impr' = 'eval', changed = new Set<number>(), done = false, msg = '';
    let cov = new Set<number>(), cnt: number[] = [], evalK = -1;
    function reset(newData = false) {
      if (newData) seed++;
      T = collect(N, seed);
      cov = new Set(T.map((t) => t.s * 4 + t.a)); cnt = new Array(R * C).fill(0); T.forEach((t) => cnt[t.s]++);
      pi = new Array(R * C).fill(0); w = null; k = 0; phase = 'eval'; changed = new Set(); done = false; evalK = -1;
      msg = `${N} transitions tirées par une politique aléatoire. Politique initiale π₀ : toujours ↑.`;
      draw();
    }
    function step() {
      if (done) return;
      if (phase === 'eval') {
        w = lstdq(T, pi); evalK = k; phase = 'impr'; changed = new Set();
        msg = `Évaluer π${sub(k)} : système linéaire A w = b de ${NA} × ${NA} (λ = 10⁻³), résolu d'un coup avec les ${N} transitions.`;
      } else {
        const out = pi.slice(), ch = new Set<number>();
        for (const [r, c] of free) {
          const s = idx(r, c), q = [0, 1, 2, 3].map((a) => w![s * 4 + a]), m = Math.max(...q), a = q.indexOf(m);
          if (a !== pi[s] && q[pi[s]] < m - 1e-9) { out[s] = a; ch.add(s); }
        }
        if (ch.size === 0) { done = true; msg = `Améliorer : aucune case ne change d'action. La politique est stable, LSPI s'arrête après ${k} amélioration${k > 1 ? 's' : ''}.`; }
        else { pi = out; changed = ch; k++; phase = 'eval'; msg = `Améliorer : ${ch.size} case${ch.size > 1 ? 's changent' : ' change'} d'action (π${sub(k)}).`; }
      }
      draw();
    }
    const sub = (n: number) => '₀₁₂₃₄₅₆₇₈₉'[n] ?? `_${n}`;
    function all() { let g = 0; while (!done && g++ < 60) step(); }
    const mkb = (label: string, f: () => void) => { const b = document.createElement('button'); b.textContent = label; b.addEventListener('click', f); $('ctl').appendChild(b); return b; };
    const stepB = mkb('évaluer π₀', step);
    mkb('tout exécuter', all);
    mkb('nouvelles données', () => reset(true));
    mkb('recommencer', () => reset(false));
    const nIn = $('n') as HTMLInputElement;
    nIn.addEventListener('input', () => { $('n-out').textContent = nIn.value; });
    nIn.addEventListener('change', () => { N = +nIn.value; reset(); });

    const cs = 60, PAD = 4;
    function draw() {
      $('n-out').textContent = String(N);
      stepB.textContent = done ? 'terminé' : phase === 'eval' ? `évaluer π${sub(k)}` : `améliorer π${sub(k)}`;
      let g = '';
      const vmax = 1;
      for (let r = 0; r < R; r++) for (let c = 0; c < C; c++) {
        const x = PAD + c * cs, y = PAD + r * cs, s = idx(r, c), w0 = cs - 4;
        if (is(WALL, r, c)) { g += `<rect x="${x}" y="${y}" width="${w0}" height="${w0}" rx="5" fill="var(--text-2)" fill-opacity="0.35"/>`; continue; }
        if (is(GOAL, r, c)) { g += `<rect x="${x}" y="${y}" width="${w0}" height="${w0}" rx="5" fill="var(--hl-stroke)" fill-opacity="0.35" stroke="var(--hl-stroke)"/><text x="${x + w0 / 2}" y="${y + w0 / 2 + 5}" text-anchor="middle" class="gv">+1</text>`; continue; }
        if (is(PIT, r, c)) { g += `<rect x="${x}" y="${y}" width="${w0}" height="${w0}" rx="5" fill="var(--h-py)" fill-opacity="0.35" stroke="var(--h-py)"/><text x="${x + w0 / 2}" y="${y + w0 / 2 + 5}" text-anchor="middle" class="gv">−1</text>`; continue; }
        const seen = cov.has(s * 4 + pi[s]);
        const v = w && seen ? w[s * 4 + pi[s]] : 0, stale = phase === 'eval' && k > 0;
        const op = w ? Math.min(0.7, Math.abs(v) / vmax * 0.75) * (stale ? 0.45 : 1) : 0;
        g += `<rect x="${x}" y="${y}" width="${w0}" height="${w0}" rx="5" fill="${v < 0 ? 'var(--h-py)' : 'var(--a-lspi)'}" fill-opacity="${op.toFixed(2)}" stroke="${changed.has(s) ? 'var(--hl-stroke)' : 'var(--border)'}" stroke-width="${changed.has(s) ? 3 : 0.9}" ${seen ? '' : 'stroke-dasharray="4 3"'}/>`;
        g += `<text x="${x + w0 / 2}" y="${y + w0 / 2 + 8}" text-anchor="middle" class="la">${DIRS[pi[s]][2]}</text>`;
        g += `<text x="${x + w0 - 5}" y="${y + w0 - 5}" text-anchor="end" class="lc">${cnt[s]}</text>`;
        if (w && seen && !stale) g += `<text x="${x + 5}" y="${y + 12}" class="lv">${fm(v)}</text>`;
        if (is(START, r, c)) g += `<text x="${x + 5}" y="${y + w0 - 5}" class="lc">départ</text>`;
      }
      const svg = $('svg') as unknown as SVGSVGElement;
      svg.setAttribute('viewBox', `0 0 ${C * cs + 2 * PAD} ${R * cs + PAD}`); svg.innerHTML = g;
      // indicateurs
      $('line').textContent = msg;
      $('kk').textContent = `${k}${done ? ' (stable)' : ''}`;
      $('kp').textContent = done ? 'plus aucun changement : la politique est stable' : phase === 'eval' ? `prochaine étape : évaluer π${sub(k)}` : `π${sub(k)} évaluée ; prochaine étape : améliorer`;
      const sv = w && evalK === k ? w[idx(START[0], START[1]) * 4 + pi[idx(START[0], START[1])]] : null;
      $('kv').textContent = sv !== null && cov.has(idx(START[0], START[1]) * 4 + pi[idx(START[0], START[1])]) ? fm(sv) : '–';
      let full = 0, ok = 0;
      for (const [r, c] of free) {
        const s = idx(r, c);
        if ([0, 1, 2, 3].every((a) => cov.has(s * 4 + a))) { full++; const q = qstar(r, c); if (q[pi[s]] >= Math.max(...q) - 1e-9) ok++; }
      }
      $('ko').innerHTML = `${ok} <small>sur ${full}</small>`;
    }
    reset();
  });
</script>

<style is:global>
  .lspw .row > .seg { display: flex; flex-wrap: wrap; gap: 6px; width: 100%; }
  .lspw .row > .seg button:last-child { margin-left: auto; }
  .lspw label.nl { max-width: 380px; margin-top: 8px; }
  .lspw .calc { margin-top: 10px; padding: 8px 12px; border-radius: 10px; background: color-mix(in srgb, var(--text-2) 4.5%, transparent); }
  .lspw .fl { display: flex; align-items: baseline; gap: 10px; }
  .lspw .fk { flex: 0 0 64px; font-size: 11.5px; font-weight: 600; color: var(--a-lspi); }
  .lspw .fm { font-size: 0.82rem; overflow-x: auto; overflow-y: hidden; min-width: 0; }
  .lspw .ln { font: 11.5px/1.5 var(--mono); color: var(--text-2); margin-top: 4px; min-height: 3em; }
  .lspw svg.lg { width: 100%; max-width: 260px; height: auto; display: block; margin: 10px auto 0; }
  .lspw svg text.gv { font: 600 13px var(--font); fill: var(--text); }
  .lspw svg text.la { font: 600 24px var(--font); fill: var(--text); }
  .lspw svg text.lc { font: 9.5px var(--font); fill: var(--text-2); }
  .lspw svg text.lv { font: 600 10.5px var(--font); fill: var(--text); }
  .lspw .note { font-size: 13px; color: var(--text-2); line-height: 1.5; margin: 8px 0 0; }
</style>
