---
// Cours RL, chapitre 4 : FQI sur un couloir continu (régresseur polynomial). Présentation selon les principes de design (labo, /labo/) :
// contrôles dans la boîte grise, une seule carte pour le graphique (titre, écart en pastille, étiquettes directes, pas de légende),
// une seule série colorée (Q ajusté de « droite », violet = action), le reste en gris.
---
<div class="widget rlw fitw" data-widget="fitw">
  <div class="ctlline">
    <div class="row"><span>Régresseur : polynôme de degré</span><span class="seg" data-ref="deg"></span></div>
    <label class="sl side"><span>Itération k</span><input type="range" data-ref="k" min="0" max="40" step="1" value="3" /><b data-ref="k-out"></b></label>
  </div>
  <div class="fcard">
    <div class="fhead"><div class="ftitle"><b>Q(x, action)</b><span data-ref="sub"></span></div><div class="fstat"><span>écart moyen de « droite » à l'optimal</span><b data-ref="ke"></b></div></div>
    <svg data-ref="svg" role="img" aria-label="FQI sur un couloir continu : cibles et courbes ajustées à l'itération k"></svg>
  </div>
  <p class="note">Couloir continu x ∈ [0, 1] : « droite » ajoute 0,1 à x, « gauche » le retire ; +1 en atteignant x = 1 ; γ = 0,9. Les 80 points sont des transitions tirées au hasard ; à chaque itération, leur cible r + γ max Q(x′, ·) utilise le Q de l'itération précédente, et le polynôme est ajusté par moindres carrés.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-widget="fitw"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const kIn = $('k') as HTMLInputElement, g = 0.9, N = 80, KMAX = 40;
    let deg = 4;
    [1, 2, 4, 8].forEach((d) => { const b = document.createElement('button'); b.textContent = String(d); b.dataset.v = String(d); b.addEventListener('click', () => { deg = d; draw(); }); $('deg').appendChild(b); });
    let sd = 424242; const rnd = () => { sd = (sd * 16807) % 2147483647; return sd / 2147483647; };
    const data = Array.from({ length: N }, () => { const x = rnd(), a = rnd() < 0.5 ? 1 : 0, xn = Math.min(1, Math.max(0, x + (a ? 0.1 : -0.1))); return { x, a, xn, term: xn >= 1, r: xn >= 1 ? 1 : 0 }; });
    const solve = (A: number[][], b: number[]) => {
      const n = b.length, M = A.map((row, i) => [...row, b[i]]);
      for (let c = 0; c < n; c++) { let p = c; for (let i = c + 1; i < n; i++) if (Math.abs(M[i][c]) > Math.abs(M[p][c])) p = i; [M[c], M[p]] = [M[p], M[c]]; for (let i = c + 1; i < n; i++) { const f = M[i][c] / M[c][c]; for (let j = c; j <= n; j++) M[i][j] -= f * M[c][j]; } }
      const x = new Array(n).fill(0); for (let i = n - 1; i >= 0; i--) x[i] = (M[i][n] - M[i].slice(i + 1, n).reduce((s, v, j) => s + v * x[i + 1 + j], 0)) / M[i][i]; return x;
    };
    const qs = (x: number) => g ** (Math.ceil((1 - x) / 0.1 - 1e-9) - 1);
    const cache: Record<number, { W: number[][]; pts: number[][][] }[]> = {};
    function run(d: number) {
      if (cache[d]) return cache[d];
      const feat = (x: number) => Array.from({ length: d + 1 }, (_, k) => (2 * x - 1) ** k);
      const fit = (pts: number[][]) => { const m = d + 1, A = Array.from({ length: m }, () => new Array(m).fill(0)), b = new Array(m).fill(0); pts.forEach(([x, y]) => { const f = feat(x); for (let i = 0; i < m; i++) { b[i] += f[i] * y; for (let j = 0; j < m; j++) A[i][j] += f[i] * f[j]; } }); for (let i = 0; i < m; i++) A[i][i] += 1e-6; return solve(A, b); };
      const ev = (w: number[], x: number) => feat(x).reduce((s, f, i) => s + f * w[i], 0);
      let W = [new Array(d + 1).fill(0), new Array(d + 1).fill(0)];
      const out = [{ W, pts: [data.filter((p) => p.a === 0).map((p) => [p.x, 0]), data.filter((p) => p.a === 1).map((p) => [p.x, 0])] }];
      for (let k = 1; k <= KMAX; k++) {
        const pts: number[][][] = [[], []];
        data.forEach((p) => pts[p.a].push([p.x, p.r + (p.term ? 0 : g * Math.max(ev(W[0], p.xn), ev(W[1], p.xn)))]));
        W = [fit(pts[0]), fit(pts[1])]; out.push({ W, pts });
      }
      (out as any).feat = feat; cache[d] = out; return out;
    }
    function draw() {
      $('deg').querySelectorAll('button').forEach((b) => b.classList.toggle('active', +b.dataset.v! === deg));
      const k = +kIn.value; $('k-out').textContent = String(k);
      $('sub').textContent = `itération ${k}, polynôme de degré ${deg}`;
      const hist = run(deg), sn = hist[k], feat = (hist as any).feat as (x: number) => number[];
      const ev = (w: number[], x: number) => feat(x).reduce((s, f, i) => s + f * w[i], 0);
      const W = 640, H = 300, ox = 40, oy = 8, rm = 124, pw = W - ox - rm, ph = H - oy - 34;
      const X = (x: number) => ox + x * pw, Y = (v: number) => oy + ph - ((Math.min(1.2, Math.max(-0.1, v)) + 0.1) / 1.3) * ph;
      let s = '';
      [0, 0.5, 1].forEach((v) => (s += `<line x1="${ox}" y1="${Y(v)}" x2="${ox + pw}" y2="${Y(v)}" stroke="var(--border)" stroke-dasharray="${v === 0 ? '' : '2 4'}"/><text x="${ox - 6}" y="${Y(v) + 3.5}" text-anchor="end" class="ax">${String(v).replace('.', ',')}</text>`));
      [0, 0.25, 0.5, 0.75, 1].forEach((x) => (s += `<text x="${X(x)}" y="${oy + ph + 15}" text-anchor="middle" class="ax">${String(x).replace('.', ',')}</text>`));
      s += `<text x="${ox + pw / 2}" y="${oy + ph + 30}" text-anchor="middle" class="ax">position x dans le couloir</text>`;
      const xs = Array.from({ length: 81 }, (_, j) => j / 80);
      const pl = (f: (x: number) => number) => xs.map((x) => `${X(x).toFixed(1)},${Y(f(x)).toFixed(1)}`).join(' ');
      s += `<polyline points="${pl(qs)}" fill="none" stroke="var(--text)" stroke-width="1.2" stroke-dasharray="4 3" opacity="0.7"/>`;
      [...sn.pts[0], ...sn.pts[1]].forEach(([x, y]) => (s += `<circle cx="${X(x).toFixed(1)}" cy="${Y(y).toFixed(1)}" r="2.6" fill="var(--text-2)" fill-opacity="0.45"/>`));
      s += `<polyline points="${pl((x) => ev(sn.W[0], x))}" fill="none" stroke="var(--text-2)" stroke-width="2"/>`;
      s += `<polyline points="${pl((x) => ev(sn.W[1], x))}" fill="none" stroke="var(--a-act)" stroke-width="2.8"/>`;
      // étiquettes directes à droite, écartées d'au moins 15 px
      const labs = [
        { t: 'Q ajusté, droite', y: Y(ev(sn.W[1], 1)), c: 'var(--a-act)', w: 600 },
        { t: 'Q ajusté, gauche', y: Y(ev(sn.W[0], 1)), c: 'var(--text-2)', w: 500 },
        { t: 'Q optimal, droite', y: Y(qs(1)), c: 'var(--text)', w: 500 },
      ].sort((a, b) => a.y - b.y);
      for (let i = 1; i < labs.length; i++) if (labs[i].y - labs[i - 1].y < 15) labs[i].y = labs[i - 1].y + 15;
      labs.forEach((l) => (s += `<text x="${ox + pw + 8}" y="${(l.y + 4).toFixed(1)}" class="lb" style="fill:${l.c};font-weight:${l.w}">${l.t}</text>`));
      s += `<text x="${X(0.03)}" y="${Y(0.7)}" class="lb" style="fill:var(--text-2);font-weight:400">points : cibles de l'itération</text>`;
      const svg = $('svg') as unknown as SVGSVGElement; svg.setAttribute('viewBox', `0 0 ${W} ${H}`); svg.innerHTML = s;
      const err = xs.reduce((a, x) => a + Math.abs(ev(sn.W[1], x) - qs(x)), 0) / xs.length;
      $('ke').textContent = err.toFixed(3).replace('.', ',');
    }
    kIn.addEventListener('input', draw);
    draw();
  });
</script>

<style is:global>
  .fitw .ctlline { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; margin-bottom: 8px; }
  .fitw .ctlline .row { margin: 0; }
  .fitw .ctlline label.sl { flex: 1 1 280px; margin: 0; }
  .widget.fitw .ctlline label.side:has(> input[type="range"]) { grid-template-columns: auto minmax(110px, 1fr) 2em; }
  .fitw .fcard { margin-top: 6px; }
  .fitw .fhead { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; margin-bottom: 4px; }
  .fitw .ftitle b { font-size: 15px; font-weight: 600; margin-right: 10px; }
  .fitw .ftitle span { font-size: 12.5px; color: var(--text-2); }
  .fitw .fstat { display: flex; align-items: baseline; gap: 8px; background: var(--surface-2); border-radius: 8px; padding: 4px 10px; }
  .fitw .fstat span { font-size: 12px; color: var(--text-2); }
  .fitw .fstat b { font-size: 14px; font-weight: 600; }
  .fitw svg { width: 100%; height: auto; display: block; margin: 0; }
  .fitw svg text.ax { font: 11px var(--font); fill: var(--text-2); }
  .fitw svg text.lb { font: 11.5px var(--font); }
</style>
