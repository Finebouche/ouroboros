---
// Cours RL, chapitre 1 : équivalent Monte-Carlo de Tree.astro, même exemple (deux actions, mêmes probabilités, γ = 0,9, récompense nulle).
// Au lieu de combiner les valeurs déjà estimées des états suivants, on joue N épisodes par action et on moyenne les retours complets.
// ILLUSTRATION : le retour est simulé comme γ × (valeur de l'état suivant + bruit gaussien d'écart-type SD), bruit inventé ; tirage à graine fixe.
import katex from 'katex';
const tx = (t: string) => katex.renderToString(t, { throwOnError: false });
const g = 0.9, N = 20, SD = 0.25;
const P = [[0.8, 0.2], [0.5, 0.5]];
const Vn = [[1.0, 0.0], [0.5, 0.2]];
const Qtrue = P.map((p, a) => g * p.reduce((s, pr, j) => s + pr * Vn[a][j], 0));
const lcg = (seed: number) => { let x = seed; return () => { x = (x * 16807) % 2147483647; return x / 2147483647; }; };
const rnd = lcg(1 * 7919);
const gauss = () => Math.sqrt(-2 * Math.log(rnd() + 1e-9)) * Math.cos(2 * Math.PI * rnd());
const draws = [0, 1].map((a) => Array.from({ length: N }, () => { const j = rnd() < P[a][0] ? 0 : 1; return g * (Vn[a][j] + SD * gauss()); }));
const jit = draws.map((d) => d.map(() => (rnd() - 0.5) * 22));
const mean = draws.map((d) => d.reduce((s, v) => s + v, 0) / N);
const pi = [0.7, 0.3];
const Vpi = pi.reduce((s, p, a) => s + p * mean[a], 0), Vstar = Math.max(...mean); // estimés à partir des moyennes
const f = (v: number, d = 2) => v.toFixed(d).replace('.', ',').replace('-', '−');
const k = (v: number, d = 2) => f(v, d).replace(',', '{,}');
// même repérage vertical que Tree.astro (encadrés remplacés par le calcul écrit au bout de chaque repère), axe élargi aux retours bruités
const X0 = 180, SC = 320, X = (v: number) => X0 + v * SC, XL = 90, XR = 640, YA = 290, BY = 4, BH = 62;
const clamp = (v: number) => Math.max((XL - X0) / SC + 0.02, Math.min((XR - X0) / SC - 0.02, v));
const F1 = '<b class="qt">Évaluer (moyenne pondérée par la politique)</b><br>' + tx(`V^\\pi(s) \\approx \\sum_a \\pi(a|s)\\,Q(s,a)`) + '<br>' + tx(`\\approx ${k(pi[0], 1)} \\times ${k(mean[0])} + ${k(pi[1], 1)} \\times ${k(mean[1])} = ${k(Vpi)}`);
const F2 = '<b class="qt">Valeur optimale (meilleure action)</b><br>' + tx(`V^\\star(s) \\approx \\max_a Q(s,a)`) + '<br>' + tx(`\\approx \\max(${k(mean[0])}\\ ;\\ ${k(mean[1])}) = ${k(Vstar)}`);
let body = '';
[0, 0.5, 1].forEach((v) => { body += `<line x1="${X(v)}" y1="${BY + BH}" x2="${X(v)}" y2="${YA + 22}" stroke="var(--border)" stroke-dasharray="2 4"/>`; });
body += `<line x1="${X(0)}" y1="${BY + BH}" x2="${X(0)}" y2="${YA}" stroke="var(--text-2)" stroke-opacity="0.5"/>`;
[0, 1].forEach((a) => {
  const y = 90 + a * 98, ys = y + 46;
  body += `<text x="8" y="${y + 13}" class="mqa">action ${a + 1}</text><text x="8" y="${y + 29}" class="mqs">${N} épisodes joués</text>`;
  body += `<rect x="${X(0)}" y="${y}" width="${Math.max(0, X(mean[a]) - X(0))}" height="26" rx="4" fill="var(--text-2)" fill-opacity="0.3" stroke="var(--text-2)"/>`;
  body += `<text x="${X(0) + 8}" y="${y + 17.5}" class="mqv">Q = ${f(mean[a], 2)}</text>`;
  body += `<line x1="${XL}" y1="${ys}" x2="${XR}" y2="${ys}" stroke="var(--border)"/>`;
  draws[a].forEach((v, i) => { body += `<circle cx="${X(clamp(v))}" cy="${ys + jit[a][i]}" r="3.2" fill="var(--a-es)" fill-opacity="0.55"/>`; });
  body += `<line x1="${X(Qtrue[a])}" y1="${y - 4}" x2="${X(Qtrue[a])}" y2="${ys + 16}" stroke="var(--text)" stroke-width="1.3" stroke-dasharray="4 3"/>`;
  body += `<text x="${XL}" y="${ys + 32}" class="mqs">moyenne de ${N} retours γ × (valeur de l'état suivant + bruit) ; Q<tspan dy="-4" font-size="9">π</tspan><tspan dy="4"> vraie ${f(Qtrue[a], a ? 3 : 2)}</tspan></text>`;
});
body += `<line x1="${X(Vpi)}" y1="${BY + BH}" x2="${X(Vpi)}" y2="${YA}" stroke="var(--a-es)" stroke-width="2" stroke-dasharray="5 3"/>` +
  `<line x1="${X(Vstar)}" y1="${BY + BH}" x2="${X(Vstar)}" y2="${YA}" stroke="var(--a-es)" stroke-width="2"/>` +
  `<foreignObject x="4" y="${BY}" width="${X(Vpi) - 4 + 6}" height="${BH}"><div class="qfl r">${F1}</div></foreignObject>` +
  `<foreignObject x="${X(Vstar) - 6}" y="${BY}" width="${656 - X(Vstar) + 6}" height="${BH}"><div class="qfl">${F2}</div></foreignObject>`;
body += `<line x1="${XL}" y1="${YA}" x2="${XR}" y2="${YA}" stroke="var(--text-2)"/>` + [0, 0.5, 1].map((v) => `<line x1="${X(v)}" y1="${YA}" x2="${X(v)}" y2="${YA + 5}" stroke="var(--text-2)"/><text x="${X(v)}" y="${YA + 18}" text-anchor="middle" class="mqs">${f(v, 1)}</text>`).join('');
---
<figure class="tmc">
  <svg viewBox="0 0 660 316" role="img" aria-label={`Monte-Carlo : ${N} retours simulés par action ; moyennes ${f(mean[0])} et ${f(mean[1])}, valeurs vraies ${f(Qtrue[0])} et ${f(Qtrue[1], 3)}`} set:html={body} />
  <figcaption>Même exemple, estimé par Monte-Carlo : chaque point est le retour complet d'un épisode joué, la barre va jusqu'à leur moyenne, l'estimation Q de l'action ; le trait noir pointillé est la valeur vraie Q<sup>π</sup>. Pas besoin des valeurs des états suivants, mais les points sont dispersés : la moyenne de {N} épisodes n'est pas exacte, et V<sup>π</sup> et V* calculés avec ces moyennes non plus. Illustration : retours simulés avec un bruit inventé (écart-type {f(SD)} autour de la valeur de l'état suivant, avant γ), tirage fixe.</figcaption>
</figure>

<style is:global>
  .tmc { margin: 1.4rem 0; font-family: var(--font); }
  .tmc svg { width: 100%; max-width: 660px; height: auto; display: block; margin: 0 auto; }
  .tmc svg text.mqa { font: 600 13px var(--font); fill: var(--text); }
  .tmc svg text.mqs { font: 11.5px var(--font); fill: var(--text-2); }
  .tmc svg text.mqv { font: 600 12.5px var(--font); fill: var(--text); paint-order: stroke; stroke: var(--bg); stroke-width: 4px; stroke-linejoin: round; }
  .tmc .qfl { font: 15px/1.35 var(--font); color: var(--a-es); white-space: nowrap; padding: 0 6px; }
  .tmc .qfl.r { text-align: right; }
  .tmc .qfl .katex { font-size: 1em; }
  .tmc .qfl .qt { display: inline-block; font: 600 13px var(--font); color: var(--text); margin-bottom: 1px; }
  .tmc figcaption { font-size: 12px; color: var(--text-2); margin-top: 8px; }
</style>
