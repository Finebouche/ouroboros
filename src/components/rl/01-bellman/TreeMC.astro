---
// Cours RL, chapitre 1 : équivalent Monte-Carlo de Tree.astro, même exemple (deux actions, mêmes probabilités, γ = 0,9, récompense nulle).
// Au lieu de combiner les valeurs déjà estimées des états suivants, on joue N épisodes par action et on moyenne les retours complets.
// ILLUSTRATION : le retour est simulé comme γ × (valeur de l'état suivant + bruit gaussien d'écart-type SD), bruit inventé ; tirage à graine fixe.
const g = 0.9, N = 20, SD = 0.25;
const P = [[0.8, 0.2], [0.5, 0.5]];
const Vn = [[1.0, 0.0], [0.5, 0.2]];
const Qtrue = P.map((p, a) => g * p.reduce((s, pr, j) => s + pr * Vn[a][j], 0));
const lcg = (seed: number) => { let x = seed; return () => { x = (x * 16807) % 2147483647; return x / 2147483647; }; };
const rnd = lcg(1 * 7919);
const gauss = () => Math.sqrt(-2 * Math.log(rnd() + 1e-9)) * Math.cos(2 * Math.PI * rnd());
const draws = [0, 1].map((a) => Array.from({ length: N }, () => { const j = rnd() < P[a][0] ? 0 : 1; return g * (Vn[a][j] + SD * gauss()); }));
const jit = draws.map((d) => d.map(() => (rnd() - 0.5) * 22));
const mean = draws.map((d) => d.reduce((s, v) => s + v, 0) / N);
const f = (v: number, d = 2) => v.toFixed(d).replace('.', ',').replace('-', '−');
const V0 = -0.5, V1 = 1.5, X0 = 150, X1 = 640, X = (v: number) => X0 + ((v - V0) / (V1 - V0)) * (X1 - X0), YA = 238;
const clamp = (v: number) => Math.max(V0 + 0.02, Math.min(V1 - 0.02, v));
let body = '';
[0, 0.5, 1].forEach((v) => { body += `<line x1="${X(v)}" y1="26" x2="${X(v)}" y2="${YA + 22}" stroke="var(--border)" stroke-dasharray="2 4"/>`; });
body += `<line x1="${X(0)}" y1="26" x2="${X(0)}" y2="${YA}" stroke="var(--text-2)" stroke-opacity="0.5"/>`;
[0, 1].forEach((a) => {
  const y = 40 + a * 98, ys = y + 46;
  body += `<text x="8" y="${y + 13}" class="mqa">action ${a + 1}</text><text x="8" y="${y + 29}" class="mqs">${N} épisodes joués</text>`;
  body += `<rect x="${X(0)}" y="${y}" width="${Math.max(0, X(mean[a]) - X(0))}" height="26" rx="4" fill="var(--text-2)" fill-opacity="0.3" stroke="var(--text-2)"/>`;
  body += `<text x="${Math.max(X(mean[a]), X(Qtrue[a])) + 8}" y="${y + 17.5}" class="mqv">moyenne = ${f(mean[a], 2)}</text>`;
  body += `<line x1="${X0}" y1="${ys}" x2="${X1}" y2="${ys}" stroke="var(--border)"/>`;
  draws[a].forEach((v, i) => { body += `<circle cx="${X(clamp(v))}" cy="${ys + jit[a][i]}" r="3.2" fill="var(--a-es)" fill-opacity="0.55"/>`; });
  body += `<line x1="${X(Qtrue[a])}" y1="${y - 4}" x2="${X(Qtrue[a])}" y2="${ys + 16}" stroke="var(--text)" stroke-width="1.3" stroke-dasharray="4 3"/>`;
  body += `<text x="${X0}" y="${ys + 32}" class="mqs">moyenne de ${N} retours γ × (valeur de l'état suivant + bruit) ; valeur vraie ${f(Qtrue[a], a ? 3 : 2)}</text>`;
});
body += `<line x1="${X0}" y1="${YA}" x2="${X1}" y2="${YA}" stroke="var(--text-2)"/>` + [0, 0.5, 1].map((v) => `<line x1="${X(v)}" y1="${YA}" x2="${X(v)}" y2="${YA + 5}" stroke="var(--text-2)"/><text x="${X(v)}" y="${YA + 18}" text-anchor="middle" class="mqs">${f(v, 1)}</text>`).join('');
---
<figure class="tmc">
  <svg viewBox="0 0 660 266" role="img" aria-label={`Monte-Carlo : ${N} retours simulés par action ; moyennes ${f(mean[0])} et ${f(mean[1])}, valeurs vraies ${f(Qtrue[0])} et ${f(Qtrue[1], 3)}`} set:html={body} />
  <figcaption>Même exemple, estimé par Monte-Carlo : chaque point est le retour complet d'un épisode joué, la barre va jusqu'à leur moyenne, le trait pointillé est la valeur vraie. Pas besoin des valeurs des états suivants, mais les points sont dispersés : la moyenne de {N} épisodes n'est pas exacte. Illustration : retours simulés avec un bruit inventé (écart-type {f(SD)} autour de la valeur de l'état suivant, avant γ), tirage fixe.</figcaption>
</figure>

<style is:global>
  .tmc { margin: 1.4rem 0; font-family: var(--font); }
  .tmc svg { width: 100%; max-width: 660px; height: auto; display: block; margin: 0 auto; }
  .tmc svg text.mqa { font: 600 13px var(--font); fill: var(--text); }
  .tmc svg text.mqs { font: 11.5px var(--font); fill: var(--text-2); }
  .tmc svg text.mqv { font: 600 12.5px var(--font); fill: var(--text); }
  .tmc figcaption { font-size: 12px; color: var(--text-2); margin-top: 8px; }
</style>
