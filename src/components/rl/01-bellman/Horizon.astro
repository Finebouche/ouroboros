---
// Cours RL, chapitre 1 : illustration du problème de l'attribution du crédit.
// Deux épisodes identiques sauf la 3e action ; l'un finit par +1, l'autre par 0. La décision qui compte est loin de la récompense.
const T = 10, cw = 46, x0 = 92, sq = 34, W = x0 + (T + 1) * cw + 6;
const ep1 = ['→', '→', '↑', '→', '↑', '↑', '→', '↑', '→', '→'];
const ep2 = ep1.map((a, i) => (i === 2 ? '↓' : a));
const KEY = 2;
const cx = (i: number) => x0 + i * cw + cw / 2;
let o = '';
const top = 30, rowH = 56;
// bande de la seule différence
o += `<rect x="${cx(KEY) - sq / 2 - 5}" y="${top - 8}" width="${sq + 10}" height="${rowH + sq + 16}" rx="9" fill="var(--hl-stroke)" fill-opacity="0.12" stroke="var(--hl-stroke)" stroke-opacity="0.6" stroke-dasharray="4 3"/>`;
o += `<text x="${cx(KEY)}" y="${top - 14}" text-anchor="middle" class="hk">seule différence</text>`;
[[ep1, '+1', 'épisode 1'], [ep2, '0', 'épisode 2']].forEach(([acts, rew, name], row) => {
  const y = top + row * rowH;
  o += `<text x="${x0 - 12}" y="${y + sq / 2 + 4}" text-anchor="end" class="hn">${name}</text>`;
  (acts as string[]).forEach((a, i) => {
    o += `<rect x="${cx(i) - sq / 2}" y="${y}" width="${sq}" height="${sq}" rx="7" fill="var(--text-2)" fill-opacity="0.1" stroke="var(--border)"/>`;
    o += `<text x="${cx(i)}" y="${y + sq / 2 + 6}" text-anchor="middle" class="ha">${a}</text>`;
  });
  const win = rew === '+1';
  o += `<rect x="${cx(T) - sq / 2}" y="${y}" width="${sq}" height="${sq}" rx="7" fill="${win ? 'var(--hl-stroke)' : 'var(--text-2)'}" fill-opacity="${win ? 0.3 : 0.1}" stroke="${win ? 'var(--hl-stroke)' : 'var(--border)'}"/>`;
  o += `<text x="${cx(T)}" y="${y + sq / 2 + 4.5}" text-anchor="middle" class="hv">${rew}</text>`;
});
// axe du temps
const ty = top + rowH + sq + 22;
o += `<line x1="${cx(0) - sq / 2}" y1="${ty}" x2="${cx(T) + sq / 2}" y2="${ty}" stroke="var(--text-2)" stroke-width="1"/><path d="M ${cx(T) + sq / 2} ${ty} l -6 -3.5 v 7 z" fill="var(--text-2)"/>`;
o += `<text x="${cx(0) - sq / 2}" y="${ty + 14}" class="hs">actions, dans l'ordre</text><text x="${cx(T) + sq / 2}" y="${ty + 14}" text-anchor="end" class="hs">récompense</text>`;
const H = ty + 20;
---
<figure class="rlf rlf-horizon">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Deux épisodes identiques sauf la troisième action ; le premier finit avec une récompense de plus un, le second avec zéro" set:html={o} />
  <figcaption>Deux épisodes qui ne diffèrent que par la 3e action : le premier finit par +1, le second par 0. Le crédit revient donc à cette 3e action, sept pas avant la récompense, et pas aux dernières, qui sont identiques. Ici, la comparaison la désigne ; en pratique, les épisodes diffèrent à chaque pas et la récompense ne dit rien de l'action responsable : il faut beaucoup d'épisodes pour démêler qui a mérité quoi.</figcaption>
</figure>

<style is:global>
  .rlf-horizon svg { max-width: 640px; }
  .rlf-horizon svg .hk { font: 600 11px var(--font); fill: var(--hl-text); }
  .rlf-horizon svg .hs { font: 10.5px var(--font); fill: var(--text-2); }
  .rlf-horizon svg .hn { font: 600 11.5px var(--font); fill: var(--text); }
  .rlf-horizon svg .ha { font: 600 16px var(--font); fill: var(--a-act); }
  .rlf-horizon svg .hv { font: 600 13px var(--font); fill: var(--text); }
</style>
