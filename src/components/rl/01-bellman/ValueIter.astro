---
// Cours RL, chapitre 1 : itération de valeur sur la grille 4 × 4 (but +1, piège −1, mur). Deux rangées de boutons : γ (0,5 ; 0,9 ; 0,99) et l'itération (0 à 6, puis la convergence).
// Tout est calculé à la construction : V_0 = 0, puis V_{k+1}(s) = max_a [r + γ V_k(s')], toutes les cases à partir de V_k.
// Chaque case est une croix : quatre triangles, un par action (↑ → ↓ ←), avec la valeur r + γ V_k(s') de l'action ; la meilleure est colorée ;
// au centre, V_{k+1}(s), le maximum des quatre. Dernière position : valeurs à la convergence (V*).
import katex from 'katex';
const tx = (t: string) => katex.renderToString(t, { throwOnError: false });
const F = tx('V_{k+1}(s) = \\max_a \\big[\\, r + \\gamma\\, V_k(s\') \\,\\big]');

const R = 4, C = 4, GAMMAS = [0.5, 0.9, 0.99], GOAL = [0, 3], PIT = [1, 3], WALL = [1, 1], START = [3, 0];
const DIRS: [number, number, string][] = [[-1, 0, '↑'], [0, 1, '→'], [1, 0, '↓'], [0, -1, '←']];
const is = (p: number[], r: number, c: number) => p[0] === r && p[1] === c;
const term = (r: number, c: number) => is(GOAL, r, c) || is(PIT, r, c);
const mv = (r: number, c: number, a: number): [number, number, number] => {
  let nr = r + DIRS[a][0], nc = c + DIRS[a][1];
  if (nr < 0 || nr >= R || nc < 0 || nc >= C || is(WALL, nr, nc)) { nr = r; nc = c; }
  return [nr, nc, is(GOAL, nr, nc) ? 1 : is(PIT, nr, nc) ? -1 : 0];
};
const fm = (v: number) => (Math.abs(v) < 5e-3 ? '0' : v.toFixed(2).replace('.', ',').replace('-', '−'));
type Grid = number[][];
const cands = (V: Grid, r: number, c: number, G: number) => [0, 1, 2, 3].map((a) => { const [nr, nc, rw] = mv(r, c, a); const vn = term(nr, nc) ? 0 : V[nr][nc]; return rw + G * vn; });
const next = (V: Grid, G: number): Grid => V.map((row, r) => row.map((_, c) => (term(r, c) || is(WALL, r, c) ? 0 : Math.max(...cands(V, r, c, G)))));
// V_0 … V_6 (le départ reçoit sa première valeur à l'itération 6), puis la convergence
// (pour chaque γ ; sur cette grille déterministe, V_6 = V* quel que soit γ)
const VS: Grid[][] = GAMMAS.map((G) => {
  const Vs: Grid[] = [Array.from({ length: R }, () => new Array(C).fill(0))];
  for (let k = 1; k <= 6; k++) Vs.push(next(Vs[k - 1], G));
  let Vstar = Vs[6];
  for (let k = 0; k < 400; k++) Vstar = next(Vstar, G);
  return [...Vs, Vstar];
});
// position p du curseur : p = 0 → V_0 (rien n'est encore calculé) ; 1…6 → V_p, calculé à partir de V_{p-1} ; 7 → V*, calculé à partir de V*
const labels = ['0', '1', '2', '3', '4', '5', '6', 'convergence'];
const frame = (g: number, p: number) => ({ V: VS[g][p], prev: p === 0 ? null : p === 7 ? VS[g][7] : VS[g][p - 1] });

const cs = 112, w = cs - 12, GW = 4 * cs + 12, GH = 4 * cs + 12;
const tri = (x: number, y: number, a: number) => {
  const cx = x + w / 2, cy = y + w / 2;
  return [`${x},${y} ${x + w},${y} ${cx},${cy}`, `${x + w},${y} ${x + w},${y + w} ${cx},${cy}`, `${x + w},${y + w} ${x},${y + w} ${cx},${cy}`, `${x},${y + w} ${x},${y} ${cx},${cy}`][a];
};
const txtPos = (x: number, y: number, a: number): [number, number, string] => {
  const cx = x + w / 2, cy = y + w / 2;
  return [[cx, y + 13, 'middle'], [x + w - 5, cy + 3.5, 'end'], [cx, y + w - 6, 'middle'], [x + 5, cy + 3.5, 'start']][a] as [number, number, string];
};
const cell = (g: number, p: number, r: number, c: number) => {
  const x = 6 + c * cs, y = 6 + r * cs, { V, prev } = frame(g, p), cx = x + w / 2, cy = y + w / 2;
  if (is(WALL, r, c)) return `<rect x="${x}" y="${y}" width="${w}" height="${w}" rx="14" fill="var(--text-2)" fill-opacity="0.16"/>`;
  const end = (fill: string, t: string, cap: string) => `<rect x="${x}" y="${y}" width="${w}" height="${w}" rx="14" fill="${fill}" fill-opacity="0.26" stroke="${fill}" stroke-opacity="0.7"/><text x="${cx}" y="${cy + 2}" text-anchor="middle" class="vgv">${t}</text><text x="${cx}" y="${cy + 20}" text-anchor="middle" class="vqz">${cap}</text>`;
  if (is(GOAL, r, c)) return end('var(--hl-stroke)', '+1', 'but');
  if (is(PIT, r, c)) return end('var(--h-py)', '−1', 'piège');
  const q = prev ? cands(prev, r, c, GAMMAS[g]) : null, m = q ? Math.max(...q) : 0, v = V[r][c];
  // le fond de la case est d'autant plus sombre que V est grand : la valeur se propage depuis le but
  let o = `<rect x="${x}" y="${y}" width="${w}" height="${w}" rx="14" fill="var(--surface)" stroke="var(--border)" stroke-width="0.9"/>`;
  o += `<rect x="${x}" y="${y}" width="${w}" height="${w}" rx="14" fill="var(--text-2)" fill-opacity="${(0.03 + 0.2 * Math.max(0, v)).toFixed(3)}"/>`;
  const id = `vc${g}-${p}-${r}-${c}`;
  o += `<clipPath id="${id}"><rect x="${x}" y="${y}" width="${w}" height="${w}" rx="14"/></clipPath>`;
  if (q) for (let a = 0; a < 4; a++) {
    const best = m > 1e-9 && q[a] > m - 1e-9, [tx0, ty0, an] = txtPos(x, y, a);
    if (best) o += `<polygon points="${tri(x, y, a)}" fill="var(--text-2)" fill-opacity="0.3" clip-path="url(#${id})"/>`;
    o += `<text x="${tx0}" y="${ty0}" text-anchor="${an}" class="${q[a] < -1e-9 ? 'vqn' : best ? 'vqb' : 'vqz'}">${fm(q[a])}</text>`;
  }
  o += `<path d="M${x + 10},${y + 10} L${x + w - 10},${y + w - 10} M${x + w - 10},${y + 10} L${x + 10},${y + w - 10}" stroke="var(--text-2)" stroke-opacity="0.18" stroke-width="0.8" stroke-linecap="round"/>`;
  o += `<circle cx="${cx}" cy="${cy}" r="17" fill="var(--surface)" stroke="var(--text-2)" stroke-opacity="0.55" stroke-width="1"/>`;
  o += `<text x="${cx}" y="${cy + 4.5}" text-anchor="middle" class="vvc">${fm(v)}</text>`;
  if (is(START, r, c)) o += `<text x="${x + 9}" y="${y + 17}" class="vst">S</text>`;
  return o;
};
---
<div class="widget rlw vif" data-widget="vif">
  <div class="vih"><b>Itération de valeur</b><span>règles connues (P : où mène chaque action ; r : la récompense) : on calcule, on ne joue pas</span></div>
  <div class="vif-fm" set:html={F} />
  <div class="row"><span>Actualisation γ :</span><span class="seg" data-ref="segG"></span></div>
  <div class="row"><span>Itération k :</span><span class="seg" data-ref="seg"></span></div>
  <div class="vgrids">
    {GAMMAS.map((G, g) => labels.map((_, p) => (
      <svg class="vsv" data-g={g} data-p={p} viewBox={`0 0 ${GW} ${GH}`} role="img" aria-label={`γ = ${G}, itération ${labels[p]} : valeur des quatre actions dans chaque case, et V au centre`} hidden={!(g === 1 && p === 2)} set:html={Array.from({ length: 16 }, (_, i) => cell(g, p, Math.floor(i / 4), i % 4)).join('')} />
    )))}
  </div>
  <p class="note"><i>s′</i> : case voisine dans la direction de l'action (sur place contre un mur ou un bord) ; <i>r</i> = +1 au but, −1 au piège, 0 sinon. Chaque case est une croix : un triangle par direction (↑ → ↓ ←) avec la valeur de l'action <i>Q<sub>k</sub>(s, a) = r + γ V<sub>k−1</sub>(s′)</i> ; la meilleure est grisée. Au centre, <i>V<sub>k</sub>(s) = max<sub>a</sub> Q<sub>k</sub>(s, a)</i>, qui sert à l'itération suivante. S : la case de départ ; plus le fond est sombre, plus V est grande. À la convergence, les triangles grisés donnent la politique optimale.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-widget="vif"]').forEach((root) => {
    const seg = root.querySelector<HTMLElement>('[data-ref="seg"]')!, segG = root.querySelector<HTMLElement>('[data-ref="segG"]')!;
    const names = ['0', '1', '2', '3', '4', '5', '6', 'convergence'], gammas = ['0,5', '0,9', '0,99'];
    let g = 1, p = 2;
    const show = () => {
      root.querySelectorAll<SVGElement>('svg.vsv').forEach((s) => { s.toggleAttribute('hidden', !(+s.dataset.g! === g && +s.dataset.p! === p)); });
      seg.querySelectorAll('button').forEach((b, i) => b.classList.toggle('active', i === p));
      segG.querySelectorAll('button').forEach((b, i) => b.classList.toggle('active', i === g));
    };
    names.forEach((n, i) => { const b = document.createElement('button'); b.textContent = n; b.addEventListener('click', () => { p = i; show(); }); seg.appendChild(b); });
    gammas.forEach((n, i) => { const b = document.createElement('button'); b.textContent = n; b.addEventListener('click', () => { g = i; show(); }); segG.appendChild(b); });
    show();
  });
</script>

<style is:global>
  .vif .vih { margin-bottom: 6px; }
  .vif .vih b { font-size: 15px; font-weight: 600; color: var(--text); margin-right: 10px; }
  .vif .vih span { display: block; font-size: 12.5px; color: var(--text-2); margin-top: 1px; }
  .vif .vif-fm { font-size: 1rem; overflow-x: auto; overflow-y: hidden; margin-bottom: 8px; }
  .vif .vgrids { margin-top: 4px; }
  .vif svg.vsv { width: 100%; max-width: 460px; height: auto; display: block; margin: 0 auto; }
  .vif svg.vsv[hidden] { display: none; }
  .vif svg text.vgv { font: 600 13px var(--font); fill: var(--text); }
  .vif svg text.vqz { font: 10.5px var(--font); fill: var(--text-2); opacity: 0.9; }
  .vif svg text.vqb { font: 600 11px var(--font); fill: var(--text); }
  .vif svg text.vqn { font: 10.5px var(--font); fill: var(--h-py); }
  .vif svg text.vvc { font: 600 13px var(--font); fill: var(--text); }
  .vif svg text.vst { font: 700 11px var(--font); fill: var(--text-2); }
</style>
