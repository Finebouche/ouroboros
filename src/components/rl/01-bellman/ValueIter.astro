---
// Cours RL, chapitre 1 : itération de valeur sur une grille 4 × 4 déterministe. On règle k et γ, et on déplace le but, le piège ou le mur.
---
<div class="widget rlw vi" data-widget="vi">
  <div class="row"><span>Placer :</span><span class="seg" data-ref="mode"></span><span class="hint">puis cliquer sur une case de la grille</span></div>
  <label class="sl"><span>Itération k</span><input type="range" data-ref="k" min="0" max="12" step="1" value="3" /><b data-ref="k-out"></b></label>
  <label class="sl"><span>Facteur d'actualisation γ</span><input type="range" data-ref="g" min="0.5" max="0.99" step="0.01" value="0.9" /><b data-ref="g-out"></b></label>
  <svg class="clk" data-ref="svg" role="img" aria-label="Valeurs et politique de la grille après k itérations de valeur"></svg>
  <div class="kpis">
    <div><span>Itérations pour converger</span><b data-ref="kc"></b></div>
    <div><span>Valeur de la case de départ (en bas à gauche)</span><b data-ref="vs"></b></div>
  </div>
  <p class="note">Une flèche indique l'action qui maximise « récompense + γ × valeur de la case atteinte » d'après les valeurs affichées. À k = 0 toutes les valeurs sont nulles. Quand le but est inaccessible, les valeurs restent à 0.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-widget="vi"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const R = 4, C = 4, START: [number, number] = [3, 0], cs = 74;
    const DIRS: [number, number, string][] = [[-1, 0, '↑'], [0, 1, '→'], [1, 0, '↓'], [0, -1, '←']];
    const st = { goal: [0, 3] as [number, number], pit: [1, 3] as [number, number], wall: [1, 1] as [number, number], mode: 'goal' };
    const same = (p: [number, number], r: number, c: number) => p[0] === r && p[1] === c;
    const term = (r: number, c: number) => same(st.goal, r, c) || same(st.pit, r, c);
    const step = (r: number, c: number, a: number): [number, number, number] => {
      let nr = r + DIRS[a][0], nc = c + DIRS[a][1];
      if (nr < 0 || nr >= R || nc < 0 || nc >= C || same(st.wall, nr, nc)) { nr = r; nc = c; }
      return [nr, nc, same(st.goal, nr, nc) ? 1 : same(st.pit, nr, nc) ? -1 : 0];
    };
    const kIn = $('k') as HTMLInputElement, gIn = $('g') as HTMLInputElement;
    [['but (+1)', 'goal'], ['piège (−1)', 'pit'], ['mur', 'wall']].forEach(([l, v]) => {
      const b = document.createElement('button'); b.textContent = l; b.dataset.v = v;
      b.addEventListener('click', () => { st.mode = v; draw(); }); $('mode').appendChild(b);
    });
    const fm = (v: number) => v.toFixed(2).replace('.', ',');
    function draw() {
      $('mode').querySelectorAll('button').forEach((b) => b.classList.toggle('active', b.dataset.v === st.mode));
      const g = +gIn.value, K = +kIn.value;
      $('k-out').textContent = String(K); $('g-out').textContent = fm(g);
      const hist: number[][][] = [Array.from({ length: R }, () => new Array(C).fill(0))];
      for (let k = 0; k < 30; k++) {
        const V = hist[hist.length - 1];
        hist.push(V.map((row, r) => row.map((_, c) => (term(r, c) || same(st.wall, r, c) ? 0 : Math.max(...DIRS.map((__, a) => { const [nr, nc, rew] = step(r, c, a); return rew + g * (term(nr, nc) ? 0 : V[nr][nc]); }))))));
      }
      let kc = 0; for (let k = 1; k < hist.length; k++) { const d = Math.max(...hist[k].flatMap((row, r) => row.map((v, c) => Math.abs(v - hist[k - 1][r][c])))); if (d > 1e-4) kc = k; }
      kc = Math.min(kc + 1, 30);
      const V = hist[K], vmax = Math.max(1e-9, ...hist[hist.length - 1].flat());
      let s = '';
      for (let r = 0; r < R; r++) for (let c = 0; c < C; c++) {
        const x = 6 + c * cs, y = 6 + r * cs, w = cs - 3;
        if (same(st.wall, r, c)) { s += `<rect x="${x}" y="${y}" width="${w}" height="${w}" rx="5" fill="var(--text-2)" fill-opacity="0.35"/>`; continue; }
        if (same(st.goal, r, c)) { s += `<rect x="${x}" y="${y}" width="${w}" height="${w}" rx="5" fill="var(--hl-stroke)" fill-opacity="0.35" stroke="var(--hl-stroke)"/><text x="${x + w / 2}" y="${y + w / 2 + 5}" text-anchor="middle" class="gv">+1</text>`; continue; }
        if (same(st.pit, r, c)) { s += `<rect x="${x}" y="${y}" width="${w}" height="${w}" rx="5" fill="var(--h-py)" fill-opacity="0.35" stroke="var(--h-py)"/><text x="${x + w / 2}" y="${y + w / 2 + 5}" text-anchor="middle" class="gv">−1</text>`; continue; }
        const v = V[r][c];
        s += `<rect x="${x}" y="${y}" width="${w}" height="${w}" rx="5" fill="var(--a-fqi)" fill-opacity="${(0.06 + 0.7 * Math.max(v, 0) / vmax).toFixed(2)}" stroke="var(--border)" stroke-width="0.8"/>`;
        s += `<text x="${x + 6}" y="${y + 14}" class="vs">${v === 0 ? '0' : fm(v)}</text>`;
        if (K > 0 && v > 0) {
          const q = DIRS.map((__, a) => { const [nr, nc, rew] = step(r, c, a); return rew + g * (term(nr, nc) ? 0 : V[nr][nc]); }), best = Math.max(...q);
          const bests = DIRS.map((d, a) => [d, q[a]] as const).filter(([, qa]) => qa > best - 1e-9).map(([d]) => d);
          bests.forEach((d) => { const o = bests.length === 1 ? 0 : 15; s += `<text x="${x + w / 2 + d[1] * o}" y="${y + w / 2 + 8 + d[0] * o}" text-anchor="middle" class="ar">${d[2]}</text>`; });
        }
        if (same(START, r, c)) s += `<text x="${x + w / 2}" y="${y + w - 6}" text-anchor="middle" class="vs">départ</text>`;
      }
      const svg = $('svg') as unknown as SVGSVGElement;
      svg.setAttribute('viewBox', `0 0 ${C * cs + 12} ${R * cs + 12}`); svg.innerHTML = s;
      $('kc').textContent = String(kc);
      $('vs').textContent = fm(hist[hist.length - 1][START[0]][START[1]]);
    }
    ($('svg') as unknown as SVGSVGElement).addEventListener('click', (e) => {
      const svg = $('svg') as unknown as SVGSVGElement, rect = svg.getBoundingClientRect();
      const sx = (C * cs + 12) / rect.width, c = Math.floor(((e.clientX - rect.left) * sx - 6) / cs), r = Math.floor(((e.clientY - rect.top) * sx - 6) / cs);
      if (r < 0 || r >= R || c < 0 || c >= C || (r === START[0] && c === START[1])) return;
      const others = (['goal', 'pit', 'wall'] as const).filter((m) => m !== st.mode);
      if (others.some((m) => same(st[m], r, c))) return;
      (st as any)[st.mode] = [r, c]; draw();
    });
    ['k', 'g'].forEach((r) => $(r).addEventListener('input', draw));
    draw();
  });
</script>
