---
// Cours RL, chapitre 1 : deux agents apprennent chacun avec sa méthode, chacun dans son couloir de 7 cases (l'agent avance vers la droite
// mais glisse parfois en arrière), avec ses propres épisodes. Monte-Carlo met à jour en fin d'épisode avec le retour complet ;
// TD(0), fondé sur Bellman, met à jour à chaque pas avec « récompense + γ × valeur actuelle de la case atteinte ». Même pas α = 0,1.
// Chaque agent tient dans une seule bande : une colonne par case (barre = valeur estimée, trait = valeur vraie), le jeton au-dessus.
import katex from 'katex';
const tex = (s: string) => katex.renderToString(s, { throwOnError: false });
const F = {
  mc1: tex('G_t = r_{t+1} + \\gamma\\, r_{t+2} + \\gamma^2\\, r_{t+3} + \\dots'),
  mc2: tex('V(s) \\leftarrow V(s) + \\alpha\\,\\big(G_t - V(s)\\big), \\quad \\alpha = 0{,}1'),
  td1: tex('\\text{erreur TD} = r + \\gamma\\, V(s\') - V(s)'),
  td2: tex('V(s) \\leftarrow V(s) + \\alpha \\times (\\text{erreur TD}), \\quad \\alpha = 0{,}1'),
};
---
<div class="widget rlw runw" data-widget="runw">
  <div class="row"><span class="seg" data-ref="ctl"></span></div>
  <div class="sl2">
    <label class="sl" title="Facteur d'actualisation γ"><span>Actualisation γ</span><input type="range" data-ref="g" min="0.5" max="0.99" step="0.01" value="0.95" /><b data-ref="g-out"></b></label>
    <label class="sl" title="Probabilité de glisser d'une case en arrière à chaque pas"><span>Glissade p</span><input type="range" data-ref="p" min="0" max="0.45" step="0.05" value="0.3" /><b data-ref="p-out"></b></label>
  </div>
  <div class="expgrid">
  <div class="expbox" data-ref="boxMC">
    <div class="eh"><b style="color:var(--a-es)">Monte-Carlo</b> <span class="ev">(every-visit)</span><span class="es" data-ref="stepMC"></span></div>
    <div class="fm" set:html={F.mc1} /><div class="ef" data-ref="l1MC"></div>
    <div class="fm" set:html={F.mc2} /><div class="ef" data-ref="l2MC"></div>
    <svg class="exp" data-ref="svgMC" role="img" aria-label="Agent Monte-Carlo : valeur estimée de chaque case du couloir et position de l'agent"></svg>
  </div>
  <div class="expbox" data-ref="boxTD">
    <div class="eh"><b style="color:var(--a-fqi)">TD(0)</b><span class="es" data-ref="stepTD"></span></div>
    <div class="fm" set:html={F.td1} /><div class="ef" data-ref="l1TD"></div>
    <div class="fm" set:html={F.td2} /><div class="ef" data-ref="l2TD"></div>
    <svg class="exp" data-ref="svgTD" role="img" aria-label="Agent TD(0) : valeur estimée de chaque case du couloir et position de l'agent"></svg>
  </div>
  </div>
  <div class="plotrow">
    <svg class="plot" data-ref="svg2" role="img" aria-label="Erreur d'estimation de chaque méthode selon le nombre d'épisodes"></svg>
    <div class="kpis">
      <div title="vert : Monte-Carlo, bleu : TD(0)"><span>Épisodes joués</span><b data-ref="ke"></b></div>
      <div title="vert : Monte-Carlo, bleu : TD(0)"><span>Erreur actuelle</span><b data-ref="kc"></b></div>
    </div>
  </div>
  <p class="note"><b>Évaluation de politique : la politique est fixe, toujours essayer d'aller à droite, vers le but (+1).</b> Le hasard vient du terrain, qui fait glisser l'agent d'une case en arrière avec la probabilité choisie. Les deux agents ne l'améliorent jamais : ils estiment seulement ce qu'elle vaut, chacun avec ses propres épisodes. Barres : valeur estimée de chaque case par l'agent ; contour en pointillé : valeur vraie. Monte-Carlo ne met rien à jour avant la fin de son épisode, puis met à jour d'un coup toutes les cases visitées. TD(0), une méthode fondée sur Bellman, met à jour la case qu'il vient de quitter à chaque pas.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-widget="runw"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const S = 7, ALPHA = 0.1, NAVG = 30, EPAVG = 150, CAP = 300;
    const gIn = $('g') as HTMLInputElement, pIn = $('p') as HTMLInputElement;
    let g = 0.95, p = 0.3, Vt: number[];
    const lcg = (seed: number) => { let x = seed; return () => { x = (x * 16807) % 2147483647; return x / 2147483647; }; };
    type Move = { from: number; to: number; slip: boolean; r: number; step: number; end?: boolean };
    type Agent = { V: number[]; s: number; steps: number; path: number[]; rew: number[]; inEp: boolean; ep: number; errs: number[]; line: string; tip: string; move: Move | null; rnd: () => number };
    const newAgent = (seed: number): Agent => ({ V: new Array(S).fill(0), s: 0, steps: 0, path: [], rew: [], inEp: false, ep: 0, errs: [], line: '', tip: '', move: null, rnd: lcg(seed) });
    let mc: Agent, td: Agent, avg: [number, number][] = [];
    const fm = (v: number) => v.toFixed(2).replace('.', ',');
    const truth = () => { let V = new Array(S).fill(0); for (let k = 0; k < 3000; k++) V = V.map((_, i) => (1 - p) * (i === S - 1 ? 1 : g * V[i + 1]) + p * g * V[Math.max(0, i - 1)]); return V; };
    const rms = (V: number[]) => Math.sqrt(V.reduce((a, v, i) => a + (v - Vt[i]) ** 2, 0) / S);
    const mk = (label: string, f: () => void) => { const b = document.createElement('button'); b.textContent = label; b.addEventListener('click', f); $('ctl').appendChild(b); return b; };
    let timer: number | null = null;
    const stop = () => { if (timer) { clearInterval(timer); timer = null; } playB.textContent = '▶ lecture rapide'; };
    mk('pas suivant', () => { stop(); stepAgent(mc, 'mc', true); stepAgent(td, 'td', true); draw(); });
    mk('épisode suivant', () => { stop(); runEpisode(mc, 'mc'); runEpisode(td, 'td'); draw(); });
    mk('20 épisodes', () => { stop(); for (let i = 0; i < 20; i++) { runEpisode(mc, 'mc'); runEpisode(td, 'td'); } draw(); });
    const playB = mk('▶ lecture rapide', () => {
      if (timer) { stop(); return; }
      playB.textContent = '⏸ pause';
      timer = window.setInterval(() => { for (let k = 0; k < 4; k++) { stepAgent(mc, 'mc', true); stepAgent(td, 'td', true); } draw(); if (mc.ep >= EPAVG && td.ep >= EPAVG) stop(); }, 60);
    });
    mk('tout effacer', () => { stop(); reset(); });
    function averageCurves() {
      const out: [number, number][] = Array.from({ length: EPAVG }, () => [0, 0]);
      const r2 = lcg(987654321);
      for (let m = 0; m < NAVG; m++) {
        const A = new Array(S).fill(0), B = new Array(S).fill(0);
        for (let e = 0; e < EPAVG; e++) {
          for (const which of [0, 1]) {
            const V = which === 0 ? A : B; let x = 0, st = 0; const pa: number[] = [], rw: number[] = [];
            while (x < S && st < CAP) {
              const ns = r2() < p ? Math.max(0, x - 1) : x + 1, r = ns === S ? 1 : 0;
              if (which === 1) V[x] += ALPHA * (r + g * (ns === S ? 0 : V[ns]) - V[x]);
              pa.push(x); rw.push(r); x = ns; st++;
            }
            if (which === 0) { let G = 0; for (let i = pa.length - 1; i >= 0; i--) { G = rw[i] + g * G; V[pa[i]] += ALPHA * (G - V[pa[i]]); } }
          }
          out[e][0] += rms(A) / NAVG; out[e][1] += rms(B) / NAVG;
        }
      }
      return out;
    }
    function reset() {
      g = +gIn.value; p = +pIn.value; Vt = truth(); mc = newAgent(12345); td = newAgent(54321); avg = averageCurves(); draw();
    }
    function stepAgent(a: Agent, kind: 'mc' | 'td', explain: boolean) {
      if (!a.inEp) { a.s = 0; a.steps = 0; a.path = []; a.rew = []; a.inEp = true; }
      const slip = a.rnd() < p, ns = slip ? Math.max(0, a.s - 1) : a.s + 1, r = ns === S ? 1 : 0;
      const old = a.V[a.s];
      if (kind === 'td') a.V[a.s] += ALPHA * (r + g * (ns === S ? 0 : a.V[ns]) - a.V[a.s]);
      a.path.push(a.s); a.rew.push(r); a.steps++;
      const nextLabel = ns === S ? 'but (valeur 0)' : `V(${ns + 1})`, nextV = ns === S ? 0 : a.V[ns];
      if (explain) {
        a.move = { from: a.s, to: ns, slip, r, step: a.steps };
        if (kind === 'td') {
          const target = r + g * nextV, err = target - old;
          a.line = `s = ${a.s + 1} : ${r} + ${fm(g)}×${fm(nextV)} − ${fm(old)} = ${fm(err).replace('-', '−')}\nV(${a.s + 1}) = ${fm(old)} + 0,1×${fm(err).replace('-', '−')} = ${fm(a.V[a.s])}`;
        } else { a.line = 'aucune mise à jour avant la fin de l\'épisode\n'; }
      }
      a.s = ns;
      if (ns === S || a.steps >= CAP) {
        if (kind === 'mc') {
          let G = 0; for (let i = a.path.length - 1; i >= 0; i--) { G = a.rew[i] + g * G; a.V[a.path[i]] += ALPHA * (G - a.V[a.path[i]]); }
          if (explain) { a.line = `fin de l'épisode (${a.steps} pas) : G = ${fm(G)} pour la case 1\n${new Set(a.path).size} cases mises à jour d'un coup`; }
        }
        if (explain && a.move) a.move.end = true;
        a.ep++; a.inEp = false; a.errs.push(rms(a.V));
      }
    }
    function runEpisode(a: Agent, kind: 'mc' | 'td') { let k = 0; do { stepAgent(a, kind, false); k++; } while (a.inEp && k < CAP + 5); a.line = ''; a.move = null; }
    function strip(svg: SVGSVGElement, col: string, a: Agent) {
      const cw = 35, W = (S + 1) * cw + 8, x0 = 4, sq = cw - 8, bh = 40;
      let o = '';
      const cx = (i: number) => x0 + Math.min(i, S) * cw + cw / 2;
      // couloir : une case carrée par position, le jeton dedans
      for (let i = 0; i <= S; i++) {
        const goal = i === S, dest = !!a.move && a.move.to === i, orig = !!a.move && a.move.from === i && !dest;
        o += `<rect x="${x0 + i * cw + 4}" y="4" width="${sq}" height="${sq}" rx="5" fill="${goal ? 'var(--hl-stroke)' : 'var(--text-2)'}" fill-opacity="${goal ? 0.3 : 0.1}" stroke="${dest ? col : orig ? col : goal ? 'var(--hl-stroke)' : 'var(--border)'}" stroke-width="${dest ? 2 : 1}"${orig ? ' stroke-dasharray="3 2"' : ''}/><text x="${x0 + i * cw + cw / 2}" y="${4 + sq / 2 + 3.5}" text-anchor="middle" class="vs">${goal ? '+1' : i + 1}</text>`;
      }
      if (a.move) o += `<circle cx="${cx(a.move.from)}" cy="${4 + sq / 2}" r="5" fill="none" stroke="${col}" stroke-width="1.3" stroke-dasharray="2 2"/>`;
      o += `<circle cx="${cx(a.s)}" cy="${4 + sq / 2}" r="5.5" fill="${col}"/>`;
      // valeurs estimées : une barre par case, en dessous du couloir
      const by = 4 + sq + 12;
      o += `<line x1="${x0}" y1="${by + bh}" x2="${x0 + S * cw}" y2="${by + bh}" stroke="var(--border)"/>`;
      for (let i = 0; i < S; i++) {
        const hx = x0 + i * cw + 4, w = sq, hv = bh * Math.min(1, Vt[i]), h = bh * Math.min(1, Math.max(0, a.V[i]));
        if (h > 0.5) o += `<rect x="${hx}" y="${by + bh - h}" width="${w}" height="${h}" rx="2" fill="${col}" fill-opacity="0.85"/>`;
        o += `<rect x="${hx}" y="${by + bh - hv}" width="${w}" height="${hv}" rx="2" fill="none" stroke="var(--text-2)" stroke-width="1" stroke-dasharray="3 2"/>`;
        o += `<text x="${hx + w / 2}" y="${by + bh + 12}" text-anchor="middle" class="vs" style="font-size:9.5px">${fm(a.V[i])}</text>`;
      }
      svg.setAttribute('viewBox', `0 0 ${W} ${by + bh + 18}`); svg.innerHTML = o;
    }
    function head(el: HTMLElement, l1: HTMLElement, l2: HTMLElement, a: Agent) {
      el.innerHTML = '';
      if (a.move && a.move.slip) { const s2 = document.createElement('span'); s2.textContent = ' · a glissé'; s2.style.color = 'var(--h-py)'; el.appendChild(s2); }
      if (a.move && a.move.r) { const s3 = document.createElement('span'); s3.textContent = ' · récompense +1'; s3.style.color = 'var(--hl-text)'; el.appendChild(s3); }
      const parts = a.line.split('\n'); l1.textContent = parts[0] ?? ''; l2.textContent = parts[1] ?? '';
    }
    function draw() {
      strip($('svgMC') as unknown as SVGSVGElement, 'var(--a-es)', mc);
      strip($('svgTD') as unknown as SVGSVGElement, 'var(--a-fqi)', td);
      head($('stepMC'), $('l1MC'), $('l2MC'), mc);
      head($('stepTD'), $('l1TD'), $('l2TD'), td);
      // graphique d'erreur
      const W2 = 440, px = 52, py = 8, ph = 120, pw = 370, all = [...avg.flat(), ...mc.errs, ...td.errs], ymax = Math.max(0.3, ...all) * 1.05;
      const X = (e: number) => px + (e / EPAVG) * pw, Y = (v: number) => py + ph - (Math.min(v, ymax) / ymax) * ph;
      let o2 = `<text x="14" y="${py + ph / 2}" transform="rotate(-90 14 ${py + ph / 2})" text-anchor="middle" class="vs">erreur selon les épisodes</text>`;
      o2 += `<line x1="${px}" y1="${py + ph}" x2="${px + pw}" y2="${py + ph}" stroke="var(--border)"/><line x1="${px}" y1="${py}" x2="${px}" y2="${py + ph}" stroke="var(--border)"/>`;
      [0, 50, 100, 150].forEach((e) => (o2 += `<text x="${X(e)}" y="${py + ph + 14}" text-anchor="middle" class="vs">${e}</text>`));
      [0, ymax / 2, ymax].forEach((v) => (o2 += `<text x="${px - 5}" y="${Y(v) + 3}" text-anchor="end" class="vs">${v.toFixed(2).replace('.', ',')}</text>`));
      const line = (pts: number[], col: string, dash: string, w: number) => `<polyline points="${pts.map((v, i) => `${X(i + 1).toFixed(1)},${Y(v).toFixed(1)}`).join(' ')}" fill="none" stroke="${col}" stroke-width="${w}" ${dash ? `stroke-dasharray="${dash}"` : ''} stroke-linejoin="round"/>`;
      o2 += line(avg.map((a) => a[0]), 'var(--a-es)', '5 3', 1.6) + line(avg.map((a) => a[1]), 'var(--a-fqi)', '5 3', 1.6);
      if (mc.errs.length) o2 += line(mc.errs, 'var(--a-es)', '', 2.4);
      if (td.errs.length) o2 += line(td.errs, 'var(--a-fqi)', '', 2.4);
      o2 += `<line x1="${px + pw - 134}" y1="${py + 10}" x2="${px + pw - 114}" y2="${py + 10}" stroke="var(--text-2)" stroke-width="1.6" stroke-dasharray="5 3"/><text x="${px + pw - 108}" y="${py + 14}" class="vs">moyenne de 30 essais</text>`;
      o2 += `<text x="${px + pw / 2}" y="${py + ph + 30}" text-anchor="middle" class="vs">épisodes joués par chaque agent</text>`;
      const svg2 = $('svg2') as unknown as SVGSVGElement;
      svg2.setAttribute('viewBox', `0 0 ${W2} ${py + ph + 38}`); svg2.innerHTML = o2;
      $('g-out').textContent = fm(g); $('p-out').textContent = fm(p);
      const two = (x: string, y: string) => `<i style="font-style:normal;color:var(--a-es)">${x}</i> · <i style="font-style:normal;color:var(--a-fqi)">${y}</i>`;
      $('ke').innerHTML = two(String(mc.ep), String(td.ep));
      $('kc').innerHTML = two(fm(rms(mc.V)), fm(rms(td.V)));
    }
    ['g', 'p'].forEach((r) => $(r).addEventListener('change', reset));
    ['g', 'p'].forEach((r) => $(r).addEventListener('input', () => { $('g-out').textContent = fm(+gIn.value); $('p-out').textContent = fm(+pIn.value); }));
    reset();
  });
</script>

<style is:global>
  .runw .row > .seg { display: flex; width: 100%; }
  .runw .row > .seg button:last-child { margin-left: auto; }
  .runw .sl2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 22px; }
  .runw .sl2 .sl { grid-template-columns: auto 1fr 34px; gap: 10px; }
  .runw .expgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 10px 0; }
  .runw .expbox { border: 1px solid var(--border); border-radius: 10px; padding: 8px 10px 6px; min-width: 0; }
  .runw .eh { font-size: 13px; color: var(--text-2); }
  .runw .eh b { font-size: 14px; }
  .runw .eh .ev { font-size: 12px; font-style: italic; }
  .runw .fm { margin: 4px 0 0; font-size: 0.82rem; overflow-x: auto; overflow-y: hidden; }
  .runw .fm .katex { font-size: 1em; }
  .runw .ef { font: 10.5px/1.5 var(--mono); color: var(--text-2); min-height: 1.5em; margin: 0 0 2px; white-space: nowrap; overflow: hidden; }
  .runw svg.exp { margin: 2px 0 0; }
  .runw .plotrow { display: flex; gap: 16px; align-items: center; margin-top: 8px; }
  .runw .plotrow svg { flex: 1 1 0; min-width: 0; margin: 0; }
  .runw .plotrow .kpis { flex: 0 0 180px; flex-direction: column; margin: 0; gap: 8px; }
  .runw .plotrow .kpis > div { flex: 0 0 auto; display: block; }
  .runw .plotrow .kpis > div > span { display: block; margin-bottom: 2px; }
  .runw .lgd { white-space: nowrap; margin: 0 0 2px; font-size: 12px; color: var(--text-2); display: flex; align-items: center; gap: 6px; }
  .runw .lgd i { display: inline-block; flex: 0 0 16px; width: 16px; height: 0; border-top: 2.4px dashed var(--text-2); }
  .runw svg.exp text.vs, .runw svg.plot text.vs { font: 10.5px var(--font); fill: var(--text-2); }
  @media (max-width: 700px) { .runw .plotrow { flex-direction: column; align-items: stretch; } .runw .plotrow .kpis { flex-basis: auto; } }
  @media (max-width: 600px) { .runw .sl2 { grid-template-columns: 1fr; } }
  @media (max-width: 700px) { .runw .expgrid { grid-template-columns: 1fr; } }
</style>
