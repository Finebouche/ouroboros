---
// Cours RL, chapitre 1 : de la valeur des actions à la valeur de l'état. Un état, deux actions : une barre par action (sa valeur Q),
// et deux repères sur le même axe : la moyenne pondérée par la politique (évaluer, V) et le maximum (optimiser, V*).
// Q(a) = γ × moyenne des V(s′) des deux états suivants (récompense nulle) ; γ = 0,9.
import katex from 'katex';
const tx = (s: string) => katex.renderToString(s, { throwOnError: false });
const g = 0.9;
const pi = [0.7, 0.3];
const P = [[0.8, 0.2], [0.5, 0.5]];
const Vn = [[1.0, 0.0], [0.5, 0.2]];
const Q = P.map((p, a) => g * p.reduce((s, pr, j) => s + pr * Vn[a][j], 0));
const Vpi = pi.reduce((s, p, a) => s + p * Q[a], 0), Vstar = Math.max(...Q);
const f = (v: number, d = 2) => v.toFixed(d).replace('.', ',');
const k = (v: number, d = 2) => f(v, d).replace(',', '{,}');
const calc = (a: number) => `${f(g, 1)} × (${f(P[a][0], 1)} × ${f(Vn[a][0], 1)} + ${f(P[a][1], 1)} × ${f(Vn[a][1], 1)})`;
const X0 = 150, X1 = 640, X = (v: number) => X0 + v * (X1 - X0), YA = 222;
const rows = [0, 1].map((a) => {
  const y = 56 + a * 82, ys = y + 40;
  let o = `<text x="8" y="${y + 13}" class="qa">action ${a + 1}</text><text x="8" y="${y + 29}" class="qs">π = ${f(pi[a], 1)}</text>` +
    `<rect x="${X0}" y="${y}" width="${X(Q[a]) - X0}" height="26" rx="4" fill="var(--text-2)" fill-opacity="0.3" stroke="var(--text-2)" stroke-width="1"/>` +
    `<text x="${X0 + 8}" y="${y + 17.5}" class="qv">Q = ${f(Q[a], Q[a] === 0.72 ? 2 : 3)}</text>` +
    `<line x1="${X0}" y1="${ys}" x2="${X1}" y2="${ys}" stroke="var(--border)"/>`;
  P[a].forEach((pr, j) => {
    const x = X(g * Vn[a][j]), r = 2 + 3.5 * Math.sqrt(pr);
    o += `<circle cx="${x}" cy="${ys}" r="${r}" fill="var(--text-2)" fill-opacity="0.35"/><text x="${x}" y="${ys + 15}" text-anchor="middle" class="qs">${f(pr, 1)}</text>`;
  });
  return o + `<text x="${X0}" y="${ys + 32}" class="qs">${calc(a)}</text>`;
}).join('');
const axis = [0, 0.5, 1].map((v) => `<line x1="${X(v)}" y1="${YA}" x2="${X(v)}" y2="${YA + 5}" stroke="var(--text-2)"/><text x="${X(v)}" y="${YA + 18}" text-anchor="middle" class="qs">${f(v, 1)}</text>`).join('');
const marks =
  `<line x1="${X(Vpi)}" y1="40" x2="${X(Vpi)}" y2="${YA}" stroke="var(--a-fqi)" stroke-width="2" stroke-dasharray="5 3"/>` +
  `<text x="${X(Vpi) - 6}" y="34" text-anchor="end" class="qm">V<tspan dy="-5" font-size="10">π</tspan><tspan dy="5">(s) = ${f(Vpi)}</tspan></text>` +
  `<line x1="${X(Vstar)}" y1="40" x2="${X(Vstar)}" y2="${YA}" stroke="var(--a-fqi)" stroke-width="2"/>` +
  `<text x="${X(Vstar) + 6}" y="34" class="qm">V<tspan dy="-4" font-size="11">*</tspan><tspan dy="4">(s) = ${f(Vstar)}</tspan></text>`;
const body = rows + `<line x1="${X0}" y1="${YA}" x2="${X1}" y2="${YA}" stroke="var(--text-2)"/>` + axis + marks;
const F1 = tx(`V^\\pi(s) = \\sum_a \\pi(a|s)\\,Q(s,a) = ${k(pi[0], 1)} \\times ${k(Q[0], 2)} + ${k(pi[1], 1)} \\times ${k(Q[1], 3)} = ${k(Vpi)}`);
const F2 = tx(`V^\\star(s) = \\max_a Q(s,a) = \\max(${k(Q[0], 2)}\\ ;\\ ${k(Q[1], 3)}) = ${k(Vstar)}`);
---
<figure class="qb">
  <svg viewBox="0 0 660 248" role="img" aria-label={`Valeur des deux actions (${f(Q[0])} et ${f(Q[1], 3)}), moyenne pondérée par la politique ${f(Vpi)}, maximum ${f(Vstar)}`} set:html={body} />
  <div class="qbc">
    <div><b>Évaluer</b> : moyenne des actions, pondérée par la politique <span class="qe" set:html={F1} /></div>
    <div><b>Valeur optimale</b> : meilleure action <span class="qe" set:html={F2} /></div>
  </div>
  <figcaption>Chaque action mène à deux états suivants (points, avec leur probabilité), placés à leur valeur multipliée par γ = 0,9 ; la barre va jusqu'à leur moyenne pondérée, la valeur Q de l'action. Récompense nulle.</figcaption>
</figure>

<style is:global>
  .qb { margin: 1.4rem 0; font-family: var(--font); }
  .qb svg { width: 100%; max-width: 660px; height: auto; display: block; margin: 0 auto; }
  .qb svg text.qa { font: 600 13px var(--font); fill: var(--text); }
  .qb svg text.qs { font: 11.5px var(--font); fill: var(--text-2); }
  .qb svg text.qv { font: 600 12.5px var(--font); fill: var(--text); }
  .qb svg text.qm { font: 600 13px var(--font); fill: var(--a-fqi); }
  .qb .qbc { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 8px; }
  .qb .qbc > div { border-left: 3px solid var(--a-fqi); background: color-mix(in srgb, var(--text-2) 6%, transparent); border-radius: 6px; padding: 8px 12px; font-size: 13px; color: var(--text-2); }
  .qb .qbc b { color: var(--text); font-weight: 600; }
  .qb .qbc .katex { font-size: 0.95em; }
  .qb .qbc > div > span.qe { display: block; margin-top: 4px; overflow-x: auto; overflow-y: hidden; color: var(--text); }
  .qb figcaption { font-size: 12px; color: var(--text-2); margin-top: 8px; }
  @media (max-width: 640px) { .qb .qbc { grid-template-columns: 1fr; } }
</style>
