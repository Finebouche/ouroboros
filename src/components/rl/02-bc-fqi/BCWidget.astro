---
// Cours RL, chapitre 2 : BC (tabulaire) lâché depuis une case choisie, comparé à l'expert. On règle le nombre de démonstrations.
// Les règles et l'expert viennent de ../world.ts (grille 4 × 4, politique optimale).
---
<div class="widget rlw bcw" data-widget="bcw">
  <div class="row"><span>Démonstrations de l'expert :</span><span class="seg" data-ref="n"></span><span class="hint">puis cliquer sur une case de départ</span></div>
  <svg class="clk" data-ref="svg" role="img" aria-label="Trajectoires de l'expert et de la politique apprise par imitation depuis la case choisie"></svg>
  <div class="kpis">
    <div><span>Expert</span><b data-ref="ke"></b></div>
    <div><span>BC</span><b data-ref="kb"></b></div>
    <div><span>Cases couvertes par les démonstrations</span><b data-ref="kc"></b></div>
  </div>
  <p class="note">Bleu : cases vues dans les démonstrations et action de l'expert. Gris : action par défaut (la plus fréquente) dans les cases jamais vues. Trait bleu : trajectoire de l'expert ; trait rouge : trajectoire de la politique apprise. Version tabulaire de BC : avec un réseau de neurones, l'action dans les cases non vues est une extrapolation, pas une valeur par défaut, mais le problème est le même.</p>
</div>

<script>
  import { R, C, DIRS, is, terminal, expert, rollout, step, GOAL, PIT, WALL } from '../world';
  document.querySelectorAll<HTMLElement>('[data-widget="bcw"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const cs = 74;
    const SETS: Record<string, number[][]> = { '2': [[3, 0], [3, 3]], '3': [[3, 0], [3, 3], [3, 1]], '4': [[3, 0], [3, 3], [3, 1], [3, 2]] };
    const st = { n: '2', start: [3, 1] as number[] };
    [['2', '2'], ['3', '3'], ['4', '4']].forEach(([l, v]) => {
      const b = document.createElement('button'); b.textContent = `${l} départs`; b.dataset.v = v;
      b.addEventListener('click', () => { st.n = v; draw(); }); $('n').appendChild(b);
    });
    const free = (r: number, c: number) => !terminal(r, c) && !is(WALL, r, c);
    const n13 = Array.from({ length: R * C }, (_, i) => [Math.floor(i / C), i % C]).filter(([r, c]) => free(r, c)).length;
    const cen = (r: number, c: number): [number, number] => [6 + c * cs + (cs - 3) / 2, 6 + r * cs + (cs - 3) / 2];
    const arr = (x1: number, y1: number, x2: number, y2: number, col: string) => {
      const L = Math.hypot(x2 - x1, y2 - y1) || 1, ux = (x2 - x1) / L, uy = (y2 - y1) / L, h = 8, bx = x2 - ux * h, by = y2 - uy * h;
      return `<line x1="${x1}" y1="${y1}" x2="${bx}" y2="${by}" stroke="${col}" stroke-width="2.6"/><polygon points="${x2},${y2} ${bx - uy * 3.8},${by + ux * 3.8} ${bx + uy * 3.8},${by - ux * 3.8}" fill="${col}"/>`;
    };
    function status(path: number[][], pol: (r: number, c: number) => number) {
      const [r, c] = path[path.length - 1];
      if (is(GOAL, r, c)) return `atteint le but en ${path.length - 1} pas`;
      if (is(PIT, r, c)) return `tombe dans le piège après ${path.length - 1} pas`;
      const [nr, nc] = step(r, c, pol(r, c));
      return nr === r && nc === c ? 'reste bloqué contre un mur' : 'n\'atteint pas le but en 10 pas';
    }
    function draw() {
      $('n').querySelectorAll('button').forEach((b) => b.classList.toggle('active', b.dataset.v === st.n));
      const visited = new Set<string>(), acts: number[] = [];
      SETS[st.n].forEach((s) => rollout(s, expert).slice(0, -1).forEach(([r, c]) => { const k = `${r},${c}`; if (!visited.has(k)) { visited.add(k); acts.push(expert(r, c)); } }));
      const counts = [0, 0, 0, 0]; acts.forEach((a) => counts[a]++);
      const def = counts.indexOf(Math.max(...counts));
      const learned = (r: number, c: number) => (visited.has(`${r},${c}`) ? expert(r, c) : def);
      let s = '';
      for (let r = 0; r < R; r++) for (let c = 0; c < C; c++) {
        const x = 6 + c * cs, y = 6 + r * cs, w = cs - 3;
        if (is(WALL, r, c)) { s += `<rect x="${x}" y="${y}" width="${w}" height="${w}" rx="5" fill="var(--text-2)" fill-opacity="0.35"/>`; continue; }
        if (is(GOAL, r, c)) { s += `<rect x="${x}" y="${y}" width="${w}" height="${w}" rx="5" fill="var(--hl-stroke)" fill-opacity="0.35" stroke="var(--hl-stroke)"/><text x="${x + w / 2}" y="${y + w / 2 + 5}" text-anchor="middle" class="gv">+1</text>`; continue; }
        if (is(PIT, r, c)) { s += `<rect x="${x}" y="${y}" width="${w}" height="${w}" rx="5" fill="var(--h-py)" fill-opacity="0.35" stroke="var(--h-py)"/><text x="${x + w / 2}" y="${y + w / 2 + 5}" text-anchor="middle" class="gv">−1</text>`; continue; }
        const seen = visited.has(`${r},${c}`), isStart = r === st.start[0] && c === st.start[1];
        s += `<rect x="${x}" y="${y}" width="${w}" height="${w}" rx="5" fill="${seen ? 'var(--a-fqi)' : 'var(--text-2)'}" fill-opacity="${seen ? 0.26 : 0.07}" stroke="${isStart ? 'var(--text)' : 'var(--border)'}" stroke-width="${isStart ? 2 : 0.8}"/>`;
        s += `<text x="${x + w / 2}" y="${y + w / 2 + 8}" text-anchor="middle" class="ar" style="fill:${seen ? 'var(--a-fqi)' : 'var(--text-2)'};opacity:${seen ? 1 : 0.7}">${DIRS[learned(r, c)][3]}</text>`;
      }
      const pe = rollout(st.start, expert, 10), pb = rollout(st.start, learned, 10);
      const draw2 = (p: number[][], col: string, off: number) => {
        let o = '';
        for (let i = 0; i < p.length - 1; i++) {
          if (p[i][0] === p[i + 1][0] && p[i][1] === p[i + 1][1]) { const [x, y] = cen(p[i][0], p[i][1]); o += `<circle cx="${x + off}" cy="${y + off}" r="20" fill="none" stroke="${col}" stroke-width="2.2" stroke-dasharray="4 3"/>`; break; }
          const [x1, y1] = cen(p[i][0], p[i][1]), [x2, y2] = cen(p[i + 1][0], p[i + 1][1]); o += arr(x1 + off, y1 + off, x2 + off, y2 + off, col);
        }
        const [sx, sy] = cen(p[0][0], p[0][1]); return o + `<circle cx="${sx + off}" cy="${sy + off}" r="4.5" fill="${col}"/>`;
      };
      s += draw2(pe, 'var(--a-fqi)', -6) + draw2(pb, 'var(--h-py)', 6);
      const svg = $('svg') as unknown as SVGSVGElement;
      svg.setAttribute('viewBox', `0 0 ${C * cs + 12} ${R * cs + 12}`); svg.innerHTML = s;
      $('ke').textContent = status(pe, expert); $('kb').textContent = status(pb, learned);
      $('kc').textContent = `${visited.size} sur ${n13}`;
    }
    ($('svg') as unknown as SVGSVGElement).addEventListener('click', (e) => {
      const svg = $('svg') as unknown as SVGSVGElement, rect = svg.getBoundingClientRect(), k = (C * cs + 12) / rect.width;
      const c = Math.floor(((e.clientX - rect.left) * k - 6) / cs), r = Math.floor(((e.clientY - rect.top) * k - 6) / cs);
      if (r >= 0 && r < R && c >= 0 && c < C && free(r, c)) { st.start = [r, c]; draw(); }
    });
    draw();
  });
</script>
