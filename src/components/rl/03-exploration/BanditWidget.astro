---
// Cours RL, chapitre 3 : un bandit à 6 bras, pas à pas. Chaque bras a une récompense moyenne inconnue de l'agent (trait pointillé) ;
// l'agent tient une estimation Q(a) (barre) et choisit un bras selon sa stratégie : glouton, ε-greedy, softmax, optimiste ou UCB.
// Sous chaque barre : le nombre d'essais N, et soit la probabilité de jouer ce bras au prochain pas, soit le score UCB.
import katex from 'katex';
const tex = (s: string) => katex.renderToString(s, { throwOnError: false });
const FSEL: [string, string][] = [
  ['glouton', tex('a = \\arg\\max_a Q(a)')],
  ['eps', tex('a = \\arg\\max_a Q(a)\\ \\text{, sauf avec probabilité } \\varepsilon = 0{,}1 \\text{ : un bras au hasard}')],
  ['soft', tex('P(a) = \\dfrac{e^{Q(a)/\\tau}}{\\sum_b e^{Q(b)/\\tau}}, \\qquad \\tau = 0{,}25')],
  ['opt', tex('Q_0(a) = 5 \\ \\text{ (bien au-dessus de toute valeur possible), puis } a = \\arg\\max_a Q(a)')],
  ['ucb', tex('a = \\arg\\max_a \\Big[\\, Q(a) + c\\sqrt{\\dfrac{\\ln t}{N(a)}}\\,\\Big], \\qquad c = 2')],
];
const FUPD: [string, string][] = [
  ['mean', tex('Q(a) \\leftarrow Q(a) + \\dfrac{1}{N(a)}\\,\\big(r - Q(a)\\big)\\qquad \\text{(moyenne des récompenses reçues)}')],
  ['alpha', tex('Q(a) \\leftarrow Q(a) + \\alpha\\,\\big(r - Q(a)\\big), \\qquad \\alpha = 0{,}1')],
];
---
<div class="widget rlw banw" data-widget="banw">
  <div class="row"><span>Stratégie :</span><span class="seg" data-ref="strat"></span></div>
  <div class="row"><span class="seg" data-ref="ctl"></span></div>
  {FSEL.map(([k, h]) => <div class="fm" data-sel={k} set:html={h} hidden />)}
  {FUPD.map(([k, h]) => <div class="fm" data-upd={k} set:html={h} hidden />)}
  <svg data-ref="svg" role="img" aria-label="Six bras : estimation de la récompense moyenne de chacun, valeur vraie, nombre d'essais et probabilité d'être joué"></svg>
  <div class="calc" data-ref="line"></div>
  <div class="kpis">
    <div><span>Pas joués</span><b data-ref="kt"></b></div>
    <div><span>Récompense cumulée</span><b data-ref="kc"></b></div>
    <div><span>Regret cumulé</span><b data-ref="kr"></b><i>ce qu'on perd, à chaque pas, face au meilleur bras (le bras 3)</i></div>
  </div>
  <p class="note">Barre : estimation Q(a) de la récompense moyenne du bras. Trait pointillé : sa vraie valeur, inconnue de l'agent. Point ambre : la dernière récompense reçue (elle fluctue : écart-type 1). Contour : dernier bras joué.</p>
</div>

<script>
  import { rng, gauss, argmaxTie, softmax, STRATS, LABELS, COLORS, EPS, TAU, UCB_C, Q0_OPT, ALPHA_OPT } from './bandit';
  import type { Strat } from './bandit';

  document.querySelectorAll<HTMLElement>('[data-widget="banw"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const MU = [0.3, -0.6, 1.3, 0.9, -1.1, 0.6], K = MU.length, BEST = 2, MSTAR = Math.max(...MU);
    const fm = (v: number, d = 2) => v.toFixed(d).replace('.', ',').replace('-', '−');
    let strat: Strat = 'glouton', seed = 43, rnd = rng(seed);
    type Last = { a: number; r: number; qOld: number; qNew: number; msg: string };
    let Q: number[], N: number[], t = 0, cum = 0, regret = 0, last: Last | null = null;
    let timer: number | null = null, playB: HTMLButtonElement | null = null;

    function reset(newSeed = false) {
      stop();
      if (newSeed) seed++;
      rnd = rng(seed);
      Q = new Array(K).fill(strat === 'opt' ? Q0_OPT : 0); N = new Array(K).fill(0);
      t = 0; cum = 0; regret = 0; last = null;
      root.querySelectorAll<HTMLElement>('[data-sel]').forEach((e) => (e.hidden = e.dataset.sel !== strat));
      root.querySelectorAll<HTMLElement>('[data-upd]').forEach((e) => (e.hidden = e.dataset.upd !== (strat === 'opt' ? 'alpha' : 'mean')));
      draw();
    }
    // score UCB de chaque bras au prochain pas (infini si jamais essayé)
    const ucbScores = () => Q.map((q, a) => (N[a] === 0 ? Infinity : q + UCB_C * Math.sqrt(Math.log(t + 1) / N[a])));
    // probabilité de jouer chaque bras au prochain pas
    function probs(): number[] {
      const tie = (v: number[]) => { const m = Math.max(...v), n = v.filter((x) => x >= m - 1e-12).length; return v.map((x) => (x >= m - 1e-12 ? 1 / n : 0)); };
      if (strat === 'soft') return softmax(Q, TAU);
      if (strat === 'eps') return tie(Q).map((p) => EPS / K + (1 - EPS) * p);
      if (strat === 'ucb') return tie(ucbScores().map((x) => (x === Infinity ? 1e9 : x)));
      return tie(Q);
    }
    function step() {
      const n = t + 1;
      let a: number, msg: string;
      if (strat === 'eps') {
        const u = rnd();
        if (u < EPS) { a = Math.floor(rnd() * K); msg = `tirage ${fm(u)} < ε : exploration, bras ${a + 1} au hasard`; }
        else { a = argmaxTie(Q, rnd); msg = `tirage ${fm(u)} ≥ ε : le meilleur Q, bras ${a + 1}`; }
      } else if (strat === 'soft') {
        const p = softmax(Q, TAU), u = rnd();
        let c = 0; a = K - 1;
        for (let i = 0; i < K; i++) { c += p[i]; if (u < c) { a = i; break; } }
        msg = `bras ${a + 1} tiré avec la probabilité ${Math.round(p[a] * 100)} %`;
      } else if (strat === 'ucb') {
        const sc = ucbScores();
        a = argmaxTie(sc.map((x) => (x === Infinity ? 1e9 : x)), rnd);
        msg = N[a] === 0 ? `bras ${a + 1} jamais essayé : score infini` : `bras ${a + 1}, meilleur score : ${fm(Q[a])} + ${fm(sc[a] - Q[a])} = ${fm(sc[a])}`;
      } else {
        a = argmaxTie(Q, rnd);
        msg = `le meilleur Q, bras ${a + 1}`;
      }
      const r = MU[a] + gauss(rnd);
      N[a]++;
      const qOld = Q[a];
      Q[a] += (strat === 'opt' ? ALPHA_OPT : 1 / N[a]) * (r - Q[a]);
      t = n; cum += r; regret += MSTAR - MU[a];
      last = { a, r, qOld, qNew: Q[a], msg };
    }

    const mk = (label: string, f: () => void) => { const b = document.createElement('button'); b.textContent = label; b.addEventListener('click', f); $('ctl').appendChild(b); return b; };
    function stop() { if (timer) { clearInterval(timer); timer = null; } if (playB) playB.textContent = '▶ lecture'; }
    mk('pas suivant', () => { stop(); step(); draw(); });
    mk('10 pas', () => { stop(); for (let i = 0; i < 10; i++) step(); draw(); });
    playB = mk('▶ lecture', () => {
      if (timer) { stop(); return; }
      playB!.textContent = '⏸ pause';
      timer = window.setInterval(() => { step(); draw(); if (t >= 2000) stop(); }, 220);
    });
    mk('recommencer', () => reset(true));
    STRATS.forEach((s) => {
      const b = document.createElement('button'); b.textContent = LABELS[s]; b.dataset.v = s;
      b.addEventListener('click', () => { strat = s; seed = 43; reset(); }); $('strat').appendChild(b);
    });

    function draw() {
      $('strat').querySelectorAll('button').forEach((b) => b.classList.toggle('active', (b as HTMLElement).dataset.v === strat));
      const col = COLORS[strat];
      const W = 640, px = 34, pw = W - px - 6, py = 22, ph = 150, cw = pw / K;
      const ymin = -2, ymax = strat === 'opt' ? 5.5 : 3.2;
      const Y = (v: number) => py + ph - ((Math.max(ymin, Math.min(ymax, v)) - ymin) / (ymax - ymin)) * ph;
      const P = probs(), sc = strat === 'ucb' ? ucbScores() : [];
      let o = '';
      (strat === 'opt' ? [-2, 0, 2, 4] : [-2, 0, 2]).forEach((g) => {
        o += `<line x1="${px}" y1="${Y(g)}" x2="${px + pw}" y2="${Y(g)}" stroke="var(--border)" ${g === 0 ? '' : 'stroke-dasharray="2 4"'}/><text x="${px - 6}" y="${Y(g) + 3.5}" text-anchor="end" class="vs">${g}</text>`;
      });
      for (let a = 0; a < K; a++) {
        const cx = px + a * cw + cw / 2, bw = Math.min(46, cw - 18);
        if (last && last.a === a) o += `<rect x="${cx - cw / 2 + 3}" y="${py - 6}" width="${cw - 6}" height="${ph + 12}" rx="8" fill="none" stroke="var(--text)" stroke-opacity="0.45" stroke-width="1.3"/>`;
        // barre Q(a)
        const y0 = Y(0), yq = Y(Q[a]);
        o += `<rect x="${cx - bw / 2}" y="${Math.min(y0, yq)}" width="${bw}" height="${Math.max(1.5, Math.abs(y0 - yq))}" rx="3" fill="${col}" fill-opacity="0.6"/>`;
        // bonus UCB au-dessus de la barre
        if (strat === 'ucb') {
          if (N[a] === 0) o += `<text x="${cx}" y="${py + 11}" text-anchor="middle" class="vi">∞</text>`;
          else { const yt = Y(sc[a]); o += `<rect x="${cx - bw / 2}" y="${yt}" width="${bw}" height="${Math.max(0, yq - yt)}" rx="3" fill="${col}" fill-opacity="0.18" stroke="${col}" stroke-dasharray="3 2"/>`; }
        }
        // valeur vraie : trait pointillé
        o += `<line x1="${cx - bw / 2 - 5}" y1="${Y(MU[a])}" x2="${cx + bw / 2 + 5}" y2="${Y(MU[a])}" stroke="var(--text)" stroke-width="1.6" stroke-dasharray="4 3"/>`;
        // dernière récompense
        if (last && last.a === a) o += `<circle cx="${cx}" cy="${Y(last.r)}" r="4.5" fill="var(--hl-stroke)" stroke="var(--surface)" stroke-width="1"/>`;
        // valeur Q
        const qy = Q[a] >= 0 ? Math.min(yq, y0) - 4 : Math.max(yq, y0) + 11;
        o += `<text x="${cx + bw / 2 + 4}" y="${Math.max(py + 10, Math.min(py + ph - 2, qy))}" class="vs">${fm(Q[a])}</text>`;
        // étiquettes
        const ly = py + ph + 16;
        o += `<text x="${cx}" y="${ly}" text-anchor="middle" class="vl">bras ${a + 1}</text>`;
        o += `<text x="${cx}" y="${ly + 15}" text-anchor="middle" class="vs">N = ${N[a]}</text>`;
        if (strat === 'ucb') o += `<text x="${cx}" y="${ly + 30}" text-anchor="middle" class="vs${P[a] === Math.max(...P) ? ' hi' : ''}">${sc[a] === Infinity ? 'score ∞' : 'score ' + fm(sc[a])}</text>`;
        else o += `<text x="${cx}" y="${ly + 30}" text-anchor="middle" class="vs${P[a] === Math.max(...P) ? ' hi' : ''}">joué à ${Math.round(P[a] * 100)} %</text>`;
      }
      const svg = $('svg') as unknown as SVGSVGElement;
      svg.setAttribute('viewBox', `0 0 ${W} ${py + ph + 52}`); svg.innerHTML = o;
      $('line').textContent = last
        ? `pas ${t} : ${last.msg}. Récompense ${fm(last.r)} ; Q(${last.a + 1}) : ${fm(last.qOld)} → ${fm(last.qNew)}`
        : 'Appuie sur « pas suivant » : l\'agent choisit un bras, reçoit une récompense et met à jour son estimation.';
      $('kt').textContent = String(t); $('kc').textContent = fm(cum, 1); $('kr').textContent = fm(regret, 1);
    }
    reset();
  });
</script>

<style is:global>
  .banw .row > .seg { display: inline-flex; flex-wrap: wrap; }
  .banw .row:has(> .seg[data-ref="ctl"]) > .seg { display: flex; width: 100%; }
  .banw .row > .seg[data-ref="ctl"] button:last-child { margin-left: auto; }
  .banw .row { margin-bottom: 6px; }
  .banw [hidden] { display: none !important; }
  .banw .fm { margin: 6px 0 0; font-size: 0.9rem; overflow-x: auto; overflow-y: hidden; }
  .banw svg { max-width: 680px; margin: 8px auto 0; }
  .banw svg text.vs { font: 10.5px var(--font); fill: var(--text-2); }
  .banw svg text.vs.hi { fill: var(--text); font-weight: 600; }
  .banw svg text.vl { font: 600 11.5px var(--font); fill: var(--text); }
  .banw svg text.vi { font: 600 15px var(--font); fill: var(--a-lspi); }
  .banw .calc { font-size: 12.5px; line-height: 1.5; color: var(--text-2); min-height: 3em; margin: 4px 0 2px; }
</style>
