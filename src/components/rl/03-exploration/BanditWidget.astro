---
// Cours RL, chapitre 3 : deux stratégies côte à côte sur le même bandit à 6 bras, avec les mêmes récompenses
// (la k-ième récompense du bras a est la même pour les deux agents). Pour chaque agent : la répartition des essais N(a)
// (barre), l'estimation Q(a) et la vraie moyenne q*(a). En bas : le regret cumulé, tirage en cours et moyenne de 200 tirages.
// Boutons 1 / 10 / 100 pas, pas de lecture automatique ; plafond de 1 000 pas.
import katex from 'katex';
import { STRATS } from './bandit';
const tex = (s: string) => katex.renderToString(s, { throwOnError: false });
const RULE: Record<string, string> = {
  glouton: tex('a = \\arg\\max_a Q(a)'),
  eps: tex('\\arg\\max_a Q(a)') + ', ou au hasard avec la probabilité ' + tex('\\varepsilon = 0{,}1'),
  soft: tex('P(a) \\propto e^{Q(a)/\\tau}') + ', ' + tex('\\tau = 0{,}25'),
  opt: tex('Q_0(a) = 5') + ', puis ' + tex('\\arg\\max_a Q(a)'),
  ucb: tex('\\arg\\max_a \\big[\\,Q(a) + 2\\sqrt{\\ln t / N(a)}\\,\\big]'),
};
const UPD = tex('Q(a) = \\text{moyenne des récompenses reçues du bras } a') + ' (sauf pour l\'optimiste : pas ' + tex('\\alpha = 0{,}1') + ' depuis ' + tex('Q_0 = 5') + ')';
---
<div class="widget rlw banw" data-widget="banw">
  <div class="row"><span class="seg" data-ref="ctl"></span></div>
  <div class="fm" set:html={UPD} />
  <div class="bgrid">
    {['A', 'B'].map((k) => (
      <div class="bbox">
        <select data-ref={'sel' + k} aria-label={k === 'A' ? 'Stratégie du premier agent' : 'Stratégie du second agent'}></select>
        {STRATS.map((s) => <div class="bfm" data-p={k} data-rule={s} set:html={RULE[s]} hidden />)}
        <svg class="bsv" data-ref={'svg' + k} role="img" aria-label="Répartition des essais sur les six bras, estimation et vraie moyenne de chaque bras"></svg>
        <div class="bcalc" data-ref={'l' + k}></div>
      </div>
    ))}
  </div>
  <div class="bplot">
    <svg data-ref="svgR" role="img" aria-label="Regret cumulé des deux agents selon le nombre de pas"></svg>
    <div class="kpis">
      <div><span>Pas joués</span><b data-ref="kt"></b></div>
      <div><span>Regret cumulé</span><b data-ref="kr"></b></div>
      <div><span>Essais sur le meilleur bras</span><b data-ref="kb"></b></div>
    </div>
  </div>
  <p class="note">Barre : part des essais donnés au bras, N(a) au-dessus. q* : vraie moyenne, inconnue de l'agent ; récompenses bruitées (écart-type 1), les mêmes pour les deux agents. Courbes : regret de ce tirage (trait plein) et moyenne de 200 tirages (pointillé).</p>
</div>

<script>
  import { rng, gauss, argmaxTie, softmax, STRATS, LABELS, COLORS, EPS, TAU, UCB_C, Q0_OPT, ALPHA_OPT } from './bandit';
  import type { Strat } from './bandit';

  document.querySelectorAll<HTMLElement>('[data-widget="banw"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const MU = [0.3, -0.6, 1.3, 0.9, -1.1, 0.6], K = MU.length, BEST = 2, MSTAR = Math.max(...MU), T = 1000, NAVG = 200;
    const fm = (v: number, d = 2) => v.toFixed(d).replace('.', ',').replace('-', '−');
    // récompenses communes : la k-ième récompense du bras a, tirée une fois par graine
    const noiseFor = (seed: number) => Array.from({ length: K }, (_, a) => { const r = rng(seed * 31 + a + 1); return Array.from({ length: T }, () => gauss(r)); });
    type Agent = { s: Strat; Q: number[]; N: number[]; t: number; reg: number; regs: number[]; rnd: () => number; noise: number[][]; msg: string; last: number };
    const newAgent = (s: Strat, seed: number, noise: number[][]): Agent => ({ s, Q: new Array(K).fill(s === 'opt' ? Q0_OPT : 0), N: new Array(K).fill(0), t: 0, reg: 0, regs: [0], rnd: rng(seed * 7 + 1000), noise, msg: '', last: -1 });
    function step(g: Agent, explain: boolean) {
      if (g.t >= T) return;
      const { Q, N, rnd } = g;
      let a: number, msg = '';
      if (g.s === 'eps') {
        const u = rnd();
        if (u < EPS) { a = Math.floor(rnd() * K); msg = `tirage ${fm(u)} < ε : bras ${a + 1} au hasard`; }
        else { a = argmaxTie(Q, rnd); msg = `tirage ${fm(u)} ≥ ε : meilleur Q, bras ${a + 1}`; }
      } else if (g.s === 'soft') {
        const p = softmax(Q, TAU), u = rnd();
        let c = 0; a = K - 1;
        for (let i = 0; i < K; i++) { c += p[i]; if (u < c) { a = i; break; } }
        msg = `bras ${a + 1}, tiré avec la probabilité ${Math.round(p[a] * 100)} %`;
      } else if (g.s === 'ucb') {
        const sc = Q.map((q, i) => (N[i] === 0 ? 1e9 : q + UCB_C * Math.sqrt(Math.log(g.t + 1) / N[i])));
        a = argmaxTie(sc, rnd);
        msg = N[a] === 0 ? `bras ${a + 1} jamais essayé : score infini` : `bras ${a + 1} : ${fm(Q[a])} + bonus ${fm(sc[a] - Q[a])} = ${fm(sc[a])}`;
      } else {
        a = argmaxTie(Q, rnd);
        msg = `meilleur Q, bras ${a + 1}`;
      }
      const r = MU[a] + g.noise[a][N[a]];
      N[a]++;
      const qOld = Q[a];
      Q[a] += (g.s === 'opt' ? ALPHA_OPT : 1 / N[a]) * (r - Q[a]);
      g.t++; g.reg += MSTAR - MU[a]; g.regs.push(g.reg); g.last = a;
      if (explain) g.msg = `pas ${g.t} : ${msg} ; récompense ${fm(r)}, Q(${a + 1}) : ${fm(qOld)} → ${fm(Q[a])}`;
    }
    // regret moyen sur NAVG tirages, calculé une fois par stratégie
    const avgCache = new Map<Strat, number[]>();
    function avg(s: Strat) {
      if (!avgCache.has(s)) {
        const out = new Array(T + 1).fill(0);
        for (let i = 1; i <= NAVG; i++) { const g = newAgent(s, i, noiseFor(i)); for (let k = 0; k < T; k++) step(g, false); g.regs.forEach((v, k) => (out[k] += v / NAVG)); }
        avgCache.set(s, out);
      }
      return avgCache.get(s)!;
    }

    const strat: [Strat, Strat] = ['eps', 'ucb'];
    let seed = 1, A: Agent, B: Agent;
    function reset(newSeed = false) {
      if (newSeed) seed++;
      const noise = noiseFor(seed);
      A = newAgent(strat[0], seed, noise); B = newAgent(strat[1], seed, noise); draw();
    }
    (['A', 'B'] as const).forEach((k, i) => {
      const sel = $('sel' + k) as HTMLSelectElement;
      STRATS.forEach((s) => { const o = document.createElement('option'); o.value = s; o.textContent = LABELS[s]; sel.appendChild(o); });
      sel.value = strat[i];
      sel.addEventListener('change', () => { strat[i] = sel.value as Strat; reset(); });
    });
    const mk = (label: string, f: () => void) => { const b = document.createElement('button'); b.textContent = label; b.addEventListener('click', f); $('ctl').appendChild(b); return b; };
    const adv = (n: number) => { for (let i = 0; i < n; i++) { const ex = i === n - 1; step(A, ex); step(B, ex); } draw(); };
    mk('1 pas', () => adv(1));
    mk('10 pas', () => adv(10));
    mk('100 pas', () => adv(100));
    mk('recommencer', () => reset(true));

    function arms(svg: SVGSVGElement, g: Agent) {
      const col = COLORS[g.s], W = 300, px = 4, cw = (W - 2 * px) / K, top = 22, bh = 84, base = top + bh;
      let o = '';
      o += `<line x1="${px}" y1="${base}" x2="${W - px}" y2="${base}" stroke="var(--border)"/>`;
      for (let a = 0; a < K; a++) {
        const cx = px + a * cw + cw / 2, bw = cw - 14, h = g.t ? (bh * g.N[a]) / g.t : 0;
        if (g.last === a) o += `<rect x="${cx - cw / 2 + 2}" y="${top - 18}" width="${cw - 4}" height="${bh + 66}" rx="6" fill="none" stroke="var(--text)" stroke-opacity="0.4"/>`;
        o += `<rect x="${cx - bw / 2}" y="${base - h}" width="${bw}" height="${Math.max(h, 0.8)}" rx="2" fill="${col}" fill-opacity="0.65"/>`;
        o += `<text x="${cx}" y="${base - h - 4}" text-anchor="middle" class="bn">${g.N[a]}</text>`;
        o += `<text x="${cx}" y="${base + 14}" text-anchor="middle" class="bl${a === BEST ? ' bb' : ''}">bras ${a + 1}</text>`;
        o += `<text x="${cx}" y="${base + 27}" text-anchor="middle" class="bs">q* ${fm(MU[a], 1)}</text>`;
        o += `<text x="${cx}" y="${base + 40}" text-anchor="middle" class="bs" style="fill:${col}">Q ${fm(g.Q[a], 1)}</text>`;
      }
      svg.setAttribute('viewBox', `0 0 ${W} ${base + 46}`); svg.innerHTML = o;
    }
    function regretPlot() {
      const W = 440, px = 44, py = 10, ph = 120, pw = 380, xmax = Math.min(T, Math.max(100, Math.ceil(Math.max(A.t, B.t) / 100) * 100));
      const aA = avg(A.s), aB = avg(B.s), ymax = Math.max(10, aA[xmax], aB[xmax], A.reg, B.reg) * 1.08;
      const X = (k: number) => px + (k / xmax) * pw, Y = (v: number) => py + ph - (v / ymax) * ph;
      let o = `<line x1="${px}" y1="${py + ph}" x2="${px + pw}" y2="${py + ph}" stroke="var(--border)"/><line x1="${px}" y1="${py}" x2="${px}" y2="${py + ph}" stroke="var(--border)"/>`;
      [0, xmax / 2, xmax].forEach((k) => (o += `<text x="${X(k)}" y="${py + ph + 14}" text-anchor="middle" class="bs">${k}</text>`));
      [0, ymax / 2, ymax].forEach((v) => (o += `<text x="${px - 5}" y="${Y(v) + 3.5}" text-anchor="end" class="bs">${Math.round(v)}</text>`));
      o += `<text x="12" y="${py + ph / 2}" transform="rotate(-90 12 ${py + ph / 2})" text-anchor="middle" class="bs">regret cumulé</text>`;
      o += `<text x="${px + pw / 2}" y="${py + ph + 30}" text-anchor="middle" class="bs">pas</text>`;
      const pl = (v: number[], n: number, col: string, dash: boolean) => { const st = Math.max(1, Math.floor(n / 200)); const pts: string[] = []; for (let k = 0; k <= n; k += st) pts.push(`${X(k).toFixed(1)},${Y(v[k]).toFixed(1)}`); return `<polyline points="${pts.join(' ')}" fill="none" stroke="${col}" stroke-width="${dash ? 1.5 : 2.3}"${dash ? ' stroke-dasharray="5 3"' : ''}/>`; };
      o += pl(aA, xmax, COLORS[A.s], true) + pl(aB, xmax, COLORS[B.s], true);
      if (A.t) o += pl(A.regs, A.t, COLORS[A.s], false);
      if (B.t) o += pl(B.regs, B.t, COLORS[B.s], false);
      const svg = $('svgR') as unknown as SVGSVGElement;
      svg.setAttribute('viewBox', `0 0 ${W} ${py + ph + 36}`); svg.innerHTML = o;
    }
    function draw() {
      arms($('svgA') as unknown as SVGSVGElement, A); arms($('svgB') as unknown as SVGSVGElement, B);
      (['A', 'B'] as const).forEach((k, i) => {
        root.querySelectorAll<HTMLElement>(`[data-p="${k}"]`).forEach((e) => (e.hidden = e.dataset.rule !== strat[i]));
        ($('sel' + k) as HTMLElement).style.color = COLORS[strat[i]];
      });
      $('lA').textContent = A.msg || '—'; $('lB').textContent = B.msg || '—';
      regretPlot();
      const two = (x: string, y: string) => `<i style="font-style:normal;color:${COLORS[A.s]}">${x}</i> · <i style="font-style:normal;color:${COLORS[B.s]}">${y}</i>`;
      $('kt').textContent = String(A.t);
      $('kr').innerHTML = two(fm(A.reg, 0), fm(B.reg, 0));
      $('kb').innerHTML = two(A.t ? Math.round((100 * A.N[BEST]) / A.t) + ' %' : '–', B.t ? Math.round((100 * B.N[BEST]) / B.t) + ' %' : '–');
    }
    reset();
  });
</script>

<style is:global>
  .banw .row > .seg { display: flex; width: 100%; }
  .banw .row > .seg button:last-child { margin-left: auto; }
  .banw .fm { margin: 6px 0 0; font-size: 0.9rem; overflow-x: auto; overflow-y: hidden; }
  .banw [hidden] { display: none !important; }
  .banw .bgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 10px 0 0; }
  .banw .bbox { border: 1px solid var(--border); border-radius: 10px; padding: 8px 10px 6px; min-width: 0; }
  .banw .bbox select { font: 600 14px var(--font); background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 3px 8px; }
  .banw .bfm { font-size: 12.5px; color: var(--text-2); margin: 6px 0 0; min-height: 2.4em; line-height: 1.6; }
  .banw .bfm .katex { font-size: 1.05em; color: var(--text); }
  .banw svg.bsv { width: 100%; max-width: 320px; display: block; margin: 6px auto 0; }
  .banw svg text.bn { font: 600 10.5px var(--font); fill: var(--text); }
  .banw svg text.bl { font: 11px var(--font); fill: var(--text); }
  .banw svg text.bl.bb { font-weight: 700; }
  .banw svg text.bs { font: 10px var(--font); fill: var(--text-2); }
  .banw .bcalc { font-size: 11.5px; line-height: 1.45; color: var(--text-2); min-height: 3em; margin-top: 4px; padding: 4px 6px; border-radius: 6px; background: color-mix(in srgb, var(--text-2) 6%, transparent); }
  .banw .bplot { display: grid; grid-template-columns: minmax(0, 1fr) 190px; gap: 14px; align-items: center; margin-top: 10px; }
  .banw .bplot svg { width: 100%; display: block; }
  .banw .bplot .kpis { flex-direction: column; gap: 6px; margin: 0; }
  .banw .bplot .kpis > div { flex: 0 0 auto; flex-direction: column; align-items: flex-start; border-radius: 8px; padding: 6px 10px; background: color-mix(in srgb, var(--text-2) 6%, transparent); }
  @media (max-width: 640px) { .banw .bgrid, .banw .bplot { grid-template-columns: 1fr; } }
</style>
