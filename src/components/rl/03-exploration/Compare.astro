---
// Cours RL, chapitre 3 : les cinq stratégies sur le banc d'essai à 10 bras de Sutton & Barto, moyennées sur 500 problèmes tirés au hasard :
// pour chaque problème, 10 récompenses moyennes q*(a) ~ N(0, 1), et chaque récompense reçue = q*(a) + bruit N(0, 1). 1 000 pas par problème.
// Mêmes 500 problèmes pour toutes les stratégies. Seul ε est réglable (ε-greedy) ; les autres paramètres sont ceux du widget précédent.
---
<div class="widget rlw cmpw" data-widget="cmpw">
  <div class="cpar">
    <label title="Probabilité de jouer un bras au hasard pour ε-greedy"><span>Exploration ε (ε-greedy)</span><input type="range" data-ref="e" min="0.01" max="0.3" step="0.01" value="0.1" /><b data-ref="e-out"></b></label>
  </div>
  <svg data-ref="svg" role="img" aria-label="Récompense moyenne obtenue à chaque pas, pour chaque stratégie, moyennée sur 500 problèmes à 10 bras"></svg>
  <div class="kpis" data-ref="kpis"></div>
  <p class="note">Chaque courbe est la récompense obtenue au pas t, moyennée sur 500 problèmes. Trait pointillé : ce que rapporte le meilleur bras, en moyenne : aucune stratégie ne peut le dépasser. Les paramètres sont ceux du widget précédent (softmax τ = 0,25 ; UCB c = 2 ; optimiste Q<sub>0</sub> = 5 avec α = 0,1).</p>
</div>

<script>
  import { rng, gauss, argmaxTie, softmax, STRATS, LABELS, COLORS, TAU, UCB_C, Q0_OPT, ALPHA_OPT } from './bandit';
  import type { Strat } from './bandit';

  document.querySelectorAll<HTMLElement>('[data-widget="cmpw"]').forEach((root) => {
    const $ = (r: string) => root.querySelector<HTMLElement>(`[data-ref="${r}"]`)!;
    const K = 10, RUNS = 500, T = 1000, WIN = 100;
    const fm = (v: number, d = 2) => v.toFixed(d).replace('.', ',').replace('-', '−');
    let eps = 0.1;
    // récompense moyenne à chaque pas, sur RUNS problèmes (mêmes problèmes pour toutes les stratégies : graine 1000 + i)
    function series(strat: Strat, e: number) {
      const avg = new Float64Array(T);
      let bestSum = 0;
      for (let i = 0; i < RUNS; i++) {
        const r = rng(1000 + i);
        const mu = Array.from({ length: K }, () => gauss(r));
        bestSum += Math.max(...mu);
        const Q = new Array(K).fill(strat === 'opt' ? Q0_OPT : 0), N = new Array(K).fill(0);
        for (let t = 0; t < T; t++) {
          let a: number;
          if (strat === 'eps' && r() < e) a = Math.floor(r() * K);
          else if (strat === 'soft') {
            const p = softmax(Q, TAU), u = r();
            let c = 0; a = K - 1;
            for (let j = 0; j < K; j++) { c += p[j]; if (u < c) { a = j; break; } }
          } else if (strat === 'ucb') a = argmaxTie(Q.map((q, j) => (N[j] === 0 ? 1e9 : q + UCB_C * Math.sqrt(Math.log(t + 1) / N[j]))), r);
          else a = argmaxTie(Q, r);
          const rew = mu[a] + gauss(r);
          N[a]++;
          Q[a] += (strat === 'opt' ? ALPHA_OPT : 1 / N[a]) * (rew - Q[a]);
          avg[t] += rew / RUNS;
        }
      }
      return { avg, best: bestSum / RUNS };
    }
    const data = {} as Record<Strat, Float64Array>;
    let best = 0;
    STRATS.forEach((s) => { const x = series(s, eps); data[s] = x.avg; best = x.best; });

    function draw() {
      const W = 640, px = 40, py = 10, pw = 584, ph = 190, ymax = 1.8;
      const X = (t: number) => px + (t / (T - 1)) * pw, Y = (v: number) => py + ph - (Math.max(0, Math.min(ymax, v)) / ymax) * ph;
      let o = `<line x1="${px}" y1="${py + ph}" x2="${px + pw}" y2="${py + ph}" stroke="var(--border)"/><line x1="${px}" y1="${py}" x2="${px}" y2="${py + ph}" stroke="var(--border)"/>`;
      [0, 0.5, 1, 1.5].forEach((g) => (o += `<text x="${px - 6}" y="${Y(g) + 3.5}" text-anchor="end" class="vs">${fm(g, 1)}</text>`));
      [0, 250, 500, 750, 1000].forEach((t) => (o += `<text x="${X(Math.min(t, T - 1))}" y="${py + ph + 14}" text-anchor="middle" class="vs">${t}</text>`));
      o += `<text x="${px + pw / 2}" y="${py + ph + 30}" text-anchor="middle" class="vs">pas joués</text>`;
      o += `<text x="12" y="${py + ph / 2}" transform="rotate(-90 12 ${py + ph / 2})" text-anchor="middle" class="vs">récompense moyenne au pas t</text>`;
      o += `<line x1="${px}" y1="${Y(best)}" x2="${px + pw}" y2="${Y(best)}" stroke="var(--text)" stroke-width="1.4" stroke-dasharray="5 4"/><text x="${px + pw - 4}" y="${Y(best) - 5}" text-anchor="end" class="vs">meilleur bras : ${fm(best)}</text>`;
      STRATS.forEach((s) => {
        let pts = '';
        for (let t = 0; t < T; t += 2) pts += `${X(t).toFixed(1)},${Y(data[s][t]).toFixed(1)} `;
        o += `<polyline points="${pts}" fill="none" stroke="${COLORS[s]}" stroke-width="2.2" stroke-linejoin="round"/>`;
      });
      const svg = $('svg') as unknown as SVGSVGElement;
      svg.setAttribute('viewBox', `0 0 ${W} ${py + ph + 38}`); svg.innerHTML = o;
      $('e-out').textContent = fm(eps);
      $('kpis').innerHTML = STRATS.map((s) => {
        const m = Array.from(data[s].slice(T - WIN)).reduce((a, b) => a + b, 0) / WIN;
        const name = s === 'eps' ? `ε-greedy (ε = ${fm(eps)})` : LABELS[s];
        return `<div><span><i class="sw" style="background:${COLORS[s]}"></i>${name}</span><b>${fm(m)}</b></div>`;
      }).join('');
    }
    const eIn = $('e') as HTMLInputElement;
    eIn.addEventListener('input', () => { $('e-out').textContent = fm(+eIn.value); });
    eIn.addEventListener('change', () => { eps = +eIn.value; data.eps = series('eps', eps).avg; draw(); });
    draw();
  });
</script>

<style is:global>
  .cmpw .cpar { margin-bottom: 4px; max-width: 360px; }
  .cmpw svg { max-width: 680px; margin: 6px auto 0; }
  .cmpw svg text.vs { font: 10.5px var(--font); fill: var(--text-2); }
  .cmpw .kpis > div { flex: 1 1 130px; }
  .cmpw .kpis .sw { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; }
  .cmpw .kpis > div > span { white-space: nowrap; }
</style>
