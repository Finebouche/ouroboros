---
// Cours RL, chapitre 3 : SARSA contre Q-learning, même mise en forme que McBellman.astro (chapitre 1).
// À gauche de chaque colonne, un petit schéma de la cible : depuis s′, l'action jouée (SARSA) ou la meilleure (Q-learning).
import katex from 'katex';
const tx = (s: string) => katex.renderToString(s, { throwOnError: false });
const SA = 'var(--a-lspi)', QL = 'var(--a-fqi)';
// schéma : s′ et ses quatre actions ; SARSA en suit une (tirée par ε-greedy), Q-learning prend la plus grande
const tree = (kind: 's' | 'q') => {
  const vals = [0.3, 0.8, 0.5, 0.2], pick = kind === 's' ? 0 : 1, col = kind === 's' ? SA : QL;
  let o = `<svg viewBox="0 0 178 62" class="tdgl" aria-hidden="true"><circle cx="20" cy="31" r="11" fill="var(--text-2)" fill-opacity="0.12" stroke="var(--text-2)"/><text x="20" y="35" text-anchor="middle" class="tl">s′</text>`;
  vals.forEach((v, i) => {
    const y = 8 + i * 15.5, on = i === pick;
    o += `<line x1="31" y1="31" x2="88" y2="${y}" stroke="${on ? col : 'var(--border)'}" stroke-width="${on ? 2 : 1}"/>`;
    o += `<rect x="90" y="${y - 6}" width="${8 + 46 * v}" height="12" rx="3" fill="${on ? col : 'var(--text-2)'}" fill-opacity="${on ? 0.85 : 0.25}"/>`;
  });
  o += `<text x="176" y="${kind === 's' ? 12 : 27.5}" text-anchor="end" class="tn">${kind === 's' ? 'jouée' : 'max'}</text>`;
  return o + '</svg>';
};
const rows: [string, string, string][] = [
  ['Cible', tx("r + \\gamma\\, Q(s', a')"), tx("r + \\gamma \\max_{a'} Q(s', a')")],
  ['Action en s′', tree('s') + '<span>celle que l\'agent jouera vraiment ensuite, exploration comprise</span>', tree('q') + '<span>la meilleure selon Q, qu\'elle soit jouée ou non</span>'],
  ['Ce qu\'il apprend', 'la valeur de la politique qu\'il suit (avec ses explorations)', 'la valeur de la politique optimale'],
  ['Équation visée', 'Bellman pour une politique', 'Bellman d\'optimalité'],
  ['Nom', '<b>sur la politique</b> (<i>on-policy</i>)', '<b>hors politique</b> (<i>off-policy</i>)'],
];
---
<figure class="mb td">
  <div class="mbr mbhd">
    <div></div>
    <div style={`color:${SA}`}><b>SARSA</b><i>(s, a, r, s′, a′)</i></div>
    <div style={`color:${QL}`}><b>Q-learning</b><i>max sur a′</i></div>
  </div>
  {rows.map(([k, a, b], i) => (
    <div class={`mbr mbg${i % 2 ? ' alt' : ''}`}>
      <div class="mbk">{k}</div>
      <div class="mbc" set:html={a} />
      <div class="mbc" set:html={b} />
    </div>
  ))}
</figure>

<style is:global>
  .mb { margin: 1.4rem 0; font-family: var(--font); }
  .mb .mbr { display: grid; grid-template-columns: 128px minmax(0, 1fr) minmax(0, 1fr); column-gap: 18px; align-items: center; }
  .mb .mbhd { padding: 0 14px 8px; }
  .mb .mbhd b { display: block; font-size: 13px; font-weight: 600; }
  .mb .mbhd i { font-style: normal; font-size: 11px; color: var(--text-2); }
  .mb .mbg { border-radius: 8px; background: color-mix(in srgb, var(--text-2) 7%, transparent); padding: 9px 14px; margin-bottom: 6px; }
  .mb .mbg.alt { background: color-mix(in srgb, var(--text-2) 3.5%, transparent); }
  .mb .mbk { font-size: 12px; font-weight: 600; color: var(--text); }
  .mb .mbc { font-size: 13px; color: var(--text); line-height: 1.45; overflow-x: auto; overflow-y: hidden; }
  .mb .mbc .katex { font-size: 1.1em; }
  .td .tdgl { display: block; width: 178px; height: auto; margin-bottom: 4px; }
  .td .tdgl .tl { font: 11px var(--font); fill: var(--text); }
  .td .tdgl .tn { font: 600 10px var(--font); fill: var(--text-2); }
  .td .mbc > span { display: block; font-size: 12px; color: var(--text-2); line-height: 1.35; }
  @media (max-width: 640px) { .mb .mbr { grid-template-columns: 1fr; row-gap: 4px; } .mb .mbhd { display: none; } }
</style>
