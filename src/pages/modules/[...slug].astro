---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArchSidebar from '../../components/ArchSidebar.astro';

export async function getStaticPaths() {
  const modules = (await getCollection('modules')).sort((a, b) => a.data.num - b.data.num);
  return modules.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: modules[i - 1], next: modules[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---
<Base title={`Module ${entry.data.num} · ${entry.data.title}`} wide={!!entry.data.sidebar}>
  <div class:list={[{ layout: !!entry.data.sidebar }]}>
    {entry.data.sidebar === 'transformer' && <ArchSidebar />}
    <article>
      <p><a href="/">&larr; Carte de progression</a></p>
      <h1>Module {entry.data.num} · {entry.data.title}</h1>
      <Content />
      <nav class="pn">
        {prev ? <a href={`/modules/${prev.id}/`}>&larr; {prev.data.title}</a> : <span />}
        {next ? <a href={`/modules/${next.id}/`}>{next.data.title} &rarr;</a> : <span />}
      </nav>
    </article>
  </div>
</Base>
<style>
  .pn { display: flex; justify-content: space-between; margin-top: 3rem; border-top: 1px solid var(--border); padding-top: 1rem; }
</style>
