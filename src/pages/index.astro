---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const modules = (await getCollection('modules')).sort((a, b) => a.data.num - b.data.num);
const labels = { 'a-venir': 'à venir', 'en-cours': 'en cours', termine: 'terminé' } as const;
---
<Base title="Carte de progression">
  <h1>Comprendre Ouroboros</h1>
  <p>
    Un cours visuel pour comprendre comment une récurrence en profondeur (un bloc bouclé T fois)
    et une récurrence dans le temps (un état transporté d'un token au suivant) peuvent coexister,
    et pourquoi certains couplages gardent l'entraînement parallèle.
  </p>
  <h2>Carte de progression</h2>
  <ol class="modules">
    {modules.map((m) => (
      <li>
        <a href={`/modules/${m.id}/`}>Module {m.data.num} · {m.data.title}</a>
        <span class={`badge ${m.data.status}`}>{labels[m.data.status]}</span>
        <div class="sum">{m.data.summary}</div>
      </li>
    ))}
  </ol>
</Base>
<style>
  .modules { list-style: none; padding: 0; }
  .modules li { border-bottom: 1px solid var(--border); padding: 0.8rem 0; }
  .modules a { font-weight: 500; margin-right: 0.6rem; }
  .sum { color: var(--text-2); font-size: 15px; }
</style>
