.dm.o6 input[type="range"][data-discrete]::-webkit-slider-runnable-track { height: 10px; border-radius: 0; border-bottom: 1.5px solid var(--text-2); box-shadow: none; background: var(--ticks, none);  }
.dm.o6 input[type="range"][data-discrete]::-moz-range-track { height: 10px; border-radius: 0; border-bottom: 1.5px solid var(--text-2); box-shadow: none; background: var(--ticks, none);  }
.dm.o6 input[type="range"][data-discrete]::-moz-range-progress { background: transparent; }
.dm.o6 input[type="range"][data-discrete]::-webkit-slider-thumb { width: 6px; height: 20px; border-radius: 2px; background: var(--text); border: 1px solid var(--surface); box-shadow: none; box-sizing: border-box; margin-top: -9px; }
.dm.o6 input[type="range"][data-discrete]::-moz-range-thumb { width: 6px; height: 20px; border-radius: 2px; background: var(--text); border: 1px solid var(--surface); box-shadow: none; box-sizing: border-box;  }
.dm.o5 input[type="range"]:not([data-discrete])::-webkit-slider-runnable-track { height: 2px; border-radius: 2px; box-shadow: none; background: linear-gradient(to right, var(--text-2) calc(7px + (100% - 14px) * var(--pf)), var(--border) 0);  }
.dm.o5 input[type="range"]:not([data-discrete])::-moz-range-track { height: 2px; border-radius: 2px; box-shadow: none; background: linear-gradient(to right, var(--text-2) calc(7px + (100% - 14px) * var(--pf)), var(--border) 0);  }
.dm.o5 input[type="range"]:not([data-discrete])::-moz-range-progress { background: transparent; }
.dm.o5 input[type="range"]:not([data-discrete])::-webkit-slider-thumb { width: 14px; height: 14px; border-radius: 50%; background: var(--surface); border: 2px solid var(--text); box-sizing: border-box; box-shadow: none; margin-top: -6px; }
