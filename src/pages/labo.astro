.dm.o7 input[type="range"]::-moz-range-thumb { width: 6px; height: 20px; border-radius: 2px; background: var(--text); border: 1px solid var(--surface); box-shadow: none; box-sizing: border-box;  }
.dm.o6 input[type="range"] { height: 20px; --tw: 16px; }
.dm.o6 input[type="range"]:not([data-discrete])::-webkit-slider-runnable-track { height: 6px; border-radius: 6px; box-shadow: inset 0 0 0 1px var(--border); background: linear-gradient(to right, var(--accent) calc(8px + (100% - 16px) * var(--pf)), var(--surface-2) 0);  }
.dm.o6 input[type="range"]:not([data-discrete])::-moz-range-track { height: 6px; border-radius: 6px; box-shadow: inset 0 0 0 1px var(--border); background: linear-gradient(to right, var(--accent) calc(8px + (100% - 16px) * var(--pf)), var(--surface-2) 0);  }
