.dm.o7 input[type="range"]::-moz-range-track { height: 10px; border-radius: 0; border-bottom: 1.5px solid var(--text-2); box-shadow: none; background: var(--ticks, none);  }
.dm.o7 input[type="range"]::-moz-range-progress { background: transparent; }
